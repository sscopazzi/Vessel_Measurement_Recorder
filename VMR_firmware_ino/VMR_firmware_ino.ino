  if (!sdOK) { server.send(409, "application/json", "{\"error\":\"No microSD card\"}"); return; }
  if (!logging) { server.send(409, "application/json", "{\"error\":\"Not recording: press START LOGGING first\"}"); return; }
  reqLoggerAtMs = millis();
  reqLogger = 1;
