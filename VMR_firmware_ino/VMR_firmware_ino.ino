// Size-2 text, tight: digits and letters 11 px apart (the 10 px glyph + 1), punctuation only as wide
// as its ink - so a longitude like 122\xF815'25.9"W (12 characters) still fits the 128 px.
static int bigAdv(uint8_t c, int& shift) {
  switch (c) {
    case '.':  shift = 4; return 5;                  // ink in columns 2-3 of the 5
    case '\'': case '"': shift = 2; return 7;        // columns 1-3
    case ' ':  shift = 0; return 6;
    default:   shift = 0; return 11;
  }
}
int bigWidth(const char* s) { int w = 0, sh; for (; *s; s++) w += bigAdv((uint8_t)*s, sh); return w ? w - 1 : 0; }
void bigTextRight(int xr, int y, const char* s) {       // right edge at xr
  int x = xr - bigWidth(s) + 1, sh;
  for (; *s; s++) { int a = bigAdv((uint8_t)*s, sh); display.drawChar(x - sh, y, *s, SH110X_WHITE, SH110X_WHITE, 2); x += a; }
}

// The position in the format chosen on the dashboard (card 14), from the exact NMEA degrees x 1e7,
// to the dashboard's precision: 38.10206\xF8N / 38\xF806.124'N / 38\xF806'07.4"N
void fmtPosBig(char* out, size_t n, int32_t e7, char pos, char neg) {
  char h = e7 < 0 ? neg : pos;
  uint32_t a = e7 < 0 ? (uint32_t)(-(int64_t)e7) : (uint32_t)e7, d = a / 10000000UL, f = a % 10000000UL;
  if (P.posFmt == 1) {                                         // dd.ddddd
    uint32_t v = (a + 50) / 100;
    snprintf(out, n, "%lu.%05lu%c%c", (unsigned long)(v / 100000), (unsigned long)(v % 100000), (char)248, h);
  } else if (P.posFmt == 2) {                                  // dd mm ss.s
    uint32_t t = (uint32_t)(((uint64_t)f * 36000 + 5000000) / 10000000);   // tenths of a second
    if (t >= 36000) { d++; t = 0; }
    snprintf(out, n, "%lu%c%02lu'%02lu.%lu\"%c", (unsigned long)d, (char)248, (unsigned long)(t / 600),
             (unsigned long)(t % 600 / 10), (unsigned long)(t % 10), h);
  } else {                                                     // dd mm.mmm
    uint32_t m = (uint32_t)(((uint64_t)f * 60000 + 5000000) / 10000000);   // thousandths of a minute
    if (m >= 60000) { d++; m = 0; }
    snprintf(out, n, "%lu%c%02lu.%03lu'%c", (unsigned long)d, (char)248, (unsigned long)(m / 1000), (unsigned long)(m % 1000), h);
  }
}

// ---- Screen 5: GPS. The fix line, then the position in big letters (v7.42; the details are in card 14).
void drawGps() {
  char line[32];
  bool fx = gpsFixValid();
  const char* q = !fx ? "NO FIX" : (gps.gpsFixQ == 2 ? "DGPS" : "GPS");
  snprintf(line, sizeof(line), "GPS %-6s %2dHz", q, GPS_RATE_HZ);
  printAt(0, 0, line);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  if (!fx) { printCentered(28, "Waiting for a fix"); return; }
  fmtPosBig(line, sizeof(line), gps.latE7, 'N', 'S');
  bigTextRight(127, 17, line);
  fmtPosBig(line, sizeof(line), gps.lonE7, 'E', 'W');
  bigTextRight(127, 41, line);
}

