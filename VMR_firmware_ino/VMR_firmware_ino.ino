// Firmware update: header with %, the name and old -> new version in the
// middle (with kB received, then "Restarting..."), a progress bar along the
// bottom; the error instead if it failed.
void drawOta() {
  uint8_t st = otaState;
  uint32_t d = otaDone, tot = otaTotal;
  int pct = st == OTA_OK ? 100 : tot ? (int)(100ULL * d / tot) : 0;
  if (pct > 100) pct = 100;
  char t[40];
  display.fillRect(0, 0, 128, 9, SH110X_WHITE);
  display.setTextColor(SH110X_BLACK);
  printAt(2, 1, st == OTA_FAIL ? "UPDATE FAILED" : "FIRMWARE UPDATE");
  if (st != OTA_FAIL) { snprintf(t, sizeof(t), "%3d%%", pct); printAt(128 - 4 * 6 - 2, 1, t); }
  display.setTextColor(SH110X_WHITE);
  if (st != OTA_FAIL) {
    printCentered(13, "Vessel Measurement");
    printCentered(22, "Recorder");
    char nv[20];                                               // new version: "..." until found, "?" if never
    if (otaNewVer[0]) snprintf(nv, sizeof(nv), "v%s", otaNewVer); else strcpy(nv, st == OTA_OK ? "?" : "...");
    snprintf(t, sizeof(t), "v%.*s --> %s", (int)(sizeof(FW_MARK) - FW_MARK_HEAD - 2), FW_MARK + FW_MARK_HEAD, nv);
    printCentered(33, t);
    if (st == OTA_OK) strcpy(t, "Restarting...");
    else snprintf(t, sizeof(t), "%lu / %lu kB", (unsigned long)(d / 1024), (unsigned long)(tot / 1024));
    printCentered(43, t);
  } else {
    char e[22];                                                // the error, over two lines, broken at a space
    size_t n = strlen(otaErr), cut = n;
    if (n > 21) { cut = 21; while (cut > 8 && otaErr[cut] != ' ') cut--; if (otaErr[cut] != ' ') cut = 21; }
    strncpy(e, otaErr, cut); e[cut] = 0;
    printAt(0, 15, e);
    if (n > cut) { const char* r = otaErr + cut; while (*r == ' ') r++; strncpy(e, r, 21); e[21] = 0; printAt(0, 23, e); }
    printAt(0, 35, "Old firmware kept");
    printAt(0, 43, "Logging is stopped");
  }
  if (st != OTA_FAIL) {
    display.drawRect(0, 53, 128, 11, SH110X_WHITE);
    display.fillRect(2, 55, 124 * pct / 100, 7, SH110X_WHITE);
  }
}

// ---- Screen 6: clinometer. A needle hanging from the top centre swings over
// a +/-40 deg scale (starboard down = needle to the right, as seen looking
// forward); the two small triangles are drag pointers that stay at the
// largest roll each way until A+C is held (or Reset on the dashboard).
#define CLINO_CX     64
#define CLINO_CY      2
#define CLINO_R      58
#define CLINO_MAXDEG 40
void clinoPt(float deg, float r, int& x, int& y) {
  float a = deg * DEG_TO_RAD;
  x = CLINO_CX + (int)lroundf(sinf(a) * r);
  y = CLINO_CY + (int)lroundf(cosf(a) * r);
}

void clinoPointer(float deg) {
  if (deg == 0) return;
  deg = constrain(deg, -(float)CLINO_MAXDEG - 2, (float)CLINO_MAXDEG + 2);
  int x0, y0, x1, y1, x2, y2;
  clinoPt(deg, CLINO_R - 7, x0, y0);                          // tip, just inside the scale
  clinoPt(deg - 2.5f, CLINO_R - 13, x1, y1);
  clinoPt(deg + 2.5f, CLINO_R - 13, x2, y2);
  display.fillTriangle(x0, y0, x1, y1, x2, y2, SH110X_WHITE);
}

void drawClino() {
  int x0, y0, x1, y1;
  for (int a = -CLINO_MAXDEG; a <= CLINO_MAXDEG; a += 2) {     // the arc
    clinoPt(a, CLINO_R, x0, y0);
    display.drawPixel(x0, y0, SH110X_WHITE);
  }
  for (int a = -CLINO_MAXDEG; a <= CLINO_MAXDEG; a += 5) {     // ticks: long every 10 deg
    clinoPt(a, CLINO_R, x0, y0);
    clinoPt(a, CLINO_R - (a % 10 ? 3 : 6), x1, y1);
    display.drawLine(x0, y0, x1, y1, SH110X_WHITE);
  }
  printAt(4, 46, "P40");
  printAt(106, 46, "S40");
  char t[16];
  bool f = imuFresh();
  if (f) {
    float r = constrain(roll, -(float)CLINO_MAXDEG - 3, (float)CLINO_MAXDEG + 3);
    clinoPt(r, CLINO_R - 4, x1, y1);
    display.drawLine(CLINO_CX, CLINO_CY, x1, y1, SH110X_WHITE);
    display.drawLine(CLINO_CX + 1, CLINO_CY, x1 + 1, y1, SH110X_WHITE);   // 2 px needle
    display.fillCircle(CLINO_CX, CLINO_CY, 3, SH110X_WHITE);
  }
  clinoPointer(clinoMaxS);
  clinoPointer(clinoMaxP);
  display.setTextSize(2);                                      // live roll, top left
  if (f) snprintf(t, sizeof(t), "%.1f", fabsf(roll)); else strcpy(t, "--");
  printAt(0, 0, t);
  display.setTextSize(1);
  printAt(0, 17, !f || fabsf(roll) < 0.05f ? "" : roll > 0 ? "STBD" : "PORT");   // nothing at 0.0
  snprintf(t, sizeof(t), "P%5.1f", -clinoMaxP);                // drag pointer values, top right
  printAt(128 - 6 * 6, 0, t);
  snprintf(t, sizeof(t), "S%5.1f", clinoMaxS);
  printAt(128 - 6 * 6, 9, t);
}

// ---- Screen 7: location marks, newest at the top, in the small font of the serial monitor.
// The web task (which owns the list) writes the lines into markOled; this copies them under a lock.
// Built-in 6 x 8 font, as the boot list: the header and its rule, then 7 lines (21 characters)
void drawMarks() {
  MarkOled M[MARK_OLED_N];
  char H[24];
  uint8_t cnt;
  portENTER_CRITICAL(&markOledMux);
  if (markOled) memcpy(M, markOled, sizeof(M)); else memset(M, 0, sizeof(M));
  memcpy(H, markOledHdr, sizeof(H)); cnt = markOled ? markOledCnt : 0;
  portEXIT_CRITICAL(&markOledMux);
  printCentered(0, H);
  display.drawFastHLine(0, 7, 128, SH110X_WHITE);
  int row = 0;
  // small = the left text in the serial monitor's 4 x 6 font (bottoms lined up), when the normal
  // font would run into the right text
  auto line = [&](const char* left, const char* right, bool small) {
    if (row >= 7) return;
    int y = 9 + 8 * row++;
    if (right[0]) printAt(128 - 6 * (int)strlen(right), y, right);
    if (!left[0]) return;
    if (!small) { printAt(0, y, left); return; }
    display.setFont(&TomThumb);
    if (left[0] == ' ') printAt(6, y + 7, left + 1);             // the same one-space indent as the big font
    else printAt(0, y + 7, left);                                // (its glyphs end on the same pixel row)
    display.setFont();
  };
  for (int i = 0; i < cnt && row < 7; i++) {
    const MarkOled& m = M[i];
    char t[16];
    snprintf(t, sizeof(t), "%u%s %s", m.n, m.kind == 'M' ? "" : "C", m.hm);   // 5C = cast 5
    line(t, m.fix ? m.lat : "no fix", false);
    char info[40];                                               // second line, left: one space in, - for a mark
    snprintf(info, sizeof(info), " %s", m.info[0] ? m.info : "-");
    if (m.fix) line(info, m.lon, strlen(info) + strlen(m.lon) > 21);   // always beside the longitude
    else if (m.info[0]) line(info, "", false);                   // a cast without a fix; a mark: one line only
  }
}

// ---- Screen 8: sky plot. Horizon at the edge, overhead in the middle, north
// up. Filled = used in the fix, open = seen; bigger = stronger signal.
void drawSky() {
  const int cx = 31, cy = 32, R = 30;
  display.drawCircle(cx, cy, R, SH110X_WHITE);
  for (int a = 0; a < 360; a += 15) {                          // 45 deg elevation ring, dotted
    float r = a * DEG_TO_RAD;
    display.drawPixel(cx + (int)lroundf(sinf(r) * R / 2), cy - (int)lroundf(cosf(r) * R / 2), SH110X_WHITE);
  }
  display.drawPixel(cx, cy, SH110X_WHITE);
  display.fillRect(cx - 3, 0, 7, 9, SH110X_BLACK);             // "N" on the circle
  printAt(cx - 2, 1, "N");
  uint32_t now = millis();
  int nSeen = 0, nUsed = 0;
  for (int i = 0; i < SKY_MAX; i++) {
    const SkySat& v = sky[i];
    if (!v.prn || now - v.ms > SKY_STALE_MS) continue;
    nSeen++;
    float rr = R * (90 - v.el) / 90.0f, a = v.az * DEG_TO_RAD;
    int x = cx + (int)lroundf(sinf(a) * rr), y = cy - (int)lroundf(cosf(a) * rr);
    int rad = v.snr >= 35 ? 3 : v.snr >= 20 ? 2 : 1;
    if (skyIsUsed(v.prn)) { display.fillCircle(x, y, rad, SH110X_WHITE); nUsed++; }
    else if (v.snr) display.drawCircle(x, y, rad, SH110X_WHITE);
    else display.drawPixel(x, y, SH110X_WHITE);
  }
  char t[24];
  printAt(68, 0, "SKY");
  snprintf(t, sizeof(t), "seen %3d", nSeen);       printAt(68, 12, t);
  snprintf(t, sizeof(t), "used %3d", nUsed);       printAt(68, 21, t);
  snprintf(t, sizeof(t), "best %2ddB", (int)gpsBestSnr); printAt(68, 30, t);
  display.fillCircle(70, 46, 2, SH110X_WHITE); printAt(76, 43, "used");
  display.drawCircle(70, 56, 2, SH110X_WHITE); printAt(76, 53, "seen");
}

// ---- Screen 9: at the dock. Trim in feet-inches (mean over the card's window; by the stern / head)
// and list to 0.01 deg. "UNCAL" = trim measured from level zero only.
void drawDock() {
  char t[24];
  float tm = trimMetres(dockRawPitch), ft = tm / 0.3048f;
  display.fillRect(0, 0, 128, 9, SH110X_WHITE);
  display.setTextColor(SH110X_BLACK);
  printAt(2, 1, "AT THE DOCK");
  snprintf(t, sizeof(t), "%s", P.trimCal ? "cal" : "UNCAL");
  printAt(126 - 6 * (int)strlen(t), 1, t);
  display.setTextColor(SH110X_WHITE);
  printAt(0, 13, "TRIM");
  display.setTextSize(2);                                      // feet-inches, like the draft marks
  if (isnan(ft)) strcpy(t, "--");
  else { int in = (int)lroundf(fabsf(ft) * 12.0f); snprintf(t, sizeof(t), "%d-%02d", in / 12, in % 12); }
  printAt(28, 12, t);
  display.setTextSize(1);
  int x = 28 + 12 * (int)strlen(t) + 4;
  printAt(x, 12, isnan(ft) ? "" : fabsf(ft) < 0.05f ? "even" : ft > 0 ? "stern" : "head");
  if (!isnan(ft)) { snprintf(t, sizeof(t), "%.1fft", fabsf(ft)); printAt(x, 21, t); }
  display.drawLine(0, 32, 127, 32, SH110X_WHITE);
  printAt(0, 40, "LIST");
  display.setTextSize(2);
  if (isnan(dockRoll)) strcpy(t, "--");
  else snprintf(t, sizeof(t), "%c%.2f", fabsf(dockRoll) < 0.005f ? ' ' : dockRoll > 0 ? 'S' : 'P', fabsf(dockRoll));
  printAt(28, 39, t);
  display.setTextSize(1);
  printAt(28 + 12 * (int)strlen(t) + 3, 39, "deg");
  uint16_t w = dockAvgS(), fl = dockFill();
  if (fl < w) snprintf(t, sizeof(t), "%u/%us", (unsigned)fl, (unsigned)w);        // still filling
  else if (w < 60) snprintf(t, sizeof(t), "%us mean", (unsigned)w);
  else snprintf(t, sizeof(t), "%umin mean", (unsigned)(w / 60));
  printAt(0, 56, t);
}

// ---- Screen 10: G-meter. The dot is the felt push in the deck plane (up =
// forward, right = starboard): heeled to starboard it sits to starboard, like
// sliding down the deck. Rings every 0.1 g (0.2 g once a peak passes 0.3 g),
// a short trail, peak-hold ticks on each axis; vertical g on the bar.
void drawGMeter() {
  const int cx = 31, cy = 32, R = 30;
  float pkMax = fmaxf(fmaxf(gPkF, gPkA), fmaxf(gPkS, gPkP));
  float ring = pkMax > 0.3f ? 0.2f : 0.1f, full = 3 * ring;            // outer ring = 3 rings
  display.drawCircle(cx, cy, R, SH110X_WHITE);
  for (int k = 1; k <= 2; k++)
    for (int a = 0; a < 360; a += 20) {
      float r = a * DEG_TO_RAD;
      display.drawPixel(cx + (int)lroundf(sinf(r) * R * k / 3), cy - (int)lroundf(cosf(r) * R * k / 3), SH110X_WHITE);
    }
  display.drawLine(cx - 2, cy, cx + 2, cy, SH110X_WHITE);
  display.drawLine(cx, cy - 2, cx, cy + 2, SH110X_WHITE);
  auto lab = [&](int x, int y, const char* t) {                       // letters sit on the outer ring
    display.fillRect(x - 1, y - 1, 7, 9, SH110X_BLACK);
    printAt(x, y, t);
  };
  lab(cx - 2, cy - R - 2, "F");
  lab(cx - 2, cy + R - 5, "A");
  lab(cx - R - 1, cy - 3, "P");
  lab(cx + R - 3, cy - 3, "S");
  auto sc = [&](float g) { return (int)lroundf(constrain(g / full, -1.05f, 1.05f) * R); };
  // peak hold: short ticks across each axis
  int t;
  if (gPkS > 0.005f) { t = sc(gPkS);  display.drawLine(cx + t, cy - 2, cx + t, cy + 2, SH110X_WHITE); }
  if (gPkP > 0.005f) { t = sc(gPkP);  display.drawLine(cx - t, cy - 2, cx - t, cy + 2, SH110X_WHITE); }
  if (gPkF > 0.005f) { t = sc(gPkF);  display.drawLine(cx - 2, cy - t, cx + 2, cy - t, SH110X_WHITE); }
  if (gPkA > 0.005f) { t = sc(gPkA);  display.drawLine(cx - 2, cy + t, cx + 2, cy + t, SH110X_WHITE); }
  char b[24];
  bool fr = accFresh();
  if (fr) {
    int x = cx + sc(gFeltS), y = cy - sc(gFeltF);
    gTrailX[gTrailHead] = (int8_t)(x - cx); gTrailY[gTrailHead] = (int8_t)(y - cy);   // trail, one point a frame
    gTrailHead = (gTrailHead + 1) % G_TRAIL;
    if (gTrailN < G_TRAIL) gTrailN++;
    for (int i = 0; i < gTrailN; i++) display.drawPixel(cx + gTrailX[i], cy + gTrailY[i], SH110X_WHITE);
    display.fillCircle(x, y, 3, SH110X_WHITE);
  }
  // numbers on the right
  printAt(68, 0, "G-METER");
  if (fr) snprintf(b, sizeof(b), "%c %.2f", gFeltS >= 0 ? 'S' : 'P', fabsf(gFeltS)); else strcpy(b, "--");
  printAt(68, 11, b);
  if (fr) snprintf(b, sizeof(b), "%c %.2f", gFeltF >= 0 ? 'F' : 'A', fabsf(gFeltF)); else strcpy(b, "--");
  printAt(68, 20, b);
  if (fr) snprintf(b, sizeof(b), "V %.2f", gVert); else strcpy(b, "--");
  printAt(68, 29, b);
  snprintf(b, sizeof(b), "ring %.1fg", ring);
  printAt(68, 40, b);
  // vertical g bar: 0.5 ... 1.5 g, tick at 1 g, peak min / max ticks
  const int bx0 = 68, bx1 = 126, by = 54;
  display.drawRect(bx0, by, bx1 - bx0 + 1, 7, SH110X_WHITE);
  auto vx = [&](float g) { return bx0 + (int)lroundf(constrain((g - 0.5f), 0.0f, 1.0f) * (bx1 - bx0)); };
  display.drawLine(vx(1.0f), by - 2, vx(1.0f), by + 8, SH110X_WHITE);
  display.drawLine(vx(gPkLo), by + 1, vx(gPkLo), by + 5, SH110X_WHITE);
  display.drawLine(vx(gPkHi), by + 1, vx(gPkHi), by + 5, SH110X_WHITE);
  if (fr) display.fillRect(min(vx(1.0f), vx(gVert)), by + 2, abs(vx(gVert) - vx(1.0f)) + 1, 3, SH110X_WHITE);
}

// Serial Monitor copy on the OLED (card 13 "Show on OLED", latching): the
// latest 10 lines in the 4 x 6 px TomThumb font, one screen line each
// (cut at 32 characters, no wrapping), newest at the bottom.
// ---- Screen 11: the wave spectra (as the Waves card): roll, pitch and heave against period on a
// log axis, 4-30 s, each scaled to its own peak (bins 1/128 Hz, straight lines between them).
// Header: Te, Tr, Hs; black on white with SYNC! / PARA! when the card would flag it.
#define WVO_P0 4.0f
#define WVO_P1 30.0f
// The heave Hs the screens show, as the Waves card (v8.0): at midships when the VMR's position is in
// card 15, else at the VMR. tz = its peak period, mid = true for the midships one.
float wvHsShown(float& tz, bool& mid) {
  mid = !isnan(wvHsMid);
  tz = mid ? wvTzMid : wvTz;
  return mid ? wvHsMid : wvHs;
}

void drawWaves() {
  char t[24];
  float hsTz; bool hsMid;
  float hs = wvHsShown(hsTz, hsMid);
  bool have = wvSpec && wvLastMs && !isnan(wvTe) && !isnan(wvTrs);   // current, or the last one (marked OLD)
  float q = have ? wvTe / wvTrs : NAN;
  const char* flag = isnan(q) ? nullptr : fabsf(q - 1.0f) <= WV_TOL ? "SYNC!" : fabsf(q / 0.5f - 1.0f) <= WV_TOL ? "PARA!" : nullptr;
  if (flag) { display.fillRect(0, 0, 128, 9, SH110X_WHITE); display.setTextColor(SH110X_BLACK); }
  if (!have) strcpy(t, "WAVES");
  else if (flag) snprintf(t, sizeof(t), "Te%4.1f Tr%4.1f %s", wvTe, wvTrs, flag);
  else if (isnan(hs)) snprintf(t, sizeof(t), "Te%4.1f Tr%4.1f Hs --", wvTe, wvTrs);
  else snprintf(t, sizeof(t), "Te%4.1f Tr%4.1f Hs%3.1fm", wvTe, wvTrs, hs);
  printAt(flag ? 1 : 0, flag ? 1 : 0, t);
  display.setTextColor(SH110X_WHITE);
  if (!have) {                                                   // why there is nothing yet
    if (P.imuOff) strcpy(t, "IMU off (card 16)");
    else if (P.atDock) strcpy(t, "Off at the dock");
    else if (paused) strcpy(t, "Paused");
    else snprintf(t, sizeof(t), "%.1f / %.1f min", wvN * WV_DT_MS / 60000.0f, WV_MIN * WV_DT_MS / 60000.0f);
    printCentered(26, t);
    if (!P.imuOff && !P.atDock && !paused) printCentered(36, "of steady motion");
    return;
  }
  const int y0 = 17, y1 = 53, xr = 127;                          // curves; legend above, axis below
  auto xOf = [&](float p) { return (int)lroundf(xr * logf(p / WVO_P0) / logf(WVO_P1 / WVO_P0)); };
  const float kPerHz = WV_SEG * (WV_DT_MS / 1000.0f);            // bin number = f x this
  display.drawFastHLine(0, y1 + 1, 128, SH110X_WHITE);
  static const uint8_t TICK[] = {5, 10, 15, 20, 25, 30};
  for (uint8_t p : TICK) { int x = xOf(p); display.drawFastVLine(min(x, 127), y1 + 2, p % 10 ? 1 : 2, SH110X_WHITE); }
  printAt(xOf(5) - 2, 57, "5s"); printAt(xOf(10) - 5, 57, "10"); printAt(xOf(15) - 5, 57, "15"); printAt(xOf(20) - 5, 57, "20");
  // 25 and 30 s: ticks only (a label would run into the 20)
  for (int q2 = 0; q2 < 3; q2++) {                               // 0 heave, 1 pitch, 2 roll
    const float* S = wvSpec[q2];
    float mx = 0;
    for (int k = WV_K0; k <= WV_K1; k++) { float p = kPerHz / k; if (p >= WVO_P0 && p <= WVO_P1 && S[k] > mx) mx = S[k]; }
    if (!(mx > 0)) continue;
    int py = -1;
    for (int x = 0; x <= xr; x++) {
      float p = WVO_P0 * powf(WVO_P1 / WVO_P0, x / (float)xr), kf = kPerHz / p;
      int k = (int)kf; float fr = kf - k;
      if (k < WV_K0 || k + 1 > WV_K1) { py = -1; continue; }
      float v = (S[k] + fr * (S[k + 1] - S[k])) / mx;
      int y = y1 - (int)lroundf(constrain(v, 0.0f, 1.0f) * (y1 - y0));
      if (q2 == 0) { if (x % 3 == 0) display.drawPixel(x, y, SH110X_WHITE); }          // heave: dotted
      else {
        if (py >= 0) display.drawLine(x - 1, py, x, y, SH110X_WHITE);
        if (q2 == 2 && py >= 0) display.drawLine(x - 1, py - 1, x, y - 1, SH110X_WHITE); // roll: 2 px
      }
      py = y;
    }
  }
  display.setFont(&TomThumb);                                    // legend, top right
  if (!wvCurrent) {                                              // the last estimate: how old, top left
    uint32_t a = (millis() - wvLastMs) / 1000;
    if (a < 3600) snprintf(t, sizeof(t), "OLD %lu:%02lu", (unsigned long)(a / 60), (unsigned long)(a % 60));
    else snprintf(t, sizeof(t), "OLD %luh%02lu", (unsigned long)(a / 3600), (unsigned long)(a / 60 % 60));
    printAt(0, 15, t);
  }
  display.drawFastHLine(44, 12, 6, SH110X_WHITE); display.drawFastHLine(44, 13, 6, SH110X_WHITE); printAt(52, 15, "roll");
  display.drawFastHLine(70, 12, 6, SH110X_WHITE); printAt(78, 15, "pitch");
  for (int x = 99; x <= 105; x += 3) display.drawPixel(x, 12, SH110X_WHITE);
  printAt(108, 15, "heave");
  display.setFont();
}

// ---- Screen 12: the Waves card's numbers and the state of the analysis.
void drawWaveStats() {
  char t[32];
  bool have = wvLastMs && !isnan(wvTe) && !isnan(wvTrs);
  printAt(0, 0, "WAVE STATS");
  if (have && wvCurrent) strcpy(t, "LIVE");
  else if (have) {
    uint32_t a = (millis() - wvLastMs) / 1000;
    if (a < 3600) snprintf(t, sizeof(t), "OLD %lu:%02lu", (unsigned long)(a / 60), (unsigned long)(a % 60));
    else snprintf(t, sizeof(t), "OLD %luh%02lu", (unsigned long)(a / 3600), (unsigned long)(a / 60 % 60));
  } else strcpy(t, "--");
  printAt(128 - 6 * (int)strlen(t), 0, t);
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  auto v1 = [](char* o, size_t n, float x) { if (isnan(x)) snprintf(o, n, "  -- "); else snprintf(o, n, "%4.1fs", x); };   // 5 wide
  char a[8], b[8];
  v1(a, sizeof(a), have ? wvTe : NAN); snprintf(t, sizeof(t), "Te %s pitch peak", a); printAt(0, 11, t);
  v1(a, sizeof(a), have ? wvTrs : NAN); snprintf(t, sizeof(t), "Tr %s roll peak", a); printAt(0, 20, t);
  if (have) {
    float q = wvTe / wvTrs;
    snprintf(t, sizeof(t), "Te/Tr %.2f %s", q, fabsf(q - 1.0f) <= WV_TOL ? "SYNC!" : fabsf(q / 0.5f - 1.0f) <= WV_TOL ? "PARA!" : "clear");
  } else strcpy(t, "Te/Tr  --");
  printAt(0, 29, t);
  float hsTz; bool hsMid;
  float hs = wvHsShown(hsTz, hsMid);
  if (have && !isnan(hs)) {                                   // "mid" = at midships, "VMR" = at the VMR (as the Waves card)
    v1(b, sizeof(b), hsTz);
    snprintf(t, sizeof(t), hs < 9.995f ? "Hs %.2fm %s pk%s" : "Hs %.1fm %s pk%s", hs, hsMid ? "mid" : "VMR", b);
  }
  else strcpy(t, "Hs  --");
  printAt(0, 38, t);
  float felt = rStat[0].n >= 3 ? rStat[0].tMed : NAN;          // as card 1, over 10 min
  v1(a, sizeof(a), felt); snprintf(t, sizeof(t), "Felt roll %s 10m", a); printAt(0, 47, t);
  uint32_t now = millis();                                     // bottom: the state of the analysis
  if (P.imuOff) strcpy(t, "IMU off (card 16)");
  else if (P.atDock) strcpy(t, "Off at the dock");
  else if (paused) strcpy(t, "Paused");
  else if (wvN < WV_MIN) {
    uint32_t left = (uint32_t)(WV_MIN - wvN) * WV_DT_MS / 1000;
    snprintf(t, sizeof(t), "Collecting %lu:%02lu left", (unsigned long)(left / 60), (unsigned long)(left % 60));
  } else {
    uint32_t el = (now - wvCalcMs) / 1000, nx = el < 30 ? 30 - el : 0;
    snprintf(t, sizeof(t), "%.1fmin, next 0:%02lu", (wvN < WV_N ? wvN : WV_N) * WV_DT_MS / 60000.0f, (unsigned long)nx);
  }
  printAt(0, 56, t);
}

// ---- Screen 13: the phones / laptops on the hotspot (card 18's list), newest first.
void drawDevices() {
  DevSeen d[DEV_N];
  uint8_t n = 0;
  portENTER_CRITICAL(&devMux);
  if (devs) { memcpy(d, devs, sizeof(d)); n = devCount; }
  portEXIT_CRITICAL(&devMux);
  int on = 0;
  for (int i = 0; i < n; i++) if (d[i].on) on++;
  char t[32];
  printAt(0, 0, "WI-FI DEVICES");
  snprintf(t, sizeof(t), "%d on", on);
  printAt(128 - 6 * (int)strlen(t), 0, t);
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  if (!n) { printCentered(28, "None since boot"); return; }
  for (int i = 0; i < n; i++) {
    int y = 11 + 9 * i;
    if (d[i].on) display.fillCircle(2, y + 3, 2, SH110X_WHITE); else display.drawCircle(2, y + 3, 2, SH110X_WHITE);
    char nm[24];
    if (d[i].name[0]) snprintf(nm, sizeof(nm), "%s", d[i].name);
    else snprintf(nm, sizeof(nm), "%s %02X%02X%02X", d[i].kind[0] ? d[i].kind : "Device", d[i].mac[3], d[i].mac[4], d[i].mac[5]);
    nm[14] = 0;                                                // the time keeps its place
    printAt(8, y, nm);
    uint32_t u = d[i].on ? d[i].onUnix : d[i].offUnix;
    if (u) { DateTime lt(ltOf(u)); snprintf(t, sizeof(t), "%02u:%02u", (unsigned)lt.hour(), (unsigned)lt.minute()); }
    else {                                                     // no clock yet: how long ago
      uint32_t ago = (millis() - (d[i].on ? d[i].onMs : d[i].offMs)) / 60000;
      snprintf(t, sizeof(t), ago < 100 ? "%2lum" : ">99m", (unsigned long)ago);
    }
    printAt(128 - 6 * (int)strlen(t), y, t);
  }
  static uint32_t staMs = 0;                                   // signal of those on (as screen 3), every 2 s
  static int staN = 0, staWorst = 0;
  if (!staMs || millis() - staMs > 2000) {
    staMs = millis();
    wifi_sta_list_t sl;
    staN = 0; staWorst = 0;
    if (esp_wifi_ap_get_sta_list(&sl) == ESP_OK) {
      staN = sl.num;
      for (int i = 0; i < sl.num; i++) if (!i || sl.sta[i].rssi < staWorst) staWorst = sl.sta[i].rssi;
    }
  }
  if (staN) { snprintf(t, sizeof(t), "weakest %d dBm", staWorst); printAt(0, 47, t); }
  display.fillCircle(2, 59, 2, SH110X_WHITE); printAt(8, 56, "joined");
  display.drawCircle(56, 59, 2, SH110X_WHITE); printAt(62, 56, "left (LT)");
}

// ---- Screen 14 (v8.3): true wind, live (the last 1-s mean), with the 2-min mean and the apparent
// wind. Without a GPS fix (no true wind) it shows the apparent wind instead, and says so.
static int deg360(float v) { int k = (int)lroundf(v) % 360; return k < 0 ? k + 360 : k; }
void drawWind() {
  char t[32];
  if (!windActive()) { printAt(0, 0, "WIND"); display.drawFastHLine(0, 8, 128, SH110X_WHITE); printCentered(24, "Wind meter off"); printCentered(36, "(card 16)"); return; }
  bool f = windFresh();
  float aa = f && !isnan(windS1) ? windA1 : f ? windAwa : NAN, as = f && !isnan(windS1) ? windS1 : f ? windAwsKn : NAN;
  float tr, td, tk;
  windTrue(aa, as, tr, td, tk);
  bool tru = !isnan(tk);
  printAt(0, 0, tru ? "TRUE WIND" : "APPARENT WIND");
  if (windMcOn && f) printAt(116, 0, "MC");                     // motion corrected
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  if (!f) { printCentered(28, windLocked ? "No wind data" : "Wind meter: no data"); return; }
  float sp = tru ? tk : as, dir = tru ? (isnan(td) ? tr : td) : aa;
  bool compass = tru && !isnan(td);                              // N up; else bow up
  display.setTextSize(3);
  if (isnan(sp)) strcpy(t, "--"); else snprintf(t, sizeof(t), sp < 99.95f ? "%.1f" : "%.0f", sp);
  printAt(0, 12, t);
  display.setTextSize(1);
  printAt(6 + 18 * (int)strlen(t) - 4, 28, "kn");
  if (isnan(dir)) strcpy(t, "from --");
  else snprintf(t, sizeof(t), compass ? "from %03d T" : "from %03d rel", deg360(dir));
  printAt(0, 38, t);
  float a2, s2, g10, x;
  windMeans(120, a2, s2, x); windMeans(WIND_SEC_N, x, x, g10);
  float r2, d2, k2;
  windTrue(a2, s2, r2, d2, k2);
  if (tru && !isnan(k2)) {
    if (!isnan(d2)) snprintf(t, sizeof(t), "2-min %.1fkn %03dT", k2, deg360(d2));
    else snprintf(t, sizeof(t), "2-min %.1fkn", k2);
  } else if (!isnan(s2)) snprintf(t, sizeof(t), "2-min %.1fkn %03drel", s2, deg360(a2));
  else strcpy(t, "2-min --");
  printAt(0, 47, t);
  if (tru) snprintf(t, sizeof(t), "App %03d %.1f G%.1f", deg360(aa), as, isnan(g10) ? 0.0f : g10);
  else snprintf(t, sizeof(t), gpsFixValid() ? "Gust %.1fkn (10 min)" : "No GPS fix: no true", isnan(g10) ? 0.0f : g10);
  if (tru && isnan(g10)) { char* g = strstr(t, " G"); if (g) *g = 0; }
  printAt(0, 56, t);
  // dial: an arrow from the side the wind comes from, toward the middle
  const int cx = 111, cy = 28, R = 16;
  display.drawCircle(cx, cy, R, SH110X_WHITE);
  printAt(cx - 2, cy - R + 2, compass ? "N" : "^");
  if (!isnan(dir)) {
    float a = dir * DEG_TO_RAD, sx = sinf(a), sy = -cosf(a);
    int x0 = cx + (int)lroundf(sx * (R - 1)), y0 = cy + (int)lroundf(sy * (R - 1));
    int x1 = cx - (int)lroundf(sx * 5), y1 = cy - (int)lroundf(sy * 5);
    display.drawLine(x0, y0, x1, y1, SH110X_WHITE);
    float px = -sy, py = sx;                                     // the head at the inner end
    display.fillTriangle(x1 + (int)lroundf(sx * 6 + px * 4), y1 + (int)lroundf(sy * 6 + py * 4),
                         x1 + (int)lroundf(sx * 6 - px * 4), y1 + (int)lroundf(sy * 6 - py * 4), x1, y1, SH110X_WHITE);
  }
}

void drawSerial() {
  const int COLS = 32, ROWS = 10;
  display.setFont(&TomThumb);
  uint32_t seq = Log.seq();
  char ln[SLOG_LEN + 1];
  for (int r = ROWS - 1; r >= 0 && seq > 0; r--, seq--) {         // newest at the bottom, one line each
    if (!Log.get(seq - 1, ln)) break;
    ln[COLS] = 0;                                                // no wrapping: cut at the screen edge
    printAt(0, r * 6 + 5, ln);                                   // custom fonts: y is the baseline
  }
  display.setFont();                                             // back to the built-in 6 x 8 font
}

void drawScreen() {
  bool ota = otaState != OTA_IDLE;
  if (!displayOK || (!displayOn && !oledForced)) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  if (ota || serOledOn || imuWarnOn() || paused) {   // priority: update, serial (latched), IMU warning, pause
    if (ota) drawOta(); else if (serOledOn) drawSerial(); else if (imuWarnOn()) drawImuWarn(); else drawPaused();
    crumb(ST_OLED_SEND);
    display.display();
    return;
  }
  switch (screen) {
    case SCREEN_LIVE:     drawLive();     break;
    case SCREEN_GRAPH:    drawGraph();    break;
    case SCREEN_POSITION: drawPosition(); break;
    case SCREEN_ALLTIME:  drawAllTime();  break;
    case SCREEN_GPS:      drawGps();      break;
    case SCREEN_CLINO:    drawClino();    break;
    case SCREEN_MARKS:    drawMarks();    break;
    case SCREEN_SKY:      drawSky();      break;
    case SCREEN_DOCK:     drawDock();     break;
    case SCREEN_GMETER:   drawGMeter();   break;
    case SCREEN_WAVES:    drawWaves();    break;
    case SCREEN_WAVESTAT: drawWaveStats(); break;
    case SCREEN_DEVICES:  drawDevices();  break;
    case SCREEN_WIND:     drawWind();     break;
  }
  // Progress while A+C held on a screen that uses it
  if ((screen == SCREEN_POSITION || screen == SCREEN_ALLTIME || screen == SCREEN_CLINO || screen == SCREEN_GMETER) &&
      btnA.isDown() && btnC.isDown() && !comboFired) {
    uint32_t held = min(btnA.downFor(), btnC.downFor());
    if (held > 300) {
      char t[24];
      int left = (int)((HOLD_ACTION_MS - (held < HOLD_ACTION_MS ? held : HOLD_ACTION_MS)) / 1000) + 1;
      snprintf(t, sizeof(t), "%s in %ds", screen == SCREEN_POSITION ? "Zero" : screen == SCREEN_CLINO ? "Pointers" :
               screen == SCREEN_GMETER ? "Peaks" : "Reset", left);
      drawOverlay(t);
    }
  } else if ((int32_t)(msgUntil - millis()) > 0) {
    drawOverlay(msgText);
  }
  crumb(ST_OLED_SEND);
  display.display();
}

