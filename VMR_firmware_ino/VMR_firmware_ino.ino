// ---- Sensor mounting / signs (see SIGN CONVENTION in the header)
#define USE_GAME_ROTATION_VECTOR 1        // 1 = no magnetometer (recommended on steel ships)
#define ROLL_FLIP                0        // 1 if a tilt to starboard reads P
#define PITCH_FLIP               0        // 1 if bow up reads negative
#define YAW_FLIP                 0        // 1 if a turn to starboard reads ROT negative
#define USE_POT_SWITCH           1        // 0 if the pot switch is NOT wired (else display stays off)

// ---- Rates
#define IMU_REPORT_US          20000UL    // 50 Hz IMU reports
#define MAG_REPORT_US         100000UL    // magnetometer TEST (v8.0): calibrated field at 10 Hz, shown under Yaw in card 1;
                                          //   roll / pitch / yaw still come from the game rotation vector (no magnetometer)
#define MAG_SMOOTH_S               2.0f   // magnetic heading: the horizontal field averaged over about this long
// The BNO085 is read on a 5 ms beat, not on every loop pass (~1 ms): each read is an I2C
// transfer the chip may clock-stretch, and Adafruit lists it as troublesome on ESP32 I2C
// ("violates I2C protocol timing in some cases"). Every read that finds nothing new is a
// chance to trip it for no gain: this cuts them about five-fold. Reports still arrive every
// 20 ms (the chip queues them), so no data is lost; latency is at most 5 ms.
#define IMU_POLL_MS                5UL
#define LOG_INTERVAL_MS          100UL    // SD log rate with the IMU on (10 Hz)
// Logging rates (card 7): 10 Hz with the IMU; with it off (card 16) also these slower ones, the rows
// then on the clock (1-min rows at :00 s ...). 1 min and slower: in Datalogger mode the VMR sleeps
// between rows (LOGGER_WAKE_LEAD_MS before each it wakes for the GPS fix and the add-on readings).
#define LOG_RATE_N                 7
const uint32_t LOG_RATE_MS[LOG_RATE_N] = {100, 1000, 5000, 20000, 60000, 300000, 600000};
#define LOGGER_SLEEP_MIN_MS    60000UL    // sleep between rows only at this rate or slower
#define LOGGER_WAKE_LEAD_MS    20000UL    // awake this long before each row (GPS back from standby)
#define GPS_RATE_HZ                1      // 1, 5 or 10 (10 Hz disables SBAS - see header)
#define DISPLAY_INTERVAL_MS      200UL    // OLED refresh (5 Hz)
// I2C bus speed for everything on it (IMU, OLED, battery gauge, RTC, add-ons). v3.5-3.6 ran
// 100 kHz to see if the BNO085 dropped off less: it did not, and a full OLED frame took ~105 ms
// instead of ~27 ms, so v3.7 is back at 400 kHz.
#define I2C_HZ                 400000UL
#define GRAPH_SAMPLE_MS          500UL    // graph sample spacing (2 Hz)
#define GRAPH_POINTS            1200      // 1200 x 0.5 s = 10 min (longest graph length); 2 x 4.8 KB heap
#define GRAPH_WEB_BUCKETS        120      // dashboard graph is sent as at most this many columns
#define GRAPH_ENVELOPE_S         300      // graphs this long or longer draw the roll/pitch envelope

// ---- Derived values
#define ROT_SMOOTH_S             1.0f     // rate of turn smoothing (s) for screens/maxima
#define ROLL_PERIOD_HYST_DEG     0.3f     // roll must swing past +/- this (about its mean) to count a cycle
#define ROLL_PERIOD_MEAN_S      60.0f     // running mean removed first, so list/heel doesn't matter
#define ROLL_PERIOD_CYCLES         9      // median of this many recent cycles
#define COG_AVG_MIN_KN           0.3f     // averaged COG shows -- below this averaged speed
#define TARE_TAU_S              5.0f      // level-zero uses a 5 s running mean, not one sample
#define WARMUP_MS              10000UL    // ignore all-time maxima for first 10 s of IMU data

// ---- IMU recovery (see IMU ON I2C in the header)
#define IMU_SILENT_MS         5000UL      // no orientation this long (while being polled) -> recover the IMU
#define IMU_LAST_RESORT_MS   15000UL      // silent this long despite re-requests -> power-cycle the rail (60 s before v7.4:
                                          //   8 dropouts on 2026-11-03 were each ~52 s of no data, all fixed by the power-cycle)
#define IMU_RECOVER_GAP_MS   60000UL      // power-cycles at most this often; doubles after each one
#define IMU_RECOVER_GAP_MAX_MS 120000UL   //   that brings no data back, up to this
#define I2C_POWER_OFF_MS         1000      // STEMMA QT rail held off during a power-cycle (resets BNO085 + EEPROM); was 250 before v3.8
#define I2C_POWER_SETTLE_MS       300      // wait after power-on before talking to them

// ---- Time
#define RTC_MAX_DRIFT_S            2      // re-set RTC from GPS if off by more than this (0 = never)
#define GPS_FIX_TIMEOUT_MS      3000UL    // fix older than this counts as lost

// ---- Storage
#define MAXIMA_SAVE_MIN_MS     60000UL    // at most one EEPROM write of new maxima per minute
#define SETTINGS_SAVE_DELAY_MS  2000UL    // save settings 2 s after the last change
