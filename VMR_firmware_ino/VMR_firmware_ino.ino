// The page itself is at the very end of this file, gzipped (its source: web/index.html).
extern const uint8_t INDEX_HTML_GZ[];   // the page and the logo, gzipped (end of the sketch; web/make_page.py)
extern const size_t  INDEX_HTML_GZ_LEN;
extern const uint8_t LOGO_SVG_GZ[];
extern const size_t  LOGO_SVG_GZ_LEN;

// GET /logo.svg: the Aspect Wave logo for the welcome box, asked for only when it opens and
// cached by the phone, so the page itself stays as small as before
void handleLogo() {
  server.sendHeader("Cache-Control", "max-age=31536000");
  server.sendHeader("Content-Encoding", "gzip");
  server.send_P(200, "image/svg+xml", (const char*)LOGO_SVG_GZ, LOGO_SVG_GZ_LEN);
}

void jsonNum(String& s, float v, int dp) {
  if (isnan(v) || isinf(v)) s += "null";
  else s += String(v, dp);
}

void jsonKV(String& s, const char* k, float v, int dp, bool comma = true) {
  s += '"'; s += k; s += "\":";
  jsonNum(s, v, dp);
  if (comma) s += ',';
}

void jsonTime(String& s, const char* k, uint32_t t, bool comma = true) {
  s += '"'; s += k; s += "\":\"";
  if (t) {
    DateTime d(t);
    char b[32];
    snprintf(b, sizeof(b), "%04u-%02u-%02u %02u:%02u:%02u",
             (unsigned)d.year(), (unsigned)d.month(), (unsigned)d.day(),
             (unsigned)d.hour(), (unsigned)d.minute(), (unsigned)d.second());
    s += b;
  }
  s += '"';
  if (comma) s += ',';
}

void handleRoot() {
  server.sendHeader("Cache-Control", "no-store");      // always the page of the running firmware
  uint32_t t0 = millis();
  // a copy in RAM, as in v5.1 (PSRAM: over 4 KB); gzipped, about 55 KB (v7.4; 168 KB before)
  uint8_t* page = (uint8_t*)ps_malloc(INDEX_HTML_GZ_LEN);
  if (!page) page = (uint8_t*)malloc(INDEX_HTML_GZ_LEN);
  if (!page) { pageNoMem++; server.send(503, "text/plain", "VMR out of memory, reload"); return; }
  memcpy(page, INDEX_HTML_GZ, INDEX_HTML_GZ_LEN);
  server.sendHeader("Content-Encoding", "gzip");
  server.setContentLength(INDEX_HTML_GZ_LEN);
  server.send(200, "text/html; charset=utf-8", "");     // headers only
  size_t w = server.client().write(page, INDEX_HTML_GZ_LEN);
  free(page);
  if (w < INDEX_HTML_GZ_LEN) pageShort++;
  pageSendMs = millis() - t0;
  if (pageSendMs > pageWorstMs) pageWorstMs = pageSendMs;
  pageLoads++;
}

void handleData() {
  static size_t dataLen = 6144;          // grows to the largest reply so far: one allocation, no regrowth
  uint32_t t0 = millis();
  plotRelease();
  String j;
  j.reserve(dataLen + 512);

  char src;
  uint32_t u = utcNow(src);
  j += "{\"build\":\"" __DATE__ " " __TIME__ "\",\"ver\":\"" FW_VERSION "\",\"unix\":"; j += (unsigned long)u;
  j += ",\"src\":\""; j += (src == 'G') ? "GPS" : (src == 'R') ? "RTC" : (src == 'P') ? "phone" : "none";
  j += "\",\"gpsTime\":"; j += gpsTimeSeen ? "true" : "false";
  j += ",\"paused\":"; j += paused ? "true" : "false";
  j += ",\"pausedS\":"; j += paused ? (unsigned long)((millis() - pausedAtMs) / 1000) : 0UL;
  j += ",\"otaMax\":"; j += (unsigned long)otaMax;
  j += ",\"fwSize\":"; j += (unsigned long)fwSize;
  j += ",\"serOled\":"; j += serOledOn ? "true" : "false";
  j += ',';
  jsonKV(j, "battV", battV, 2);
  jsonKV(j, "battPct", battPct, 0);
  jsonKV(j, "battRate", battRate, 1);
  jsonKV(j, "cpuT", cpuTempC, 0);
  j += "\"upS\":"; j += (unsigned long)(esp_timer_get_time() / 1000000ULL); j += ',';   // 64-bit timer: no 49.7-day wrap
  j += "\"mk\":{\"n\":"; j += (unsigned)marks.size(); j += ",\"rev\":"; j += (unsigned long)marksRev;
  j += ",\"ok\":"; j += marksSaved ? "true" : "false"; j += ",\"f\":\""; j += markFile;
  j += "\",\"open\":"; j += markOpenCast() + 1; j += "},";
  // Wi-Fi: phones on the hotspot and their signal strength as heard by the VMR;
  // "me" = the phone making this request (matched through its DHCP lease)
  {
    wifi_sta_list_t sl;
    int me = 0;
    j += "\"wifi\":{\"rssi\":[";
    if (esp_wifi_ap_get_sta_list(&sl) == ESP_OK) {
      esp_netif_pair_mac_ip_t pairs[ESP_WIFI_MAX_CONN_NUM];
      for (int i = 0; i < sl.num; i++) { memcpy(pairs[i].mac, sl.sta[i].mac, 6); pairs[i].ip.addr = 0; }
      esp_netif_t* ap = esp_netif_get_handle_from_ifkey("WIFI_AP_DEF");
      if (ap && sl.num) esp_netif_dhcps_get_clients_by_mac(ap, sl.num, pairs);
      uint32_t rip = (uint32_t)server.client().remoteIP();
      for (int i = 0; i < sl.num; i++) {
        if (i) j += ',';
        j += (int)sl.sta[i].rssi;
        if (pairs[i].ip.addr && pairs[i].ip.addr == rip) me = sl.sta[i].rssi;
      }
    }
    j += "],\"me\":"; if (me) j += me; else j += "null";
    j += "},";
  }


  bool fx = gpsFixValid();
  j += "\"fix\":"; j += fx ? "true" : "false";
  j += ",\"sats\":"; j += (int)gps.gpsSats;
  j += ",\"fixQ\":"; j += (int)gps.gpsFixQ;
  j += ",\"gpsHz\":"; j += GPS_RATE_HZ;
  j += ",\"gpsOff\":"; j += gpsOff ? "true" : "false";
  j += ",\"inView\":"; j += (int)(gpsInView[0] + gpsInView[1]);
  j += ",\"snr\":"; j += (int)gpsBestSnr;
  j += ",\"gpsAge\":"; if (gpsLastNmeaMs) j += (unsigned long)((millis() - gpsLastNmeaMs) / 1000); else j += "null";
  j += ",\"gpsDiag\":{\"gp\":"; j += (int)gpsInView[0];
  j += ",\"gl\":"; j += (int)gpsInView[1];
  j += ",\"nmeaHz\":"; jsonNum(j, gpsNmeaRate, 1);
  j += ",\"ant\":"; j += (int)GPS.antenna;                // 0 not reported, 1 problem, 2 internal, 3 external
  j += ",\"fixAge\":"; if (gps.gpsLastFixMs) j += (unsigned long)((millis() - gps.gpsLastFixMs) / 1000); else j += "null";
  j += ",\"restarts\":"; j += (unsigned long)gpsRestarts;
  j += "},";
  jsonKV(j, "lat", fx ? gps.gpsLat : NAN, 6);
  jsonKV(j, "lon", fx ? gps.gpsLon : NAN, 6);
  jsonKV(j, "alt", fx ? gps.gpsAlt : NAN, 1);
  jsonKV(j, "sog", fx ? gps.gpsSpeed / KNOTS_TO_MS : NAN, 1);
  jsonKV(j, "sogMs", fx ? gps.gpsSpeed : NAN, 2);
  jsonKV(j, "cog", fx ? gps.gpsAngle : NAN, 0);
  jsonKV(j, "sogAvg", sogAvgKn, 1);
  jsonKV(j, "cogAvg", cogAvgDeg, 1);
  jsonKV(j, "hdop", gps.gpsHdop, 2);

  bool f = imuFresh();
  jsonKV(j, "roll",    f ? roll    : NAN, 1);
  jsonKV(j, "pitch",   f ? pitch   : NAN, 1);
  jsonKV(j, "rot",     f ? rotShown() : NAN, 0);         // deg/min, smoothed + deadband
  {                                                        // magnetometer test (v8.0)
    bool mf = f && magFresh();
    jsonKV(j, "mh", mf ? magHeading() : NAN, 1);           // magnetic heading of the bow
    j += "\"mvar\":"; j += String(P.magVar10 / 10.0f, 1); j += ',';   // variation, + east (v8.5)
    jsonKV(j, "mdev", mf ? magDeviation() : NAN, 1);       // deviation from COG (v8.5)
    jsonKV(j, "mt", mf ? magTotal : NAN, 1);               // field strength, uT
    jsonKV(j, "md", mf ? magDip : NAN, 0);                 // dip, deg (+ = down)
    jsonKV(j, "ma", mf ? (float)magAcc : NAN, 0);          // calibration 0-3
  }
  jsonKV(j, "rollT",   f ? rollPeriod : NAN, 1);           // s
  j += "\"rollTn\":"; j += (int)rpCount; j += ',';
  jsonKV(j, "gm", f ? gmEst : NAN, 2);
  jsonKV(j, "gmC", gmC, 3);
  j += "\"clino\":["; jsonNum(j, clinoMaxP, 1); j += ','; jsonNum(j, clinoMaxS, 1); j += "],";
  {                                                  // G-meter: felt push (fwd, stbd), vertical g, peaks
    bool fa = accFresh();
    j += "\"gmet\":{";
    jsonKV(j, "f", fa ? gFeltF : NAN, 3); jsonKV(j, "s", fa ? gFeltS : NAN, 3); jsonKV(j, "v", fa ? gVert : NAN, 3);
    j += "\"pk\":[";
    jsonNum(j, gPkF, 3); j += ','; jsonNum(j, gPkA, 3); j += ','; jsonNum(j, gPkS, 3); j += ',';
    jsonNum(j, gPkP, 3); j += ','; jsonNum(j, gPkHi, 3); j += ','; jsonNum(j, gPkLo, 3);
    j += "]},";
  }
  {                                                  // waves: window fill and the last estimates
    j += "\"atDock\":"; j += (int)P.atDock; j += ',';
    j += "\"wave\":{\"n\":"; j += wvN; j += ",\"need\":"; j += WV_MIN; j += ",\"dt\":"; j += WV_DT_MS; j += ',';
    jsonKV(j, "te", wvTe, 1); jsonKV(j, "tz", wvTz, 1); jsonKV(j, "trs", wvTrs, 1); jsonKV(j, "hs", wvHs, 2);
    jsonKV(j, "hsm", wvHsMid, 2); jsonKV(j, "tzm", wvTzMid, 1);   // heave Hs at midships, its peak (null without the VMR's position)
    j += "\"cur\":"; j += wvCurrent ? "true" : "false";            // false: the values are the last estimate, age s old
    j += ",\"age\":"; j += wvLastMs ? (long)((millis() - wvLastMs) / 1000) : -1L;
    j += "},";
  }
  {                                                  // indicator LEDs (card 17): what each shows now, why the Fault one is on
    j += "\"leds\":{\"s\":[";
    for (int i = 0; i < LED_N; i++) { if (i) j += ','; j += '"'; j += ledOnPin[i] ? ledState[i] : "no pin"; j += '"'; }
    j += "],\"why\":\""; j += faultWhy[faultWhyIdx];
    j += "\",\"sw\":"; j += ledSwitchOn() ? "true" : "false";
    j += ",\"pct\":"; j += (ledDutyNow() * 100 + 512) / 1023;
    j += "},";
  }
  windJson(j);                                       // wind meter (v8.2; card 4, card 16)
  {                                                  // I2C add-ons (card 16 and their cards)
    int okm = 0;
    for (int i = 0; i < EXT_N; i++) if (ext[i].ok) okm |= 1 << i;
    j += "\"ext\":{\"en\":"; j += (int)P.extEn; j += ",\"ok\":"; j += okm;
    j += ",\"addr\":[";
    for (int i = 0; i < EXT_N; i++) { if (i) j += ','; j += (int)extAddr(i); }
    j += "],\"src\":["; j += (int)P.scrSrc; j += ','; j += (int)P.potSrc; j += ','; j += (int)P.potSwSrc; j += ','; j += (int)markSrcNow(); j += ','; j += (int)castSrcNow();
    j += "],\"scan\":\""; j += i2cFoundList; j += "\",";
    jsonKV(j, "p", extPa / 100.0f, 2);                 // hPa
    jsonKV(j, "tend", presTendency(), 1);              // hPa / 3 h
    j += "\"tendH\":"; j += String(presCount ? (presCount - 1) / 6.0f : 0.0f, 1); j += ',';
    jsonKV(j, "tb", extTb, 1); jsonKV(j, "ta", extTa, 1); jsonKV(j, "rh", extRh, 1);
    j += "\"pcf\":"; if (ext[EXT_PCF].ok) j += (int)extPcfVal; else j += "null";
    j += ",\"adc\":[";                                  // (a list of one: the page reads adc[0])
    if (!ext[EXT_ADC1].ok) j += "null";
    else { j += '['; for (int ch = 0; ch < 8; ch++) { if (ch) j += ','; j += (int)extAdc[ch]; } j += ']'; }
    j += "]},";
  }
  {                                                  // at the dock: window means and live values
    float L = shipLengthM();
    j += "\"dock\":{";
    jsonKV(j, "trim", trimMetres(dockRawPitch), 3);      // m, + = by the stern
    jsonKV(j, "trimNow", f ? trimMetres(rawPitch) : NAN, 3);
    jsonKV(j, "ang", isnan(dockRawPitch) ? NAN : trimAngle(dockRawPitch), 3);
    jsonKV(j, "list", dockRoll, 3);
    jsonKV(j, "listNow", f ? roll : NAN, 2);
    jsonKV(j, "L", L, 1);
    j += "\"n\":"; j += (int)dockN;
    j += ",\"win\":"; j += (int)dockAvgS(); j += ",\"fill\":"; j += (int)dockFill();
    j += ",\"cal\":"; j += (int)P.trimCal;
    j += ",\"cf\":"; j += (int)P.calFwdIn; j += ",\"cm\":"; j += (int)P.calMidIn; j += ",\"ca\":"; j += (int)P.calAftIn;
    j += ',';
    jsonTime(j, "ct", P.trimCalUnix, false);
    j += "},";
  }
  if (server.hasArg("sky")) {                       // sky plot (card 14, only while shown): [prn, elev, az, snr, used]
    j += "\"sky\":[";
    uint32_t now = millis();
    bool first = true;
    for (int i = 0; i < SKY_MAX; i++) {
      const SkySat& v = sky[i];
      if (!v.prn || now - v.ms > SKY_STALE_MS) continue;
      if (!first) j += ',';
      first = false;
      char b[40];
      snprintf(b, sizeof(b), "[%u,%u,%u,%u,%d]", v.prn, v.el, v.az, v.snr, skyIsUsed(v.prn) ? 1 : 0);
      j += b;
    }
    j += "],";
  }
  j += "\"gmNear\":"; j += gmNearTe ? "true," : "false,";
  j += "\"rs\":[";                                 // roll statistics, 10 and 30 min
  for (int w = 0; w < 2; w++) {
    const RollStats& st = rStat[w];
    if (w) j += ',';
    j += "{\"min\":"; j += (int)RS_WIN_MIN[w]; j += ",\"n\":"; j += (int)st.n; j += ',';
    jsonKV(j, "sig", st.sig, 1); jsonKV(j, "max", st.maxAmp, 1);
    jsonKV(j, "mean", st.mean, 1); jsonKV(j, "rms", st.rms, 1); jsonKV(j, "tp", st.tMed, 1);
    j += "\"ovS\":"; j += (int)st.overS; j += ",\"ovP\":"; j += (int)st.overP; j += '}';
  }
  j += "],";

  Win w = window1m();
  j += "\"m1\":{";
  jsonKV(j, "rMax", w.rMax, 1); jsonKV(j, "rMin", w.rMin, 1);
  jsonKV(j, "pMax", w.pMax, 1); jsonKV(j, "pMin", w.pMin, 1);
  jsonKV(j, "yr", w.yrMax * 60.0f, 0, false);
  j += "},\"all\":{";
  jsonKV(j, "rMax", P.rollMaxPos, 1);  jsonTime(j, "trMax", P.tRollMaxPos);
  jsonKV(j, "rMin", P.rollMaxNeg, 1);  jsonTime(j, "trMin", P.tRollMaxNeg);
  jsonKV(j, "pMax", P.pitchMaxPos, 1); jsonTime(j, "tpMax", P.tPitchMaxPos);
  jsonKV(j, "pMin", P.pitchMaxNeg, 1); jsonTime(j, "tpMin", P.tPitchMaxNeg);
  jsonKV(j, "yr", P.yawRateMax * 60.0f, 0); jsonTime(j, "tyr", P.tYawRateMax, false);
  j += "},";

  j += "\"zero\":"; j += P.zeroApplied ? "true" : "false"; j += ',';
  jsonKV(j, "zr", P.rollOffset, 2);
  {                                                  // level zero (v8.4): what it was set to read, and what Set would use now
    float tr, hs, ref = levelRefPitch(tr, hs);
    j += "\"zref\":"; j += String(P.zeroRef100 / 100.0f, 2); j += ',';
    jsonKV(j, "zrefNow", ref, 2); jsonKV(j, "zrefTrim", tr, 2); jsonKV(j, "zrefHs", hs, 2);
  }
  jsonKV(j, "zp", P.pitchOffset, 2);

  char ln[64] = "";
  if (sdLock(50)) { strncpy(ln, logName[0] ? logName + 1 : "", sizeof(ln) - 1); sdUnlock(); }
  j += "\"sd\":"; j += sdOK ? "true" : "false";
  j += ",\"log\":{\"on\":"; j += logging ? "true" : "false";
  j += ",\"intr\":"; j += logInterrupted ? "true" : "false";
  j += ",\"daily\":"; j += logDaily ? "true" : "false";
  j += ",\"file\":\""; j += ln; j += "\"";
  j += ",\"sec\":"; j += logging ? (unsigned long)((millis() - logStartMs) / 1000) : 0UL;
  j += ",\"rows\":"; j += (unsigned long)logRows;
  j += ",\"bytes\":"; j += String((double)logBytes, 0);
  j += ",\"drop\":"; j += (unsigned long)pendDropped;
  j += ",\"chk\":"; j += (unsigned long)sdChkFails;
  j += ",\"buf\":"; j += (unsigned long)bufSeconds();               // last 20 min: seconds buffered, the save
  j += ",\"bs\":"; j += (int)bufSaveState; j += ",\"bsn\":\""; j += bufSaveState == 2 ? bufSaveName + 1 : "";
  j += "\",\"bse\":\""; j += bufSaveErr; j += "\",\"bss\":"; j += (unsigned long)bufSaveSec;
  j += ",\"rate\":"; j += P.imuOff ? (int)P.logRate : 0;
  {
    uint32_t lm = logMs();                          // slow rates: seconds to the next row
    long nx = logging && lm > LOG_INTERVAL_MS && logSlot != UINT64_MAX ? (long)(((logSlot + 1) * (uint64_t)lm - logClockMs()) / 1000) : -1;
    j += ",\"next\":"; j += nx;
  }
  j += ",\"cond\":\""; j += LOAD_COND[P.logCond < LOAD_COND_N ? P.logCond : 0];
  j += "\",\"ev\":[";
  for (int i = 0; i < 5 && i < evCount; i++) {
    if (i) j += ',';
    j += "{\"n\":"; j += (unsigned)evList[i].n; j += ',';
    jsonTime(j, "t", evList[i].unix);
    j += "\"note\":\""; j += evList[i].note; j += "\"}";
  }
  j += "]},\"disp\":{\"ok\":"; j += displayOK ? "true" : "false";
  j += ",\"on\":"; j += displayOn ? "true" : "false";
  j += ",\"scr\":"; j += (int)screen;
  j += ",\"pct\":"; j += (int)((contrast * 100 + 127) / 255);
  j += ",\"src\":\""; j += P.briWeb ? "web" : potRawNow() < 0 ? "noknob" : "pot";
  j += "\",\"flip\":"; j += (int)P.oledFlip;
  j += "},\"set\":{\"gmax\":"; j += (int)P.graphMax;
  j += ",\"rotdb\":"; j += (int)P.rotDeadband;
  j += ",\"gmin\":"; j += (int)P.graphMin;
  j += ",\"pmax\":"; j += (int)P.pitchGraphMax;
  j += ",\"pmin\":"; j += (int)P.pitchGraphMin;
  j += ",\"beam\":"; j += String(P.shipBeamCm / 100.0f, 2);
  j += ",\"draft\":"; j += String(P.shipDraftCm / 100.0f, 2);
  j += ",\"len\":"; j += String(P.shipLengthDm / 10.0f, 1);
  j += ",\"lbp\":"; j += String(P.shipLbpDm / 10.0f, 1);
  j += ",\"dfwd\":"; j += String(P.draftFwdCm / 100.0f, 2);
  j += ",\"daft\":"; j += String(P.draftAftCm / 100.0f, 2);
  j += ",\"dmid\":"; j += String(P.draftMidCm / 100.0f, 2);
  j += ",\"kdeck\":"; j += String(P.keelDeckCm / 100.0f, 2);
  j += ",\"kbr\":"; j += String(P.keelBridgeCm / 100.0f, 2);
  j += ",\"ktop\":"; j += String(P.keelTopCm / 100.0f, 2);
  j += ",\"pwl\":"; j += String(P.parWlDm / 10.0f, 1);
  j += ",\"cb\":"; j += String(P.cbX1000 / 1000.0f, 3);
  j += ",\"cwp\":"; j += String(P.cwpX1000 / 1000.0f, 3);
  j += ",\"tpi\":"; j += String(P.tpiX10 / 10.0f, 1);
  j += ",\"disp\":"; j += (unsigned long)P.dispX10 * 10UL;
  j += ",\"gmlc\":"; j += String(P.gmLcFt100 / 100.0f, 2);
  j += ",\"pf\":"; j += (int)P.posFmt;
  j += ",\"vx\":"; if (P.vmrXdm == VMR_POS_UNSET) j += "null"; else j += String(P.vmrXdm / 10.0f, 1);
  j += ",\"vy\":"; if (P.vmrYcm == VMR_POS_UNSET) j += "null"; else j += String(P.vmrYcm / 100.0f, 2);
  j += ",\"vz\":"; j += String(P.vmrZcm / 100.0f, 2);
  j += ",\"ledp\":["; j += (int)P.ledPin[0]; j += ','; j += (int)P.ledPin[1]; j += ','; j += (int)P.ledPin[2]; j += ']';
  j += ",\"rthr\":"; j += (int)P.rollThrDeg;
  j += ",\"cond\":"; j += (int)P.logCond;
  j += ",\"gsecs\":"; j += (int)graphSecs();
  j += ",\"sogavg\":"; j += (int)P.sogAvgS;
  j += ",\"dockavg\":"; j += (int)dockAvgS();
  j += ",\"zd\":"; j += (int)P.zdHours;
  j += "},\"reset\":\""; j += resetReason;
  j += "\",\"crash\":\"";
  { String c = crashReport; c.replace("\\", "\\\\"); c.replace("\"", "\\\""); c.replace("\n", "\\n"); j += c; }
  j += "\",\"i2cMiss\":\""; j += i2cMissing;
  j += "\",\"i2cNote\":\""; j += i2cBusNote;
  j += "\",\"imuRec\":"; j += (unsigned long)imuRecoveries;
  j += ",\"imuSoft\":"; j += (unsigned long)imuSoftRecoveries;
  j += ",\"imuWrX\":"; j += (unsigned long)imuWriteGiveUps;
  j += ",\"i2cRd\":"; j += (unsigned long)WireS.resets;          // I2C driver renewed after a failed read
  j += ",\"imuOk\":"; j += imuFresh() ? "true" : "false";
  j += ",\"imuOff\":"; j += P.imuOff ? "true" : "false";

  // Graph: the chosen length, at most GRAPH_WEB_BUCKETS columns. When k samples
  // share a column, send that column's min and max (keeps the roll peaks).
  uint16_t secs = graphSecs();
  int nS = (int)((uint32_t)secs * 1000UL / GRAPH_SAMPLE_MS);
  int k = (nS + GRAPH_WEB_BUCKETS - 1) / GRAPH_WEB_BUCKETS;
  int avail = (int)gCount < nS ? (int)gCount : nS;
  int nB = (avail + k - 1) / k;
  j += ",\"gSecs\":"; j += (int)secs;
  j += ",\"gK\":"; j += k;
  j += ",\"gB\":"; j += nS / k;
  j += ",\"gDt\":"; j += String(k * GRAPH_SAMPLE_MS / 1000.0f, 2);
  const float* series[2] = {gRoll, gPitch};
  const char* names[2] = {",\"gRoll\":[", "],\"gPitch\":["};
  for (int sr = 0; sr < 2; sr++) {
    j += names[sr];
    if (!series[sr]) continue;
    for (int bk = 0; bk < nB; bk++) {
      int ageHi = (nB - bk) * k - 1, ageLo = (nB - 1 - bk) * k;   // bucket covers these ages
      float lo = INFINITY, hi = -INFINITY;
      for (int age = ageHi; age >= ageLo; age--) {
        if (age >= gCount) continue;
        float v = series[sr][(gHead + GRAPH_POINTS - 1 - age) % GRAPH_POINTS];
        if (isnan(v)) continue;
        lo = fminf(lo, v); hi = fmaxf(hi, v);
      }
      if (bk) j += ',';
      if (lo > hi) { j += (k == 1) ? "null" : "null,null"; continue; }
      jsonNum(j, lo, 2);
      if (k > 1) { j += ','; jsonNum(j, hi, 2); }
    }
  }
  j += "],\"heap\":{\"free\":"; j += (unsigned long)ESP.getFreeHeap();
  j += ",\"big\":"; j += (unsigned long)ESP.getMaxAllocHeap();
  j += ",\"min\":"; j += (unsigned long)ESP.getMinFreeHeap();
  j += ",\"pfree\":"; j += (unsigned long)ESP.getFreePsram();
  j += ",\"pbig\":"; j += (unsigned long)ESP.getMaxAllocPsram();
  // web timing, ms: this reply's build and size go out with the next one
  j += "},\"web\":{\"dB\":"; j += dataBuildMs; j += ",\"dS\":"; j += dataSendMs; j += ",\"dKB\":"; j += dataBytes;
  j += ",\"dBr\":"; j += wDataBuild.recent(); j += ",\"dSr\":"; j += wDataSend.recent();
  j += ",\"dBb\":"; j += wDataBuild.boot; j += ",\"dSb\":"; j += wDataSend.boot;
  j += ",\"pS\":"; j += pageSendMs; j += ",\"pSb\":"; j += pageWorstMs; j += ",\"pN\":"; j += pageLoads;
  j += ",\"wR\":"; j += wWebWait.recent(); j += ",\"wB\":"; j += wWebWait.boot;
  j += ",\"dCut\":"; j += dataShort; j += ",\"pCut\":"; j += pageShort; j += ",\"pMem\":"; j += pageNoMem;
  j += "}}";
  if (j.length() > dataLen) dataLen = j.length();

  server.sendHeader("Cache-Control", "no-store");
  uint32_t t1 = millis();
  dataBuildMs = t1 - t0; wDataBuild.add(dataBuildMs);
  server.setContentLength(j.length());
  server.send(200, "application/json", "");             // headers only
  size_t sent = server.client().write(j.c_str(), j.length());
  if (sent < j.length()) dataShort++;
  dataSendMs = millis() - t1; wDataSend.add(dataSendMs);
  dataBytes = j.length();
}

// ---- ZIPCORE BEGIN (store-only streamed ZIP; also compiled by host tests) ----
#ifdef ESP_PLATFORM
// The chip's ROM has the CRC-32 table: no 1 KB table in RAM (v7.4). It inverts on the way in and
// out; this running value is not inverted, so invert around it.
void zipCrcInit() {}
uint32_t zipCrcUpdate(uint32_t c, const uint8_t* p, size_t n) { return ~esp_rom_crc32_le(~c, p, (uint32_t)n); }
#else                                                   // host tests: the table
static uint32_t zipCrcTable[256];
static bool zipCrcReady = false;

void zipCrcInit() {
  if (zipCrcReady) return;
  for (uint32_t i = 0; i < 256; i++) {
    uint32_t c = i;
    for (int k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320UL ^ (c >> 1)) : (c >> 1);
    zipCrcTable[i] = c;
  }
  zipCrcReady = true;
}

// Running CRC-32: start at 0xFFFFFFFF, invert at the end
uint32_t zipCrcUpdate(uint32_t c, const uint8_t* p, size_t n) {
  while (n--) c = zipCrcTable[(c ^ *p++) & 0xFF] ^ (c >> 8);
  return c;
}
#endif

void zipPut16(uint8_t* p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
void zipPut32(uint8_t* p, uint32_t v) {
  p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
}

void zipDosTime(uint32_t unixT, uint16_t* t, uint16_t* d) {
  if (unixT < 315532800UL) { *t = 0; *d = (1 << 5) | 1; return; }   // before 1980: 1980-01-01
  time_t tt = (time_t)unixT;
  struct tm tmv;
  gmtime_r(&tt, &tmv);
  *t = (uint16_t)((tmv.tm_hour << 11) | (tmv.tm_min << 5) | (tmv.tm_sec / 2));
  *d = (uint16_t)(((tmv.tm_year - 80) << 9) | ((tmv.tm_mon + 1) << 5) | tmv.tm_mday);
}

// Non-empty entries use flag bit 3 (CRC follows the data in a data descriptor).
// Empty entries have a known CRC (0), so they get a plain header and no descriptor.
uint16_t zipFlags(const ZipEntry* e) { return e->size ? 0x0008 : 0x0000; }

size_t zipLocalHeader(uint8_t* o, const ZipEntry* e) {
  size_t n = strlen(e->name);
  zipPut32(o, 0x04034b50UL); zipPut16(o + 4, 20); zipPut16(o + 6, zipFlags(e)); zipPut16(o + 8, 0);
  zipPut16(o + 10, e->dosTime); zipPut16(o + 12, e->dosDate);
  // CRC is not known yet (it follows in the data descriptor), but the sizes
  // are, so write them: lets streaming unzippers handle uncompressed entries.
  zipPut32(o + 14, 0); zipPut32(o + 18, e->size); zipPut32(o + 22, e->size);
  zipPut16(o + 26, (uint16_t)n); zipPut16(o + 28, 0);
  memcpy(o + 30, e->name, n);
  return 30 + n;
}

size_t zipDescriptor(uint8_t* o, const ZipEntry* e) {
  if (!e->size) return 0;
  zipPut32(o, 0x08074b50UL); zipPut32(o + 4, e->crc); zipPut32(o + 8, e->size); zipPut32(o + 12, e->size);
  return 16;
}

size_t zipCentral(uint8_t* o, const ZipEntry* e) {
  size_t n = strlen(e->name);
  zipPut32(o, 0x02014b50UL); zipPut16(o + 4, 20); zipPut16(o + 6, 20); zipPut16(o + 8, zipFlags(e));
  zipPut16(o + 10, 0); zipPut16(o + 12, e->dosTime); zipPut16(o + 14, e->dosDate);
  zipPut32(o + 16, e->crc); zipPut32(o + 20, e->size); zipPut32(o + 24, e->size);
  zipPut16(o + 28, (uint16_t)n); zipPut16(o + 30, 0); zipPut16(o + 32, 0);
  zipPut16(o + 34, 0); zipPut16(o + 36, 0); zipPut32(o + 38, 0); zipPut32(o + 42, e->offset);
  memcpy(o + 46, e->name, n);
  return 46 + n;
}

size_t zipEnd(uint8_t* o, uint16_t count, uint32_t cdSize, uint32_t cdOffset) {
  zipPut32(o, 0x06054b50UL); zipPut16(o + 4, 0); zipPut16(o + 6, 0);
  zipPut16(o + 8, count); zipPut16(o + 10, count);
  zipPut32(o + 12, cdSize); zipPut32(o + 16, cdOffset); zipPut16(o + 20, 0);
  return 22;
}

uint64_t zipTotalSize(const ZipEntry* e, size_t count) {
  uint64_t t = 22;
  for (size_t i = 0; i < count; i++) {
    uint64_t n = strlen(e[i].name);
    t += (30 + n) + e[i].size + (e[i].size ? 16 : 0) + (46 + n);
  }
  return t;
}

// Streams a complete ZIP. Reads each entry's bytes via rd() (exactly e[i].size
// bytes), writes everything via wr(). Fills crc/offset as it goes.
bool zipStream(ZipEntry* e, size_t count, ZipReadFn rd, ZipSinkFn wr, void* ctx,
               uint8_t* buf, size_t bufLen) {
  zipCrcInit();
  uint8_t hdr[46 + ZIP_NAME_MAX];
  uint32_t off = 0;
  for (size_t i = 0; i < count; i++) {
    e[i].offset = off;
    size_t h = zipLocalHeader(hdr, &e[i]);
    if (!wr(ctx, hdr, h)) return false;
    off += h;
    uint32_t left = e[i].size, c = 0xFFFFFFFFUL;
    while (left) {
      size_t want = left < bufLen ? left : bufLen;
      int got = rd(ctx, i, buf, want);
      if (got <= 0) return false;
      c = zipCrcUpdate(c, buf, (size_t)got);
      if (!wr(ctx, buf, (size_t)got)) return false;
      left -= (uint32_t)got;
    }
    e[i].crc = ~c;
    off += e[i].size;
    h = zipDescriptor(hdr, &e[i]);
    if (h && !wr(ctx, hdr, h)) return false;
    off += h;
  }
  uint32_t cdStart = off;
  for (size_t i = 0; i < count; i++) {
    size_t h = zipCentral(hdr, &e[i]);
    if (!wr(ctx, hdr, h)) return false;
    off += h;
  }
  size_t h = zipEnd(hdr, (uint16_t)count, off - cdStart, cdStart);
  return wr(ctx, hdr, h);
}
// ---- ZIPCORE END ----

// ---------------------------- microSD file manager ---------------------------
bool validName(const String& n) {
  if (n.length() == 0 || n.length() >= ZIP_NAME_MAX) return false;
  if (n[0] == '.') return false;
  for (size_t i = 0; i < n.length(); i++) {
    char c = n[i];
    if (c == '/' || c == '\\' || c == '"' || (uint8_t)c < 0x20) return false;
  }
  return true;
}

// The folder a file request is for: dir=a -> "/archive/", dir=p -> "/plots/", dir=m -> the location
// marks, else the top folder "/"
const char* webDir() { String d = server.arg("dir"); return d == "a" ? "/archive/" : d == "p" ? "/plots/" : d == "m" ? MARK_DIR "/" : "/"; }

// Files in one folder ("/" or "/archive/"; skips folders, dot-files and odd
// names). Call with sdMutex held.
void listFiles(const char* dir, std::vector<String>& names, std::vector<uint32_t>* sizes) {
  String d = dir;
  if (d.length() > 1 && d.endsWith("/")) d.remove(d.length() - 1);      // SD.open wants "/archive"
  File root = SD.open(d.c_str());
  if (!root || !root.isDirectory()) { if (root) root.close(); return; }
  File f = root.openNextFile();
  while (f) {
    if (!f.isDirectory()) {
      String nm = f.name();
      bool markAux = strcmp(dir, MARK_DIR "/") == 0 && !nm.endsWith(".csv");   // current.txt, marks.tmp
      if (validName(nm) && !markAux) {
        names.push_back(nm);
        if (sizes) sizes->push_back((uint32_t)f.size());
      }
    }
    f.close();
    f = root.openNextFile();
  }
  root.close();
}

bool clientWriteAll(NetworkClient& c, const uint8_t* p, size_t n) {
  while (n) {
    size_t w = c.write(p, n);
    if (w == 0) return false;
    p += w; n -= w;
  }
  return true;
}

bool loggingActive() { return logging || logWanted; }

bool rejectIfLogging() {
  if (!loggingActive()) return false;
  server.send(409, "text/plain", "Stop logging first");
  return true;
}

void handleFiles() {
  const char* dir = webDir();
  if (!sdLock(3000)) { server.send(503, "application/json", "{\"sd\":false,\"busy\":true,\"files\":[]}"); return; }
  if (!sdOK && !loggingActive()) sdOK = sdMount();      // card may have been swapped while stopped
  if (!sdOK) { sdUnlock(); server.send(200, "application/json", "{\"sd\":false,\"files\":[]}"); return; }
  // The file being recorded is flushed to the card every 2 s; flush it now too, so the size
  // listed (and what a plot reads) is up to the last row. Every logFile call is under sdMutex.
  if (logging && logFile) logCheckpoint();
  std::vector<String> names;
  std::vector<uint32_t> sizes;
  listFiles(dir, names, &sizes);
  uint32_t aN, pN; unsigned long long aB, pB;
  folderCount("/archive", aN, aB);
  folderCount("/plots", pN, pB);
  unsigned long long total = SD.totalBytes(), used = SD.usedBytes();
  String active = logName[0] && dir[1] == 0 ? String(logName + 1) : String("");   // REC: top folder only
  sdUnlock();

  String j;
  j.reserve(64 + names.size() * 48);
  char b[160];
  snprintf(b, sizeof(b), "{\"sd\":true,\"total\":%llu,\"used\":%llu,\"arch\":%lu,\"archB\":%llu,\"plots\":%lu,\"plotsB\":%llu,\"files\":[",
           total, used, (unsigned long)aN, aB, (unsigned long)pN, pB);
  j += b;
  for (size_t i = 0; i < names.size(); i++) {
    if (i) j += ',';
    j += "{\"n\":\""; j += names[i]; j += "\",\"s\":"; j += sizes[i];
    j += ",\"a\":"; j += (names[i] == active) ? "true" : "false"; j += '}';
  }
  j += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

void handleDownload() {
  String n = server.arg("f");
  bool plotImg = server.arg("dir") == "p" && n.endsWith(".png");   // saved plot images: small, so also while
  if (!plotImg && rejectIfLogging()) return;                        // recording (like Save to System)
  if (!webBuf) { server.send(500, "text/plain", "Out of memory"); return; }
  if (!validName(n)) { server.send(400, "text/plain", "Bad file name"); return; }
  if (!sdLock(3000)) { server.send(503, "text/plain", "SD card busy, try again"); return; }
  File f = sdOK ? SD.open((webDir() + n).c_str(), FILE_READ) : File();
  bool ok = f && !f.isDirectory();
  uint32_t size = ok ? (uint32_t)f.size() : 0;
  if (!ok && f) f.close();
  sdUnlock();
  if (!ok) { server.send(404, "text/plain", "File not found"); return; }

  bool csv = n.endsWith(".csv") || n.endsWith(".CSV"), png = n.endsWith(".png");
  server.sendHeader("Content-Disposition", String(server.arg("view") == "1" ? "inline" : "attachment") + "; filename=\"" + n + "\"");
  server.sendHeader("Cache-Control", "no-store");
  server.setContentLength(size);
  server.send(200, csv ? "text/csv" : png ? "image/png" : "application/octet-stream", "");

  NetworkClient& client = server.client();
  uint32_t left = size;                  // send exactly the size announced in Content-Length
  while (left) {
    size_t want = left < WEB_BUF_BYTES ? left : WEB_BUF_BYTES;
    if (!sdLock(3000)) break;
    int got = f.read(webBuf, want);
    sdUnlock();
    if (got <= 0) break;
    if (!clientWriteAll(client, webBuf, (size_t)got)) break;
    left -= (uint32_t)got;
  }
  if (sdLock(3000)) { f.close(); sdUnlock(); } else f.close();
  if (left) { client.stop(); Log.printf("Web: download of %s aborted\n", n.c_str()); }
}

int webZipRead(void* vctx, size_t idx, uint8_t* buf, size_t want) {
  ZipCtx* z = (ZipCtx*)vctx;
  if (!sdLock(3000)) return -1;
  if (z->cur != (int)idx) {
    if (z->f) z->f.close();
    char path[ZIP_NAME_MAX + 12];
    snprintf(path, sizeof(path), "%s%s", z->dir, z->e[idx].name);
    z->f = sdOK ? SD.open(path, FILE_READ) : File();
    z->cur = (int)idx;
  }
  int got = z->f ? z->f.read(buf, want) : -1;
  sdUnlock();
  return got;
}

bool webZipSink(void* vctx, const uint8_t* buf, size_t n) {
  return clientWriteAll(*((ZipCtx*)vctx)->client, buf, n);
}

void handleZip() {
  if (rejectIfLogging()) return;
  const char* dir = webDir();
  if (!webBuf) { server.send(500, "text/plain", "Out of memory"); return; }
  std::vector<String> names;
  bool all = server.arg("all") == "1";
  if (!all) {
    for (int i = 0; i < server.args(); i++) if (server.argName(i) == "f") names.push_back(server.arg(i));
  }
  if (!sdLock(3000)) { server.send(503, "text/plain", "SD card busy, try again"); return; }
  if (!sdOK) { sdUnlock(); server.send(503, "text/plain", "No microSD card"); return; }
  if (all) listFiles(dir, names, nullptr);
  size_t count = names.size();
  if (count == 0 || count > ZIP_MAX_FILES) {
    sdUnlock();
    server.send(400, "text/plain", count ? "Too many files for one zip; select fewer" : "No files selected");
    return;
  }
  ZipEntry* e = new (std::nothrow) ZipEntry[count];
  if (!e) { sdUnlock(); server.send(500, "text/plain", "Out of memory"); return; }
  String bad;
  for (size_t i = 0; i < count && !bad.length(); i++) {
    memset(&e[i], 0, sizeof(ZipEntry));
    if (!validName(names[i])) { bad = "bad name"; break; }
    File f = SD.open((dir + names[i]).c_str(), FILE_READ);
    if (!f || f.isDirectory()) { bad = names[i]; if (f) f.close(); break; }
    strncpy(e[i].name, names[i].c_str(), ZIP_NAME_MAX - 1);
    e[i].size = (uint32_t)f.size();
    zipDosTime((uint32_t)f.getLastWrite(), &e[i].dosTime, &e[i].dosDate);
    f.close();
  }
  sdUnlock();
  if (bad.length()) { delete[] e; server.send(404, "text/plain", "Not found: " + bad); return; }

  uint64_t total = zipTotalSize(e, count);
  if (total > 0xFFFFFFF0ULL) {
    delete[] e;
    server.send(413, "text/plain", "Selection is over 4 GB; select fewer files or pull the card");
    return;
  }

  char zname[40];
  if (clockSynced) {
    DateTime t(nowUnix());
    snprintf(zname, sizeof(zname), "VMR%s_%04u%02u%02u_%02u%02u.zip", dir[1] == 'a' ? "_archive" : dir[1] == 'p' ? "_plots" : dir[1] == 'l' ? "_marks" : "", (unsigned)t.year(),
             (unsigned)t.month(), (unsigned)t.day(), (unsigned)t.hour(), (unsigned)t.minute());
  } else {
    snprintf(zname, sizeof(zname), "VMR%s.zip", dir[1] == 'a' ? "_archive" : dir[1] == 'p' ? "_plots" : dir[1] == 'l' ? "_marks" : "_logs");
  }
  server.sendHeader("Content-Disposition", String("attachment; filename=\"") + zname + "\"");
  server.sendHeader("Cache-Control", "no-store");
  server.setContentLength((size_t)total);
  server.send(200, "application/zip", "");

  ZipCtx z;
  z.dir = dir;
  z.e = e;
  z.cur = -1;
  z.client = &server.client();
  bool ok = zipStream(e, count, webZipRead, webZipSink, &z, webBuf, WEB_BUF_BYTES);
  if (z.f) { if (sdLock(3000)) { z.f.close(); sdUnlock(); } else z.f.close(); }
  delete[] e;
  if (!ok) { server.client().stop(); Log.println("Web: zip download aborted"); }
  else Log.printf("Web: sent %s (%u files, %llu bytes)\n", zname, (unsigned)count, (unsigned long long)total);
}

// Move one file between folders ("/" and "/archive/"); a name already at the
// destination gets _2, _3 ... Call with sdMutex held.
bool sdMoveFile(const char* from, const char* to, const String& n) {
  int dot = n.lastIndexOf('.');
  String base = dot > 0 ? n.substring(0, dot) : n, ext = dot > 0 ? n.substring(dot) : String("");
  String dst = to + n;
  for (int k = 2; SD.exists(dst.c_str()) && k < 1000; k++) dst = to + base + "_" + k + ext;
  return SD.rename((from + n).c_str(), dst.c_str());
}

// POST /archive: move the f= files (none given: every file) in the card's top
// folder into /archive (made if missing), or with back=1 the f= files from
// /archive back to the top folder. Only while stopped.
void handleArchive() {
  if (loggingActive()) { server.send(409, "application/json", "{\"moved\":0,\"failed\":[\"stop logging first\"]}"); return; }
  if (plotState == 1) { server.send(409, "application/json", "{\"moved\":0,\"failed\":[\"wait for the plot to finish\"]}"); return; }
  bool back = server.arg("back") == "1";
  std::vector<String> names;
  for (int i = 0; i < server.args(); i++) if (server.argName(i) == "f") names.push_back(server.arg(i));
  if (!back) {
    if (!sdLock(3000)) { server.send(503, "application/json", "{\"moved\":0,\"failed\":[\"SD busy\"]}"); return; }
    bool dirOk = sdOK && (SD.exists("/archive") || SD.mkdir("/archive"));
    if (dirOk && names.empty()) listFiles("/", names, nullptr);   // no f= : all of them
    sdUnlock();
    if (!dirOk) { server.send(500, "application/json", "{\"moved\":0,\"failed\":[\"could not make the archive folder\"]}"); return; }
  }
  int moved = 0, nFail = 0;
  String failed;
  for (size_t i = 0; i < names.size(); i++) {
    const String& n = names[i];
    bool ok = false;
    if (validName(n) && sdLock(5000)) {
      if (sdOK) ok = back ? sdMoveFile("/archive/", "/", n) : sdMoveFile("/", "/archive/", n);
      sdUnlock();
    }
    if (ok) moved++;
    else { if (nFail++) failed += ','; failed += '"'; failed += validName(n) ? n : String("(invalid name)"); failed += '"'; }
    vTaskDelay(1);
  }
  Log.printf("Web: %s %d file(s), %d failed\n", back ? "un-archived" : "archived", moved, nFail);
  String j = "{\"moved\":"; j += moved; j += ",\"failed\":["; j += failed; j += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

// Files and bytes in a folder, e.g. "/archive" (call with sdMutex held)
void folderCount(const char* dir, uint32_t& n, unsigned long long& bytes) {
  n = 0; bytes = 0;
  File d = SD.open(dir);
  if (!d || !d.isDirectory()) { if (d) d.close(); return; }
  for (File f = d.openNextFile(); f; f = d.openNextFile()) {
    if (!f.isDirectory()) { n++; bytes += f.size(); }
    f.close();
  }
  d.close();
}

void handleDelete() {
  if (loggingActive()) {
    server.send(409, "application/json", "{\"deleted\":0,\"failed\":[\"stop logging first\"]}");
    return;
  }
  if (plotState == 1) {
    server.send(409, "application/json", "{\"deleted\":0,\"failed\":[\"wait for the plot to finish\"]}");
    return;
  }
  std::vector<String> names;
  const char* dir = webDir();
  bool all = server.arg("all") == "1";
  if (all) {
    if (!sdLock(3000)) { server.send(503, "application/json", "{\"deleted\":0,\"failed\":[\"SD busy\"]}"); return; }
    if (sdOK) listFiles(dir, names, nullptr);
    sdUnlock();
  } else {
    for (int i = 0; i < server.args(); i++) if (server.argName(i) == "f") names.push_back(server.arg(i));
  }

  int deleted = 0, nFail = 0;
  String failed;
  for (size_t i = 0; i < names.size(); i++) {
    const String& n = names[i];
    bool valid = validName(n), ok = false;
    if (valid && sdLock(5000)) {
      if (sdOK) ok = SD.remove((dir + n).c_str());
      sdUnlock();
    }
    if (ok) deleted++;
    else {
      if (nFail++) failed += ',';
      failed += '"'; failed += valid ? n : String("(invalid name)"); failed += '"';
    }
    vTaskDelay(1);
  }
  Log.printf("Web: deleted %d file(s), %d failed\n", deleted, nFail);
  String j = "{\"deleted\":"; j += deleted; j += ",\"failed\":["; j += failed; j += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

void sendLogState() {
  char ln[64] = "";
  if (sdLock(50)) { strncpy(ln, logName[0] ? logName + 1 : "", sizeof(ln) - 1); sdUnlock(); }
  String j = "{\"on\":"; j += logging ? "true" : "false";
  j += ",\"file\":\""; j += ln; j += "\",\"sd\":"; j += sdOK ? "true" : "false"; j += "}";
  server.send(200, "application/json", j);
}

// POST /log  state=start[&tag=suffix][&cond=0-5][&split=day] | state=stop
void handleLog() {
  String st = server.arg("state");
  if (st == "start") {
    if (!loggingActive()) {
      if (sdLock(3000)) { if (!sdOK) sdOK = sdMount(); sdUnlock(); }
      if (!sdOK) { server.send(409, "application/json", "{\"error\":\"No microSD card\"}"); return; }
      // File-name suffix: letters, digits, - and _ only (spaces become -)
      String tg = server.arg("tag");
      size_t k = 0;
      for (size_t i = 0; i < tg.length() && k < LOG_TAG_MAX; i++) {
        char c = tg[i];
        if (c == ' ') c = '-';
        if (isalnum((unsigned char)c) || c == '-' || c == '_') pendTag[k++] = c;
      }
      pendTag[k] = 0;
      int cd = server.hasArg("cond") ? server.arg("cond").toInt() : -1;
      pendCond = (cd >= 0 && cd < LOAD_COND_N) ? (uint8_t)cd : 255;
      pendDaily = server.arg("split") == "day";
      logWanted = true;
    }
  } else if (st == "stop") {
    logWanted = false;
  } else {
    server.send(400, "application/json", "{\"error\":\"state must be start or stop\"}");
    return;
  }
  uint32_t t0 = millis();                         // wait for loop() to apply it
  while (logging != logWanted && millis() - t0 < 4000) vTaskDelay(10);
  sendLogState();
}

// POST /zero  action=set|clear  |  action=nudge&axis=roll|pitch&d=1|-1 (shift reading 0.1 deg)
void handleZero() {
  String a = server.arg("action");
  uint32_t t0 = millis();
  if (a == "nudge") {
    int d = constrain((int)server.arg("d").toInt(), -10, 10);
    if (server.arg("axis") == "roll") reqNudgeRoll = d; else reqNudgePitch = d;
    while ((reqNudgeRoll || reqNudgePitch) && millis() - t0 < 2000) vTaskDelay(10);
  } else if (a == "set" || a == "clear") {
    if (a == "set" && !imuFresh()) { server.send(409, "application/json", "{\"error\":\"No IMU data\"}"); return; }
    reqZero = (a == "set") ? 1 : 0;
    while (reqZero >= 0 && millis() - t0 < 2000) vTaskDelay(10);
  } else {
    server.send(400, "application/json", "{\"error\":\"action must be set, clear or nudge\"}");
    return;
  }
  String j = "{\"zero\":"; j += P.zeroApplied ? "true" : "false";
  j += ",\"zr\":"; j += String(P.rollOffset, 2);
  j += ",\"zp\":"; j += String(P.pitchOffset, 2); j += "}";
  server.send(200, "application/json", j);
}

// POST /set  any of: screen=0..9  pct=1..100 (brightness)  on=0/1 (OLED)  flip=0/1
//   gmax / gmin (roll graph) and pmax / pmin (pitch graph): -70..70, top above bottom
//   gsecs=30|60|120|300|600  sogavg=1..60  dockavg=30|60|120|300  rotdb=0..60  zd=-12..12  rthr=1..45
//   ship data: beam len lbp dfwd dmid daft kdeck kbr ktop pwl (m), cb cwp tpi disp (0 clears)
//   briweb=0/1 (brightness from the slider / the knob)  charge=0/1  atdock=0/1  resetmax=1  clinoreset=1  greset=1  serol=0/1 (serial on the OLED)
//   exten=.. with exta0-4, imu (card 16)  pins=1 with scrsrc, potsrc, swsrc, marksrc, castsrc, ledpins=m,r,f (card 17)
//   ledtest=1 (card 17)  extscan=1
// Values are checked here and applied by loop() (applyWebRequests).
void handleSet() {
  if (server.hasArg("screen")) {
    int v = server.arg("screen").toInt();
    if (v >= 0 && v < NUM_SCREENS) reqScreen = v;
  }
  if (server.hasArg("pct")) {
    int v = constrain((int)server.arg("pct").toInt(), 1, 100);
    reqContrast = (int16_t)constrain((v * 255 + 50) / 100, 1, 255);
  }
  if (server.hasArg("briweb")) reqBriWeb = server.arg("briweb") == "1" ? 1 : 0;
  if (server.hasArg("on")) reqDisplayOn = server.arg("on") == "1" ? 1 : 0;
  if (server.hasArg("gmax")) {
    int v = server.arg("gmax").toInt();
    if (v >= -GRAPH_LIMIT_DEG && v <= GRAPH_LIMIT_DEG) reqGraphMax = v;
  }
  if (server.hasArg("gmin")) {
    int v = server.arg("gmin").toInt();
    if (v >= -GRAPH_LIMIT_DEG && v <= GRAPH_LIMIT_DEG) reqGraphMin = v;
  }
  if (server.hasArg("pmax")) {
    int v = server.arg("pmax").toInt();
    if (v >= -GRAPH_LIMIT_DEG && v <= GRAPH_LIMIT_DEG) reqPitchMax = v;
  }
  if (server.hasArg("pmin")) {
    int v = server.arg("pmin").toInt();
    if (v >= -GRAPH_LIMIT_DEG && v <= GRAPH_LIMIT_DEG) reqPitchMin = v;
  }
  if (server.arg("resetmax") == "1") reqResetMax = 1;
  if (server.arg("clinoreset") == "1") reqClinoReset = 1;
  if (server.arg("greset") == "1") reqGReset = 1;
  if (server.hasArg("serol")) serOledOn = server.arg("serol") == "1";   // serial monitor on the OLED
  // Card 16 (the parts: exten, exta0-4, imu) and card 17 (pin mappings: pins=1 with scrsrc, potsrc, swsrc,
  // marksrc, castsrc, ledpins=m,r,f) save separately (v8.1): what a request leaves out stays as it is.
  if (server.hasArg("exten") || server.hasArg("pins")) {
    bool ex = server.hasArg("exten");
    pendExtEn = ex ? (uint8_t)(server.arg("exten").toInt() & (((1 << EXT_N) - 1) | EXT_WIND)) : P.extEn;
    for (int i = 0; i < EXT_N; i++) {
      int a = ex ? (int)strtol(server.arg("exta" + String(i)).c_str(), nullptr, 0) : P.extAddr[i];
      pendExtAddr[i] = extAddrAllowed(i, (uint8_t)a) ? (uint8_t)a : 0;
    }
    pendScr = server.hasArg("scrsrc") ? (uint8_t)constrain((int)server.arg("scrsrc").toInt(), 0, 8) : P.scrSrc;
    pendPot = server.hasArg("potsrc") ? (uint8_t)constrain((int)server.arg("potsrc").toInt(), 0, 8) : P.potSrc;
    pendSw  = server.hasArg("swsrc") ? (uint8_t)constrain((int)server.arg("swsrc").toInt(), 0, SW_NONE) : P.potSwSrc;
    if (server.hasArg("marksrc")) {
      pendMark = (uint8_t)constrain((int)server.arg("marksrc").toInt(), 0, 8);
      if (pendMark) pendMark |= (uint8_t)constrain((int)server.arg("castsrc").toInt(), 0, 8) << 4;
    } else pendMark = P.markKey == MARK_KEY ? P.markSrc : 0;
    pendImuOff = server.hasArg("imu") ? (server.arg("imu") == "0" ? 1 : 0) : P.imuOff;
    // the wind meter (v8.3): windrate 0-4, windoff deg (-180..180), windz m above the keel (0 clears), windy m (+ starboard)
    pendWindRate = P.windRate; pendWindOff = P.windOff10; pendWindZ = P.windZcm; pendWindY = P.windYcm;
    if (server.hasArg("windrate")) { int v = server.arg("windrate").toInt(); if (v >= 0 && v <= WIND_RATE_N) pendWindRate = v; }
    if (server.hasArg("windy")) { float v = server.arg("windy").toFloat(); if (v >= -50 && v <= 50) pendWindY = (int16_t)lroundf(v * 100); }
    if (server.hasArg("windoff")) { float v = server.arg("windoff").toFloat(); if (v >= -180 && v <= 180) pendWindOff = (int16_t)lroundf(v * 10); }
    if (server.hasArg("windz")) { float v = server.arg("windz").toFloat(); if (v >= 0 && v <= 200) pendWindZ = (uint16_t)lroundf(v * 100); }
    if (loggingActive()) pendImuOff = P.imuOff;     // not while recording (the rate would change mid-file)
    memcpy(pendLed, P.ledPin, 3);
    if (server.hasArg("ledpins")) {                 // "m,r,f", each 0-4 (none, A0-A3), no pin twice
      uint8_t l[3] = {0, 0, 0};
      int n = sscanf(server.arg("ledpins").c_str(), "%hhu,%hhu,%hhu", &l[0], &l[1], &l[2]);
      if (n == 3 && ledPinsOk(l)) memcpy(pendLed, l, 3);
    }
    reqExtSet = true;
  }
  if (server.hasArg("ledtest")) reqLedTest = true;  // card 17: each LED 1 s in turn
  if (server.hasArg("magvar")) {                    // card 1 Mag row (v8.5): variation, deg, + east
    float v = server.arg("magvar").toFloat();
    if (v >= -180 && v <= 180) { P.magVar10 = (int16_t)lroundf(v * 10); markPersistDirty(true); }
  }
  if (server.hasArg("posfmt")) {                    // card 14: the format the OLED GPS screen uses too
    String f = server.arg("posfmt");
    reqPosFmt = f == "d" ? 1 : f == "dms" ? 2 : f == "dm" ? 0 : -1;
  }
  if (server.hasArg("lograte")) {                   // card 7: only with the IMU off, not while recording
    int v = server.arg("lograte").toInt();
    if (v >= 0 && v < LOG_RATE_N && (P.imuOff || v == 0) && !loggingActive()) reqLogRate = v;
  }
  if (server.hasArg("extscan")) reqExtScan = true;
  if (server.hasArg("atdock")) reqAtDock = server.arg("atdock") == "1" ? 1 : 0;
  if (server.arg("charge") == "1") { reqChargeAtMs = millis(); reqCharge = 1; }
  if (server.hasArg("flip")) reqFlip = server.arg("flip") == "1" ? 1 : 0;
  // ship data in metres (0 clears); roll statistics threshold in degrees
  auto meters = [](const String& a, float lo, float hi, float scale) -> int32_t {
    float v = a.toFloat();
    if (v == 0) return 0;
    return (v >= lo && v <= hi) ? (int32_t)lroundf(v * scale) : -1;
  };
  if (server.hasArg("beam"))  reqBeamCm   = meters(server.arg("beam"), 1, 100, 100);
  if (server.hasArg("len"))   reqLengthDm = meters(server.arg("len"), 5, 500, 10);
  if (server.hasArg("lbp"))   reqLbpDm    = meters(server.arg("lbp"), 5, 500, 10);
  if (server.hasArg("dfwd"))  reqDraftFwdCm   = meters(server.arg("dfwd"), 0.3f, 40, 100);
  if (server.hasArg("daft"))  reqDraftAftCm   = meters(server.arg("daft"), 0.3f, 40, 100);
  if (server.hasArg("dmid"))  reqDraftMidCm   = meters(server.arg("dmid"), 0.3f, 40, 100);
  if (server.hasArg("kdeck")) reqKeelDeckCm   = meters(server.arg("kdeck"), 1, 80, 100);
  if (server.hasArg("kbr"))   reqKeelBridgeCm = meters(server.arg("kbr"), 1, 120, 100);
  if (server.hasArg("ktop"))  reqKeelTopCm    = meters(server.arg("ktop"), 1, 150, 100);
  if (server.hasArg("pwl"))   reqParWlDm      = meters(server.arg("pwl"), 1, 500, 10);
  if (server.hasArg("cb"))    reqCb           = meters(server.arg("cb"), 0.3f, 0.99f, 1000);    // (not metres: same 0-clears / range check)
  if (server.hasArg("cwp"))   reqCwp          = meters(server.arg("cwp"), 0.4f, 1.0f, 1000);
  if (server.hasArg("tpi"))   reqTpi          = meters(server.arg("tpi"), 1, 1000, 10);
  if (server.hasArg("disp"))  reqDisp         = meters(server.arg("disp"), 100, 655000, 0.1f);
  if (server.hasArg("gmlc"))  reqGmLc         = meters(server.arg("gmlc"), 0.1f, 100, 100);       // feet (not metres: same 0-clears / range check)
  // VMR position: signed metres (+ forward / + starboard), 0 is a real place; blank clears
  auto signedPos = [](const String& a, float lim, float scale) -> int32_t {
    String t = a; t.trim();
    if (!t.length()) return VMR_POS_UNSET;
    float v = t.toFloat();
    return (isfinite(v) && fabsf(v) <= lim) ? (int32_t)lroundf(v * scale) : POS_REQ_NONE;   // out of range: ignored
  };
  if (server.hasArg("vx"))    reqVmrXdm       = signedPos(server.arg("vx"), 300, 10);
  if (server.hasArg("vy"))    reqVmrYcm       = signedPos(server.arg("vy"), 50, 100);
  if (server.hasArg("vz"))    reqVmrZcm       = meters(server.arg("vz"), 0.5f, 150, 100);
  if (server.hasArg("rthr")) {
    int v = server.arg("rthr").toInt();
    if (v >= 1 && v <= 45) reqRollThr = v;
  }
  if (server.hasArg("rotdb")) {
    int v = server.arg("rotdb").toInt();
    if (v >= 0 && v <= 60) reqRotDb = v;
  }
  if (server.hasArg("gsecs")) {
    int v = server.arg("gsecs").toInt();
    for (int i = 0; i < GRAPH_LENGTHS; i++) if (GRAPH_SECS[i] == v) reqGraphIdx = i;
  }
  if (server.hasArg("sogavg")) {
    int v = server.arg("sogavg").toInt();
    if (v >= 1 && v <= 60) reqSogAvg = v;
  }
  if (server.hasArg("dockavg")) {                      // 30, 60, 120, 300 s
    int v = server.arg("dockavg").toInt();
    if (v == 30 || v == 60 || v == 120 || v == 300) reqDockAvg10 = v / 10;
  }
  if (server.hasArg("zd")) {
    int v = server.arg("zd").toInt();
    if (v >= -12 && v <= 12) { reqZd = v; reqZdSet = 1; }
  }
  server.send(200, "application/json", "{\"ok\":true}");
}

// POST /logger  -> datalogger mode (Wi-Fi goes off ~0.6 s after this reply)
