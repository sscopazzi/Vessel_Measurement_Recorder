                                         (unsigned)t.minute(), (unsigned)t.second(), z); }
  else   snprintf(b, sizeof(b), "--:--:-- ZD%s", z);
  printAt(0, 0, b);
  if (battOK && !isnan(battPct)) {
    snprintf(b, sizeof(b), "%3d%%", (int)lroundf(battPct));
    printAt(128 - 6 * 4, 0, b);
  }
}

