float    wvAnX = NAN, wvAnY = NAN;        // the VMR's position (m) when the analysis started; NaN = not entered
// The last estimate is kept when the window starts again (IMU gap, pause, dock): the Waves card and
// the OLED keep showing it, labelled with its age (v7.4). GM and the CSV use only a current one.
bool     wvCurrent = false;            // the estimate above is from the window now filling
uint32_t wvLastMs = 0;                 // millis() of the last estimate (0 = none since boot)
bool     wvNewForLog = false;          // a new estimate: written on the next CSV row only
#define  WV_TOL 0.10f                  // Te / Tr flagged within +/-10 % of 1 and of 0.5 (Circ.1228 gives no tolerance; 15 % before v8.4)
float  (*wvSpec)[WV_K1 + 1] = nullptr;  // last spectra [3][WV_K1 + 1]: heave (m2/Hz), pitch, roll (deg2/Hz) - heap
