// I2C read failures (v8.63). On the ESP32-S2, ESP-IDF 5.5's I2C master driver sets contains_read for a
// read and clears it only when a read completes: a read that is NACKed (a device not answering) or times
// out leaves it set, and when the next transfer of any kind finishes, its interrupt handler "finishes
// the read" - one byte written through a stale op pointer: address 0 (StoreProhibited in
// i2c_isr_receive_handler, v8.51) or live memory (lwIP's mutex corrupted, LoadProhibited in the web
// task, v8.61). Both came with the add-ons not answering. A new driver starts clean, so every read that
// comes back short makes a new one at once, before any other transfer. Every library here reaches the
// bus through the TwoWire pointer it is given (requestFrom is virtual), so all reads come through this.
class SafeWire : public TwoWire {
 public:
  explicit SafeWire(uint8_t n) : TwoWire(n) {}
  uint32_t resets = 0;
  size_t requestFrom(uint8_t a, size_t n, bool stop) override {
    size_t r = TwoWire::requestFrom(a, n, stop);
    if (r != n) renew();
    return r;
  }
  size_t requestFrom(uint8_t a, size_t n) override { return requestFrom(a, n, true); }
  void renew() {
    uint32_t hz = getClock(); uint16_t to = getTimeOut();
    TwoWire::end();
    TwoWire::begin(SDA, SCL, hz ? hz : 400000UL);
    setTimeOut(to);
    resets++;
  }
};
SafeWire WireS(0);
#define Wire WireS                        // after the library headers (one declares Wire again); every object is given &Wire
