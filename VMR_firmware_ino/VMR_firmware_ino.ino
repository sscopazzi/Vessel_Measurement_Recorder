void writeLogHeader() { writeLogHeaderTo(logFile, recFile + 1, logDaily, logPrevName, logStartUnix); }

// Called with sdMutex held (loop task, while logging). Mounts the card if
// needed, (re)opens this recording's file for appending, and writes
// everything waiting in pend[].
void sdWritePending(uint32_t now) {
  if (!sdOK) {
    if (now - lastSdRetryMs < sdRetryGapMs) return;
    lastSdRetryMs = now;
    sdOK = sdMount();
    if (!sdOK) { sdRetryGapMs = min(sdRetryGapMs * 2, SD_RETRY_MAX_MS); return; }
    sdRetryGapMs = SD_RETRY_MIN_MS;
    Log.println("SD: mounted");
  }

  if (!logFile) {
    if (!recFile[0]) makeLogName(recFile, sizeof(recFile));     // first write since Start
    logFile = SD.open(recFile, FILE_APPEND);                     // reopen after an SD error appends
    if (!logFile) { sdFail(); return; }
    strncpy(logName, recFile, sizeof(logName) - 1);
    logName[sizeof(logName) - 1] = 0;
    if (logging) memcpy(rr.file, recFile, sizeof(rr.file));      // for a resume after a crash
    if (logFile.size() == 0) { writeLogHeader(); logFile.flush(); }   // new file
    else if (resumeOpen) logBytes = logFile.size();              // resumed: what is already in the file
    resumeOpen = false;
    logOpenSize = logFile.size(); logOpenBytes = logBytes; lastCkMs = millis();
    Log.printf("SD: recording to %s\n", logName);
  }

  if (sdDownMs && logging) {                                     // back after an outage: say so in the file
    uint32_t lost = pendDropped - sdDownDrop;
    unsigned long sec = (millis() - sdDownMs) / 1000;
    snprintf(sdEvNote, sizeof(sdEvNote), "SD RECOVERED after %lu s (%lu rows lost)", sec, (unsigned long)lost);
    if (strlen(sdEvNote) > EVENT_NOTE_MAX) snprintf(sdEvNote, sizeof(sdEvNote), "SD RECOVERED %lus (%lu lost)", sec, (unsigned long)lost);
    sdEvPending = true;
    Log.printf("SD: %s (%lu bytes waiting)\n", sdEvNote, (unsigned long)pendLen);
  }
  sdDownMs = 0;
  if (pendLen) {                                                // a chunk at a time: a backlog does not stop the loop
    size_t n = pendLen < SD_WRITE_CHUNK ? pendLen : SD_WRITE_CHUNK;
    if (logFile.write((const uint8_t*)pend, n) != n) { sdFail(); return; }
    logBytes += n;
    pendLen -= n;
    if (pendLen) memmove(pend, pend + n, pendLen);
  }
  if (now - lastFlushMs > 2000) { logFile.flush(); lastFlushMs = now; }

  // Checkpoint every 60 s: close the file and open it again for appending. On this card stack the
  // file's size in the card's directory - what Refresh, Plot from file, and the card after a power
  // loss see - only moved on a close: the 2-s flush did not do it. (v4.7-4.8 took that for a failing
  // card and remounted it every check, dropping rows; v4.5-4.8's flush before a plot did not help.)
  // Refresh and Make plot also checkpoint the recording first (logCheckpoint, from their tasks).
  if (now - lastCkMs >= 60000) logCheckpoint();
}

// Close the recording and open it again for appending, so the card's directory has its true size.
// Call with sdMutex held (any task: every logFile call is under the mutex). After the reopen, the
// size must be what was written: a shortfall is counted and logged (card 12) - a diagnostic only.
void logCheckpoint() {
  if (!logFile || !recFile[0]) return;
  lastCkMs = millis();
  logFile.close();
  logFile = SD.open(recFile, FILE_APPEND);
  if (!logFile) { sdFail(); return; }
  uint64_t want = logOpenSize + (logBytes - logOpenBytes);
  uint32_t got = logFile.size();
  if (got < want) {
    sdChkFails++;
    if (sdChkFails <= 5) Log.printf("SD: checkpoint found %lu bytes on the card, %lu written\n", (unsigned long)got, (unsigned long)want);
  }
  logOpenSize = got; logOpenBytes = logBytes;
}

// Daily files: close this file at 00:00 UTC and let the next write open a new
// one named for the new day (the rows before midnight go to the old file
// first). If the card is busy, try again on the next row.
bool logDayRoll(uint32_t unixNow) {
  if (!sdLock(2000)) return false;
  while (sdOK && pendLen) sdWritePending(millis());
  if (logFile) { logFile.flush(); logFile.close(); }
  strncpy(logPrevName, logName[0] ? logName + 1 : recFile + (recFile[0] ? 1 : 0), sizeof(logPrevName) - 1);
  logPrevName[sizeof(logPrevName) - 1] = 0;
  recFile[0] = 0; logName[0] = 0;
  logStartUnix = unixNow;                         // names the new file and its header
  sdUnlock();
  Log.printf("Logging: new day, new file (closed %s)\n", logPrevName);
  return true;
}

// ---- Last 20 min buffer (v8.62) ----
bool bufWanted() { return !logging && !logWanted && sdOK && pendCap && !(bufSaveState == 1 && !bufSeq); }
void bufName(char* out, size_t n, uint32_t seq) { snprintf(out, n, BUF_DIR "/%lu.csv", (unsigned long)seq); }
// sdMutex held for all of these
void bufWritePend() {
  if (!pendLen) return;
  if (!bufF) { pendLen = 0; return; }
  if (bufF.write((const uint8_t*)pend, pendLen) != pendLen) {
    Log.println("Last 20 min: write failed, buffer restarted");
    bufF.close(); bufSeq = 0;
  }
  pendLen = 0;
}
void bufPrune() {                       // old files go, but not those a save is copying
  while (bufOldest && bufSeq - bufOldest >= BUF_SEGS && !(bufSaveState == 1 && bufOldest >= bufSaveFrom)) {
    char nm[32]; bufName(nm, sizeof(nm), bufOldest); SD.remove(nm); bufOldest++;
  }
}
void bufEmptyDir() {
  SD.mkdir(BUF_DIR);
  File d = SD.open(BUF_DIR);
  String del[48]; int nd = 0;
  if (d && d.isDirectory()) for (File f = d.openNextFile(); f && nd < 48; f = d.openNextFile()) {
    if (!f.isDirectory()) del[nd++] = String(BUF_DIR "/") + f.name();
    f.close();
  }
  if (d) d.close();
  for (int i = 0; i < nd; i++) SD.remove(del[i].c_str());
}
bool bufNext(uint32_t now) {             // close the file filling, open the next (pend holds only the old file's rows)
  bufWritePend();
  if (bufF) bufF.close();
  if (!bufSeq) { bufEmptyDir(); bufOldest = 0; }
  bufSeq++;
  char nm[32]; bufName(nm, sizeof(nm), bufSeq);
  bufF = SD.open(nm, FILE_WRITE);
  if (!bufF) { bufSeq = 0; return false; }
  if (!bufOldest) bufOldest = bufSeq;
  bufSegUnix[bufSeq % BUF_META] = clockSynced ? nowUnix() : 0;
  bufSegMs = bufFlushMs = now;
  bufPrune();
  return true;
}
void bufEnd() {                          // recording starts: no buffer meanwhile
  if (!bufSeq && !bufF) return;
  if (sdLock(1000)) { if (bufF) bufF.close(); sdUnlock(); }
  bufSeq = 0; pendLen = 0;
}
uint32_t bufSeconds() {                  // how much is buffered (s), for the dashboard
  if (!bufSeq || logging) return 0;
  uint32_t full = min(bufSeq - bufOldest, (uint32_t)(BUF_SEGS - 1));
  return min(full * (BUF_SEG_MS / 1000) + (millis() - bufSegMs) / 1000, 20UL * 60UL);
}

void bufSaveTask(void*) {
  char* b = (char*)malloc(8192);
  File o, in;
  const char* err = nullptr;
  if (!b) err = "not enough memory";
  if (!err && sdLock(3000)) { o = SD.open(BUF_TMP, FILE_APPEND); sdUnlock(); }
  if (!err && !o) err = "cannot write the file";
  for (uint32_t q = bufSaveFrom; !err && q <= bufSaveTo; q++) {
    char nm[32]; bufName(nm, sizeof(nm), q);
    if (!sdLock(3000)) { err = "microSD busy"; break; }
    in = SD.open(nm, FILE_READ);
    sdUnlock();
    if (!in) continue;                   // (a file that was never written)
    while (!err) {
      if (!sdLock(3000)) { err = "microSD busy"; break; }
      int n = in.read((uint8_t*)b, 8192);
      if (n > 0 && o.write((const uint8_t*)b, n) != (size_t)n) err = "write failed (card full?)";
      sdUnlock();
      if (n <= 0) break;
      vTaskDelay(1);
    }
    if (sdLock(3000)) { in.close(); sdUnlock(); }
  }
  if (sdLock(5000)) {
    if (o) o.close();
    if (!err && !SD.rename(BUF_TMP, bufSaveName)) err = "could not move it to the top folder";
    if (err) SD.remove(BUF_TMP);
    sdUnlock();
  } else if (!err) err = "microSD busy";
  free(b);
  if (err) { strncpy(bufSaveErr, err, sizeof(bufSaveErr) - 1); bufSaveState = 3; Log.printf("Last 20 min: not saved (%s)\n", err); }
  else { bufSaveState = 2; Log.printf("Last 20 min: saved %s\n", bufSaveName); }
  vTaskDelete(nullptr);
}

// Save Last 20min (loop task): the open file closed and a new one started, a header for the joined
// file, then the task copies the 1-min files into it
void serviceBufSave(uint32_t now) {
  if (!reqBufSave) return;
  reqBufSave = false;
  bufSaveErr[0] = 0;
  if (logging || bufSaveState == 1) return;
  if (!bufSeq) { strcpy(bufSaveErr, "nothing buffered yet"); bufSaveState = 3; return; }
  if (!sdLock(3000)) { strcpy(bufSaveErr, "microSD busy"); bufSaveState = 3; return; }
  bufWritePend();
  if (bufF) bufF.close();
  uint32_t to = bufSeq, from = max(bufOldest, to >= BUF_SEGS ? to - BUF_SEGS + 1 : 1UL);
  uint32_t u = bufSegUnix[from % BUF_META];
  char base[48];
  if (u) { DateTime t(u); snprintf(base, sizeof(base), "/%04u%02u%02u_%02u%02u%02uZ_last20min", (unsigned)t.year(), (unsigned)t.month(),
                                   (unsigned)t.day(), (unsigned)t.hour(), (unsigned)t.minute(), (unsigned)t.second()); }
  else strcpy(base, "/NOCLK_last20min");
  snprintf(bufSaveName, sizeof(bufSaveName), "%s.csv", base);
  for (int k = 2; SD.exists(bufSaveName) && k < 100; k++) snprintf(bufSaveName, sizeof(bufSaveName), "%s_%d.csv", base, k);
  SD.remove(BUF_TMP);
  File o = SD.open(BUF_TMP, FILE_WRITE);
  bool ok = (bool)o;
  if (ok) {
    char tag[LOG_TAG_MAX + 1]; memcpy(tag, P.logTag, sizeof(tag));
    strncpy(P.logTag, "last20min", LOG_TAG_MAX);
    writeLogHeaderTo(o, bufSaveName + 1, false, "", u);
    memcpy(P.logTag, tag, sizeof(tag));
    o.close();
  }
  bufSaveSec = (to - from) * (BUF_SEG_MS / 1000) + (now - bufSegMs) / 1000;
  bufSaveFrom = from; bufSaveTo = to;
  bufSaveState = ok ? 1 : 3;              // protects from..to from bufPrune before the next file opens
  if (bufNext(now)) slowForce = true;
  sdUnlock();
  if (!ok) { strcpy(bufSaveErr, "cannot write the file"); return; }
  if (xTaskCreate(bufSaveTask, "bufsave", 4096, nullptr, tskIDLE_PRIORITY, nullptr) != pdPASS) {
    strcpy(bufSaveErr, "could not start"); bufSaveState = 3;
  }
}

// Degrees x 1e7 as a decimal with 6 places, rounded (0.11 m)
void deg6(char* out, size_t n, int32_t e7) {
  int64_t v = e7 >= 0 ? ((int64_t)e7 + 5) / 10 : ((int64_t)e7 - 5) / 10;
  uint64_t a = v < 0 ? (uint64_t)(-v) : (uint64_t)v;
  snprintf(out, n, "%s%lu.%06lu", v < 0 ? "-" : "", (unsigned long)(a / 1000000ULL), (unsigned long)(a % 1000000ULL));
}

// The rate rows are written at: 10 Hz while the IMU is on, else the one chosen in card 7
uint32_t logMs() { return P.imuOff && P.logRate < LOG_RATE_N ? LOG_RATE_MS[P.logRate] : LOG_INTERVAL_MS; }
// UTC in ms (millis() before there is a clock), for rows on the clock at the slower rates
uint64_t logClockMs() { return clockSynced ? (uint64_t)baseUnix * 1000ULL + (uint32_t)(millis() - baseMillis) : (uint64_t)millis(); }
uint64_t logSlot = UINT64_MAX;                     // the last slow-rate slot written (UINT64_MAX = a row now)

// Applies Start/Stop requested from the dashboard (loop task)
void applyLogRequest(uint32_t now) {
  if (logWanted == logging) return;
  if (logWanted) {
    bufEnd();                          // the last-20-min buffer stops while recording
    logging = true;                    // a new file opens on the first write
    logStartMs = now;
    logStartUnix = clockSynced ? nowUnix() : 0;
    recFile[0] = 0;                    // every Start gets its own file
    if (!resumePending) { strncpy(P.logTag, pendTag, LOG_TAG_MAX); P.logTag[LOG_TAG_MAX] = 0; }   // (a resume keeps its tag)
    if (pendCond < LOAD_COND_N) P.logCond = pendCond;
    pendCond = 255;
    logDaily = pendDaily; logDay = 0; logPrevName[0] = 0;
    logInterrupted = false;
    evCount = 0;
    reqEvent = false;
    sysEvent = nullptr; pauseRowDue = false;
    logRows = 0; logBytes = 0; pendDropped = 0; pendLen = 0; sdChkFails = 0; slowForce = true;
    sdDownMs = 0; sdEvPending = false;
    logSlot = UINT64_MAX;                         // slow rates: the first row at once, then on the clock
    gpsNewForLog = false;
    P.logActive = 1;
    if (resumePending) {                          // after a crash: the same file, its counts, a CRASH RESTART event
      resumePending = false; resumeOpen = true;
      strncpy(recFile, rr.file, sizeof(recFile) - 1); recFile[sizeof(recFile) - 1] = 0;
      logStartUnix = rr.startUnix; logDaily = rr.daily; logDay = rr.day;
      logRows = rr.rows; evCount = rr.evCount;
      rr.baseS += bootCrashUpS > rr.startUpS ? bootCrashUpS - rr.startUpS : 0;
      logStartMs = now - rr.baseS * 1000UL;
      rr.startUpS = now / 1000;
      sysEvent = crashNote;
      if (rr.paused) { paused = true; pausedAtMs = now; pauseRowDue = true; }   // one row for the event, then paused as before
      if (rr.logger) { reqLoggerAtMs = now; reqLogger = 1; }
      Log.printf("Logging: RESUMED %s after a crash (%s)\n", recFile, bootCrashKind);
      return;
    }
    rr = {}; rr.magic = RR_MAGIC; rr.ver = fwHash(); rr.daily = logDaily; rr.startUpS = now / 1000;
    Log.printf("Logging: START (%s)\n", logDaily ? "a new file each day" : "one file");
  } else {
    if (sdLock(3000)) {
      while (sdOK && pendLen) sdWritePending(now);   // write what is buffered
      if (logFile) { logFile.flush(); logFile.close(); }
      logName[0] = 0;
      sdUnlock();
    }
    pendLen = 0;
    logging = false;
    sysEvent = nullptr; pauseRowDue = false;
    P.logActive = 0;
    rr.magic = 0;
    Log.printf("Logging: STOP (%lu rows)\n", (unsigned long)logRows);
  }
  markPersistDirty(true);
}

void logSample() {
  uint32_t now = millis();
  applyLogRequest(now);
  if (logging) { rr.day = logDay; rr.startUnix = logStartUnix; rr.paused = paused; rr.logger = loggerMode; }
  bool buffering = !logging && !paused && bufWanted();   // not recording: the last 20 min go to /.buf
  if (buffering && (!bufF || now - bufSegMs >= BUF_SEG_MS) && (!bufFailMs || now - bufFailMs > 30000)) {
    if (sdLock(0)) {
      if (bufNext(now)) { slowForce = true; bufFailMs = 0; }
      else { bufFailMs = now | 1; Log.println("Last 20 min: cannot open a file in /.buf, trying again in 30 s"); }
      sdUnlock();
    }
  }
  if ((!logging && !buffering) || (paused && !pauseRowDue)) {   // not recording, or paused: no rows
    gpsNewForLog = false;
    wvNewForLog = false;                             // (an estimate made while not recording is not written later)
    accSumF = accSumS = accSumU = 0; accSumN = 0;
    return;
  }
  if (logging && logDaily && clockSynced) {          // daily files: a new one at 00:00 UTC
    uint32_t u = baseUnix + (now - baseMillis) / 1000, day = u / 86400;
    if (!logDay) logDay = day;
    else if (day != logDay && logDayRoll(u)) { logDay = day; slowForce = true; }
  }
  if (logging) { logRows++; rr.rows = logRows; rr.day = logDay; rr.startUnix = logStartUnix; }
  char ts[32] = "";
  if (clockSynced) {
    uint32_t el = now - baseMillis;
    DateTime t(baseUnix + el / 1000);
    snprintf(ts, sizeof(ts), "%04u-%02u-%02uT%02u:%02u:%02u.%03uZ",
             (unsigned)t.year(), (unsigned)t.month(), (unsigned)t.day(),
             (unsigned)t.hour(), (unsigned)t.minute(), (unsigned)t.second(),
             (unsigned)(el % 1000));
  }
  bool f = imuFresh();
  // GPS columns only on the first row after a new RMC; blank otherwise
  char gpsCols[160];
  if (gpsNewForLog) {
    gpsNewForLog = false;
    long age = (long)(now - gpsRmcMs);
    bool ok = gps.gpsFix;
    if (ok) {
      // lat / lon from the exact NMEA value (degrees x 1e7) rounded to 6 decimals: the float copy
      // (gpsLat / gpsLon) holds only ~7 digits, so at 122 deg its 6th decimal was noise (~0.8 m)
      char la[16], lo[16];
      deg6(la, sizeof(la), gps.latE7); deg6(lo, sizeof(lo), gps.lonE7);
      snprintf(gpsCols, sizeof(gpsCols), "%s,%s,%.1f,%.2f,%.2f,%.1f,1,%d,%.2f,%d,%ld",
               la, lo, gps.gpsAlt, gps.gpsSpeed, gps.gpsSpeed / KNOTS_TO_MS,
               gps.gpsAngle, (int)gps.gpsSats, gps.gpsHdop, (int)gps.gpsFixQ, age);
    } else {
      snprintf(gpsCols, sizeof(gpsCols), ",,,,,,0,%d,,0,%ld", (int)gps.gpsSats, age);
    }
  } else {
    snprintf(gpsCols, sizeof(gpsCols), ",,,,,,,,,,");
  }

  // roll period, GM estimate, event marker (blank when none)
  char extra[80], rp[12] = "", gm[12] = "", evN[12] = "", evT[EVENT_NOTE_MAX + 1] = "";
  if (f && !isnan(rollPeriod)) snprintf(rp, sizeof(rp), "%.2f", rollPeriod);
  if (f && !isnan(gmEst)) snprintf(gm, sizeof(gm), "%.2f", gmEst * M_TO_FT);   // feet
  // a marked event from the dashboard first; a PAUSED / RESUMED marker takes the next free row
  if (logging && sdEvPending && !sysEvent && !reqEvent) { sysEvent = sdEvNote; sdEvPending = false; }
  const char* evNote = !logging ? nullptr : reqEvent ? (const char*)reqEventNote : sysEvent;   // (none in the buffer)
  if (evNote) {
    LogEvent e;
    e.n = ++evCount; rr.evCount = evCount;
    e.unix = clockSynced ? nowUnix() : 0;
    strncpy(e.note, evNote, EVENT_NOTE_MAX);
    e.note[EVENT_NOTE_MAX] = 0;
    for (int i = 4; i > 0; i--) evList[i] = evList[i - 1];
    evList[0] = e;
    if (reqEvent) reqEvent = false;
    else { sysEvent = nullptr; pauseRowDue = false; }   // marker written (rows stop after PAUSED)
    snprintf(evN, sizeof(evN), "%u", (unsigned)e.n);
    strncpy(evT, e.note, sizeof(evT) - 1); evT[sizeof(evT) - 1] = 0;
    Log.printf("Event %u: %s\n", (unsigned)e.n, e.note);
  }

  char acc[40] = ",,";                                 // mean acceleration over this row, g
  if (accSumN && accFresh())
    snprintf(acc, sizeof(acc), "%.4f,%.4f,%.4f", accSumF / accSumN, accSumS / accSumN, accSumU / accSumN);
  accSumF = accSumS = accSumU = 0; accSumN = 0;
  char addon[48], pa[12] = "", ta[12] = "", rh[12] = "";  // add-ons: blank when off / not answering
  if (!isnan(extPa)) snprintf(pa, sizeof(pa), "%.2f", extPa / 100.0f);
  if (!isnan(extTa)) snprintf(ta, sizeof(ta), "%.2f", extTa);
  if (!isnan(extRh)) snprintf(rh, sizeof(rh), "%.1f", extRh);
  char wave[96] = ",,,,,,,,";                          // Waves card estimates: only on the row after a new one
  if (wvNewForLog) {
    wvNewForLog = false;
    char src; float tr = wvRollPeriod(src), q = (!isnan(wvTe) && tr > 0) ? wvTe / tr : NAN;
    int flag = isnan(q) ? -1 : fabsf(q - 1.0f) <= WV_TOL ? 1 : fabsf(q / 0.5f - 1.0f) <= WV_TOL ? 2 : 0;
    char a[8] = "", b2[8] = "", c[8] = "", dq[8] = "", fl[4] = "", e[8] = "", g2[8] = "", h[8] = "";
    if (!isnan(wvTe)) snprintf(a, sizeof(a), "%.1f", wvTe);
    if (!isnan(tr)) { snprintf(b2, sizeof(b2), "%.1f", tr); c[0] = src; c[1] = 0; }
    if (!isnan(q)) { snprintf(dq, sizeof(dq), "%.2f", q); snprintf(fl, sizeof(fl), "%d", flag); }
    if (!isnan(wvHs)) snprintf(e, sizeof(e), "%.2f", wvHs);
    if (!isnan(wvTz)) snprintf(g2, sizeof(g2), "%.1f", wvTz);
    if (!isnan(wvTrs)) snprintf(h, sizeof(h), "%.1f", wvTrs);
    char hm[8] = "";
    if (!isnan(wvHsMid)) snprintf(hm, sizeof(hm), "%.2f", wvHsMid);
    snprintf(wave, sizeof(wave), "%s,%s,%s,%s,%s,%s,%s,%s,%s", a, b2, c, dq, fl, e, g2, h, hm);
  }
  char dock[24] = ",";                                 // trim / list: blank until the trim is calibrated
  if (P.trimCal && f) {
    float tm = trimMetres(rawPitch);
    if (!isnan(tm)) snprintf(dock, sizeof(dock), "%.2f,%.2f", tm * M_TO_FT, roll);
  }

  char mag[48], mh1[12] = "", mf1[12] = "", mc[12] = "";   // magnetometer test (v8.0): blank without fresh data
  if (f && magFresh()) {
    float mh = magHeading();
    if (!isnan(mh)) { snprintf(mh1, sizeof(mh1), "%.1f", mh); snprintf(mf1, sizeof(mf1), "%.1f", magTotal); snprintf(mc, sizeof(mc), "%u", (unsigned)magAcc); }
  }
  char wind[64] = "";                                  // wind meter columns (v8.2), filled below
  windLogCols(wind, sizeof(wind));
  char imu[72] = ",,";                                 // roll, pitch, ROT: blank without IMU data (no yaw_deg from v8.5)
  if (f) snprintf(imu, sizeof(imu), "%.2f,%.2f,%.2f", roll, pitch, yawRate * 60.0f);
  // Slow columns (v8.2): battery, level zero, roll period, GM, the add-on weather and the magnetometer
  // calibration change at most about once a second. All of them are written together on the first row
  // of every second and on any row where one changes; on the other rows all are blank (batt_v, never
  // blank when written, marks which). About 20 bytes a row less.
  static char slPrev[SLOW_N][12];
  static uint32_t slMs = 0;
  char bv[12], bp[12], za[4];
  snprintf(bv, sizeof(bv), "%.3f", battV); snprintf(bp, sizeof(bp), "%.1f", battPct); snprintf(za, sizeof(za), "%d", (int)P.zeroApplied);
  char* sl[SLOW_N] = {bv, bp, za, rp, gm, pa, ta, rh, mc};
  bool slAll = slowForce || now - slMs >= 1000;
  for (int i = 0; i < SLOW_N && !slAll; i++) if (strcmp(sl[i], slPrev[i])) slAll = true;
  if (slAll) {
    slMs = now; slowForce = false;
    for (int i = 0; i < SLOW_N; i++) { strncpy(slPrev[i], sl[i], sizeof(slPrev[i]) - 1); slPrev[i][sizeof(slPrev[i]) - 1] = 0; }
  } else for (int i = 0; i < SLOW_N; i++) sl[i][0] = 0;
  if (evNote) snprintf(extra, sizeof(extra), "%s,%s,%s,%s", rp, gm, evN, evT);
  else snprintf(extra, sizeof(extra), "%s,%s,,", rp, gm);
  snprintf(addon, sizeof(addon), "%s,%s,%s", pa, ta, rh);
  snprintf(mag, sizeof(mag), "%s,%s,%s", mh1, mf1, mc);
  char line[800];                                     // a full row is ~360 characters (room for every field at its widest)
  snprintf(line, sizeof(line),
           "%s,%lu,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s%s\n",
           ts, (unsigned long)now, imu,
           gpsCols, bv, bp, za, extra, acc, addon, dock, wave, mag, wind);

  size_t L = strlen(line);
  if (!logging) {                                     // the last-20-min buffer: written in ~2 KB pieces
    if (pendLen + L <= pendCap) { memcpy(pend + pendLen, line, L); pendLen += L; }
    if ((pendLen >= 2048 || now - bufFlushMs >= 2000) && sdLock(0)) {
      bufWritePend();
      if (bufF && now - bufFlushMs >= 2000) { bufF.flush(); bufFlushMs = now; }
      sdUnlock();
    }
    return;
  }
  ledHeartMs = now ? now : 1;                         // Recording LED: the Datalogger blink
  if (pendLen + L <= pendCap) { memcpy(pend + pendLen, line, L); pendLen += L; }
  else pendDropped++;              // buffer full (card gone too long): counted, shown in card 7 and the event

  if (!sdLock(0)) return;          // card briefly busy (web file listing): keep buffering
  sdWritePending(now);             // no card mounted: the rows stay in the buffer until a remount works (v7.34;
                                   // before, they were thrown away at once - 39 s and 56 s gaps on 2026-11-03)
  sdUnlock();
}

// Datalogger mode countdown (screen button): the OLED on for LOGGER_PEEK_MS,
// showing the time to the next row, then off again.
void loggerPeek() {
  peekOn = true;
  peekUntilMs = millis() + LOGGER_PEEK_MS;
  peekDrawMs = 0;
  if (displayOK) display.oled_command(SH110X_DISPLAYON);
}

void drawLoggerPeek() {
  if (!displayOK) return;
  display.clearDisplay();
  display.setFont();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  printAt(0, 0, logging ? "DATALOGGER  REC" : "DATALOGGER");
  uint32_t lm = logMs();
  char big[12] = "";
  const char* top = "Next row in";
  if (!logging) { top = "Not recording"; }
  else if (lm == LOG_INTERVAL_MS) { top = "Recording at"; strcpy(big, "10 Hz"); }
  else {
    uint64_t next = (logSlot + 1) * (uint64_t)lm, nowc = logClockMs();
    uint32_t s = next > nowc ? (uint32_t)((next - nowc + 999) / 1000) : 0;
    snprintf(big, sizeof(big), "%lu:%02lu", (unsigned long)(s / 60), (unsigned long)(s % 60));
  }
  printAt(0, 14, top);
  if (big[0]) {
    display.setTextSize(3);
    int w = (int)strlen(big) * 18 - 3;
    printAt((display.width() - w) / 2, 26, big);
    display.setTextSize(1);
  }
  printAt(0, 56, markSrcNow() ? "B or Mark: Wi-Fi on" : "B: Wi-Fi on");
  display.display();
}

// Datalogger mode at 1 min or slower: sleep (light sleep: RAM, the open file and the clock kept;
// Wi-Fi and the OLED are already off) until LOGGER_WAKE_LEAD_MS before the next row, the GPS in
// standby meanwhile. Button B wakes it and leaves Datalogger mode (Wi-Fi back); the screen button
// wakes it to show the countdown. PCF8574 buttons wake it through its INT wire on A4 (any input
// change wakes it; the screen button shows the countdown, the Mark button leaves Datalogger mode).
void loggerSleep(uint32_t lm) {
  uint64_t next = (logSlot + 1) * (uint64_t)lm, nowc = logClockMs();
  if (next <= nowc + LOGGER_WAKE_LEAD_MS + 3000) return;            // too close: stay awake
  uint32_t sleepMs = (uint32_t)(next - nowc - LOGGER_WAKE_LEAD_MS);
  if (pendLen || reqEvent || sysEvent || reqMarkBtn || otaState != OTA_IDLE) return;
  if (peekOn) return;                                                // countdown showing
  if (ledHeartMs && millis() - ledHeartMs < LED_HEARTBEAT_MS + 20) return;   // the Recording LED's blink first
  if (ledMarkEvMs) return;                                           // a Mark LED flash first
  bool scrPin = P.scrSrc == 0 && !windActive();                      // a PCF8574 screen button cannot wake it
  if (digitalRead(BUTTON_B) == LOW || (scrPin && digitalRead(SCREEN_BTN_PIN) == LOW)) return;  // held: would wake at once
  // PCF8574 buttons: its INT wire to A4 wakes it. INT goes low on any input change and stays low
  // until the port is read, so read it now; still low = a change just now: stay awake this round.
  // A PCF8574 button held down (screen, mark, cast): stay awake until it is let go.
  bool pcfOn = ext[EXT_PCF].ok && extOn(EXT_PCF);
  if (pcfOn) {
    extPcfVal = pcf.digitalReadByte();
    uint8_t m = 0;
    if (P.scrSrc >= 1 && P.scrSrc <= 8) m |= 1 << (P.scrSrc - 1);
    if (markSrcNow()) m |= 1 << (markSrcNow() - 1);
    if (castSrcNow()) m |= 1 << (castSrcNow() - 1);
    if ((extPcfVal & m) != m || digitalRead(PCF_INT_PIN) == LOW) return;
  }
  if (sdLock(500)) { if (logFile) logCheckpoint(); sdUnlock(); } else return;   // close + reopen: the size on the card is right if the power is cut while asleep
  if (!gpsOff) gpsSend("PMTK161,0");                                 // GPS standby (hot start on waking)
  Log.printf("Datalogger: asleep for %lu s (next row in %lu s)\n", (unsigned long)(sleepMs / 1000), (unsigned long)((next - nowc) / 1000));
  Serial.flush();
  ledsOff();                                                         // PWM stops in light sleep: dark, not stuck on
  gpio_wakeup_enable((gpio_num_t)BUTTON_B, GPIO_INTR_LOW_LEVEL);
  if (scrPin) gpio_wakeup_enable((gpio_num_t)SCREEN_BTN_PIN, GPIO_INTR_LOW_LEVEL);
  if (pcfOn) gpio_wakeup_enable((gpio_num_t)PCF_INT_PIN, GPIO_INTR_LOW_LEVEL);
  esp_sleep_enable_gpio_wakeup();
  esp_sleep_enable_timer_wakeup((uint64_t)sleepMs * 1000ULL);
  esp_task_wdt_reset();
  esp_light_sleep_start();
  esp_task_wdt_reset();
  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_GPIO);
  gpio_wakeup_disable((gpio_num_t)BUTTON_B);
  gpio_wakeup_disable((gpio_num_t)SCREEN_BTN_PIN);
  gpio_wakeup_disable((gpio_num_t)PCF_INT_PIN);
  if (!gpsOff) { gpsSend("PMTK000"); gpsSend("PMTK000"); }           // any byte wakes it
  gpsLastNmeaMs = millis();                                          // standby on purpose: not silence
  bool byTimer = esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_TIMER;
  const char* why = "for the next row";
  if (!byTimer) {                                                    // which button: B is handled by serviceButtons
    if (pcfOn) extPcfVal = pcf.digitalReadByte();                    // fresh, and clears INT
    if (digitalRead(BUTTON_B) == LOW) why = "button B";
    else if (scrPin ? digitalRead(SCREEN_BTN_PIN) == LOW || !pcfOn : (P.scrSrc && extPinLow(P.scrSrc - 1))) { why = "screen button: countdown"; loggerPeek(); }   // even a short tap
    else if (pcfOn) why = "PCF8574 input (the Mark button leaves Datalogger mode)";
    else { why = "screen button: countdown"; loggerPeek(); }
  }
  Log.printf("Datalogger: awake (%s)\n", why);
}

// SOG / COG moving averages: 1 Hz history, over the last P.sogAvgS s.
// SOG is the mean speed. COG is the direction of the mean velocity vector
// (east/north components), so headings wrap through 000/360 correctly and
// near-zero speeds (random GPS COG) carry almost no weight.
void serviceSog(uint32_t now) {
  if (now - lastSogTickMs < 1000) return;
  lastSogTickMs = (now - lastSogTickMs > 3000) ? now : lastSogTickMs + 1000;
  bool fx = gpsFixValid();
  float kn = fx ? gps.gpsSpeed / KNOTS_TO_MS : NAN;
  float a = gps.gpsAngle * (float)DEG_TO_RAD;
  sogHist[sogIdx] = kn;
  velE[sogIdx] = fx ? kn * sinf(a) : NAN;
  velN[sogIdx] = fx ? kn * cosf(a) : NAN;
  sogIdx = (sogIdx + 1) % 60;
  float sum = 0, se = 0, sn = 0;
  int cnt = 0;
  for (int i = 1; i <= P.sogAvgS && i <= 60; i++) {
    int k = (sogIdx + 60 - i) % 60;
    if (isnan(sogHist[k])) continue;
    sum += sogHist[k]; se += velE[k]; sn += velN[k]; cnt++;
  }
  sogAvgKn = cnt ? sum / cnt : NAN;
  if (cnt && hypotf(se, sn) / cnt >= COG_AVG_MIN_KN) {
    float c = atan2f(se, sn) * (float)RAD_TO_DEG;
    cogAvgDeg = c < 0 ? c + 360.0f : c;
  } else {
    cogAvgDeg = NAN;
  }
}

// ============================================================================
//                             BATTERY / POT
// ============================================================================
// The MAX17048 runs from the battery: no battery usually means begin() fails
// or the voltage reads NaN. Both show as "No battery" (battV = NaN).
void serviceBattery() {
  uint32_t now = millis();
  if (lastBattMs != 0 && now - lastBattMs < 5000) return;
  lastBattMs = now;
  cpuTempC = temperatureRead();                      // on-chip sensor, every 5 s with the battery
  if (!battOK) battOK = maxlipo.begin(&Wire);       // battery plugged in later
  if (!battOK) { battV = battPct = battRate = NAN; return; }
  float v = maxlipo.cellVoltage();
  if (isnan(v) || v < 2.5f) { battV = battPct = battRate = NAN; return; }
  battV = v;
  battPct = constrain(maxlipo.cellPercent(), 0.0f, 100.0f);
  battRate = maxlipo.chargeRate();
}

void setDisplayOn(bool on) {
  if (on == displayOn) return;
  displayOn = on;
  if (displayOK) display.oled_command(displayOn || oledForced ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
  lastDrawMs = 0;
}

// 180-degree turn of the SH1107 frame buffer (page format): reversing the byte
// order and the bits in each byte maps pixel (x,y) to (W-1-x, H-1-y).
void flipBuffer180() {
  uint8_t* b = display.getBuffer();
  if (!b) return;
  size_t n = (size_t)display.width() * display.height() / 8;
  for (size_t i = 0, j = n - 1; i < j; i++, j--) { uint8_t t = b[i]; b[i] = b[j]; b[j] = t; }
  for (size_t i = 0; i < n; i++) {
    uint8_t v = b[i];
    v = (uint8_t)((v & 0xF0) >> 4 | (v & 0x0F) << 4);
    v = (uint8_t)((v & 0xCC) >> 2 | (v & 0x33) << 2);
    v = (uint8_t)((v & 0xAA) >> 1 | (v & 0x55) << 1);
    b[i] = v;
  }
}

uint8_t oledRotation() { return P.oledFlip ? 3 : 1; }

void setContrastLevel(int c) {
  c = constrain(c, 1, 255);
  contrast = c;
  if (displayOK) display.setContrast((uint8_t)contrast);
}

// Physical controls. The switch acts only on a flip (the dashboard's On / Off works in between).
// Brightness comes from ONE place, the card 3 checkbox: the knob, or the dashboard slider
// (v4.3; before, the last change won, and a knob reading that wandered - an unwired pin
// floats - kept taking the brightness back from the slider).
uint8_t briWebLevel() { return P.briLevel ? P.briLevel : BOOT_CONTRAST; }
void servicePot() {
  uint32_t now = millis();
  if (now - lastPotMs < 50) return;
  lastPotMs = now;

#if USE_POT_SWITCH
  bool pcfDown = swOnPcf() && extOn(EXT_PCF) && !ext[EXT_PCF].ok;   // keep the last state while the PCF8574 is
  bool sw = potSwOn();                                                // not answering (it used to read ON, which
  if (lastSwState < 0) lastSwState = sw;                              // lit a switched-off OLED for a few seconds)
  else if (!pcfDown && (int8_t)sw != lastSwState) { lastSwState = sw; setDisplayOn(sw); }
#endif

  // Median of the last 5 readings first: a single stray one (ADC noise, a bus glitch) cannot
  // move the brightness. Then a 0.25 running mean, and a step only when the knob has clearly
  // moved (POT_STEP of 255, ~2.4 %) - so a reading sitting on a step edge no longer flickers
  // it (v4.0 and before: 3 steps, single readings, and the ADS7830 pot read straight after
  // another channel - see serviceExt). The ends are exact: fully down is 1, fully up 255.
  static int pHist[5];
  static uint8_t pN = 0, pI = 0;
  int rd = P.briWeb || otaState != OTA_IDLE ? -1 : potRawNow();   // (update screen: full brightness, set by serviceOledForce)
  if (rd < 0) { pN = 0; potEma = -1; return; }       // slider mode, or no knob to read: brightness stays put
  pHist[pI] = rd; pI = (pI + 1) % 5; if (pN < 5) pN++;
  int srt[5];
  memcpy(srt, pHist, sizeof(int) * pN);
  for (int i = 1; i < pN; i++)                     // insertion sort, n <= 5
    for (int k = i; k > 0 && srt[k - 1] > srt[k]; k--) { int q = srt[k]; srt[k] = srt[k - 1]; srt[k - 1] = q; }
  int raw = srt[pN / 2];
  bool fresh = potEma < 0;
  if (fresh) potEma = raw; else potEma += 0.25f * (raw - potEma);
  int c = constrain(map((int)potEma, 0, 4095, 1, 255), 1, 255);
  if (fresh || abs(c - contrast) >= POT_STEP || ((c <= 2 || c >= 253) && c != contrast)) setContrastLevel(c);
}

// ================================ LEDs (v8.1) ================================
// Mark, Recording and Fault LEDs, each on its own Feather pin (card 17), not via the PCF8574, so
// the Fault LED still works when the I2C bus doesn't. PWM brightness follows the OLED; off with
// the pot switch, in Datalogger sleep and in Charge mode. Patterns: see serviceLeds().
// (the LED settings and state are with the globals, under "Indicator LEDs")

void ledsApplyPins() {                           // P.ledPin -> PWM on those pins (others let go)
  for (int i = 0; i < LED_N; i++) {
    uint8_t want = P.ledPin[i] <= 4 ? P.ledPin[i] : 0;
    if (want == ledOnPin[i]) continue;
    if (ledOnPin[i]) { ledcWrite(LED_GPIO[ledOnPin[i]], 0); ledcDetach(LED_GPIO[ledOnPin[i]]); pinMode(LED_GPIO[ledOnPin[i]], INPUT); }
    ledOnPin[i] = 0;
    if (want && ledcAttach(LED_GPIO[want], LED_PWM_HZ, LED_PWM_BITS)) { ledcWrite(LED_GPIO[want], 0); ledOnPin[i] = want; }
    ledLastDuty[i] = -1;
  }
}
void ledsOff() {
  for (int i = 0; i < LED_N; i++) if (ledOnPin[i]) { ledcWrite(LED_GPIO[ledOnPin[i]], 0); ledLastDuty[i] = 0; }
}
void ledsRelease() {                             // Charge mode: PWM off and the pins held low through deep sleep
  for (int i = 0; i < LED_N; i++) if (ledOnPin[i]) {
    uint8_t g = LED_GPIO[ledOnPin[i]];
    ledcWrite(g, 0); ledcDetach(g); pinMode(g, OUTPUT); digitalWrite(g, LOW);
    ledOnPin[i] = 0; ledLastDuty[i] = -1;
  }
}
bool ledSwitchOn() {                             // the pot switch: off = LEDs off; no switch fitted = on
#if USE_POT_SWITCH
  if (P.potSwSrc == SW_NONE) return true;
  return lastSwState != 0;                       // -1: not read yet
#else
  return true;
#endif
}
int ledDutyNow() {
  int c = contrastBeforeOta >= 0 ? contrastBeforeOta : contrast;   // (a firmware update forces the OLED to full)
  float f = constrain(c, 1, 255) / 255.0f;
  return LED_DUTY_MIN + (int)((1023 - LED_DUTY_MIN) * f * f);
}
void ledMarkEvent(uint32_t now, bool level, uint32_t len) { ledMarkEvMs = now ? now : 1; ledMarkEvLen = len; ledMarkEvLevel = level; }

// What is wrong now; the Fault LED starts once something has been wrong for FAULT_HOLD_MS
void faultCheck(uint32_t now) {
  static bool battLow = false;
  char w[96] = "";
  auto add = [&](const char* t) { if (w[0]) strlcat(w, "; ", sizeof(w)); strlcat(w, t, sizeof(w)); };
  if (!P.imuOff && !imuFresh()) add("IMU silent");
  for (int i = 0; i < EXT_N; i++) if (extOn(i) && !ext[i].ok) { char t[24]; snprintf(t, sizeof(t), "%s not answering", EXT_NAME[i]); add(t); }
  if (windActive() && windOn && !loggerMode && now - windStartMs > windSilentMs() && (!windGoodMs || now - windGoodMs > windSilentMs())) add("wind meter silent");
  if (i2cMissing.indexOf("OLED") >= 0) add("OLED missing");
  if (i2cMissing.indexOf("EEPROM") >= 0) add("EEPROM missing");
  if (i2cMissing.indexOf("RTC") >= 0) add("RTC missing");
  if (logging && sdDownMs) add("microSD failing");
  if (!gpsOff && !loggerMode && (!gpsLastNmeaMs || now - gpsLastNmeaMs > 5000)) add("GPS silent");
  battLow = battOK && !isnan(battPct) && !(battRate > 0) && battPct < (battLow ? BATT_LOW_PCT + 1 : BATT_LOW_PCT);
  if (battLow) add("battery low");
  uint8_t k = faultWhyIdx ^ 1;
  strlcpy(faultWhy[k], w, sizeof(faultWhy[k]));
  faultWhyIdx = k;
  if (!w[0]) { faultRawSince = 0; faultLed = false; return; }
  if (!faultRawSince) faultRawSince = now ? now : 1;
  if (!faultLed && now - faultRawSince >= FAULT_HOLD_MS) { faultLed = true; if (!faultLedStart) faultLedStart = now ? now : 1; }
}

// Mark: a blink per mark; on during a cast (an off-blink per mark); a flash on a Datalogger wake.
// Recording: on; slow blink paused; fast blink microSD failing; a blink per row in Datalogger sleep.
// Fault: FAULT in Morse while faultCheck() finds something (held 5 s), the word finished at the end.
void serviceLeds(uint32_t now) {
  static uint32_t lastChk = 0;
  if (now - lastChk >= 1000) { lastChk = now; faultCheck(now); }
  if (reqLedTest) { reqLedTest = false; ledTestMs = now ? now : 1; }
  bool on[LED_N];
  // Mark
  on[LED_MARK] = castOpenNow;
  ledState[LED_MARK] = castOpenNow ? "on (cast open)" : "off";
  if (ledMarkEvMs) { if (now - ledMarkEvMs < ledMarkEvLen) on[LED_MARK] = ledMarkEvLevel; else ledMarkEvMs = 0; }
  // Recording
  bool sleepy = loggerMode && logging && logMs() >= LOGGER_SLEEP_MIN_MS;
  if (!logging)      { on[LED_REC] = false; ledState[LED_REC] = "off (not recording)"; }
  else if (sleepy)   { on[LED_REC] = ledHeartMs && now - ledHeartMs < LED_HEARTBEAT_MS; ledState[LED_REC] = "blink per row (Datalogger)"; }
  else if (sdDownMs) { on[LED_REC] = (now / 125) & 1; ledState[LED_REC] = "fast blink (microSD failing)"; }
  else if (paused)   { on[LED_REC] = (now / 1000) & 1; ledState[LED_REC] = "slow blink (paused)"; }
  else               { on[LED_REC] = true; ledState[LED_REC] = "on (recording)"; }
  // Fault: Morse, each word finished before it stops
  on[LED_FAULT] = false;
  if (faultLedStart) {
    uint32_t u = ((now - faultLedStart) / LED_MORSE_UNIT_MS) % 52;
    if (!faultLed && u >= 45) faultLedStart = 0;
    else on[LED_FAULT] = MORSE_FAULT[u] == '1';
  }
  ledState[LED_FAULT] = faultLed ? "FAULT in Morse" : faultLedStart ? "finishing the word" : "off";
  // Test (card 17): each LED in turn, 1 s, full brightness, whatever the switch
  int test = -1;
  if (ledTestMs) { uint32_t t = now - ledTestMs; if (t < 1000UL * LED_N) test = t / 1000; else ledTestMs = 0; }
  bool sw = ledSwitchOn();
  int duty = ledDutyNow();
  for (int i = 0; i < LED_N; i++) {
    if (!ledOnPin[i]) continue;
    int d = test >= 0 ? (test == i ? 1023 : 0) : (on[i] && sw ? duty : 0);
    if (d != ledLastDuty[i]) { ledcWrite(LED_GPIO[ledOnPin[i]], d); ledLastDuty[i] = d; }
  }
}

// Charge mode (v6.4): everything that can be is switched off and the ESP32 goes into deep sleep,
// so the battery charges as fast as it can; the Feather's charge LED goes out when it is full.
// Logging stops (file closed), settings are saved, the GPS goes to standby, the OLED off, the
// STEMMA QT rail (IMU, EEPROM, add-ons, I2C pull-ups and so the battery gauge) off with the bus
// lines held low (no back-powering), Wi-Fi off. OLED button B or the screen button wakes it, as
// does turning the VMR off and on: a fresh boot either way.
void chargeSleep() {
  Log.println("Charge mode: everything off, deep sleep. Button B or the screen button (or off / on) wakes the VMR.");
  if (logging || logWanted) { logWanted = false; applyLogRequest(millis()); }
  pauseWeb(true);                               // no more requests, no location-mark writes
  if (eepromOK) savePersist();
  if (sdLock(3000)) { SD.end(); sdOK = false; }  // held: nothing writes to the card again
  gpsSend("PMTK161,0");                         // GPS standby (any byte wakes it: the next boot)
  delay(50);
  if (displayOK) display.oled_command(SH110X_DISPLAYOFF);
  server.close();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_OFF);
  Wire.end();
  pinMode(SCL, OUTPUT); digitalWrite(SCL, LOW);
  pinMode(SDA, OUTPUT); digitalWrite(SDA, LOW);
  stemmaPower(false);
  gpio_hold_en((gpio_num_t)SDA);
  gpio_hold_en((gpio_num_t)SCL);
#if defined(PIN_I2C_POWER)
  gpio_hold_en((gpio_num_t)PIN_I2C_POWER);
#endif
  ledsRelease();                                     // indicator LEDs off (held low)
  gpio_deep_sleep_hold_en();
  pinMode(LED_BUILTIN, OUTPUT); digitalWrite(LED_BUILTIN, LOW);
  // pin 12 wakes it only as a screen button: as the wind meter's data line it would wake it at once
  bool w12 = !windActive();
  if (!w12) { digitalWrite(WIND_DE_PIN, LOW); gpio_hold_en((gpio_num_t)WIND_DE_PIN); }   // SP3485 stays receiving
  const gpio_num_t wake[2] = {(gpio_num_t)BUTTON_B, (gpio_num_t)SCREEN_BTN_PIN};   // both to GND
  for (int i = 0; i < (w12 ? 2 : 1); i++) { gpio_num_t g = wake[i]; rtc_gpio_init(g); rtc_gpio_set_direction(g, RTC_GPIO_MODE_INPUT_ONLY); rtc_gpio_pullup_en(g); rtc_gpio_pulldown_dis(g); }
  esp_sleep_pd_config(ESP_PD_DOMAIN_RTC_PERIPH, ESP_PD_OPTION_ON);   // keeps those pull-ups on
  esp_sleep_enable_ext1_wakeup((1ULL << BUTTON_B) | (w12 ? (1ULL << SCREEN_BTN_PIN) : 0), ESP_EXT1_WAKEUP_ANY_LOW);
  Serial.flush();
  delay(100);
  esp_deep_sleep_start();
}

// After charge mode's deep sleep: let go of the pins it held (call first thing in setup)
void releaseSleepPins() {
  gpio_deep_sleep_hold_dis();
  gpio_hold_dis((gpio_num_t)SDA);
  gpio_hold_dis((gpio_num_t)SCL);
#if defined(PIN_I2C_POWER)
  gpio_hold_dis((gpio_num_t)PIN_I2C_POWER);
#endif
  gpio_hold_dis((gpio_num_t)WIND_DE_PIN);
  if (esp_sleep_get_wakeup_cause() != ESP_SLEEP_WAKEUP_UNDEFINED) {
    rtc_gpio_deinit((gpio_num_t)BUTTON_B);
    rtc_gpio_deinit((gpio_num_t)SCREEN_BTN_PIN);
  }
}

// Wi-Fi idle: nobody on the hotspot for a minute -> CPU 80 MHz (the slowest Wi-Fi allows; Datalogger
// mode already records at 80). The hotspot stays at full power, so a phone finds it as before; joining
// brings 240 MHz back within 0.5 s - before DHCP and the page load. Logger sets its own speed.
void serviceIdle(uint32_t now) {
  if (loggerMode) { wifiIdle = false; staSeenMs = now; return; }   // the minute restarts after
  if (now - staChkMs < 500) return;
  staChkMs = now;
  bool sta = WiFi.softAPgetStationNum() > 0;
  if (sta) staSeenMs = now;
  if (sta && wifiIdle) {
    setCpuFrequencyMhz(240);
    wifiIdle = false;
    Log.println("Wi-Fi: phone connected - CPU 240 MHz");
  } else if (!sta && !wifiIdle && now - staSeenMs >= IDLE_AFTER_MS) {
    setCpuFrequencyMhz(80);
    wifiIdle = true;
    Log.println("Wi-Fi idle (no phone for 1 min) - CPU 80 MHz");
  }
}

// Pause/resume the web task around Wi-Fi changes
void pauseWeb(bool p) {
  webPaused = p;
  if (!p) return;
  uint32_t t0 = millis();
  while (!webIdle && millis() - t0 < 3000) vTaskDelay(10);
}

// Datalogger mode: while recording (started with Start), switch off Wi-Fi and
// the OLED and slow the CPU. It never starts a recording itself.
// Button B or the Mark button (PCF8574; no mark is made) brings Wi-Fi and the OLED back. The screen button only shows the
// countdown to the next row for LOGGER_PEEK_MS (proof of life), then the OLED
// goes off again.
void setLoggerMode(bool on) {
  if (on == loggerMode) return;
  if (on) {
    dispBeforeLogger = displayOn;
    setDisplayOn(false);
    if (oledForced) { oledForced = false; if (displayOK) display.oled_command(SH110X_DISPLAYOFF); }   // serial / IMU warning screens too
    peekOn = false;
    pauseWeb(true);
    server.close();
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);
    setCpuFrequencyMhz(80);
    pinMode(LED_BUILTIN, OUTPUT);
    wifiIdle = false;                            // datalogger mode owns the CPU speed now
    loggerMode = true;
    Log.println("Datalogger mode ON (Wi-Fi off). B or Mark: Wi-Fi back on; screen button: countdown to the next row.");
  } else {
    setCpuFrequencyMhz(240);
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    server.begin();
    pauseWeb(false);
    digitalWrite(LED_BUILTIN, LOW);
    if (peekOn) { peekOn = false; if (displayOK && !dispBeforeLogger) display.oled_command(SH110X_DISPLAYOFF); }
    setDisplayOn(dispBeforeLogger);
    loggerMode = false;
    lastDrawMs = 0;
    Log.println("Datalogger mode OFF (Wi-Fi on)");
  }
}

// Restart the hotspot (dashboard, card 18): clears phones that left without
// disconnecting, which otherwise hold some of the AP's 4 places.
void wifiRestart() {
  Log.println("Wi-Fi: restarting the hotspot");
  pauseWeb(true);
  server.close();
  WiFi.softAPdisconnect(true);
  delay(300);
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  server.begin();
  pauseWeb(false);
}

// Clock from the dashboard phone, used only until GPS time has been seen this boot
void applyPhoneTime() {
  if (!reqPhone) return;
  reqPhone = false;
  if (gpsTimeSeen) return;
  uint32_t u = reqPhoneUnix + (millis() - reqPhoneRxMs) / 1000;
  setClock(DateTime(u));
  clockSrc = 'P';
  if (!phoneZdDone) {                                  // ZD from the phone once per boot
    phoneZdDone = true;
    P.zdHours = reqPhoneZd;
    markPersistDirty(true);
  }
  Log.printf("Clock set from phone (ZD %+d)\n", (int)P.zdHours);
}

// Pause / resume (dashboard). While logging, a PAUSED row is written before
// the rows stop and a RESUMED row when they start again (event column).
void setPaused(bool on) {
  if (on == paused) return;
  paused = on;
  if (on) {
    pausedAtMs = millis();
    rsCur = {0, 0, 0};                                 // drop the part-filled 10 s roll block
    if (logging) { sysEvent = "PAUSED"; pauseRowDue = true; }
  } else if (pauseRowDue) {
    sysEvent = nullptr; pauseRowDue = false;           // resumed before the marker went out
  } else if (logging) {
    sysEvent = "RESUMED";
  }
  lastDrawMs = 0;
  Log.printf("VMR %s\n", on ? "PAUSED" : "RESUMED");
}

// The pause, update and serial screens show even with the OLED switched off;
// during an update the contrast is also set to full.
void serviceOledForce() {
  bool ota = otaState != OTA_IDLE, want = paused || ota || serOledOn || imuWarnOn();
  if (want != oledForced) {
    oledForced = want;
    if (displayOK && !displayOn) display.oled_command(want ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
    lastDrawMs = 0;
  }
  if (ota && contrastBeforeOta < 0) { contrastBeforeOta = contrast; setContrastLevel(255); }
  else if (!ota && contrastBeforeOta >= 0) { setContrastLevel(contrastBeforeOta); contrastBeforeOta = -1; }
  if (otaState == OTA_FAIL && millis() - otaEndMs > 15000) otaState = OTA_IDLE;   // error shown 15 s
}

// Restart button (card 18) and a verified firmware update (card 19): stop
// logging (closes the file; after an update it was stopped when the upload
// began), save settings, restart. Logging does not resume after this.
void doRestart(const char* why) {
  Log.println(why);
  if (logging || logWanted) { logWanted = false; applyLogRequest(millis()); }
  if (eepromOK) savePersist();
  delay(300);
  esp_restart();
}

// Settings and actions requested from the dashboard. The web task only sets
// req* variables; they are applied here, in the loop task, so the I2C bus,
// the OLED and the EEPROM image P are only ever touched from one task.
void applyWebRequests() {
  if (reqExtSet) { reqExtSet = false; extApplySettings(); }
  int16_t s = reqScreen;
  if (s >= 0) { reqScreen = -1; if (s < NUM_SCREENS) { screen = (uint8_t)s; lastDrawMs = 0; } }
  int16_t c = reqContrast;
  if (c >= 0) {                                    // the slider: only in slider mode (saved to EEPROM)
    reqContrast = -1;
    if (P.briWeb) { P.briLevel = (uint8_t)c; setContrastLevel(c); markPersistDirty(true); }
  }
  int8_t bw = reqBriWeb;
  if (bw >= 0) {
    reqBriWeb = -1;
    if (P.briWeb != (uint8_t)bw) {
      P.briWeb = (uint8_t)bw;
      if (bw) { P.briLevel = (uint8_t)contrast; }      // slider mode starts where the knob left it
      else potEma = -1;                                // knob mode: its reading applies at once
      markPersistDirty(true);
      Log.printf("Brightness from the %s\n", bw ? "dashboard" : "knob");
    }
  }
  int8_t o = reqDisplayOn;
  if (o >= 0) { reqDisplayOn = -1; setDisplayOn(o == 1); }
  int8_t z = reqZero;
  if (z >= 0) { setZero(z == 1); reqZero = -1; }
  int8_t gx = reqGraphMax, gn = reqGraphMin;
  // graph limits: any whole degree +/-GRAPH_LIMIT_DEG, top always above bottom
  if (gx != REQ_NONE) { reqGraphMax = REQ_NONE; if (gx > P.graphMin) { P.graphMax = gx; markPersistDirty(true); lastDrawMs = 0; } }
  if (gn != REQ_NONE) { reqGraphMin = REQ_NONE; if (gn < P.graphMax) { P.graphMin = gn; markPersistDirty(true); lastDrawMs = 0; } }
  int8_t px = reqPitchMax, pn = reqPitchMin;
  if (px != REQ_NONE) { reqPitchMax = REQ_NONE; if (px > P.pitchGraphMin) { P.pitchGraphMax = px; markPersistDirty(true); } }
  if (pn != REQ_NONE) { reqPitchMin = REQ_NONE; if (pn < P.pitchGraphMax) { P.pitchGraphMin = pn; markPersistDirty(true); } }
  if (reqResetMax) { reqResetMax = 0; resetAllTime(); }
  int8_t ad = reqAtDock;
  if (ad >= 0) {
    reqAtDock = -1;
    if (P.atDock != (uint8_t)ad) {
      P.atDock = (uint8_t)ad;
      markPersistDirty(true);
      if (logging && !sysEvent) sysEvent = ad ? "AT DOCK" : "UNDERWAY";   // marked in the CSV
      Log.printf("%s: wave analysis %s\n", ad ? "At the dock" : "Underway", ad ? "off" : "on");
    }
  }
  if (reqClinoReset) { reqClinoReset = 0; clinoMaxS = clinoMaxP = 0; }
  if (reqGReset) { reqGReset = 0; gPeaksReset(); }
  int8_t tc = reqTrimCal;
  if (tc) {
    if (tc > 0) trimCalibrate(reqCalF, reqCalM, reqCalA);
    else { P.trimCal = 0; markPersistDirty(true); Log.println("Trim calibration cleared"); if (logging && !sysEvent) sysEvent = "TRIM CAL CLEARED"; }
    reqTrimCal = 0;
  }
  if (reqCharge == 1 && millis() - reqChargeAtMs > 600) { reqCharge = -1; chargeSleep(); }   // reply sent first
  int8_t pf = reqPosFmt;
  if (pf >= 0) { reqPosFmt = -1; if (P.posFmt != pf) { P.posFmt = (uint8_t)pf; markPersistDirty(true); lastDrawMs = 0; } }
  int8_t lr = reqLogRate;
  if (lr >= 0) { reqLogRate = -1; if (!loggingActive() && (P.imuOff || lr == 0)) { P.logRate = (uint8_t)lr; markPersistDirty(true); Log.printf("Logging rate: %lu ms\n", (unsigned long)logMs()); } }
  if (reqLogger == 1 && millis() - reqLoggerAtMs > 600) { reqLogger = -1; setLoggerMode(true); }   // reply sent first
  if (reqBeamCm >= 0 || reqLengthDm >= 0 || reqLbpDm >= 0 || reqRollThr > 0 ||
      reqDraftFwdCm >= 0 || reqDraftAftCm >= 0 || reqDraftMidCm >= 0 || reqKeelDeckCm >= 0 || reqKeelBridgeCm >= 0 ||
      reqKeelTopCm >= 0 || reqParWlDm >= 0 || reqCb >= 0 || reqCwp >= 0 || reqTpi >= 0 || reqDisp >= 0 || reqGmLc >= 0 ||
      reqVmrXdm != POS_REQ_NONE || reqVmrYcm != POS_REQ_NONE || reqVmrZcm >= 0) {
    if (reqBeamCm >= 0)   { P.shipBeamCm = (uint16_t)reqBeamCm;     reqBeamCm = -1; }
    if (reqLengthDm >= 0) { P.shipLengthDm = (uint16_t)reqLengthDm; reqLengthDm = -1; }
    if (reqLbpDm >= 0)    { P.shipLbpDm = (uint16_t)reqLbpDm;       reqLbpDm = -1; }
    if (reqRollThr > 0)   { P.rollThrDeg = (uint8_t)reqRollThr;     reqRollThr = -1; }
    if (reqDraftFwdCm >= 0 || reqDraftAftCm >= 0 || reqDraftMidCm >= 0) {
      if (reqDraftFwdCm >= 0) { P.draftFwdCm = (uint16_t)reqDraftFwdCm; reqDraftFwdCm = -1; }
      if (reqDraftAftCm >= 0) { P.draftAftCm = (uint16_t)reqDraftAftCm; reqDraftAftCm = -1; }
      if (reqDraftMidCm >= 0) { P.draftMidCm = (uint16_t)reqDraftMidCm; reqDraftMidCm = -1; }
      shipDraftUpdate();                               // quarter mean with all three (v8.12)
    }
    if (reqKeelDeckCm >= 0)   { P.keelDeckCm = (uint16_t)reqKeelDeckCm;     reqKeelDeckCm = -1; }
    if (reqKeelBridgeCm >= 0) { P.keelBridgeCm = (uint16_t)reqKeelBridgeCm; reqKeelBridgeCm = -1; }
    if (reqKeelTopCm >= 0)    { P.keelTopCm = (uint16_t)reqKeelTopCm;       reqKeelTopCm = -1; }
    if (reqParWlDm >= 0)      { P.parWlDm = (uint16_t)reqParWlDm;           reqParWlDm = -1; }
    if (reqCb >= 0)           { P.cbX1000 = (uint16_t)reqCb;                reqCb = -1; }
    if (reqCwp >= 0)          { P.cwpX1000 = (uint16_t)reqCwp;              reqCwp = -1; }
    if (reqTpi >= 0)          { P.tpiX10 = (uint16_t)reqTpi;                reqTpi = -1; }
    if (reqDisp >= 0)         { P.dispX10 = (uint16_t)reqDisp;              reqDisp = -1; }
    if (reqGmLc >= 0)         { P.gmLcFt100 = (uint16_t)reqGmLc;            reqGmLc = -1; }
    if (reqVmrXdm != POS_REQ_NONE) { P.vmrXdm = (int16_t)reqVmrXdm;             reqVmrXdm = POS_REQ_NONE; }
    if (reqVmrYcm != POS_REQ_NONE) { P.vmrYcm = (int16_t)reqVmrYcm;             reqVmrYcm = POS_REQ_NONE; }
    if (reqVmrZcm >= 0)       { P.vmrZcm = (uint16_t)reqVmrZcm;             reqVmrZcm = -1; }
    markPersistDirty(true);
    lastStatsMs = 0;                                  // recompute GM / statistics now
  }
  int8_t fl = reqFlip;
  if (fl >= 0) {
    reqFlip = -1;
    P.oledFlip = fl;
    if (displayOK) display.setRotation(oledRotation());
    markPersistDirty(true);
    lastDrawMs = 0;
  }
  int8_t db = reqRotDb;
  if (db >= 0) { reqRotDb = -1; P.rotDeadband = db; markPersistDirty(true); }
  applyPhoneTime();
  int8_t rg = reqGps;
  if (rg) { reqGps = 0; if (rg >= 3) gpsSetOff(rg == 3); else gpsRestart(rg == 2); }
  if (reqRestart) doRestart("Restart requested from the dashboard");
  if (reqWifiRestart && !loggerMode) { reqWifiRestart = 0; delay(200); wifiRestart(); }   // reply sent first
  int8_t pz = reqPause;
  if (pz >= 0) { reqPause = -1; setPaused(pz == 1); }
  if (reqOtaReboot && millis() - otaEndMs > 1000) doRestart("Firmware update installed: restarting");   // reply sent first
  int8_t gi = reqGraphIdx;
  if (gi >= 0) { reqGraphIdx = -1; P.graphSecIdx = gi; markPersistDirty(true); lastDrawMs = 0; }
  int8_t sa = reqSogAvg;
  if (sa > 0) { reqSogAvg = 0; P.sogAvgS = sa; markPersistDirty(true); }
  int8_t da = reqDockAvg10;
  if (da > 0) { reqDockAvg10 = 0; P.dockAvg10 = (da == 6) ? 0 : da; markPersistDirty(true); }   // 60 s stored as 0 (the default)
  if (reqZdSet) { P.zdHours = reqZd; reqZdSet = 0; markPersistDirty(true); lastDrawMs = 0; }
  int16_t nr = reqNudgeRoll, np = reqNudgePitch;
  if (nr || np) {                          // shift the READING: offset moves the other way
    P.rollOffset  = roundf((P.rollOffset  - nr * 0.1f) * 100.0f) / 100.0f;
    P.pitchOffset = roundf((P.pitchOffset - np * 0.1f) * 100.0f) / 100.0f;
    P.zeroApplied = 1;
    reqNudgeRoll = 0; reqNudgePitch = 0;
    markPersistDirty(true);
  }
}

