void printAt(int x, int y, const char* s) { display.setCursor(x, y); display.print(s); }

void fmtVal(char* out, size_t n, float v, int w, bool sign, int dp = 1) {
  if (isnan(v)) snprintf(out, n, "%*s", w, "--");
  else if (sign) snprintf(out, n, "%+*.*f", w, dp, v);
  else snprintf(out, n, "%*.*f", w, dp, v);
}

// Roll as size + side, 6 chars wide, right-aligned: " 12.3S" = starboard down, "  4.0P" = port down.
// Number first (as the marks screen): the leading spaces keep the columns apart - with the side
// first, "Rol" + "P  3.4" read "RolP  3.4S  3.8" (before v7.4).
void fmtRoll(char* out, size_t n, float v) {
  if (isnan(v)) { snprintf(out, n, "%5s ", "--"); return; }   // "--" under the digits
  float a = fabsf(v);
  if (a < 0.05f) snprintf(out, n, "%5.1f ", 0.0f);
  else           snprintf(out, n, "%5.1f%c", a, v > 0 ? 'S' : 'P');
}

void drawHeaderTime() {
