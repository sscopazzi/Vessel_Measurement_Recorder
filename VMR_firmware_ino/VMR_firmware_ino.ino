// from the accelerometer turned by the orientation quaternion), roll and
// pitch, the last 17 min of them; Welch spectra every 30 s once there are
// 8.5 min. Heap (24 kB), made at the first sample.
#define WV_DT_MS   500
#define WV_N      2048                  // 17 min at 2 Hz
#define WV_MIN    1024                  // 8.5 min before the first estimate
#define WV_SEG     256                  // Welch segment: 128 s, half overlap -> 1/128 Hz bins
#define WV_K0        4                  // spectrum bins sent / searched: k = 4 (32 s) ...
#define WV_K1       80                  //   ... 80 (3.2 s)
float   *wvA = nullptr, *wvR = nullptr, *wvP = nullptr;
