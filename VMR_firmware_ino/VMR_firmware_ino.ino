// Set uses the 5 s running mean of raw roll/pitch, not a single sample
bool setZero(bool on) {
  if (on && !haveImu) { showMessage("No IMU data"); return false; }
  if (!on) {
    P.zeroApplied = 0; P.rollOffset = 0; P.pitchOffset = 0; P.zeroRef100 = 0;
    showMessage("Level zero CLEARED");
  } else {
    float tr, hs, ref = levelRefPitch(tr, hs);      // with drafts: pitch reads the deck slope they give
    if (isnan(ref) || fabsf(ref) > 15) ref = 0;
    P.rollOffset = tareRollAvg; P.pitchOffset = tarePitchAvg - ref; P.zeroApplied = 1;
    P.zeroRef100 = (int16_t)lroundf(ref * 100);
    showMessage("Level zero SET");
  }
  if (logging && !sysEvent) sysEvent = P.zeroApplied ? "LEVEL ZERO SET" : "LEVEL ZERO CLEARED";   // roll / pitch reference changed
  Log.printf("Zero: %s  roll_off=%.2f pitch_off=%.2f (pitch set to read %.2f)\n",
                P.zeroApplied ? "on" : "off", P.rollOffset, P.pitchOffset, P.zeroRef100 / 100.0f);
  markPersistDirty(true);
  return true;
}

void toggleZero() {
  setZero(!P.zeroApplied);
}

void resetAllTime() {
  P.rollMaxPos = P.rollMaxNeg = P.pitchMaxPos = P.pitchMaxNeg = P.yawRateMax = 0;
  P.tRollMaxPos = P.tRollMaxNeg = P.tPitchMaxPos = P.tPitchMaxNeg = P.tYawRateMax = 0;
  imuStartMs = millis();                         // restart warm-up so the press itself is not recorded
  showMessage("All-time max RESET");
  Log.println("All-time maxima reset");
  markPersistDirty(true);
}

// The OLED buttons step through these; the all-time maxima, sky plot and trim / list screens are
// picked from the dashboard only (card 3; v7.42)
bool screenInCycle(uint8_t s) { return s != SCREEN_ALLTIME && s != SCREEN_SKY && s != SCREEN_DOCK && (s != SCREEN_WIND || windActive()); }

void serviceButtons() {
  btnA.update(); btnB.update(); btnC.update(); btnScr.update();
  if (loggerMode) {                                    // B: leave datalogger mode; screen button: countdown
    if (btnB.pressed) setLoggerMode(false);
    else if (btnScr.pressed) loggerPeek();
    return;
  }

  if (paused && btnB.pressed) {                        // B resumes after a pause (the screen stays)
    setPaused(false);
  } else if (btnB.pressed || btnScr.pressed) {
    do screen = (screen + 1) % NUM_SCREENS; while (!screenInCycle(screen));   // 4, 8, 9: dashboard only
    lastDrawMs = 0;
  }

  if (screen == SCREEN_GRAPH) {
    if (btnA.pressed && !btnC.isDown()) {          // A: top (positive) limit up
      P.graphMax += GRAPH_STEP_DEG;
      if (P.graphMax > GRAPH_LIMIT_DEG) P.graphMax = max(GRAPH_STEP_DEG, P.graphMin + 1);   // wrap, staying above the bottom
      markPersistDirty(true); lastDrawMs = 0;
    }
    if (btnC.pressed && !btnA.isDown()) {          // C: bottom (negative) limit down
      P.graphMin -= GRAPH_STEP_DEG;
      if (P.graphMin < -GRAPH_LIMIT_DEG) P.graphMin = min(-GRAPH_STEP_DEG, P.graphMax - 1); // wrap, staying below the top
      markPersistDirty(true); lastDrawMs = 0;
    }
  }

  if (btnA.isDown() && btnC.isDown()) {
    uint32_t held = min(btnA.downFor(), btnC.downFor());
    if (!comboFired && held >= HOLD_ACTION_MS) {
      comboFired = true;
      if (screen == SCREEN_POSITION)     toggleZero();
      else if (screen == SCREEN_ALLTIME) resetAllTime();
      else if (screen == SCREEN_CLINO)   clinoMaxS = clinoMaxP = 0;
      else if (screen == SCREEN_GMETER)  gPeaksReset();
    }
  } else {
    comboFired = false;
  }
}

