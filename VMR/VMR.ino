#define WV_K0        4                  // spectrum bins sent / searched: k = 4 (32 s) ...
#define WV_K1       80                  //   ... 80 (1.6 s)
#define WV_KSEND     3                  // sent from k = 3 (43 s), so the card's graph reaches its 35-s edge (not searched)
float   *wvA = nullptr, *wvR = nullptr, *wvP = nullptr;
uint16_t wvHead = 0, wvN = 0;
double   wvSumA = 0, wvSumP = 0, wvSumR = 0;   // 0.5-s sums: vertical acceleration, pitch, roll (taken together)
uint16_t wvCnt = 0;
uint32_t wvMs = 0, wvCalcMs = 0;
float    wvTe = NAN, wvTz = NAN, wvTrs = NAN, wvHs = NAN;   // pitch peak (encounter), heave peak, roll peak (s); heave Hs (m)
float    wvHsMid = NAN, wvTzMid = NAN; // heave Hs moved to midships and its peak period (NaN without the VMR's position in the Level zero and ship data card)
// the same heave from the pressure. The BMP388 rises and falls with the ship: 1 m is about
// 0.12 mbar, so its 0.5-s means (read at 10 Hz) are turned into height, z = -(p - p0) / (rho g),
// rho from the pressure and the air (else box) temperature, and analysed beside the acceleration:
// no double integration, so long swell is not lost, but wind gusts and doors are in it.
float    wvHsB = NAN, wvHsBMid = NAN, wvTzB = NAN;   // pressure heave Hs at the VMR, at midships; its peak period
float   *wvB = nullptr;                   // the pressure height (m about wvBRef), WV_N - heap
float   *wvAccB = nullptr, *wvAccBMid = nullptr;   // its spectrum being summed, at the VMR and midships - heap
double   wvSumB = 0;                      // 0.5-s sum of the BMP388 readings (Pa)
uint16_t wvCntB = 0, wvBN = 0;            // readings in it; samples in a row with pressure (the window uses it whole or not at all)
float    wvBRef = NAN;                    // the pressure the heights are about (set at the start of a run of samples)
// Fused heave: the motion's heave and the pressure's, over the segments both cover. Their cross-spectrum keeps what the two
// share (each one's own noise - wind on the pressure, noise and tilt on the acceleration - averages out). Period by period:
// where the two agree (coherence 0.5 or more; the Waves card's advanced settings change it) the fused spectrum is the
// motion's own; elsewhere the motion's to 10 s and, from 14 s (long swell, where the acceleration grows weak), the shared
// part divided by the pressure's gain at the nearest period where they agree (this window's, else the learned curve below),
// blended between. Hs = 4 x its root; coherence: their agreement over the band, weighted by the motion's power; wvGainB:
// the pressure's gain at 12 s and shorter, where the acceleration is sound. Needs both for the window; NaN otherwise.
float   *wvXr = nullptr, *wvXi = nullptr, *wvXa = nullptr;      // cross-spectrum (re, im) and the motion's heave power, at the VMR - heap
float   *wvXrM = nullptr, *wvXiM = nullptr, *wvXaM = nullptr;   // the same at midships - heap
float    wvHsF = NAN, wvHsFMid = NAN, wvCohF = NAN, wvGainB = NAN;   // fused Hs at the VMR, at midships; coherence 0-1; pressure gain
// The pressure's gain by period, learned while the IMU is on (each coherent bin eased towards the new window's, a fifth of
// the way by default) and kept on the microSD card (WV_GAIN_FILE), so with the IMU off the pressure's spectrum is divided
// by it, bin by bin (the nearest bin that has one): wvHsBc. A bin keeps the last gain it had; Reset leaves the curve, the
// Waves card's Forget learned gain clears it.
#define WV_GAIN_DIR   "/.wave"
#define WV_GAIN_FILE  "/.wave/gain.bin"
#define WV_GAIN_TMP   "/.wave/gain.tmp"
#define WV_GAIN_MAGIC 0x4E474D56UL      // "VMGN"
struct WvGain { uint32_t magic; uint32_t unix; float agg; float g[WV_K1 + 1]; };   // when last learned (UTC, 0 = no clock); the 12-s-and-shorter gain then; by bin
WvGain*  wvGk = nullptr;                 // PSRAM; nullptr = no PSRAM
bool     wvGkDirty = false;
uint32_t wvGkSaveMs = 0;
float    wvHsBc = NAN;                   // pressure-only Hs corrected by wvGk
// With the IMU off (Add-ons) the analysis runs on the pressure alone: Hs and its peak period at the VMR (moving it to midships
// needs pitch and roll). Not while Datalogger sleeps between rows: the BMP388 is read only while the VMR is awake.
bool     wvBOnly = false;                // the window now filling is the pressure's alone
bool     wvAnBOnly = false;              // the analysis running is
bool     wvAnBaro = false;                // this analysis includes the pressure
int16_t  wvAnB0 = 0, wvAnBSegs = 0;       // its first segment and how many (the newest ones the pressure covers)
// Heave at midships: the hull is rigid, so the VMR rises and falls with the heave at
// midships plus x * pitch - y * roll (x forward, y to starboard of midships on the centreline;
// pitch + bow up, roll + starboard down, small angles). Taken off per frequency from the complex
// spectra of each segment: Zmid = A / -(2 pi f)^2 - x * Pitch + y * Roll.
float  (*wvCx)[2][WV_K1 + 1] = nullptr;   // this segment's complex spectra [acceleration, pitch, pressure height][re, im] - heap
float   *wvAccMid = nullptr;              // midships heave spectrum being summed, WV_K1 + 1 - heap
float    wvAnX = NAN, wvAnY = NAN;        // the VMR's position (m) when the analysis started; NaN = not entered
// The last estimate is kept when the window starts again (IMU gap, pause, dock): the Waves card and
// the OLED keep showing it, labelled with its age. GM and the CSV use only a current one.
bool     wvCurrent = false;            // the estimate above is from the window now filling
uint32_t wvLastMs = 0;                 // millis() of the last estimate (0 = none since boot)
bool     wvNewForLog = false;          // a new estimate: written on the next CSV row only
float  (*wvSpec)[WV_K1 + 1] = nullptr;  // last spectra [3][WV_K1 + 1]: heave (m2/Hz), pitch, roll (deg2/Hz) - heap
float   *wvRe = nullptr, *wvIm = nullptr;  // FFT work, WV_SEG each - heap
// The analysis runs one FFT per loop pass (wvAnalyseStep), not all 4 x 15 at once: on the ESP32-S2
// (no FPU; 80 MHz with no phone on the hotspot) the whole set takes 0.5-1.5 s, which would stop the
// loop every 30 s - rows lost and, past 1 s, a stale IMU that restarts this window.
float   *wvHann = nullptr;                // Hann window, WV_SEG - heap
float  (*wvAcc)[WV_K1 + 1] = nullptr;     // spectra being summed [3][WV_K1 + 1] - heap
int16_t  wvStep = -1;                     // next FFT of the running analysis (segment * 4 + signal); -1 = none
int16_t  wvAnSegs = 0, wvAnM = 0;
uint16_t wvAnHead = 0;                    // the window as it was when the analysis started
int      imuEvents = 0;
int8_t   i2cPowerOff = -1;             // level of PIN_I2C_POWER that switches the STEMMA QT rail OFF
bool     imuSessionOpen = false;       // the BNO08x library's single session slot is in use
bool     imuStarted = false;           // begin_I2C() has succeeded (session + callbacks are good)
bool     imuBootFail = false;          // the IMU did not start at boot: OLED warning until it does
bool     imuNeedReports = false;       // re-enable the reports (after a power-cycle or a failed command), retried every 2 s
float tareRollAvg = 0, tarePitchAvg = 0;
// ---- ROLLPERIOD STATE BEGIN ----
float    rpMean = NAN, rpM2 = 0, rpPrevX = 0, rpMaxSince = 0, rpLp1 = 0, rpLp2 = 0;
uint32_t rpPrevMs = 0, rpLastCrossMs = 0;
bool     rpArmed = false;
float    rpHist[ROLL_PERIOD_CYCLES];
float    rpMinSince = 0, rpPkS = -INFINITY, rpPkP = INFINITY;   // this cycle: lowest x, highest / lowest roll

// ---- Roll statistics (dashboard card): every full roll cycle the period
// detector accepts is stored with its single amplitude (half the peak-to-peak
// swing about the running mean) and its peak angles (including any list).
// Roll mean and RMS come from 10 s blocks of every IMU sample.
#define RS_CYCLES   1024                 // > 30 min of rolls down to a 2 s period
#define RS_BLOCK_MS 10000UL
#define RS_BLOCKS   180                  // 30 min of 10 s blocks
