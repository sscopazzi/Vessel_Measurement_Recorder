  j += "\"]}";
  j += "},\"set\":{\"wxs\":"; j += (int)wxSpanS(); j += ",\"gmax\":"; j += (int)P.graphMax;
  j += ",\"trk\":["; j += trkMoveSNow(); j += ','; j += trkStillSNow(); j += ','; j += (int)trkMoveMNow(); j += ','; if (trkAll()) j += "\"all\""; else j += trkKeepSNow() / 3600;
  j += ','; j += (unsigned long)trkN; j += ','; j += (unsigned long)trkFileBytes; j += ']';
  j += ",\"col\":"; j += (int)P.colOff; j += ",\"colf\":"; j += (int)colOffRec;
  j += ",\"wva\":["; j += String(wvCohNow(), 2); j += ','; j += String(wvBlendANow(), 0); j += ','; j += String(wvBlendBNow(), 0); j += ','; j += String(wvLearnNow(), 2); j += ']';
