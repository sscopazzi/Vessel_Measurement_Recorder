struct Button {
  uint8_t pin = 0;
  int8_t  ext = -1;                          // >= 0: read PCF8574 pin P<ext> instead of the Feather pin; -2 none
  bool stable = HIGH, lastRead = HIGH, pressed = false, released = false;
  uint32_t lastChange = 0;
  void begin(uint8_t p) {
    pin = p;
    pinMode(pin, INPUT_PULLUP);
    stable = lastRead = digitalRead(pin);
    lastChange = millis();
  }
  bool isDown() const { return stable == LOW; }
  void update() {
    pressed = released = false;
    bool r = ext >= 0 ? (extPinLow(ext) ? LOW : HIGH) : ext == -2 ? HIGH : digitalRead(pin);   // -2: no button
    uint32_t now = millis();
    if (r != lastRead) { lastRead = r; lastChange = now; }
    if (now - lastChange > 25 && r != stable) {
      stable = r;
      if (stable == LOW) pressed = true; else released = true;
    }
  }
};
