// a barge length / draft as the event shows it: ft-in for feet, else metres
void Vy::vsLen(char* o, size_t n, float x, bool m, bool draft) {
  if (!(x > 0)) { strlcpy(o, "-", n); return; }
  if (m) snprintf(o, n, draft ? "%.2f" : "%.1f", x);
  else if (draft) { int in = (int)lroundf(x * 12); snprintf(o, n, "%d-%02d", in / 12, in % 12); }
  else snprintf(o, n, "%.0f", x);
}
void Vy::vsQueueEvents() {
  const Voyage &v = P.vs, &o = vsSnap;
  char t[96], a[16], b[16], c[16];                 // (evqPush cuts to EVENT_NOTE_MAX)
  if (v.vClass != o.vClass || strcmp(v.classTxt, o.classTxt)) {
    snprintf(t, sizeof(t), "VESSEL: %s", v.vClass == VC_OTHER && v.classTxt[0] ? v.classTxt : VCLASS_NAME[v.vClass]); Vy::evqPush(t);
  }
  char now[48], was[48];
  Vy::condSummary(now, sizeof(now));
  { Voyage keep = P.vs; uint8_t kc = P.logCond; P.vs = o; P.logCond = condSnap; Vy::condSummary(was, sizeof(was)); P.vs = keep; P.logCond = kc; }
  if (strcmp(now, was)) { snprintf(t, sizeof(t), "%s: %s", v.vClass == VC_TOW ? "TOW" : "CONDITION", now[0] ? now : "none"); Vy::evqPush(t); }
  if (v.vClass == VC_TOW) {
    bool on = Vy::bargeOn(), was2 = o.vClass == VC_TOW && o.towMode && o.towMode != TOW_LIGHT;
    if (on != was2 || v.bargeType != o.bargeType || strcmp(v.bargeTxt, o.bargeTxt)) {
      snprintf(t, sizeof(t), "BARGE: %s", !on ? "none" : v.bargeType == BARGE_OTHER && v.bargeTxt[0] ? v.bargeTxt : v.bargeType ? BARGE_NAME[v.bargeType] : "type not set");
      Vy::evqPush(t);
    }
    if (on) {
      const char* u = v.lenUnit ? "m" : "ft";
      if (v.bLen != o.bLen || v.bWid != o.bWid || v.lenUnit != o.lenUnit) {
        Vy::vsLen(a, sizeof(a), v.bLen, v.lenUnit, false); Vy::vsLen(b, sizeof(b), v.bWid, v.lenUnit, false);
        snprintf(t, sizeof(t), "BARGE SIZE: %s x %s %s", a, b, u); Vy::evqPush(t);
      }
      if (v.bDf != o.bDf || v.bDm != o.bDm || v.bDa != o.bDa || v.lenUnit != o.lenUnit) {
        Vy::vsLen(a, sizeof(a), v.bDf, v.lenUnit, true); Vy::vsLen(b, sizeof(b), v.bDm, v.lenUnit, true); Vy::vsLen(c, sizeof(c), v.bDa, v.lenUnit, true);
        snprintf(t, sizeof(t), "BARGE DRAFT: F %s M %s A %s %s", a, b, c, u); Vy::evqPush(t);
      }
      if (v.bTon != o.bTon || v.tonUnit != o.tonUnit) {
        static const char* const TU[] = {"ST", "LT", "MT"};
        if (v.bTon > 0) snprintf(t, sizeof(t), "BARGE TONS: %.0f %s", v.bTon, TU[v.tonUnit]); else strcpy(t, "BARGE TONS: -");
        Vy::evqPush(t);
      }
    }
  }
  if (strcmp(v.voyage, o.voyage)) { snprintf(t, sizeof(t), "VOYAGE: %s", v.voyage[0] ? v.voyage : "-"); Vy::evqPush(t); }
  vsSnap = P.vs; condSnap = P.logCond;
}
// Loop: take what the web task staged; events after 10 quiet seconds while recording
void Vy::applyVoyage(uint32_t now) {
  if (stVsSet) {
    portENTER_CRITICAL(&vsMux);
    P.vs = stVs; P.logCond = stCond; stVsSet = false;
    portEXIT_CRITICAL(&vsMux);
    markPersistDirty(true);
    if (logging) { vsChgPend = true; vsChgMs = now; }
  }
  if (vsChgPend && now - vsChgMs >= VS_EVENT_QUIET_MS) { vsChgPend = false; if (logging) Vy::vsQueueEvents(); }
}
