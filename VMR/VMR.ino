struct RsBlock   { float sum, sumSq; uint16_t n; };
struct RollStats { uint16_t n; float sig, maxAmp, mean, rms; uint16_t overS, overP; float tMed; };   // tMed: median roll period, s
RollCycle* rsCyc = nullptr;              // heap, RS_CYCLES (12 KB, PSRAM when there is some: the static RAM is close to full)
float*     rsSort = nullptr;             // heap, RS_CYCLES: scratch for the sort
uint16_t  rsHead = 0, rsCount = 0;
RsBlock*  rsBlk = nullptr;                // RS_BLOCKS, PSRAM
RsBlock   rsCur = {0, 0, 0};
uint16_t  rsBlkHead = 0, rsBlkCount = 0;
uint32_t  rsCurStartMs = 0, lastStatsMs = 0;
static const uint16_t RS_WIN_MIN[2] = {10, 30};
RollStats rStat[2];
float     gmC = NAN, gmEst = NAN;        // GM estimate from the roll spectrum peak (m)
uint8_t  rpCount = 0, rpIdx = 0;
float    rollPeriod = NAN;             // s, median of recent full roll cycles (NaN = not measurable)
