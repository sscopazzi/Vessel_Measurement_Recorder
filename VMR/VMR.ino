inline void crumb(uint32_t st) {
  uint32_t t = micros(), was = crumbStage, d = t - crumbAtUs;
  if (was < ST_COUNT && d > stageMaxUs[was]) stageMaxUs[was] = d;
  if (was < ST_COUNT && d > rowStMaxUs) { rowStMaxUs = d; rowStStage = (uint8_t)was; }
  crumbAtUs = t; crumbStage = st;
}
