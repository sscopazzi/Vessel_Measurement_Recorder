}

// ---- Screen 10: G-meter. The dot is the felt push in the deck plane (up =
// forward, right = starboard): heeled to starboard it sits to starboard, like
// sliding down the deck. Rings every 0.1 g (0.2 g once a peak passes 0.3 g),
// a short trail, peak-hold ticks on each axis; vertical g on the bar.
void drawGMeter() {
  const int cx = 31, cy = 32, R = 30;
  float pkMax = fmaxf(fmaxf(gPkF, gPkA), fmaxf(gPkS, gPkP));
  float ring = pkMax > 0.3f ? 0.2f : 0.1f, full = 3 * ring;            // outer ring = 3 rings
  display.drawCircle(cx, cy, R, SH110X_WHITE);
  for (int k = 1; k <= 2; k++)
    for (int a = 0; a < 360; a += 20) {
      float r = a * D2R;
      display.drawPixel(cx + (int)lroundf(sinf(r) * R * k / 3), cy - (int)lroundf(cosf(r) * R * k / 3), SH110X_WHITE);
    }
  display.drawLine(cx - 2, cy, cx + 2, cy, SH110X_WHITE);
  display.drawLine(cx, cy - 2, cx, cy + 2, SH110X_WHITE);
  auto lab = [&](int x, int y, const char* t) {                       // letters sit on the outer ring
    display.fillRect(x - 1, y - 1, 7, 9, SH110X_BLACK);
    printAt(x, y, t);
  };
  lab(cx - 2, cy - R - 2, "F");
  lab(cx - 2, cy + R - 5, "A");
  lab(cx - R - 1, cy - 3, "P");
  lab(cx + R - 3, cy - 3, "S");
  auto sc = [&](float g) { return (int)lroundf(constrain(g / full, -1.05f, 1.05f) * R); };
  // peak hold: short ticks across each axis
  int t;
  if (gPkS > 0.005f) { t = sc(gPkS);  display.drawLine(cx + t, cy - 2, cx + t, cy + 2, SH110X_WHITE); }
  if (gPkP > 0.005f) { t = sc(gPkP);  display.drawLine(cx - t, cy - 2, cx - t, cy + 2, SH110X_WHITE); }
  if (gPkF > 0.005f) { t = sc(gPkF);  display.drawLine(cx - 2, cy - t, cx + 2, cy - t, SH110X_WHITE); }
  if (gPkA > 0.005f) { t = sc(gPkA);  display.drawLine(cx - 2, cy + t, cx + 2, cy + t, SH110X_WHITE); }
  char b[24];
  bool fr = accFresh();
  if (fr) {
    int x = cx + sc(gFeltS), y = cy - sc(gFeltF);
    gTrailX[gTrailHead] = (int8_t)(x - cx); gTrailY[gTrailHead] = (int8_t)(y - cy);   // trail, one point a frame
    gTrailHead = (gTrailHead + 1) % G_TRAIL;
    if (gTrailN < G_TRAIL) gTrailN++;
    for (int i = 0; i < gTrailN; i++) display.drawPixel(cx + gTrailX[i], cy + gTrailY[i], SH110X_WHITE);
    display.fillCircle(x, y, 3, SH110X_WHITE);
  }
  // numbers on the right
  printAt(68, 0, "G-METER");
  if (fr) snprintf(b, sizeof(b), "%c %.2f", gFeltS >= 0 ? 'S' : 'P', fabsf(gFeltS)); else strcpy(b, "--");
  printAt(68, 11, b);
  if (fr) snprintf(b, sizeof(b), "%c %.2f", gFeltF >= 0 ? 'F' : 'A', fabsf(gFeltF)); else strcpy(b, "--");
  printAt(68, 20, b);
  if (fr) snprintf(b, sizeof(b), "V %.2f", gVert); else strcpy(b, "--");
  printAt(68, 29, b);
  snprintf(b, sizeof(b), "ring %.1fg", ring);
  printAt(68, 40, b);
  // vertical g bar: 0.5 ... 1.5 g, tick at 1 g, peak min / max ticks
  const int bx0 = 68, bx1 = 126, by = 54;
  display.drawRect(bx0, by, bx1 - bx0 + 1, 7, SH110X_WHITE);
  auto vx = [&](float g) { return bx0 + (int)lroundf(constrain((g - 0.5f), 0.0f, 1.0f) * (bx1 - bx0)); };
  display.drawLine(vx(1.0f), by - 2, vx(1.0f), by + 8, SH110X_WHITE);
  display.drawLine(vx(gPkLo), by + 1, vx(gPkLo), by + 5, SH110X_WHITE);
  display.drawLine(vx(gPkHi), by + 1, vx(gPkHi), by + 5, SH110X_WHITE);
  if (fr) display.fillRect(min(vx(1.0f), vx(gVert)), by + 2, abs(vx(gVert) - vx(1.0f)) + 1, 3, SH110X_WHITE);
}

// Tilt ball: moved every loop pass (the frame rate does not change how it rolls)
// the best is kept in EEPROM, written when a stay in the ring ends (not while it runs)
uint32_t ballBestMs(uint32_t now) {
  uint32_t b = P.ballBest10 * 100UL, r = ballInMs ? now - ballInMs : 0;
  return r > b ? r : b;
}
void ballEndStay(uint32_t now) {
  if (!ballInMs) return;
  uint32_t r = (now - ballInMs) / 100;
  ballInMs = 0;
  if (r > P.ballBest10) { P.ballBest10 = r > 65535 ? 65535 : (uint16_t)r; markPersistDirty(false); }
}
void serviceBall(uint32_t now) {
  if (screen != SCREEN_BALL || loggerMode || P.imuOff) { ballEndStay(now); ballMs = 0; return; }
  if (!ballMs) {                                         // just picked: start in the middle
    ballX = ballY = 31.5f; ballVx = ballVy = 0; ballInMs = 0; ballTrN = 0; ballArmed = false;
    ballMs = now; return;
  }
  float dt = (now - ballMs) / 1000.0f;
  ballMs = now;
  if (dt > 0.1f) dt = 0.1f;
  if (!imuFresh()) { ballEndStay(now); return; }         // no IMU: held where it is
  // Roll and pitch are ship axes; the OLED can sit any way round to the bow on a given build. The Displays card's
  // Turn ball 90 deg turns the ball's frame a quarter at a time (default one quarter clockwise from
  // starboard = right); Flip adds a half turn.
  float gr = BALL_G * sinf(roll * D2R), gp = BALL_G * sinf(pitch * D2R);   // starboard down, bow up
  float ax, ay;
  switch ((P.ballRot + 1 + (P.oledFlip ? 2 : 0)) & 3) {  // screen x right, y down
    case 0:  ax = gr;  ay = gp;  break;                  // starboard right, bow up rolls down
    case 1:  ax = -gp; ay = gr;  break;
    case 2:  ax = -gr; ay = -gp; break;
    default: ax = gp;  ay = -gr; break;
  }
  if (fabsf(ax) < 4 && fabsf(ay) < 4 && ballVx * ballVx + ballVy * ballVy < 9) { ballVx = ballVy = 0; ax = ay = 0; }   // at rest under 0.4 deg
  float damp = 1.0f - 1.2f * dt;                         // rolling friction
  ballVx = (ballVx + ax * dt) * damp;
  ballVy = (ballVy + ay * dt) * damp;
  ballX += ballVx * dt; ballY += ballVy * dt;
  const float lo = 1 + BALL_R, hi = 62 - BALL_R;         // inside the box's 1-px wall
  if (ballX < lo) { ballX = lo; ballVx = -ballVx * 0.5f; } else if (ballX > hi) { ballX = hi; ballVx = -ballVx * 0.5f; }
  if (ballY < lo) { ballY = lo; ballVy = -ballVy * 0.5f; } else if (ballY > hi) { ballY = hi; ballVy = -ballVy * 0.5f; }
  float dx = ballX - 31.5f, dy = ballY - 31.5f;
  bool in = dx * dx + dy * dy <= (float)((BALL_RING - BALL_R) * (BALL_RING - BALL_R)) + 1.0f;
  if (!in) { ballEndStay(now); ballArmed = true; }
  else if (ballArmed && !ballInMs) ballInMs = now ? now : 1;
}

void drawBall() {
  display.drawRect(0, 0, 64, 64, SH110X_WHITE);
  for (int a = 0; a < 360; a += 30) {                    // a dotted outer ring, and the centre ring
    float r = a * D2R;
    display.drawPixel(31 + (int)lroundf(sinf(r) * 16), 31 - (int)lroundf(cosf(r) * 16), SH110X_WHITE);
  }
  bool in = ballInMs != 0;
  display.drawCircle(31, 31, BALL_RING, SH110X_WHITE);
  for (int k : {0, 63}) { display.drawLine(31, k ? 59 : 4, 31, k ? 62 : 1, SH110X_WHITE); display.drawLine(k ? 59 : 4, 31, k ? 62 : 1, 31, SH110X_WHITE); }   // edge ticks
  int bx = (int)floorf(ballX), by = (int)floorf(ballY);
  ballTx[ballTrHead] = (int8_t)bx; ballTy[ballTrHead] = (int8_t)by;   // trail: one point a frame
  ballTrHead = (ballTrHead + 1) % BALL_TRAIL;
  if (ballTrN < BALL_TRAIL) ballTrN++;
  for (int i = 0; i < ballTrN; i++) display.drawPixel(ballTx[i], ballTy[i], SH110X_WHITE);
  display.fillCircle(bx, by, BALL_R, SH110X_WHITE);
  if (in) display.drawCircle(bx, by, BALL_R + 2, SH110X_WHITE);       // a halo while it is in
  char b[24];
  printAt(65, 0, "TILT BALL");
  bool imu = !P.imuOff && imuFresh();
  if (!imu) { printAt(68, 14, P.imuOff ? "IMU off" : "No IMU"); printAt(68, 23, "data"); return; }
  snprintf(b, sizeof(b), "R %c%4.1f", fabsf(roll) < 0.05f ? ' ' : roll > 0 ? 'S' : 'P', fminf(fabsf(roll), 99.9f));      printAt(68, 12, b);
  snprintf(b, sizeof(b), "P %c%4.1f", fabsf(pitch) < 0.05f ? ' ' : pitch > 0 ? 'U' : 'D', fminf(fabsf(pitch), 99.9f));  printAt(68, 21, b);
  uint32_t t = ballInMs ? millis() - ballInMs : 0;
  snprintf(b, sizeof(b), "In %5.1fs", fminf(t / 1000.0f, 999.9f));          printAt(68, 34, b);
  snprintf(b, sizeof(b), "Best%5.1fs", fminf(ballBestMs(millis()) / 1000.0f, 999.9f)); printAt(68, 43, b);
  printAt(68, 56, in ? "HOLD IT!" : ballArmed ? "to centre" : "tilt me");
}

// Cast (OLED screen 18)
void fmtDur(char* o, size_t n, long t) {                 // m:ss, or h:mm:ss from an hour
  t = constrain(t, 0L, 359999L);
  if (t >= 3600) snprintf(o, n, "%ld:%02ld:%02ld", t / 3600, t / 60 % 60, t % 60); else snprintf(o, n, "%ld:%02ld", t / 60, t % 60);
}
void fmtDrift(char* o, size_t n, float m) {
  if (isnan(m)) strlcpy(o, "--", n);
  else if (m < 1852) snprintf(o, n, "%d%s", (int)lroundf(lShow(m)), lUnit());   // ft or m, nm from a mile
  else if (m < 100 * 1852) snprintf(o, n, "%.2f%s", dShow(m / 1852), dUnit());
  else snprintf(o, n, ">%d%s", (int)dShow(99), dUnit());
}
void drawCast() {
  CastOled C;
  portENTER_CRITICAL(&markOledMux); C = castOled; portEXIT_CRITICAL(&markOledMux);
  char b[40], d[16], e[16];
  if (!C.n || !C.open) {
    printAt(0, 0, "NO CAST OPEN");
    display.drawFastHLine(0, 9, 128, SH110X_WHITE);
    if (C.n) {
      snprintf(b, sizeof(b), "Last: cast %u at %s", C.n, C.hm); printAt(0, 14, b);
      fmtDur(d, sizeof(d), isnan(C.durS) ? -1 : lroundf(C.durS));
      if (isnan(C.durS)) strlcpy(d, "--", sizeof(d));
      fmtDrift(e, sizeof(e), C.driftM);
      snprintf(b, sizeof(b), "%s, drift %s", d, e); printAt(0, 24, b);
    }
    printCentered(46, "Hold Mark 1.5 s");
    printCentered(55, "to start a cast");
    return;
  }
  snprintf(b, sizeof(b), "CAST %u  start %s", C.n, C.hm);
  printAt(0, 0, b);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  char src; uint32_t u = utcNow(src);
  long t = C.unix && u ? (long)(u - C.unix) : C.startMs ? (long)((millis() - C.startMs) / 1000) : -1;
  if (t >= 0) fmtDur(d, sizeof(d), t); else strlcpy(d, "--:--", sizeof(d));
  display.setTextSize(2);
  printCentered(14, d);
  display.setTextSize(1);
  bool now = gpsFixValid();
  if (C.fix && now) {
    float m = markDist(C.latE7, C.lonE7, gps.latE7, gps.lonE7);
    fmtDrift(e, sizeof(e), m);
    if (m >= 1) snprintf(b, sizeof(b), "Drift %s %03dT", e, (int)lroundf(markBrg(C.latE7, C.lonE7, gps.latE7, gps.lonE7)) % 360);
    else snprintf(b, sizeof(b), "Drift %s", e);
  } else strlcpy(b, C.fix ? "Drift --  (no fix now)" : "Drift --  (no start fix)", sizeof(b));
  printAt(0, 34, b);
  if (now && !isnan(sogAvgKn)) {
    if (!isnan(cogAvgDeg)) snprintf(b, sizeof(b), "SOG %.1f%s COG %03dT", sShow(sogAvgKn), sUnit(), (int)lroundf(cogAvgDeg) % 360);
    else snprintf(b, sizeof(b), "SOG %.1f%s", sShow(sogAvgKn), sUnit());
  } else strlcpy(b, "SOG --", sizeof(b));
  if (!slmCastLine(b, sizeof(b))) { printAt(0, 44, b); printAt(0, 56, "Hold Mark 1.5 s: stop"); }
  else { printAt(0, 44, b); printAt(0, 56, "WTB Start btn: stop"); }   // a cast from the IWB
}

// Recording (OLED screen 19)
void drawRec() {
  char b[36], d[16];
  static char name[40] = "";
  if (sdLock(0)) {                                       // else the last one read
    strlcpy(name, logName[0] ? logName + 1 : "", sizeof(name));
    char* x = strstr(name, ".csv"); if (x) *x = 0;
    sdUnlock();
  }
  if (logging) {
    fmtDur(d, sizeof(d), (long)((millis() - logStartMs) / 1000));
    snprintf(b, sizeof(b), "%s %s", paused ? "PAUSED" : "REC", d);
  } else strlcpy(b, logWanted ? "Starting..." : "Not recording", sizeof(b));
  printAt(0, 0, b);
  if (logging && !paused && (millis() / 500) % 2) display.fillCircle(6 * (int)strlen(b) + 3, 3, 3, SH110X_WHITE);   // blinking dot (after the text)
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  if (!sdOK) { printAt(0, 14, "microSD: not working"); return; }
  if (!logging) {                                         // or with the screen button's hold
    printAt(0, 14, "Start it on the"); printAt(0, 23, "dashboard: Recording,");
    printAt(0, 34, "or hold the screen");
    snprintf(b, sizeof(b), "button: knob at %d/%d", hgPos(HG_REC) + 1, hgCount()); printAt(0, 43, b);
    snprintf(b, sizeof(b), "(%d-%d%%), then yes", hgTop(hgPos(HG_REC) - 1) + 1, hgTop(hgPos(HG_REC))); printAt(0, 52, b);
    return;
  }
  display.setFont(&TomThumb);                             // the file in 4 x 6: 32 characters
  printAt(0, 17, name[0] ? name : "(no file)");
  display.setFont();
  float mb = (float)((double)logBytes / 1048576.0);
  snprintf(b, sizeof(b), "Rows %lu", (unsigned long)logRows); printAt(0, 20, b);
  if (mb < 1000) snprintf(b, sizeof(b), "%.1fMB", mb); else snprintf(b, sizeof(b), "%.2fGB", mb / 1024);
  printAt(128 - 6 * (int)strlen(b), 20, b);
  uint32_t lm = logMs();
  if (lm < 1000) snprintf(b, sizeof(b), "Rate %lu Hz", (unsigned long)(1000 / lm)); else snprintf(b, sizeof(b), "Every %lu s", (unsigned long)(lm / 1000));
  printAt(0, 29, b);
  snprintf(b, sizeof(b), "Gaps %lu", (unsigned long)rowGaps);
  if (rowGaps) { size_t l = strlen(b); snprintf(b + l, sizeof(b) - l, " worst %.1fs", rowGapMax / 1000.0f); }
  printAt(0, 38, b);
  snprintf(b, sizeof(b), "Dropped %lu Rewrite %lu", (unsigned long)pendDropped, (unsigned long)sdRewrites);
  printAt(0, 47, b);
  snprintf(b, sizeof(b), "Check fails %lu", (unsigned long)sdChkFails);
  printAt(0, 56, b);
}

// ---- Screen 11: the wave spectra (as the Waves card): roll, pitch and heave against period on a
// log axis, 2-35 s (bins 1/128 Hz, straight lines between them). Roll and pitch on one scale
// (both deg^2/Hz, so their heights compare; the larger one's legend label is boxed), heave on its own.
// Header: the heave Hs, the roll peak and the pitch peak.
#define WVO_P0 2.0f                   // 2-35 s, as the Waves card (4-30 s before)
#define WVO_P1 35.0f
// The heave Hs the screens show, as the Waves card: at midships when the VMR's position is in
// the Level zero and ship data card, else at the VMR. tz = its peak period, mid = true for the midships one.
float wvHsShown(float& tz, bool& mid) {
  mid = !isnan(wvHsMid);
  tz = mid ? wvTzMid : wvTz;
  return mid ? wvHsMid : wvHs;
}

void drawWaves() {
  char t[24];
  float hsTz; bool hsMid;
  float hs = wvHsShown(hsTz, hsMid);
  bool have = wvSpec && wvLastMs && !isnan(wvTe) && !isnan(wvTrs);   // current, or the last one (marked OLD)
  // the heave Hs (VH at the VMR, MH at midships) in ft or m, the roll peak (RP) and pitch peak (PP) periods
  if (!have) strcpy(t, "WAVES");
  else {
    char h[10];
    float hv = isnan(hs) ? NAN : lShow(hs);
    if (isnan(hv)) strcpy(h, "--"); else if (hv < 9.95f) snprintf(h, sizeof(h), "%.1f%s", hv, lUnit()); else snprintf(h, sizeof(h), "%.0f%s", fminf(hv, 999), lUnit());
    float rp = fminf(wvTrs, 99.9f), pp = fminf(wvTe, 99.9f);
    snprintf(t, sizeof(t), "%s%s RP%.1f PP%.1f", hsMid ? "MH" : "VH", h, rp, pp);
    if (6 * (int)strlen(t) > scrNumX() - 3 && pp >= 9.95f)        // clear of the number - a period of 10 s or more
      snprintf(t, sizeof(t), "%s%s RP%.1f PP%.0f", hsMid ? "MH" : "VH", h, rp, pp);   // whole, the pitch one first
    if (6 * (int)strlen(t) > scrNumX() - 3 && rp >= 9.95f)
      snprintf(t, sizeof(t), pp >= 9.95f ? "%s%s RP%.0f PP%.0f" : "%s%s RP%.0f PP%.1f", hsMid ? "MH" : "VH", h, rp, pp);
  }
  printAt(0, 0, t);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);                // the rule, as the other screens
  if (!have) {                                                   // why there is nothing yet
    if (P.imuOff) { printCentered(26, "IMU off: pressure"); printCentered(36, "only, on Wave stats"); return; }   // no spectra without the motion
    if (P.atDock) strcpy(t, "Off at the dock");
    else if (paused) strcpy(t, "Paused");
    else snprintf(t, sizeof(t), "%.1f / %.1f min", wvN * WV_DT_MS / 60000.0f, WV_MIN * WV_DT_MS / 60000.0f);
    printCentered(26, t);
    if (!P.atDock && !paused) printCentered(36, "of steady motion");
    return;
  }
  const int y0 = 20, y1 = 53, xr = 127;                          // curves; legend above (under the rule), axis below
  const float kPerHz = WV_SEG * (WV_DT_MS / 1000.0f);            // bin number = f x this
  float pk[3] = {0, 0, 0};                                       // each one's peak in the window
  for (int q2 = 0; q2 < 3; q2++)
    for (int k = WV_K0; k <= WV_K1; k++) { float p = kPerHz / k; if (p >= WVO_P0 && p <= WVO_P1 && wvSpec[q2][k] > pk[q2]) pk[q2] = wvSpec[q2][k]; }
  // the period axis fits the data: 2 s either side of the periods where any curve is at least 5 % of its own
  // peak, in whole seconds, inside 2-35 s, at least 4 s wide (log scale)
  float a0 = WVO_P0, a1 = WVO_P1;
  {
    float lo = WVO_P1, hi = WVO_P0;
    for (int q2 = 0; q2 < 3; q2++) {
      if (!(pk[q2] > 0)) continue;
      for (int k = WV_K0; k <= WV_K1; k++) { float p = kPerHz / k; if (p >= WVO_P0 && p <= WVO_P1 && wvSpec[q2][k] >= 0.05f * pk[q2]) { lo = fminf(lo, p); hi = fmaxf(hi, p); } }
    }
    if (lo <= hi) { a0 = fmaxf(WVO_P0, floorf(lo - 2)); a1 = fminf(WVO_P1, ceilf(hi + 2)); }
    while (a1 - a0 < 4) { if (a0 > WVO_P0) a0 -= 1; if (a1 < WVO_P1) a1 += 1; }
  }
  auto xOf = [&](float p) { return (int)lroundf(xr * logf(p / a0) / logf(a1 / a0)); };
  display.drawFastHLine(0, y1 + 1, 128, SH110X_WHITE);
  static const uint8_t TICK[] = {2, 3, 4, 5, 6, 7, 8, 9, 10, 12, 15, 20, 25, 30, 35};
  for (uint8_t p : TICK) if (p >= a0 && p <= a1) display.drawFastVLine(min(xOf(p), 127), y1 + 2, 1, SH110X_WHITE);
  // labels: the two ends (the left one with "s"), then the rounder periods where they fit (3 px apart)
  int LX[10], LW[10], nL = 0;
  auto lab = [&](int p, int where) {                             // where: -1 left end, 1 right end, 0 under its tick
    char b[6]; snprintf(b, sizeof(b), where < 0 ? "%ds" : "%d", p);
    int w = 6 * (int)strlen(b) - 1, x = where < 0 ? 0 : where > 0 ? 128 - w : xOf(p) - w / 2;
    x = constrain(x, 0, 128 - w);
    for (int i = 0; i < nL; i++) if (x < LX[i] + LW[i] + 3 && x + w + 3 > LX[i]) return;
    if (nL >= 10) return;
    display.drawFastVLine(min(xOf(p), 127), y1 + 2, 2, SH110X_WHITE);
    printAt(x, 57, b); LX[nL] = x; LW[nL] = w; nL++;
  };
  lab((int)a0, -1); lab((int)a1, 1);
  static const uint8_t LAB[] = {5, 10, 20, 30, 15, 3, 4, 6, 8, 12, 25, 7, 9};
  for (uint8_t p : LAB) if (p > a0 && p < a1) lab(p, 0);
  int dom = pk[2] >= pk[1] ? 2 : 1;                              // the larger of roll and pitch
  int kTop = 0;                                                   // the strongest one's peak bin
  for (int k = WV_K0; k <= WV_K1; k++) { float p = kPerHz / k; if (p >= WVO_P0 && p <= WVO_P1 && (!kTop || wvSpec[dom][k] > wvSpec[dom][kTop])) kTop = k; }
  const float kStep = powf(a0 / a1, 1.0f / xr);                   // the bin of column x+1 = that of x times this
  for (int q2 = 0; q2 < 3; q2++) {                               // 0 heave, 1 pitch, 2 roll
    const float* S = wvSpec[q2];
    float mx = q2 == 0 ? pk[0] : fmaxf(pk[1], pk[2]);
    if (!(mx > 0) || !(pk[q2] > 0)) continue;
    int py = -1;
    float kf = kPerHz / a0;                                      // column 0: the axis' left end
    for (int x = 0; x <= xr; x++, kf *= kStep) {
      int k = (int)kf; float fr = kf - k;
      if (k < WV_KSEND || k + 1 > WV_K1) { py = -1; continue; }   // (k = 3, 43 s, carries the curves to 35 s)
      float v = (S[k] + fr * (S[k + 1] - S[k])) / mx;
      int y = y1 - (int)lroundf(constrain(v, 0.0f, 1.0f) * (y1 - y0));
      if (q2 == 0) { if (x % 3 == 0) display.drawPixel(x, y, SH110X_WHITE); }          // heave: dotted
      else {
        if (py >= 0) display.drawLine(x - 1, py, x, y, SH110X_WHITE);
        if (q2 == 2 && py >= 0) display.drawLine(x - 1, py - 1, x, y - 1, SH110X_WHITE); // roll: 2 px
      }
      py = y;
    }
  }
  // a dotted line down the strongest peak, its period in a box under it (moving with it): Tr or Te,
  // as the header, or the bin itself when that is missing
  float pPk = dom == 2 ? wvTrs : wvTe;
  if (!(pPk >= WVO_P0 && pPk <= WVO_P1) && kTop) pPk = kPerHz / kTop;
  if (pPk >= a0 && pPk <= a1) {
    int xp = constrain(xOf(pPk), 0, 127);
    for (int y = y0; y <= y1; y += 2) display.drawPixel(xp, y, SH110X_WHITE);
    char pl[8]; snprintf(pl, sizeof(pl), "%.1fs", pPk);
    int w = 6 * (int)strlen(pl) + 1, lx = constrain(xp - w / 2, 0, 128 - w);
    for (int i = 0; i < nL; i++)                                  // a label the box would touch goes (no half labels)
      if (LX[i] < lx + w + 2 && LX[i] + LW[i] > lx - 2) display.fillRect(LX[i], 57, LW[i] + 1, 7, SH110X_BLACK);
    display.fillRect(lx, 56, w, 8, SH110X_WHITE);
    display.setTextColor(SH110X_BLACK); printAt(lx + 1, 57, pl); display.setTextColor(SH110X_WHITE);
  }
  display.setFont(&TomThumb);                                    // legend, top right
  if (!wvCurrent) {                                              // the last estimate: how old, top left
    uint32_t a = (millis() - wvLastMs) / 1000;
    if (a < 3600) snprintf(t, sizeof(t), "OLD %lu:%02lu", (unsigned long)(a / 60), (unsigned long)(a % 60));
    else snprintf(t, sizeof(t), "OLD %luh%02lu", (unsigned long)(a / 3600), (unsigned long)(a / 60 % 60));
    printAt(0, 17, t);
  }
  display.drawFastHLine(44, 14, 6, SH110X_WHITE); display.drawFastHLine(44, 15, 6, SH110X_WHITE); printAt(52, 17, "roll");   // 2 px
  display.drawFastHLine(70, 14, 6, SH110X_WHITE); printAt(78, 17, "pitch");                                                   // lower (the rule)
  if (pk[dom] > 0) { if (dom == 2) display.drawRect(50, 11, 19, 8, SH110X_WHITE); else display.drawRect(76, 11, 22, 8, SH110X_WHITE); }   // the larger, boxed
  for (int x = 99; x <= 105; x += 3) display.drawPixel(x, 14, SH110X_WHITE);
  printAt(108, 17, "heave");
  display.setFont();
}

// ---- Screen 12: the Waves card's numbers and the state of the analysis.
void drawWaveStats() {
  char t[32];
  bool have = wvLastMs && !isnan(wvTe) && !isnan(wvTrs);
  bool haveB = wvLastMs && wvAnBOnly && !isnan(wvHsB);         // the pressure alone (IMU off)
  printAt(0, 0, "WAVE STATS");
  if ((have || haveB) && wvCurrent) strcpy(t, "LIVE");
  else if (have || haveB) {
    uint32_t a = (millis() - wvLastMs) / 1000;
    if (a < 3600) snprintf(t, sizeof(t), "OLD %lu:%02lu", (unsigned long)(a / 60), (unsigned long)(a % 60));
    else snprintf(t, sizeof(t), "OLD %luh%02lu", (unsigned long)(a / 3600), (unsigned long)(a / 60 % 60));
  } else strcpy(t, "--");
  printAt(hdrRightX(t), 0, t);
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  auto v1 = [](char* o, size_t n, float x) { if (isnan(x)) snprintf(o, n, "  -- "); else snprintf(o, n, "%4.1fs", x); };   // 5 wide
  char a[8], b[8];
  v1(a, sizeof(a), have ? wvTe : NAN); snprintf(t, sizeof(t), "Pitch pk %s", a); printAt(0, 11, t);   // the encounter period
  v1(a, sizeof(a), have ? wvTrs : NAN); snprintf(t, sizeof(t), "Roll pk  %s", a); printAt(0, 20, t);
  float hsTz; bool hsMid;
  float hs = wvHsShown(hsTz, hsMid);
  if (have && !isnan(hs)) {                                   // "mid" = at midships, "VMR" = at the VMR (as the Waves card)
    v1(b, sizeof(b), hsTz);
    float hv = lShow(hs);                                     // ft or m
    snprintf(t, sizeof(t), hv < 9.995f ? "Hs %.2f%s %s pk%s" : "Hs %.1f%s %s pk%s", hv, lUnit(), hsMid ? "mid" : "VMR", b);
  }
  else if (haveB) { float hv = lShow(wvHsB); v1(b, sizeof(b), wvTzB); snprintf(t, sizeof(t), hv < 9.995f ? "P raw %.2f%s pk%s" : "P raw %.1f%s pk%s", hv, lUnit(), b); }
  else strcpy(t, "Hs  --");
  printAt(0, 29, t);
  float hb = hsMid ? wvHsBMid : wvHsB;                         // the pressure heave, at the same place
  if (haveB) {                                                 // pressure only: corrected by the stored gain
    if (isnan(wvHsBc)) strcpy(t, "P cor  -- no gain yet");
    else {
      float hv = lShow(wvHsBc);
      int n = snprintf(t, sizeof(t), hv < 9.995f ? "P cor %.2f%s" : "P cor %.1f%s", hv, lUnit());
      if (wvGk && !isnan(wvGk->agg)) snprintf(t + n, sizeof(t) - n, " x%.2f", wvGk->agg);
    }
  }
  else if (have && !isnan(hb)) { float hv = lShow(hb); snprintf(t, sizeof(t), hv < 9.995f ? "P Hs %.2f%s %s" : "P Hs %.1f%s %s", hv, lUnit(), hsMid ? "mid" : "VMR"); }
  else strcpy(t, "P Hs  --");
  printAt(0, 38, t);
  float felt = rStat[0].n >= 3 ? rStat[0].tMed : NAN;          // as the GPS & motion card, over 10 min
  v1(a, sizeof(a), felt); snprintf(t, sizeof(t), "Felt roll %s 10m", a); printAt(0, 47, t);
  uint32_t now = millis();                                     // bottom: the state of the analysis (P: the pressure alone, IMU off)
  if (P.imuOff && loggerMode && logging && logMs() >= LOGGER_SLEEP_MIN_MS) strcpy(t, "P: Datalogger sleeps");
  else if (P.atDock) strcpy(t, "Off at the dock");
  else if (paused) strcpy(t, "Paused");
  else if (wvN < WV_MIN) {
    uint32_t left = (uint32_t)(WV_MIN - wvN) * WV_DT_MS / 1000;
    snprintf(t, sizeof(t), P.imuOff ? "P only, %lu:%02lu left" : "Collecting %lu:%02lu left", (unsigned long)(left / 60), (unsigned long)(left % 60));
  } else {
    uint32_t el = (now - wvCalcMs) / 1000, nx = el < 30 ? 30 - el : 0;
    snprintf(t, sizeof(t), P.imuOff ? "P %.1fmin, next 0:%02lu" : "%.1fmin, next 0:%02lu", (wvN < WV_N ? wvN : WV_N) * WV_DT_MS / 60000.0f, (unsigned long)nx);
  }
  printAt(0, 56, t);
}

// ---- Screen 13: the phones / laptops on the hotspot (the System card's list), newest first.
void drawDevices() {
  DevSeen d[DEV_N];
  uint8_t n = 0;
  portENTER_CRITICAL(&devMux);
  if (devs) { memcpy(d, devs, sizeof(d)); n = devCount; }
  portEXIT_CRITICAL(&devMux);
  int on = 0;
  for (int i = 0; i < n; i++) if (d[i].on) on++;
  char t[32];
  printAt(0, 0, "WI-FI DEVICES");
  snprintf(t, sizeof(t), "%d on", on);
  printAt(hdrRightX(t), 0, t);
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  if (!n) { printCentered(28, "None since boot"); return; }
  for (int i = 0; i < n; i++) {
    int y = 11 + 9 * i;
    if (d[i].on) display.fillCircle(2, y + 3, 2, SH110X_WHITE); else display.drawCircle(2, y + 3, 2, SH110X_WHITE);
    char nm[24];
    if (d[i].name[0]) snprintf(nm, sizeof(nm), "%s", d[i].name);
    else snprintf(nm, sizeof(nm), "%s %02X%02X%02X", d[i].kind[0] ? d[i].kind : "Device", d[i].mac[3], d[i].mac[4], d[i].mac[5]);
    nm[14] = 0;                                                // the time keeps its place
    printAt(8, y, nm);
    uint32_t u = d[i].on ? d[i].onUnix : d[i].offUnix;
    if (u) { DateTime lt(ltOf(u)); snprintf(t, sizeof(t), "%02u:%02u", (unsigned)lt.hour(), (unsigned)lt.minute()); }
    else {                                                     // no clock yet: how long ago
      uint32_t ago = (millis() - (d[i].on ? d[i].onMs : d[i].offMs)) / 60000;
      snprintf(t, sizeof(t), ago < 100 ? "%2lum" : ">99m", (unsigned long)ago);
    }
    printAt(128 - 6 * (int)strlen(t), y, t);
  }
  static uint32_t staMs = 0;                                   // signal of those on (as screen 3), every 2 s
  static int staN = 0, staWorst = 0;
  if (!staMs || millis() - staMs > 2000) {
    staMs = millis();
    wifi_sta_list_t sl;
    staN = 0; staWorst = 0;
    if (esp_wifi_ap_get_sta_list(&sl) == ESP_OK) {
      staN = sl.num;
      for (int i = 0; i < sl.num; i++) if (!i || sl.sta[i].rssi < staWorst) staWorst = sl.sta[i].rssi;
    }
  }
  if (staN) { snprintf(t, sizeof(t), "weakest %d dBm", staWorst); printAt(0, 47, t); }
  display.fillCircle(2, 59, 2, SH110X_WHITE); printAt(8, 56, "joined");
  display.drawCircle(56, 59, 2, SH110X_WHITE); printAt(62, 56, "left (LT)");
}

static int deg360(float v) { int k = (int)lroundf(v) % 360; return k < 0 ? k + 360 : k; }
// ---- Weather screens ----
static const uint16_t WX_SPAN_S[4] = {1200, 300, 3600, 10800};   // P.wxSpan; 0 = 20 min, the card's default
uint16_t wxSpanS() { return WX_SPAN_S[P.wxSpan < 4 ? P.wxSpan : 0]; }
int8_t wxSpanIdx(long s) { for (int8_t i = 0; i < 4; i++) if (WX_SPAN_S[i] == s) return i; return -1; }

void drawWx() {
  char t[24];
  printAt(0, 0, "WEATHER");
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  if (!wxOn()) { printCentered(24, "BMP388 / SHT off"); printCentered(36, "(Add-ons)"); return; }
  int y = 11;
  if (extOn(EXT_BMP)) {
    if (havePres() && !isnan(extPa)) {
      float mb = extPa / 100.0f, td = presTendency();
      snprintf(t, sizeof(t), "Pres  %6.1f mbar", mb); printAt(0, y, t); y += 9;
      snprintf(t, sizeof(t), "      %6.2f inHg", mb * 0.02953f); printAt(0, y, t); y += 9;
      if (isnan(td)) snprintf(t, sizeof(t), "3 h   -- (3h05 needed)");
      else snprintf(t, sizeof(t), "3 h %+5.1f mbar %s", td, fabsf(td) < 0.5f ? "steady" : td > 0 ? "up" : "down");
      printAt(0, y, t); y += 9;
    } else { printAt(0, y, "Pres  not answering"); y += 9; }
  }
  if (extOn(EXT_SHT)) {
    if (haveSht() && !isnan(extTa) && !isnan(extRh)) {
      snprintf(t, sizeof(t), "Air   %5.1f%c%s", tShow(extTa), tUnit(), shtHeatSt == 1 ? " heating" : shtHeatSt == 2 ? " settling" : "");
      printAt(0, y, t); y += 9;   // F or C; the SHT's heater on, or the sensor coming back from it
      float dp = NAN;
      if (extRh > 0) { float g = logf(extRh / 100) + 17.62f * extTa / (243.12f + extTa); dp = 243.12f * g / (17.62f - g); }
      if (isnan(dp)) snprintf(t, sizeof(t), "RH    %3d%%", (int)lroundf(extRh));
      else snprintf(t, sizeof(t), "RH    %3d%%  dew %3d%c", (int)lroundf(extRh), (int)lroundf(tShow(dp)), tUnit());
      printAt(0, y, t);
    } else printAt(0, y, "Air   not answering");
  }
}

// Pressure, temperature and humidity strips over the Weather card's span. Each pixel column is the
// mean of the readings in its slice of time; an empty slice leaves a gap (nothing is drawn across).
void drawWxGraph() {
  char t[24];
  uint16_t span = wxSpanS();
  printAt(0, 0, "WEATHER GRAPH");
  snprintf(t, sizeof(t), span < 3600 ? "%u min" : "%u h", (unsigned)(span < 3600 ? span / 60 : span / 3600));
  printAt(hdrRightX(t), 0, t);
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  int8_t ks[3]; int np = 0;
  if (extOn(EXT_BMP)) ks[np++] = 0;
  if (extOn(EXT_SHT)) { ks[np++] = 1; ks[np++] = 2; }
  if (!np) { printCentered(24, "BMP388 / SHT off"); printCentered(36, "(Add-ons)"); return; }
  bool fine = span <= 1200;
  const WxPt* ring = fine ? wxFine : wxCoarse;
  int ringN = fine ? WX_FINE_N : WX_COARSE_N, have = fine ? wxFineN : wxCoarseN, head = fine ? wxFineHead : wxCoarseHead;
  int dt = fine ? WX_FINE_S : WX_COARSE_S;
  int n = ring ? min((int)(span / dt), have) : 0;
  const int gx0 = 31, cols = 128 - gx0, top = 10, H = 64 - top, ph = H / np;
  GraphScratch* gs = GraphScratch::get(); if (!gs) return;
  float* cv = gs->cv;
  for (int q = 0; q < np; q++) {
    int k = ks[q], y0 = top + q * ph, y1 = y0 + ph - 2;
    for (int c = 0; c < cols; c++) cv[c] = NAN;
    float* cs = gs->cs; uint8_t* cn = gs->cn;
    for (int c = 0; c < cols; c++) { cs[c] = 0; cn[c] = 0; }
    for (int i = 0; i < n; i++) {                      // i = how many back from the newest
      const WxPt& w = ring[(head - 1 - i + 2 * ringN) % ringN];
      float v = k == 0 ? w.p : k == 1 ? tShow(w.t) : w.h;   // F or C
      if (isnan(v)) continue;
      int c = cols - 1 - (int)((long)i * dt * cols / span);
      if (c < 0) continue;
      cs[c] += v; cn[c]++;
    }
    float lo = INFINITY, hi = -INFINITY;
    for (int c = 0; c < cols; c++) if (cn[c]) { cv[c] = cs[c] / cn[c]; lo = fminf(lo, cv[c]); hi = fmaxf(hi, cv[c]); }
    char nm = k == 0 ? 'P' : k == 1 ? 'T' : 'H';
    if (lo > hi) { snprintf(t, sizeof(t), "%c  --", nm); printAt(0, y0, t); continue; }
    float ms = k == 0 ? 1 : k == 1 ? 1 : 2;           // the smallest span shown (mbar, F, %): noise stays small
    int a = (int)floorf(lo), b = (int)ceilf(hi);
    while (b - a < ms) { b++; if (b - a < ms) a--; }
    snprintf(t, sizeof(t), "%c%4d", nm, b); printAt(0, y0, t);
    snprintf(t, sizeof(t), " %4d", a); printAt(0, y1 - 7, t);
    display.drawFastVLine(gx0 - 1, y0, y1 - y0 + 1, SH110X_WHITE);
    if (q < np - 1) for (int x = gx0; x < 128; x += 3) display.drawPixel(x, y1 + 1, SH110X_WHITE);   // (not under the labels)
    int py = -1;
    for (int c = 0; c < cols; c++) {
      if (isnan(cv[c])) { py = -1; continue; }
      int yy = y1 - (int)lroundf((cv[c] - a) * (y1 - y0) / (float)(b - a));
      if (py >= 0) display.drawLine(gx0 + c - 1, py, gx0 + c, yy, SH110X_WHITE); else display.drawPixel(gx0 + c, yy, SH110X_WHITE);
      py = yy;
    }
  }
}

// ---- Screen 14: true wind, live (the last 1-s mean), with the 2-min mean and the apparent
// wind. Without a GPS fix (no true wind) it shows the apparent wind instead, and says so.
void drawWind() {
  char t[32];
  if (!windActive()) { printAt(0, 0, "WIND"); display.drawFastHLine(0, 8, 128, SH110X_WHITE); printCentered(24, "Wind meter off"); printCentered(36, "(Add-ons)"); return; }
  bool f = windFresh();
  float aa = f && !isnan(windS1) ? windA1 : f ? windAwa : NAN, as = f && !isnan(windS1) ? windS1 : f ? windAwsKn : NAN;
  float tr, td, tk;
  windTrue(aa, as, tr, td, tk);
  bool tru = !isnan(tk);
  printAt(0, 0, tru ? "TRUE WIND" : "APPARENT WIND");
  if (windMcOn && f) printAt(hdrRightX("MC"), 0, "MC");        // motion corrected
  display.drawFastHLine(0, 8, 128, SH110X_WHITE);
  if (!f) { printCentered(28, windLocked ? "No wind data" : "Wind meter: no data"); return; }
  float sp = tru ? tk : as, dir = tru ? (isnan(td) ? tr : td) : aa;
  bool compass = tru && !isnan(td);                              // N up; else bow up
  display.setTextSize(3);
  if (!isnan(sp)) sp = sShow(sp);
  if (isnan(sp)) strcpy(t, "--"); else snprintf(t, sizeof(t), sp < 99.95f ? "%.1f" : "%.0f", sp);
  printAt(0, 12, t);
  display.setTextSize(1);
  printAt(6 + 18 * (int)strlen(t) - 4, 28, sUnit());
  if (isnan(dir)) strcpy(t, "from --");
  else snprintf(t, sizeof(t), compass ? "from %03d T" : "from %03d rel", deg360(dir));
  printAt(0, 38, t);
  float a2, s2, g10, x;
  windMeans(120, a2, s2, x); windMeans(WIND_SEC_N, x, x, g10);
  float r2, d2, k2;
  windTrue(a2, s2, r2, d2, k2);
  if (tru && !isnan(k2)) {
    if (!isnan(d2)) snprintf(t, sizeof(t), "2-min %.1f%s %03dT", sShow(k2), sUnit(), deg360(d2));
    else snprintf(t, sizeof(t), "2-min %.1f%s", sShow(k2), sUnit());
  } else if (!isnan(s2)) snprintf(t, sizeof(t), "2-min %.1f%s %03drel", sShow(s2), sUnit(), deg360(a2));
  else strcpy(t, "2-min --");
  printAt(0, 47, t);
  if (tru) snprintf(t, sizeof(t), "App %03d %.1f G%.1f", deg360(aa), sShow(as), sShow(isnan(g10) ? 0.0f : g10));
  else if (gpsFixValid()) snprintf(t, sizeof(t), "Gust %.1f%s (10 min)", sShow(isnan(g10) ? 0.0f : g10), sUnit());
  else strcpy(t, "No GPS fix: no true");
  if (tru && isnan(g10)) { char* g = strstr(t, " G"); if (g) *g = 0; }
  printAt(0, 56, t);
  // dial: an arrow from the side the wind comes from, toward the middle
  const int cx = 111, cy = 28, R = 16;
  display.drawCircle(cx, cy, R, SH110X_WHITE);
  printAt(cx - 2, cy - R + 2, compass ? "N" : "^");
  if (!isnan(dir)) {
    float a = dir * D2R, sx = sinf(a), sy = -cosf(a);
    int x0 = cx + (int)lroundf(sx * (R - 1)), y0 = cy + (int)lroundf(sy * (R - 1));
    int x1 = cx - (int)lroundf(sx * 5), y1 = cy - (int)lroundf(sy * 5);
    display.drawLine(x0, y0, x1, y1, SH110X_WHITE);
    float px = -sy, py = sx;                                     // the head at the inner end
    display.fillTriangle(x1 + (int)lroundf(sx * 6 + px * 4), y1 + (int)lroundf(sy * 6 + py * 4),
                         x1 + (int)lroundf(sx * 6 - px * 4), y1 + (int)lroundf(sy * 6 - py * 4), x1, y1, SH110X_WHITE);
  }
}

// ---- Screen 23: a download from the dashboard, while its pop-up is open (or the VMR sends one): the file,
// how far, how fast. A browser download's numbers are the VMR's own; one fetched in pieces (the WTB's), the page's.
void drawDownload() {
  DlUi u;
  portENTER_CRITICAL(&dlUiMux); u = dlUi; portEXIT_CRITICAL(&dlUiMux);
  bool nat = !(u.ms && millis() - u.ms < 3500) || u.nat;
  char nm[48], b[32], c[16], d[16];
  uint8_t st; uint32_t got, tot, el;
  if (nat) { strlcpy(nm, dl.name, sizeof(nm)); st = dl.st; got = dl.got; tot = dl.tot; el = dl.st ? (dl.t1 ? dl.t1 : millis()) - dl.t0 : 0; }
  else { strlcpy(nm, u.name, sizeof(nm)); st = u.st; got = u.got; tot = u.tot; el = u.el; }
  printAt(0, 0, "DOWNLOAD");
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  if (strlen(nm) <= 21) printAt(0, 12, nm[0] ? nm : "--");
  else { nm[32] = 0; display.setFont(&TomThumb); printAt(0, 17, nm); display.setFont(); }   // long: 4 x 6 (32 characters)
  int pc = st == 2 ? 100 : tot ? (int)min((uint64_t)100, (uint64_t)got * 100 / tot) : -1;
  display.drawRect(0, 22, 96, 8, SH110X_WHITE);
  if (pc > 0) display.fillRect(2, 24, 92 * pc / 100, 4, SH110X_WHITE);
  if (pc >= 0) snprintf(b, sizeof(b), "%d%%", pc); else strcpy(b, "--%");
  printAt(128 - 6 * (int)strlen(b), 22, b);
  auto mb = [](char* o, size_t n, uint32_t v) { if (v >= 1048576UL) snprintf(o, n, "%.1fMB", v / 1048576.0f); else snprintf(o, n, "%lukB", (unsigned long)((v + 512) / 1024)); };
  mb(c, sizeof(c), got);
  if (tot) { mb(d, sizeof(d), tot); snprintf(b, sizeof(b), "%s of %s", c, d); } else strlcpy(b, c, sizeof(b));
  printAt(0, 34, b);
  float bps = el >= 500 ? got * 1000.0f / el : NAN;
  fmtDur(d, sizeof(d), (long)(el / 1000));
  if (isnan(bps)) snprintf(b, sizeof(b), "-- kB/s  %s", d); else snprintf(b, sizeof(b), "%.0f kB/s  %s", bps / 1024, d);
  printAt(0, 43, b);
  if (st == 1) {
    if (tot > got && bps > 0) { fmtDur(d, sizeof(d), lroundf((tot - got) / bps)); snprintf(b, sizeof(b), "%s ~%s left", nat ? "Sending" : "Getting", d); }
    else strcpy(b, nat ? "Sending" : "Getting");
  } else if (st == 2) strcpy(b, "Done");
  else if (st == 4) strcpy(b, "Cancelled");
  else if (st == 3) { snprintf(b, sizeof(b), "Stopped: %s", nat ? dl.err : ""); b[21] = 0; }
  else strcpy(b, "Starting...");
  printAt(0, 56, b);
}

// Serial Monitor copy on the OLED (the Serial monitor card "Show on OLED", latching): the
// latest 10 lines in the 4 x 6 px TomThumb font, one screen line each
// (cut at 32 characters, no wrapping), newest at the bottom.
void drawSerial() {
  const int COLS = 32, ROWS = 10;
  display.setFont(&TomThumb);
  uint32_t seq = Log.seq();
  char ln[SLOG_LEN + 1];
  for (int r = ROWS - 1; r >= 0 && seq > 0; r--, seq--) {         // newest at the bottom, one line each
    if (!Log.get(seq - 1, ln)) break;
    ln[COLS] = 0;                                                // no wrapping: cut at the screen edge
    printAt(0, r * 6 + 5, ln);                                   // custom fonts: y is the baseline
  }
  display.setFont();                                             // back to the built-in 6 x 8 font
}

// The OLED over any screen while an alarm shows: its name, what it is about, and how to acknowledge it
void drawAlarm(uint32_t now) {
  char t[32];
  bool blink = (now / 500) & 1;
  int who = -1;
  if (bnStage) who = AL_BNWAS;
  else for (int i = 1; i < AL_N; i++) if (al[i].on && !al[i].acked && P.alOut[i] != AO_OFF) { who = i; break; }
  if (who < 0) return;
  if (blink) display.fillRect(0, 0, 128, 12, SH110X_WHITE);
  display.setTextColor(blink ? SH110X_BLACK : SH110X_WHITE);
  snprintf(t, sizeof(t), "ALARM: %s", AL_NAME[who]);
  printCentered(2, t);
  display.setTextColor(SH110X_WHITE);
  display.drawRect(0, 0, 128, 64, SH110X_WHITE);
  switch (who) {
    case AL_BNWAS:
      printCentered(20, "Watch alarm");
      if (bnStage == 1) { snprintf(t, sizeof(t), "Sounds in %lu s", (unsigned long)bnLeftS(now)); printCentered(32, t); }
      else printCentered(32, "Sounding");
      break;
    case AL_ANCHOR:
      if (!isnan(anchorDistM) && gpsFixValid()) { float d = lShow(anchorDistM); snprintf(t, sizeof(t), "%.0f %s from it", d, lUnit()); printCentered(20, t);
        snprintf(t, sizeof(t), "Circle %.0f %s", lShow((float)anchorRadNow()), lUnit()); printCentered(32, t); }
      else { printCentered(20, "No GPS fix"); printCentered(32, "Position unknown"); }
      break;
    case AL_ROLL:  snprintf(t, sizeof(t), "Roll %.1f deg", roll); printCentered(20, t); snprintf(t, sizeof(t), "Limit %.0f deg", alRollDeg()); printCentered(32, t); break;
    case AL_HS:    { float z; bool m; float h = wvHsShown(z, m); if (!isnan(m ? wvHsFMid : wvHsF)) h = m ? wvHsFMid : wvHsF;
                     if (isnan(h)) strcpy(t, "Hs --"); else snprintf(t, sizeof(t), "Hs %.1f %s", lShow(h), lUnit()); printCentered(20, t);
                     snprintf(t, sizeof(t), "Limit %.1f %s", lShow(alHsM()), lUnit()); printCentered(32, t); } break;
    case AL_WIND:  { float tkn = NAN; if (windActive() && windFresh() && !isnan(windS1)) { float tr, td; windTrue(windA1, windS1, tr, td, tkn); }
                     if (isnan(tkn)) strcpy(t, "True wind --"); else snprintf(t, sizeof(t), "True wind %.0f %s", sShow(tkn), sUnit()); printCentered(20, t); } snprintf(t, sizeof(t), "Limit %.0f %s", sShow(alWindKn()), sUnit()); printCentered(32, t); break;
    case AL_BATT:  snprintf(t, sizeof(t), "Battery %.0f%%", battPct); printCentered(20, t); snprintf(t, sizeof(t), "Limit %u%%", alBattNow()); printCentered(32, t); break;
    case AL_GPS:   printCentered(20, "No GPS fix"); snprintf(t, sizeof(t), "for %lu s", (unsigned long)((now - gpsNoFixMs) / 1000)); printCentered(32, t); break;
  }
  printCentered(50, who == AL_BNWAS ? "Press a VMR button" : "Any button: silence");
}

void drawScreen() {
  bool ota = otaState != OTA_IDLE;
  if (!displayOK || (!dispLit(DISP_OLED) && !oledForced)) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  bool alm = alarmShowNow();
  if (ota || alm || serOledOn || imuWarnOn() || paused) {   // priority: update, an alarm, serial (latched), IMU warning, pause
    if (ota) drawOta(); else if (alm) drawAlarm(millis()); else if (serOledOn) drawSerial(); else if (imuWarnOn()) drawImuWarn(); else drawPaused();
    crumb(ST_OLED_SEND);
    display.display();
    return;
  }
  if (holdShow || cfmAct != 255 || infoOn) {           // the hold, its confirmation, the Wi-Fi details
    if (holdShow) drawHold(); else if (cfmAct != 255) drawConfirm(); else drawWifiInfo();
    if (!holdShow && (int32_t)(msgUntil - millis()) > 0) drawOverlay(msgText);
    crumb(ST_OLED_SEND);
    display.display();
    return;
  }
  switch (screen) {
    case SCREEN_LIVE:     drawLive();     break;
    case SCREEN_GRAPH:    drawGraph();    break;
    case SCREEN_POSITION: drawPosition(); break;
    case SCREEN_ALLTIME:  drawAllTime();  break;
    case SCREEN_GPS:      drawGps();      break;
    case SCREEN_CLINO:    drawClino();    break;
    case SCREEN_MARKS:    drawMarks();    break;
    case SCREEN_SKY:      drawSky();      break;
    case SCREEN_DOCK:     drawDock();     break;
    case SCREEN_GMETER:   drawGMeter();   break;
    case SCREEN_WAVES:    drawWaves();    break;
    case SCREEN_WAVESTAT: drawWaveStats(); break;
    case SCREEN_DEVICES:  drawDevices();  break;
    case SCREEN_WIND:     drawWind();     break;
    case SCREEN_WX:       drawWx();       break;
    case SCREEN_WXGRAPH:  drawWxGraph();  break;
    case SCREEN_BALL:     drawBall();     break;
    case SCREEN_CAST:     drawCast();     break;
    case SCREEN_CTD:      drawCtd();      break;
    case SCREEN_ROLL:     drawRoll();     break;
    case SCREEN_REC:      drawRec();      break;
    case SCREEN_HEALTH:   drawHealth();   break;
    case SCREEN_DL:       drawDownload(); break;
    case SCREEN_VOYAGE:   drawVoyage();   break;
  }
  drawScrNum();
  if ((int32_t)(msgUntil - millis()) > 0) {
    drawOverlay(msgText);
  }
  crumb(ST_OLED_SEND);
  display.display();
}

