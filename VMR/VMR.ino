  lf.println(c);
}
void writeLogHeader() { writeLogHeaderTo(logFile, recFile + 1, logDaily, logPrevName, logStartUnix, colOffRec); }

// Called with sdMutex held (loop task, while logging). Mounts the card if
// needed, (re)opens this recording's file for appending, and writes
// everything waiting in pend[].
void sdWritePending(uint32_t now) {
  if (!sdOK) {
    if (now - lastSdRetryMs < sdRetryGapMs) return;
    lastSdRetryMs = now;
    sdOK = sdMount();
    if (!sdOK) { sdRetryGapMs = min(sdRetryGapMs * 2, SD_RETRY_MAX_MS); return; }
    sdRetryGapMs = SD_RETRY_MIN_MS;
    Log.println("SD: mounted");
  }

  if (logFile && !recFile[0]) { logFile.close(); ckOk = false; }   // one a Stop could not close, still open at the next Start
  if (!logFile) {
    if (!recFile[0]) makeLogName(recFile, sizeof(recFile));     // first write since Start
    logFile = SD.open(recFile, FILE_APPEND);                     // reopen after an SD error appends
    if (!logFile) { sdFail(); return; }
    strncpy(logName, recFile, sizeof(logName) - 1);
    logName[sizeof(logName) - 1] = 0;
    if (logging) memcpy(rr.file, recFile, sizeof(rr.file));      // for a resume after a crash
    bool fresh = logFile.size() == 0 || resumeOpen;
    if (logFile.size() == 0) { writeLogHeader(); logFile.flush(); }   // new file
    else if (resumeOpen) logBytes = logFile.size();              // resumed: what is already in the file
    resumeOpen = false;
    if (fresh || !ckOk) { logOpenSize = logFile.size(); logOpenBytes = logBytes; ckLen = 0; ckOk = true; }
    else if (!ckVerify()) { sdFail(); return; }                  // reopened after an SD error
    lastCkMs = millis();
    Log.printf("SD: recording to %s\n", logName);
  }

  if (sdDownMs && logging) {                                     // back after an outage: say so in the file
    uint32_t lost = pendDropped - sdDownDrop;
    unsigned long sec = (millis() - sdDownMs) / 1000;
    char nt[48];
    snprintf(nt, sizeof(nt), "SD RECOVERED after %lu s (%lu rows lost)", sec, (unsigned long)lost);
    if (strlen(nt) > EVENT_NOTE_MAX) snprintf(nt, sizeof(nt), "SD RECOVERED %lus (%lu lost)", sec, (unsigned long)lost);
    portENTER_CRITICAL(&sdEvMux); strlcpy(sdEvNote, nt, sizeof(sdEvNote)); sdEvPending = true; portEXIT_CRITICAL(&sdEvMux);
    Log.printf("SD: %s (%lu bytes waiting)\n", nt, (unsigned long)pendCount());
  }
  sdDownMs = 0;
  const char* pc;
  size_t n = pendPeek(&pc, SD_WRITE_CHUNK);                     // a chunk at a time (one ring piece)
  if (n) {
    if (logFile.write((const uint8_t*)pc, n) != n) { sdFail(); return; }
    if (ckBuf && ckOk) { if (ckLen + n <= CK_BUF_BYTES) { memcpy(ckBuf + ckLen, pc, n); ckLen += n; } else ckOk = false; }
    logBytes += n;
    pendTake(n);
  }
  if (now - lastFlushMs > 2000) { logFile.flush(); lastFlushMs = now; }
  if (ckNoteB && logging && !sdEvPending) {                     // rows written again: say so in the file
    char nt[48]; snprintf(nt, sizeof(nt), "SD REWROTE %lu bytes", (unsigned long)ckNoteB);
    portENTER_CRITICAL(&sdEvMux); strlcpy(sdEvNote, nt, sizeof(sdEvNote)); sdEvPending = true; portEXIT_CRITICAL(&sdEvMux);
    ckNoteB = 0;
  }

  // Checkpoint every 60 s: close the file and open it again for appending. On this card stack the
  // file's size in the card's directory - what Refresh, Plot from file, and the card after a power
  // loss see - only moves on a close: a flush does not do it (and is not a failing card).
  // Refresh and Make plot also checkpoint the recording first (logCheckpoint, from their tasks).
  if (now - lastCkMs >= 60000 || (ckBuf && ckLen + SD_WRITE_CHUNK > CK_BUF_BYTES)) logCheckpoint();
}

// the file's size on the card against what was written. A shortfall since the last verified
// size (the card took the writes but its directory did not get them) is written again from ckBuf and checked once more. false = the card could not be written.
bool ckVerify() {
  uint64_t want = logOpenSize + (logBytes - logOpenBytes);
  uint32_t got = logFile.size();
  if (got < want) {
    uint32_t miss = (uint32_t)(want - got);
    if (ckBuf && ckOk && got >= logOpenSize && ckLen == logBytes - logOpenBytes) {
      if (logFile.write((const uint8_t*)ckBuf + (got - logOpenSize), miss) != miss) return false;
      logFile.flush();
      logFile.close();
      logFile = SD.open(recFile, FILE_APPEND);
      if (!logFile) return false;
      got = logFile.size();
      if (got >= want) {
        sdRewrites++; sdRewroteB += miss; ckNoteB += miss;
        Log.printf("SD: %lu bytes missing on the card, written again\n", (unsigned long)miss);
      }
    }
    if (got < want) {
      sdChkFails++;
      if (sdChkFails <= 5) Log.printf("SD: checkpoint found %lu bytes on the card, %lu written\n", (unsigned long)got, (unsigned long)want);
    }
  }
  logOpenSize = got; logOpenBytes = logBytes; ckLen = 0; ckOk = true;
  return true;
}

// Close the recording and open it again for appending, so the card's directory has its true size.
// Call with sdMutex held (any task: every logFile call is under the mutex). After the reopen, the
// size must be what was written: a shortfall is counted and logged (the Hardware check card) - a diagnostic only.
void logCheckpoint() {
  if (!logFile || !recFile[0]) return;
  lastCkMs = millis();
  logFile.close();
  logFile = SD.open(recFile, FILE_APPEND);
  if (!logFile) { sdFail(); return; }
  if (!ckVerify()) sdFail();
}

// Daily files: close this file at 00:00 UTC and let the next write open a new
// one named for the new day (the rows before midnight go to the old file
// first). If the card is busy, try again on the next row.
bool logDayRoll(uint32_t unixNow) {
  if (!sdLock(2000)) return false;
  while (sdOK && pendCount()) sdWritePending(millis());
  if (logFile) logCheckpoint();                     // checked (and put right) before it is closed
  if (logFile) { logFile.flush(); logFile.close(); }
  ckOk = false;
  strncpy(logPrevName, logName[0] ? logName + 1 : recFile + (recFile[0] ? 1 : 0), sizeof(logPrevName) - 1);
  logPrevName[sizeof(logPrevName) - 1] = 0;
  recFile[0] = 0; logName[0] = 0;
  logStartUnix = unixNow;                         // names the new file and its header
  sdUnlock();
  Log.printf("Logging: new day, new file (closed %s)\n", logPrevName);
  return true;
}

// ---- Last 20 min buffer ----
bool bufWanted() { return !logging && !logWanted && sdOK && pendCap && !(bufSaveState == 1 && !bufSeq); }
void bufName(char* out, size_t n, uint32_t seq) { snprintf(out, n, BUF_DIR "/%lu.csv", (unsigned long)seq); }
// sdMutex held for all of these
void bufWritePend() {
  if (!pendCount()) return;
  if (!bufF) { pendClear(); return; }
  const char* pc; size_t n;
  while ((n = pendPeek(&pc, pendCap)) > 0) {          // (at most two pieces: the ring's end, then its start)
    if (bufF.write((const uint8_t*)pc, n) != n) {
      Log.println("Last 20 min: write failed, buffer restarted");
      bufF.close(); bufSeq = 0; pendClear(); break;
    }
    pendTake(n);
  }
}
void bufPrune() {                       // old files go, but not those a save is copying
  while (bufOldest && bufSeq - bufOldest >= BUF_SEGS && !(bufSaveState == 1 && bufOldest >= bufSaveFrom)) {
    char nm[32]; bufName(nm, sizeof(nm), bufOldest); SD.remove(nm); bufOldest++;
  }
}
void bufEmptyDir() {
  SD.mkdir(BUF_DIR);
  File d = SD.open(BUF_DIR);
  String del[48]; int nd = 0;
  if (d && d.isDirectory()) for (File f = d.openNextFile(); f && nd < 48; f = d.openNextFile()) {
    if (!f.isDirectory()) del[nd++] = String(BUF_DIR "/") + f.name();
    f.close();
  }
  if (d) d.close();
  for (int i = 0; i < nd; i++) SD.remove(del[i].c_str());
}
bool bufNext(uint32_t now) {             // close the file filling, open the next (pend holds only the old file's rows)
  bufWritePend();
  if (bufF) bufF.close();
  if (!bufSeq) { bufEmptyDir(); bufOldest = 0; colOffBuf = P.colOff; }   // a new run: the columns as set now
  bufSeq++;
  char nm[32]; bufName(nm, sizeof(nm), bufSeq);
  bufF = SD.open(nm, FILE_WRITE);
  if (!bufF) { bufSeq = 0; return false; }
  if (!bufOldest) bufOldest = bufSeq;
  bufSegUnix[bufSeq % BUF_META] = clockSynced ? nowUnix() : 0;
  bufSegMs = bufFlushMs = now;
  bufPrune();
  return true;
}
void bufEnd() {                          // recording starts: no buffer meanwhile
  if (!bufSeq && !bufF) return;
  if (sdLock(1000)) { if (bufF) bufF.close(); sdUnlock(); }
  bufSeq = 0; pendClear();
}
uint32_t bufSeconds() {                  // how much is buffered (s), for the dashboard
  if (!bufSeq || logging) return 0;
  uint32_t full = min(bufSeq - bufOldest, (uint32_t)(BUF_SEGS - 1));
  return min(full * (BUF_SEG_MS / 1000) + (millis() - bufSegMs) / 1000, 20UL * 60UL);
}

void bufSaveTask(void*) {
  char* b = (char*)malloc(8192);
  File o, in;
  const char* err = nullptr;
  if (!b) err = "not enough memory";
  if (!err && sdLock(3000)) { o = SD.open(BUF_TMP, FILE_APPEND); sdUnlock(); }
  if (!err && !o) err = "cannot write the file";
  for (uint32_t q = bufSaveFrom; !err && q <= bufSaveTo; q++) {
    char nm[32]; bufName(nm, sizeof(nm), q);
    if (!sdLock(3000)) { err = "microSD busy"; break; }
    in = SD.open(nm, FILE_READ);
    sdUnlock();
    if (!in) continue;                   // (a file that was never written)
    while (!err) {
      if (!sdLock(3000)) { err = "microSD busy"; break; }
      int n = in.read((uint8_t*)b, 8192);
      if (n > 0 && o.write((const uint8_t*)b, n) != (size_t)n) err = "write failed (card full?)";
      sdUnlock();
      if (n <= 0) break;
      vTaskDelay(1);
    }
    if (sdLock(3000)) { in.close(); sdUnlock(); }
  }
  if (sdLock(5000)) {
    if (o) o.close();
    if (!err && !SD.rename(BUF_TMP, bufSaveName)) err = "could not move it to the top folder";
    if (err) SD.remove(BUF_TMP);
    sdUnlock();
  } else if (!err) err = "microSD busy";
  free(b);
  if (err) { strncpy(bufSaveErr, err, sizeof(bufSaveErr) - 1); bufSaveState = 3; Log.printf("Last 20 min: not saved (%s)\n", err); }
  else { bufSaveState = 2; Log.printf("Last 20 min: saved %s\n", bufSaveName); }
  vTaskDelete(nullptr);
}

// Save Last 20min (loop task): the open file closed and a new one started, a header for the joined
// file, then the task copies the 1-min files into it
void serviceBufSave(uint32_t now) {
  if (!reqBufSave) return;
  reqBufSave = false;
  bufSaveErr[0] = 0;
  if (logging || bufSaveState == 1) return;
  if (!bufSeq) { strcpy(bufSaveErr, "nothing buffered yet"); bufSaveState = 3; return; }
  if (!sdLock(3000)) { strcpy(bufSaveErr, "microSD busy"); bufSaveState = 3; return; }
  bufWritePend();
  if (bufF) bufF.close();
  uint32_t to = bufSeq, from = max(bufOldest, to >= BUF_SEGS ? to - BUF_SEGS + 1 : 1UL);
  uint32_t u = bufSegUnix[from % BUF_META];
  char base[48];
  if (u) { DateTime t(u); snprintf(base, sizeof(base), "/%04u%02u%02u_%02u%02u%02uZ_last20min", (unsigned)t.year(), (unsigned)t.month(),
                                   (unsigned)t.day(), (unsigned)t.hour(), (unsigned)t.minute(), (unsigned)t.second()); }
  else strcpy(base, "/NOCLK_last20min");
  snprintf(bufSaveName, sizeof(bufSaveName), "%s.csv", base);
  for (int k = 2; SD.exists(bufSaveName) && k < 100; k++) snprintf(bufSaveName, sizeof(bufSaveName), "%s_%d.csv", base, k);
  SD.remove(BUF_TMP);
  File o = SD.open(BUF_TMP, FILE_WRITE);
  bool ok = (bool)o;
  if (ok) {
    char tag[LOG_TAG_MAX + 1]; memcpy(tag, P.logTag, sizeof(tag));
    strncpy(P.logTag, "last20min", LOG_TAG_MAX);
    writeLogHeaderTo(o, bufSaveName + 1, false, "", u, colOffBuf);
    memcpy(P.logTag, tag, sizeof(tag));
    o.close();
  }
  bufSaveSec = (to - from) * (BUF_SEG_MS / 1000) + (now - bufSegMs) / 1000;
  bufSaveFrom = from; bufSaveTo = to;
  bufSaveState = ok ? 1 : 3;              // protects from..to from bufPrune before the next file opens
  if (bufNext(now)) slowForce = true;
  sdUnlock();
  if (!ok) { strcpy(bufSaveErr, "cannot write the file"); return; }
  if (xTaskCreate(bufSaveTask, "bufsave", 4096, nullptr, tskIDLE_PRIORITY, nullptr) != pdPASS) {
    strcpy(bufSaveErr, "could not start"); bufSaveState = 3;
  }
}

// Degrees x 1e7 as a decimal with 6 places, rounded (0.11 m)
void deg6(char* out, size_t n, int32_t e7) {
  int64_t v = e7 >= 0 ? ((int64_t)e7 + 5) / 10 : ((int64_t)e7 - 5) / 10;
  uint64_t a = v < 0 ? (uint64_t)(-v) : (uint64_t)v;
  snprintf(out, n, "%s%lu.%06lu", v < 0 ? "-" : "", (unsigned long)(a / 1000000ULL), (unsigned long)(a % 1000000ULL));
}

// The rate rows are written at: 10 Hz while the IMU is on, else the one chosen in the Recording card
uint32_t logMs() { return P.imuOff && P.logRate < LOG_RATE_N ? LOG_RATE_MS[P.logRate] : LOG_INTERVAL_MS; }
// UTC in ms (millis() before there is a clock), for rows on the clock at the slower rates
uint64_t logClockMs() { return clockSynced ? clockMsAt(millis()) : (uint64_t)millis(); }
uint64_t logSlot = UINT64_MAX;                     // the last slow-rate slot written (UINT64_MAX = a row now)

// Applies Start/Stop requested from the dashboard (loop task)
void applyLogRequest(uint32_t now) {
  if (logWanted == logging) return;
  if (logWanted) {
    bufEnd();                          // the last-20-min buffer stops while recording
    Vy::applyVoyage(now);              // the Recording card choices sent just before Start go in the header
    pendClear(); pendDiscard = false;  // before logging turns on (sdTask reads the ring only while recording)
    logStartMs = now;                  // (logging turns on at the end of this, once the file's name and
                                       //  header fields are all set: sdTask may run at any point in between)
    logStartUnix = clockSynced ? nowUnix() : 0;
    colOffRec = P.colOff;              // the Recording card's Columns: fixed for the recording (not changed while recording)
    recFile[0] = 0;                    // every Start gets its own file
    if (!resumePending) { strncpy(P.logTag, pendTag, LOG_TAG_MAX); P.logTag[LOG_TAG_MAX] = 0; }   // (a resume keeps its tag)
    if (pendCond < LOAD_COND_N) P.logCond = pendCond;
    pendCond = 255;
    logDaily = pendDaily; logDay = 0; logPrevName[0] = 0;
    if (pendGpsWait >= 0) {                        // the Start option; the knob and buttons start with the last one
      uint8_t f = (P.flags31 & ~0x10) | (pendGpsWait ? 0x10 : 0);
      if (f != P.flags31) { P.flags31 = f; markPersistDirty(true); }
      pendGpsWait = -1;
    }
    logInterrupted = false;
    evCount = 0;
    vsSnap = P.vs; condSnap = P.logCond; evqN = 0; vsChgPend = false;   // the header has these
    reqEvent = false;
    sysEvent = nullptr; pauseRowDue = false;
    logRows = 0; logBytes = 0; pendDropped = 0; sdChkFails = 0; slowForce = true;
    sdRewrites = sdRewroteB = ckNoteB = 0; ckOk = false; ckLen = 0; slewOffMs = 0;
    rowGaps = rowGapMax = rowGapUnix = rowPrevMs = 0; loopWorstMs = loopWorstUnix = 0; loopWorstStage = 0; rowGapStage = 0; loopWorstBusy[0] = 0;
    sdDownMs = 0; sdEvPending = false;
    logSlot = UINT64_MAX;                         // slow rates: the first row at once, then on the clock
    gpsNewForLog = false;
    P.logActive = 1;
    if (resumePending) {                          // after a crash: the same file, its counts, a CRASH RESTART event
      resumePending = false; resumeOpen = true;
      strncpy(recFile, rr.file, sizeof(recFile) - 1); recFile[sizeof(recFile) - 1] = 0;
      logStartUnix = rr.startUnix; logDaily = rr.daily; logDay = rr.day;
      logRows = rr.rows; evCount = rr.evCount;
      rr.baseS += bootCrashUpS > rr.startUpS ? bootCrashUpS - rr.startUpS : 0;
      logStartMs = now - rr.baseS * 1000UL;
      rr.startUpS = now / 1000;
      sysEvent = crashNote;
      if (rr.paused) { paused = true; pausedAtMs = now; pauseRowDue = true; }   // one row for the event, then paused again
      if (rr.logger) { reqLoggerAtMs = now; reqLogger = 1; }
      logging = true;                             // a new file opens on the first write
      Log.printf("Logging: RESUMED %s after a crash (%s)\n", recFile, bootCrashKind);
      return;
    }
    rr = {}; rr.magic = RR_MAGIC; rr.ver = fwHash(); rr.daily = logDaily; rr.startUpS = now / 1000;
    logging = true;                               // a new file opens on the first write
    Log.printf("Logging: START (%s)\n", logDaily ? "a new file each day" : "one file");
  } else {
    if (sdLock(3000)) {
      while (sdOK && pendCount()) sdWritePending(now);   // write what is buffered
      if (logFile) logCheckpoint();                  // checked (and put right) before it is closed
      if (logFile) { logFile.flush(); logFile.close(); }
      ckOk = false;
      logName[0] = 0;
      pendClear();
      logging = false;                               // under the lock, so sdTask cannot open the file again
      sdUnlock();
    } else { logging = false; pendDiscard = true; stopUnclosed = true; }   // (sdTask closes the file when it next has the card)
    logging = false;
    sysEvent = nullptr; pauseRowDue = false;
    P.logActive = 0;
    rr.magic = 0;
    Log.printf("Logging: STOP (%lu rows)\n", (unsigned long)logRows);
  }
  markPersistDirty(true);
}

void logSample() {
  uint32_t now = millis();
  applyLogRequest(now);
  if (logging) { rr.day = logDay; rr.startUnix = logStartUnix; rr.paused = paused; rr.logger = loggerMode; }
  bool buffering = !logging && !paused && bufWanted();   // not recording: the last 20 min go to /.buf
  if (buffering && (!bufF || now - bufSegMs >= BUF_SEG_MS) && (!bufFailMs || now - bufFailMs > 30000)) {
    if (sdLock(0)) {
      if (bufNext(now)) { slowForce = true; bufFailMs = 0; }
      else { bufFailMs = now | 1; Log.println("Last 20 min: cannot open a file in /.buf, trying again in 30 s"); }
      sdUnlock();
    }
  }
  if ((!logging && !buffering) || (paused && !pauseRowDue)) {   // not recording, or paused: no rows
    rowPrevMs = 0;
    gpsNewForLog = false;
    wvNewForLog = false;                             // (an estimate made while not recording is not written later)
    accSumF = accSumS = accSumU = 0; accSumN = 0;
    return;
  }
  if (logging && logDaily && clockSynced) {          // daily files: a new one at 00:00 UTC
    uint32_t u = (uint32_t)(clockMsAt(now) / 1000), day = u / 86400;
    if (!logDay) logDay = day;
    else if (day != logDay && logDayRoll(u)) { logDay = day; slowForce = true; }
  }
  if (logging) { logRows++; rr.rows = logRows; rr.day = logDay; rr.startUnix = logStartUnix; }
  if (logging && logMs() == LOG_INTERVAL_MS) {        // 10 Hz: a gap of 0.2 s or more = a row missing
    uint32_t g = rowPrevMs ? now - rowPrevMs : 0;
    if (g >= ROW_GAP_MS) { rowGaps++; if (g > rowGapMax) { rowGapMax = g; rowGapUnix = clockSynced ? nowUnix() : 0; rowGapStage = rowStStage; } }
    rowPrevMs = now;
    rowStMaxUs = 0;
  } else rowPrevMs = 0;
  char ts[32] = "";
  if (clockSynced) {
    uint64_t cm = clockMsAt(now);
    DateTime t((uint32_t)(cm / 1000));
    snprintf(ts, sizeof(ts), "%04u-%02u-%02uT%02u:%02u:%02u.%03uZ",
             (unsigned)t.year(), (unsigned)t.month(), (unsigned)t.day(),
             (unsigned)t.hour(), (unsigned)t.minute(), (unsigned)t.second(),
             (unsigned)(cm % 1000));
  }
  bool f = imuFresh();
  // GPS columns only on the first row after a new RMC; blank otherwise
  char gpsCols[160];
  if (gpsNewForLog) {
    gpsNewForLog = false;
    long age = (long)(now - gpsRmcMs);
    bool ok = gps.gpsFix;
    if (ok) {
      // lat / lon from the exact NMEA value (degrees x 1e7) rounded to 6 decimals: the float copy
      // (gpsLat / gpsLon) holds only ~7 digits, so at 122 deg its 6th decimal is noise (~0.8 m)
      char la[16], lo[16];
      deg6(la, sizeof(la), gps.latE7); deg6(lo, sizeof(lo), gps.lonE7);
      snprintf(gpsCols, sizeof(gpsCols), "%s,%s,%.1f,%.2f,%.2f,%.1f,1,%d,%.2f,%d,%ld",
               la, lo, gps.gpsAlt, gps.gpsSpeed, gps.gpsSpeed / KNOTS_TO_MS,
               gps.gpsAngle, (int)gps.gpsSats, gps.gpsHdop, (int)gps.gpsFixQ, age);
    } else {
      snprintf(gpsCols, sizeof(gpsCols), ",,,,,,0,%d,,0,%ld", (int)gps.gpsSats, age);
    }
  } else {
    snprintf(gpsCols, sizeof(gpsCols), ",,,,,,,,,,");
  }

  // roll period, GM estimate, event marker (blank when none)
  char extra[80], rp[12] = "", gm[12] = "", evN[12] = "", evT[EVENT_NOTE_MAX + 1] = "";
  if (f && !isnan(rollPeriod)) snprintf(rp, sizeof(rp), "%.2f", rollPeriod);
  if (f && !isnan(gmEst)) snprintf(gm, sizeof(gm), "%.2f", gmEst * M_TO_FT);   // feet
  // a marked event from the dashboard first; a PAUSED / RESUMED marker takes the next free row
  if (logging && sdEvPending && !sysEvent && !reqEvent) {
    portENTER_CRITICAL(&sdEvMux); strlcpy(sdEvRow, sdEvNote, sizeof(sdEvRow)); sdEvPending = false; portEXIT_CRITICAL(&sdEvMux);
    sysEvent = sdEvRow;                             // loop()'s own copy (sdTask may write the next note)
  }
  if (logging && !paused && evqN && !sysEvent && !reqEvent) {   // set-up changes, one a row
    strlcpy(evqCur, evq[0], sizeof(evqCur));
    for (int i = 1; i < evqN; i++) memcpy(evq[i - 1], evq[i], sizeof(evq[0]));
    evqN--; sysEvent = evqCur;
  }
  const char* evNote = !logging ? nullptr : reqEvent ? (const char*)reqEventNote : sysEvent;   // (none in the buffer)
  if (evNote) {
    LogEvent e;
    e.n = ++evCount; rr.evCount = evCount;
    e.unix = clockSynced ? nowUnix() : 0;
    strncpy(e.note, evNote, EVENT_NOTE_MAX);
    e.note[EVENT_NOTE_MAX] = 0;
    for (int i = 4; i > 0; i--) evList[i] = evList[i - 1];
    evList[0] = e;
    if (reqEvent) reqEvent = false;
    else { sysEvent = nullptr; pauseRowDue = false; }   // marker written (rows stop after PAUSED)
    snprintf(evN, sizeof(evN), "%u", (unsigned)e.n);
    strncpy(evT, e.note, sizeof(evT) - 1); evT[sizeof(evT) - 1] = 0;
    Log.printf("Event %u: %s\n", (unsigned)e.n, e.note);
  }

  char acc[40] = ",,";                                 // mean acceleration over this row, g
  if (accSumN && accFresh())
    snprintf(acc, sizeof(acc), "%.4f,%.4f,%.4f", accSumF / accSumN, accSumS / accSumN, accSumU / accSumN);
  accSumF = accSumS = accSumU = 0; accSumN = 0;
  char addon[48], pa[12] = "", ta[12] = "", rh[12] = "";  // add-ons: blank when off / not answering
  if (!isnan(extPa)) snprintf(pa, sizeof(pa), "%.2f", extPa / 100.0f);
  if (!isnan(extTa)) snprintf(ta, sizeof(ta), "%.2f", extTa);
  if (!isnan(extRh)) snprintf(rh, sizeof(rh), "%.1f", extRh);
  char wave[96] = ",,,,,";                             // Waves card estimates: only on the row after a new one
  char bw[64] = ",,,,,,";                              // the pressure heave and the fused, the same rows
  if (wvNewForLog) {
    wvNewForLog = false;
    char b1[8] = "", b2m[8] = "", b3[8] = "", f1[8] = "", f2[8] = "", f3[8] = "", f4[8] = "";
    if (!isnan(wvHsB)) snprintf(b1, sizeof(b1), "%.2f", wvHsB);
    if (!isnan(wvHsBMid)) snprintf(b2m, sizeof(b2m), "%.2f", wvHsBMid);
    if (!isnan(wvTzB)) snprintf(b3, sizeof(b3), "%.1f", wvTzB);
    if (wvAnBOnly) {                                   // the IMU off: the corrected pressure and the learned gain
      if (!isnan(wvHsBc)) snprintf(f1, sizeof(f1), "%.2f", wvHsBc);
      if (!isnan(wvHsBc) && wvGk && !isnan(wvGk->agg)) snprintf(f4, sizeof(f4), "%.2f", wvGk->agg);
    } else {
      if (!isnan(wvHsF)) snprintf(f1, sizeof(f1), "%.2f", wvHsF);
      if (!isnan(wvHsFMid)) snprintf(f2, sizeof(f2), "%.2f", wvHsFMid);
      if (!isnan(wvCohF)) snprintf(f3, sizeof(f3), "%.2f", wvCohF);
      if (!isnan(wvGainB)) snprintf(f4, sizeof(f4), "%.2f", wvGainB);
    }
    snprintf(bw, sizeof(bw), "%s,%s,%s,%s,%s,%s,%s", b1, b2m, b3, f1, f2, f3, f4);
    char a[8] = "", b2[8] = "", e[8] = "", g2[8] = "", h[8] = "";   // no ratio, flag or source columns
    if (!isnan(wvTe)) snprintf(a, sizeof(a), "%.1f", wvTe);
    if (!isnan(wvTrs)) snprintf(b2, sizeof(b2), "%.1f", wvTrs);
    if (!isnan(wvHs)) snprintf(e, sizeof(e), "%.2f", wvHs);
    if (!isnan(wvTz)) snprintf(g2, sizeof(g2), "%.1f", wvTz);
    if (!isnan(wvTrs)) snprintf(h, sizeof(h), "%.1f", wvTrs);
    char hm[8] = "";
    if (!isnan(wvHsMid)) snprintf(hm, sizeof(hm), "%.2f", wvHsMid);
    snprintf(wave, sizeof(wave), "%s,%s,%s,%s,%s,%s", a, b2, e, g2, h, hm);
  }
  char dock[24] = ",";                                 // trim / list: blank until the trim is calibrated
  if (P.trimCal && f) {
    float tm = trimMetres(rawPitch);
    if (!isnan(tm)) snprintf(dock, sizeof(dock), "%.2f,%.2f", tm * M_TO_FT, roll);
  }

  char mag[48], mh1[12] = "", mf1[12] = "", mc[12] = "";   // magnetometer test: blank without fresh data
  if (f && magFresh()) {
    float mh = magHeading();
    if (!isnan(mh)) { snprintf(mh1, sizeof(mh1), "%.1f", mh); snprintf(mf1, sizeof(mf1), "%.1f", magTotal); snprintf(mc, sizeof(mc), "%u", (unsigned)magAcc); }
  }
  char wind[64] = "";                                  // wind meter columns, filled below
  windLogCols(wind, sizeof(wind));
  char imu[72] = ",,";                                 // roll, pitch, ROT: blank without IMU data (no yaw column)
  if (f) snprintf(imu, sizeof(imu), "%.2f,%.2f,%.2f", roll, pitch, yawRate * 60.0f);
  // Slow columns: battery, level zero, roll period, GM, the add-on weather and the magnetometer
  // calibration change at most about once a second. All of them are written together on the first row
  // of every second and on any row where one changes; on the other rows all are blank (batt_v, never
  // blank when written, marks which). About 20 bytes a row less.
  static char slPrev[SLOW_N][12];
  static uint32_t slMs = 0;
  char bv[12], bp[12], za[4];
  snprintf(bv, sizeof(bv), "%.3f", battV); snprintf(bp, sizeof(bp), "%.1f", battPct); snprintf(za, sizeof(za), "%d", (int)P.zeroApplied);
  char bt[12] = "";                                   // box_temp_c, the BMP388's own temperature (inside the box)
  if (!isnan(extTb)) snprintf(bt, sizeof(bt), "%.2f", extTb);
  char* sl[SLOW_N] = {bv, bp, za, rp, gm, pa, ta, rh, mc, bt};
  bool firstRow = slowForce;                          // a new file / buffer file: mag_var_deg written too
  bool slAll = slowForce || now - slMs >= 1000;
  for (int i = 0; i < SLOW_N && !slAll; i++) if (strcmp(sl[i], slPrev[i])) slAll = true;
  if (slAll) {
    slMs = now; slowForce = false;
    for (int i = 0; i < SLOW_N; i++) { strncpy(slPrev[i], sl[i], sizeof(slPrev[i]) - 1); slPrev[i][sizeof(slPrev[i]) - 1] = 0; }
  } else for (int i = 0; i < SLOW_N; i++) sl[i][0] = 0;
  if (evNote) snprintf(extra, sizeof(extra), "%s,%s,%s,%s", rp, gm, evN, evT);
  else snprintf(extra, sizeof(extra), "%s,%s,,", rp, gm);
  snprintf(addon, sizeof(addon), "%s,%s,%s", pa, ta, rh);
  snprintf(mag, sizeof(mag), "%s,%s,%s", mh1, mf1, mc);
  // mag_var_deg: the variation in force (from the GPS position), on a file's first row and on any row where
  // it changed (blank = unchanged), so a later look at mag_heading_deg knows what was in force
  static int16_t varLogged = INT16_MIN;
  char mv[10] = "";
  if (firstRow || P.magVar10 != varLogged) { varLogged = P.magVar10; snprintf(mv, sizeof(mv), "%.1f", P.magVar10 / 10.0f); }
  char slmc[200]; slmLogCols(slmc, sizeof(slmc));     // the iwb_* columns
  char ba[12] = "";                                    // batt_a, on the rows that carry batt_v
  if (P.battType == 1 && bv[0] && !isnan(ina.a)) snprintf(ba, sizeof(ba), "%.3f", ina.a);
  char bg[10] = "";                                    // batt_gauge_pct, on the rows that carry batt_v (LiPo)
  if (P.battType == 0 && bv[0] && !isnan(battGaugePct)) snprintf(bg, sizeof(bg), "%.1f", battGaugePct);
  char line[1000];                                    // a full row is ~460 characters (room for every field at its widest)
  const uint8_t cf = logging ? colOffRec : colOffBuf;  // the Recording card's Columns left out (as the file's header says)
  int ln = snprintf(line, sizeof(line), "%s,%lu,%s,%s,%s,%s,%s,%s", ts, (unsigned long)now, imu, gpsCols, bv, bp, za, extra);
  auto put = [&](uint8_t g, const char* x) { if (!(cf & (1 << g)) && ln < (int)sizeof(line) - 1) ln += snprintf(line + ln, sizeof(line) - ln, ",%s", x); };
  put(COLG_ACC, acc); put(COLG_WX, addon); put(COLG_TRIM, dock); put(COLG_WAVE, wave); put(COLG_MAG, mag);
  put(COLG_WIND, wind + 1);                           // (windLogCols starts with a comma)
  put(COLG_MAG, mv); put(COLG_WX, bt); put(COLG_WAVE, bw); put(COLG_IWB, slmc);
  if (ln < (int)sizeof(line) - 1) snprintf(line + ln, sizeof(line) - ln, ",%s,%s\n", ba, bg);

  size_t L = strlen(line);
  if (!logging) {                                     // the last-20-min buffer: written in ~2 KB pieces
    pendPut(line, L);
    if ((pendCount() >= 2048 || now - bufFlushMs >= 2000) && sdLock(0)) {
      bufWritePend();
      if (bufF && now - bufFlushMs >= 2000) { bufF.flush(); bufFlushMs = now; }
      sdUnlock();
    }
    return;
  }
  ledHeartMs = now ? now : 1;                         // Recording LED: the Datalogger blink
  if (!pendPut(line, L)) pendDropped++;   // buffer full (card gone too long): counted, shown in the Recording card and the event
  if (sdTaskH) { xTaskNotifyGive(sdTaskH); return; }   // sdTask writes it; a slow card never holds up the rows
  if (!sdLock(0)) return;          // (no sdTask: written here) card briefly busy: keep buffering
  sdWritePending(now);             // no card mounted: the rows stay in the buffer until a remount works
  sdUnlock();
}

// the recording's writer. Woken by each row (and every 200 ms anyway, for the remount retries and the 60-s
// checkpoint); writes what is waiting, a chunk at a time, under sdMutex. loop()'s priority (1): they take turns tick by
// tick, and loop() never waits on the card itself.
void sdTask(void*) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(200));
    if (!logging && !stopUnclosed) continue;          // (logFile is not looked at without the lock)
    if (!sdLock(100)) continue;
    if (logging) {
      for (int k = 0; k < 8; k++) {                  // up to 64 KB a turn, then the lock goes back
        sdWritePending(millis());
        if (!sdOK || !logFile || !pendCount() || !logging) break;
      }
    } else {
      stopUnclosed = false;
      if (logFile) { logCheckpoint(); if (logFile) { logFile.flush(); logFile.close(); } ckOk = false; logName[0] = 0; }   // Stop could not close it
    }
    sdUnlock();
  }
}

// Datalogger mode countdown (screen button): the OLED on for LOGGER_PEEK_MS,
// showing the time to the next row, then off again.
void loggerPeek() {
  peekOn = true;
  peekUntilMs = millis() + LOGGER_PEEK_MS;
  peekDrawMs = 0;
  if (displayOK && !darkNow()) display.oled_command(SH110X_DISPLAYON);
}

void drawLoggerPeek() {
  if (!displayOK) return;
  display.clearDisplay();
  display.setFont();
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  printAt(0, 0, logging ? "DATALOGGER  REC" : "DATALOGGER");
  uint32_t lm = logMs();
  char big[12] = "";
  const char* top = "Next row in";
  if (!logging) { top = "Not recording"; }
  else if (lm == LOG_INTERVAL_MS) { top = "Recording at"; strcpy(big, "10 Hz"); }
  else {
    uint64_t next = (logSlot + 1) * (uint64_t)lm, nowc = logClockMs();
    uint32_t s = next > nowc ? (uint32_t)((next - nowc + 999) / 1000) : 0;
    snprintf(big, sizeof(big), "%lu:%02lu", (unsigned long)(s / 60), (unsigned long)(s % 60));
  }
  printAt(0, 14, top);
  if (big[0]) {
    display.setTextSize(3);
    int w = (int)strlen(big) * 18 - 3;
    printAt((display.width() - w) / 2, 26, big);
    display.setTextSize(1);
  }
  printAt(0, 56, markSrcNow() ? "B or Mark: Wi-Fi on" : "B: Wi-Fi on");
  display.display();
}

// Datalogger mode at 1 min or slower: sleep (light sleep: RAM, the open file and the clock kept;
// Wi-Fi and the OLED are already off) until LOGGER_WAKE_LEAD_MS before the next row, the GPS in
// standby meanwhile. Button B wakes it and leaves Datalogger mode (Wi-Fi back); the screen button
// wakes it to show the countdown. PCF8574 buttons wake it through its INT wire on pin 5 (any input
// change wakes it; the screen button shows the countdown, the Mark button leaves Datalogger mode).
void loggerSleep(uint32_t lm) {
  uint64_t next = (logSlot + 1) * (uint64_t)lm, nowc = logClockMs();
  if (next <= nowc + LOGGER_WAKE_LEAD_MS + 3000) return;            // too close: stay awake
  uint32_t sleepMs = (uint32_t)(next - nowc - LOGGER_WAKE_LEAD_MS);
  if (gpsWaitFix() && !gpsOff) {                                     // the Start option: no standby until a fix since waking
    bool got = gpsFixValid() && (int32_t)(gps.gpsLastFixMs - gpsWakeMs) >= 0;
    if (!got && millis() - gpsWakeMs < LOGGER_GPS_WAIT_MS) return;
  }
  if (pendCount() || reqEvent || sysEvent || reqMarkBtn || bmqTail != bmqHead || otaState != OTA_IDLE) return;
  if (xSemaphoreGetMutexHolder(sdMutex)) return;                      // sdTask still writing
  if (peekOn) return;                                                // countdown showing
  if (ledHeartMs && millis() - ledHeartMs < LED_HEARTBEAT_MS + 20) return;   // the Recording LED's blink first
  if (ledMarkEvMs) return;                                           // a Mark LED flash first
  bool scrPin = P.scrSrc == 0 && !windActive();                      // a PCF8574 screen button cannot wake it
  if (digitalRead(BUTTON_B) == LOW || (scrPin && digitalRead(SCREEN_BTN_PIN) == LOW)) return;  // held: would wake at once
  // PCF8574 buttons: its INT wire to pin 5 wakes it. INT goes low on any input change and stays low
  // until the port is read, so read it now; still low = a change just now: stay awake this round.
  // A PCF8574 button held down (screen, mark): stay awake until it is let go.
  bool pcfOn = ext[EXT_PCF].ok && extOn(EXT_PCF);
  if (pcfOn) {
    extPcfVal = pcf.digitalReadByte();
    uint8_t m = 0;
    if (SCR_ON_PCF(P.scrSrc)) m |= 1 << (P.scrSrc - 1);
    if (markSrcNow()) m |= 1 << (markSrcNow() - 1);
    if ((extPcfVal & m) != m || digitalRead(PCF_INT_PIN) == LOW) return;
  }
  if (sdLock(500)) { if (logFile) logCheckpoint(); sdUnlock(); } else return;   // close + reopen: the size on the card is right if the power is cut while asleep
  if (!gpsOff) gpsSend("PMTK161,0");                                 // GPS standby (hot start on waking)
  Log.printf("Datalogger: asleep for %lu s (next row in %lu s)\n", (unsigned long)(sleepMs / 1000), (unsigned long)((next - nowc) / 1000));
  Serial.flush();
  ledsOff();                                                         // PWM stops in light sleep: dark, not stuck on
  gpio_wakeup_enable((gpio_num_t)BUTTON_B, GPIO_INTR_LOW_LEVEL);
  if (scrPin) gpio_wakeup_enable((gpio_num_t)SCREEN_BTN_PIN, GPIO_INTR_LOW_LEVEL);
  if (pcfOn) gpio_wakeup_enable((gpio_num_t)PCF_INT_PIN, GPIO_INTR_LOW_LEVEL);
  esp_sleep_enable_gpio_wakeup();
  esp_sleep_enable_timer_wakeup((uint64_t)sleepMs * 1000ULL);
  esp_task_wdt_reset();
  esp_light_sleep_start();
  esp_task_wdt_reset();
  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_TIMER);
  esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_GPIO);
  gpio_wakeup_disable((gpio_num_t)BUTTON_B);
  gpio_wakeup_disable((gpio_num_t)SCREEN_BTN_PIN);
  gpio_wakeup_disable((gpio_num_t)PCF_INT_PIN);
  if (!gpsOff) { gpsSend("PMTK000"); gpsSend("PMTK000"); }           // any byte wakes it
  gpsLastNmeaMs = gpsWakeMs = millis();                              // standby on purpose: not silence
  bool byTimer = esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_TIMER;
  const char* why = "for the next row";
  if (!byTimer) {                                                    // which button: B is handled by serviceButtons
    if (pcfOn) extPcfVal = pcf.digitalReadByte();                    // fresh, and clears INT
    if (digitalRead(BUTTON_B) == LOW) why = "button B";
    else if (scrPin ? digitalRead(SCREEN_BTN_PIN) == LOW || !pcfOn : (SCR_ON_PCF(P.scrSrc) && extPinLow(P.scrSrc - 1))) { why = "screen button: countdown"; loggerPeek(); }   // even a short tap
    else if (pcfOn) why = "PCF8574 input (the Mark button leaves Datalogger mode)";
    else { why = "screen button: countdown"; loggerPeek(); }
  }
  Log.printf("Datalogger: awake (%s)\n", why);
}

// SOG / COG moving averages: 1 Hz history, over the last P.sogAvgS s.
// SOG is the mean speed. COG is the direction of the mean velocity vector
// (east/north components), so headings wrap through 000/360 correctly and
// near-zero speeds (random GPS COG) carry almost no weight.
void serviceSog(uint32_t now) {
  if (now - lastSogTickMs < 1000) return;
  lastSogTickMs = (now - lastSogTickMs > 3000) ? now : lastSogTickMs + 1000;
  bool fx = gpsFixValid();
  float kn = fx ? gps.gpsSpeed / KNOTS_TO_MS : NAN;
  float a = gps.gpsAngle * D2R;
  sogHist[sogIdx] = kn;
  velE[sogIdx] = fx ? kn * sinf(a) : NAN;
  velN[sogIdx] = fx ? kn * cosf(a) : NAN;
  sogIdx = (sogIdx + 1) % 60;
  float sum = 0, se = 0, sn = 0;
  int cnt = 0;
  for (int i = 1; i <= P.sogAvgS && i <= 60; i++) {
    int k = (sogIdx + 60 - i) % 60;
    if (isnan(sogHist[k])) continue;
    sum += sogHist[k]; se += velE[k]; sn += velN[k]; cnt++;
  }
  sogAvgKn = cnt ? sum / cnt : NAN;
  if (cnt && hypotf(se, sn) / cnt >= COG_AVG_MIN_KN) {
    float c = atan2f(se, sn) * R2D;
    cogAvgDeg = c < 0 ? c + 360.0f : c;
  } else {
    cogAvgDeg = NAN;
  }
}

// ============================================================================
//                             BATTERY / POT
// ============================================================================
// The MAX17048 runs from the battery: no battery usually means begin() fails
// or the voltage reads NaN. Both show as "No battery" (battV = NaN).
void serviceBattery() {
  uint32_t now = millis();
  if (lastBattMs != 0 && now - lastBattMs < 5000) return;
  lastBattMs = now;
  cpuTempC = temperatureRead();                      // on-chip sensor, every 5 s with the battery
  if (P.battType == 1) { serviceBattery12(now); return; }   // 12 V, the INA260
  if (!battOK) battOK = maxlipo.begin(&Wire);       // battery plugged in later
  if (!battOK) { battV = battPct = battRate = NAN; return; }
  float v = maxlipo.cellVoltage();
  if (isnan(v) || v < 2.5f) { battV = battPct = battRate = NAN; return; }
  battV = v;
  battGaugePct = constrain(maxlipo.cellPercent(), 0.0f, 100.0f);
  battRate = battGaugeRate = maxlipo.chargeRate();   // the gauge's: tells USB from the battery (battSource)
  battSmooth(now);
  battPctUpdate(now);
  battEmptyCheck();
}

// the voltage-based %: interpolated in LIPO_MV / LIPO_PCT10, 0 at BATT_EMPTY_V, 100 at 4.20 V
float lipoPct(float v) {
  if (isnan(v)) return NAN;
  float mv = v * 1000.0f;
  if (mv >= LIPO_MV[0]) return 100.0f;
  if (mv <= LIPO_MV[LIPO_PTS - 1]) return 0.0f;
  for (size_t i = 1; i < LIPO_PTS; i++) if (mv >= LIPO_MV[i]) {
    float f = (mv - LIPO_MV[i]) / (float)(LIPO_MV[i - 1] - LIPO_MV[i]);
    return (LIPO_PCT10[i] + f * (LIPO_PCT10[i - 1] - LIPO_PCT10[i])) / 10.0f;
  }
  return 0.0f;
}
// On the battery: battPct from the voltage (one-minute means, the median of the last 3), and battRate the slope
// of a straight line through up to the last 4 h of it (from 20 min on), started again whenever the VMR changes its
// own load (battLoadChange: Wi-Fi, CPU speed, Datalogger, displays, GPS), as the rate changes with it. The cell
// voltage moves about 10 mV an hour at 3.7-3.8 V and reads +/-15 mV, and the curve is not even, so short windows
// swing widely (replayed on the 17-21 Nov run: 60 min 17 % off at the median, 4 h 4 %). On USB, and for 3 min after
// USB comes out, the gauge's % and rate (a charging cell sits near 4.2 V whatever it holds).
void battPctUpdate(uint32_t now) {
  static float sumV = 0; static uint16_t nV = 0; static uint32_t minMs = 0;
  static float mean3[3]; static uint8_t n3 = 0;
  static uint16_t* pm = nullptr;                                  // % x 100 a minute (PSRAM: static RAM is nearly full)
  static uint8_t pmN = 0, pmHead = 0; static uint8_t srcWas = BS_UNKNOWN; static uint32_t loadSeen = 0;
  if (!pm) { pm = (uint16_t*)ps_malloc(BATT_SLOPE_MIN * sizeof(uint16_t)); if (!pm) pm = (uint16_t*)malloc(BATT_SLOPE_MIN * sizeof(uint16_t)); }
  bool onBatt = battSrc != BS_USB && !(battDownStepMs && now - battDownStepMs < BATT_GAUGE_HOLD_MS);
  uint32_t ld = battLoadMs;
  if (battSrc != srcWas || !onBatt || ld != loadSeen) { pmN = 0; pmHead = 0; }   // a new run: the source or the load changed
  srcWas = battSrc; loadSeen = ld;
  if (!minMs) minMs = now;
  sumV += battV; nV++;
  if (now - minMs >= 60000UL) {                                    // a minute's mean
    float m = sumV / nV; sumV = 0; nV = 0; minMs = now;
    if (n3 < 3) mean3[n3++] = m; else { mean3[0] = mean3[1]; mean3[1] = mean3[2]; mean3[2] = m; }
    if (onBatt && pm) { pm[pmHead] = (uint16_t)lroundf(lipoPct(m) * 100.0f); pmHead = (pmHead + 1) % BATT_SLOPE_MIN; if (pmN < BATT_SLOPE_MIN) pmN++; }
  }
  if (n3 == 3) { float a = mean3[0], b = mean3[1], c = mean3[2]; battVs = fmaxf(fminf(a, b), fminf(fmaxf(a, b), c)); }
  else if (n3) battVs = mean3[n3 - 1];
  else battVs = battV;
  if (!onBatt) { battPct = battGaugePct; battSlopeOk = false; return; }   // battRate stays the gauge's
  battPct = lipoPct(battVs);
  battSlopeOk = pmN >= BATT_SLOPE_MIN_N;
  if (!battSlopeOk) { battRate = NAN; return; }
  // least squares through the minutes, oldest first: x = 0 .. n-1 minutes
  float sx = 0, sy = 0, sxx = 0, sxy = 0; uint8_t n = pmN;
  for (uint8_t i = 0; i < n; i++) {
    float y = pm[(pmHead + BATT_SLOPE_MIN - n + i) % BATT_SLOPE_MIN] / 100.0f;
    sx += i; sy += y; sxx += (float)i * i; sxy += i * y;
  }
  float den = n * sxx - sx * sx;
  battRate = den > 0 ? (n * sxy - sx * sy) / den * 60.0f : NAN;    // %/h
  if (battRate < -0.05f) battRateLast = battRate;
  static uint32_t savedMs = 0;                                     // the draw, kept for the next start's early estimate
  if (pmN >= 30 && battRate < -0.05f && P.battAh10 && (!savedMs || now - savedMs >= 600000UL)) {
    uint16_t ma = (uint16_t)constrain(lroundf(-battRate * P.battAh10), 1L, 60000L);   // Ah x 1000 x %/h / 100
    if (!P.battDrawMa || abs((int)ma - (int)P.battDrawMa) * 20 > (int)P.battDrawMa) { P.battDrawMa = ma; markPersistDirty(false); }
    savedMs = now;
  }
}
// 0 %: BATT_EMPTY_V on the battery (the smoothed voltage, a minute of reads) starts the empty shutdown
void battEmptyCheck() {
  static uint8_t lowN = 0;
  bool low = P.battType == 0 && battSrc != BS_USB && !(battGaugeRate > 0.5f) && !isnan(battVs) && battVs <= BATT_EMPTY_V;
  lowN = low ? (lowN < 255 ? lowN + 1 : 255) : 0;
  if (lowN >= 12 && !battEmptyMs) {
    battEmptyMs = millis() ? millis() : 1;
    Log.printf("Battery empty (%.2f V): stopping the recording and shutting down\n", battVs);
  }
}

// where the power comes from. The gauge (no current sensor) works its rate out from the
// change in %, so it stays negative for minutes after USB goes in (hours left while charging, if
// trusted). The cell voltage jumps at once instead: up 40 mV or more = USB in (the charger's current,
// and the load off the battery), down = USB out. The gauge's rate confirms it (clearly positive = USB;
// clearly negative for 30 s below 4.15 V = the battery), but not in the 10 min after a step the other
// way, while the gauge catches up.
// a step now has to clear all of the last 15 s (not just its lowest / highest reading: one read
// during a Wi-Fi burst made a step), hold on the next read, and not follow the VMR's own load change.
void battSource(uint32_t now) {
  static float vh[3], candBase = 0; static uint8_t vn = 0, negN = 0; static int8_t cand = 0;
  bool held = battLoadMs && now - battLoadMs < BATT_LOAD_HOLD_MS;
  if (held) { vn = 0; cand = 0; }                       // start the 15 s again once the load has settled
  float lo = 99, hi = 0;
  for (int i = 0; i < vn; i++) { lo = fminf(lo, vh[i]); hi = fmaxf(hi, vh[i]); }
  bool up = false, down = false;
  if (cand > 0) { up = battV - candBase >= BATT_STEP_V; cand = 0; }          // the second read still up: USB in
  else if (cand < 0) { down = candBase - battV >= BATT_STEP_V; cand = 0; }   // still down: USB out
  else if (vn == 3 && battV - hi >= BATT_STEP_V) { cand = 1; candBase = hi; }
  else if (vn == 3 && lo - battV >= BATT_STEP_V) { cand = -1; candBase = lo; }
  if (vn == 3) { vh[0] = vh[1]; vh[1] = vh[2]; } else vn++;
  vh[vn - 1] = battV;
  negN = battRate < -0.5f ? (negN < 255 ? negN + 1 : 255) : 0;
  uint8_t was = battSrc;
  if (up) { battSrc = BS_USB; battUpStepMs = now ? now : 1; battDownStepMs = 0; }
  else if (down) { battSrc = BS_BATT; battDownStepMs = now ? now : 1; battUpStepMs = 0; }
  else if (battRate > 0.5f && (battSrc != BS_BATT || !battDownStepMs || now - battDownStepMs > 600000UL)) battSrc = BS_USB;
  else if (negN >= 6 && battV < BATT_FULL_V && (battSrc != BS_USB || !battUpStepMs || now - battUpStepMs > 600000UL)) battSrc = BS_BATT;
  else if (battSrc == BS_UNKNOWN && battV < BATT_FULL_V && !(battRate > 0)) battSrc = BS_BATT;   // at boot: the gauge
                                                                                           // ran on through the restart
  if (battSrc != was) { battRateAvg = NAN; if (up || down) { vh[0] = battV; vn = 1; } }
}

// the gauge's rate (noisy at small loads) averaged - over 10 min on the battery, 1 min on USB
// - and started again at each change of source: the time to full on USB (on the battery the LiPo's
// time left is battPctUpdate's slope, which also keeps the draw in the EEPROM for the next start).
void battSmooth(uint32_t now) {
  if (isnan(battRate) || isnan(battV)) { battRateAvg = NAN; battAvgSince = 0; battSrc = BS_UNKNOWN; return; }
  battSource(now);
  // the gauge's rate still the other way after a step: wait for it before averaging
  if ((battSrc == BS_USB && battRate < 0) || (battSrc == BS_BATT && battRate > 0)) { battRateAvg = NAN; battAvgSince = 0; return; }
  static uint16_t n = 0;
  if (!battAvgSince || isnan(battRateAvg)) { battRateAvg = battRate; battAvgSince = now ? now : 1; n = 1; return; }
  float k = 5.0f / (battSrc == BS_USB ? BATT_AVG_USB_S : BATT_AVG_S);   // a read every 5 s
  if (n < 1000) n++;
  battRateAvg += (battRate - battRateAvg) * fmaxf(k, 1.0f / n);   // the plain mean at first, then a running average
}
bool battSettled(uint32_t now) {                         // 2 min on USB; on a LiPo's battery, 20 min of the slope
  if (P.battType == 0 && battSrc != BS_USB) return battSlopeOk;
  return battAvgSince && !isnan(battRateAvg) && now - battAvgSince >= (battSrc == BS_USB ? 120000UL : BATT_AVG_S * 1000UL);
}
// What the battery is doing (BE_*), with h: hours left on the battery, or to full when charging (NaN =
// none yet), ma: the draw / charge current in mA (0 = unknown: needs the Ah), early: h is from the last usable
// slope or the draw saved last time (on the battery, the slope not settled since a load change, or reading flat)
uint8_t battEst(uint32_t now, float& h, int& ma, bool& early) {
  if (P.battType == 1) return battEst12(h, ma, early);   // from the measured current
  h = NAN; ma = 0; early = false;
  if (isnan(battPct)) return BE_NONE;
  bool set = battSettled(now);                           // (false while the average waits for the gauge)
  if (battSrc == BS_USB) {
    if (battPct >= 99.5f || (set && battRateAvg < 0.3f && battV >= BATT_FULL_V)) return BE_FULL;
    if (set && battRateAvg >= 0.3f) { h = (100.0f - battPct) / battRateAvg; if (P.battAh10) ma = (int)lroundf(battRateAvg * P.battAh10); }
    return BE_CHG;
  }
  if (battSrc == BS_BATT) {                              // battRate: the slope of the voltage-based % (to 0 % = 3.30 V)
    // the slope once it has settled; until then (after a load change), or while it reads flat, the last usable slope, else the draw
    // saved last time (both marked early)
    if (set && battRate < -0.05f) { h = battPct / -battRate; if (P.battAh10) ma = (int)lroundf(-battRate * P.battAh10); }
    else if (!isnan(battRateLast)) { early = true; h = battPct / -battRateLast; if (P.battAh10) ma = (int)lroundf(-battRateLast * P.battAh10); }
    else if (P.battAh10 && P.battDrawMa) { early = true; ma = P.battDrawMa; h = battPct * P.battAh10 / (float)P.battDrawMa; }
    return BE_BATT;
  }
  return BE_UNKNOWN;
}

void setDisplayOn(bool on) {
  if (on == displayOn) return;
  battLoadChange();
  displayOn = on;
  if (displayOK) display.oled_command(dispLit(DISP_OLED) || oledForced ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
  lastDrawMs = 0;
}

// 180-degree turn of the SH1107 frame buffer (page format): reversing the byte
// order and the bits in each byte maps pixel (x,y) to (W-1-x, H-1-y).
void flipBuffer180() {
  uint8_t* b = display.getBuffer();
  if (!b) return;
  size_t n = (size_t)display.width() * display.height() / 8;
  for (size_t i = 0, j = n - 1; i < j; i++, j--) { uint8_t t = b[i]; b[i] = b[j]; b[j] = t; }
  for (size_t i = 0; i < n; i++) {
    uint8_t v = b[i];
    v = (uint8_t)((v & 0xF0) >> 4 | (v & 0x0F) << 4);
    v = (uint8_t)((v & 0xCC) >> 2 | (v & 0x33) << 2);
    v = (uint8_t)((v & 0xAA) >> 1 | (v & 0x55) << 1);
    b[i] = v;
  }
}

uint8_t oledRotation() { return P.oledFlip ? 3 : 1; }

void setContrastLevel(int c) {
  c = constrain(c, 1, 255);
  contrast = c;
  if (displayOK) display.setContrast((uint8_t)contrast);
}

// Physical controls. The switch acts only on a flip (the dashboard's On / Off works in between).
// Brightness comes from ONE place, the the Displays card checkbox: the knob, or the dashboard slider
// (with the last change winning, a knob reading that wandered - an unwired pin floats -
// would keep taking the brightness back from the slider).
uint8_t briWebLevel() { return P.briLevel ? P.briLevel : BOOT_CONTRAST; }
void servicePot() {
  uint32_t now = millis();
  if (now - lastPotMs < 50) return;
  lastPotMs = now;

#if USE_POT_SWITCH
  bool pcfDown = swOnPcf() && extOn(EXT_PCF) && !ext[EXT_PCF].ok;   // keep the last state while the PCF8574 is
  bool sw = potSwOn();                                                // not answering (it reads ON, which would
  if (lastSwState < 0) lastSwState = sw;                              // light a switched-off OLED for a few seconds)
  else if (!pcfDown && (int8_t)sw != lastSwState) { lastSwState = sw; setDisplayOn(sw); }
#endif

  // Median of the last 5 readings first: a single stray one (ADC noise, a bus glitch) cannot
  // move the brightness. Then a 0.25 running mean, and a step only when the knob has clearly
  // moved (POT_STEP of 255, ~2.4 %) - so a reading sitting on a step edge does not flicker
  // it (see serviceExt for the ADS7830's channel switching). The ends are exact: fully down is 1, fully up 255.
  static int pHist[5];
  static uint8_t pN = 0, pI = 0;
  int rd = (P.briWeb && !holdShow) || otaState != OTA_IDLE ? -1 : potRawNow();   // (update screen: full brightness, set by
                                                                                // serviceOledForce; holding, the knob picks)
  if (rd < 0) { pN = 0; potEma = -1; return; }       // slider mode, or no knob to read: brightness stays put
  pHist[pI] = rd; pI = (pI + 1) % 5; if (pN < 5) pN++;
  int srt[5];
  memcpy(srt, pHist, sizeof(int) * pN);
  for (int i = 1; i < pN; i++)                     // insertion sort, n <= 5
    for (int k = i; k > 0 && srt[k - 1] > srt[k]; k--) { int q = srt[k]; srt[k] = srt[k - 1]; srt[k - 1] = q; }
  int raw = srt[pN / 2];
  bool fresh = potEma < 0;
  if (fresh) potEma = raw; else potEma += 0.25f * (raw - potEma);
  if (holdShow) return;                              // picking an action: the brightness stays at 30 %
  int c = constrain(map((int)potEma, 0, 4095, 1, 255), 1, 255);
  if (fresh || abs(c - contrast) >= POT_STEP || ((c <= 2 || c >= 253) && c != contrast)) {
    if (!fresh) alarmCtl(now);                       // a turn of the knob counts as a VMR control (BNWAS, alarms)
    setContrastLevel(c);
  }
}

// ================================ LEDs ================================
// Mark, Recording and Fault LEDs, each on its own Feather pin (the Pin mappings card), not via the PCF8574, so
// the Fault LED still works when the I2C bus doesn't. PWM brightness follows the displays; off with
// the pot switch, in Datalogger sleep and in Charge mode. Patterns: see serviceLeds().
// (the LED settings and state are with the globals, under "Indicator LEDs")

void ledsApplyPins() {                           // P.ledPin -> PWM on those pins (others let go)
  for (int i = 0; i < LED_N; i++) {
    uint8_t want = fpinOk(P.ledPin[i]) || (awPin(P.ledPin[i]) && extOn(EXT_AW)) ? P.ledPin[i] : 0;
    if (want == ledOnPin[i]) continue;
    if (awPin(ledOnPin[i])) awDim(ledOnPin[i], 0);
    else if (ledOnPin[i]) { ledcWrite(LED_GPIO[ledOnPin[i]], 0); ledcDetach(LED_GPIO[ledOnPin[i]]); pinMode(LED_GPIO[ledOnPin[i]], INPUT); }
    ledOnPin[i] = 0;
    if (awPin(want)) ledOnPin[i] = want;           // the AW9523 (its LED mode is set in awMode)
    else if (want && ledcAttach(LED_GPIO[want], LED_PWM_HZ, LED_PWM_BITS)) {
      ledcWrite(LED_GPIO[want], 0); ledOnPin[i] = want;
      if (want == FPIN_P9) gpio_set_drive_capability(GPIO_NUM_9, GPIO_DRIVE_CAP_0);   // button A still shorts it to GND if pressed: weakest drive
    }
    ledLastDuty[i] = -1;
  }
  if (awOk()) awMode();                          // which AW9523 pins are LED sinks
  xbApply();                                     // a Feather pin an LED let go of can be a button's
}
void ledsOff() {
  for (int i = 0; i < LED_N; i++) if (ledOnPin[i]) { if (awPin(ledOnPin[i])) awDim(ledOnPin[i], 0); else ledcWrite(LED_GPIO[ledOnPin[i]], 0); ledLastDuty[i] = 0; }
}
void ledsRelease() {                             // Charge mode: PWM off and the pins held low through deep sleep
  for (int i = 0; i < LED_N; i++) if (awPin(ledOnPin[i])) { awDim(ledOnPin[i], 0); ledOnPin[i] = 0; ledLastDuty[i] = -1; }
  for (int i = 0; i < LED_N; i++) if (ledOnPin[i]) {
    uint8_t g = LED_GPIO[ledOnPin[i]];
    ledcWrite(g, 0); ledcDetach(g); pinMode(g, OUTPUT); digitalWrite(g, LOW);
    ledOnPin[i] = 0; ledLastDuty[i] = -1;
  }
}
bool ledSwitchOn() {                             // the pot switch: off = LEDs off; no switch fitted = on
#if USE_POT_SWITCH
  if (P.potSwSrc == SW_NONE) return true;
  return lastSwState != 0;                       // -1: not read yet
#else
  return true;
#endif
}
int ledDutyNow() {
  int c = contrastBeforeOta >= 0 ? contrastBeforeOta : contrast;   // (a firmware update forces the OLED to full)
  float f = constrain(c, 1, 255) / 255.0f;
  return LED_DUTY_MIN + (int)((1023 - LED_DUTY_MIN) * f * f);
}
void ledMarkEvent(uint32_t now, bool level, uint32_t len) { ledMarkEvMs = now ? now : 1; ledMarkEvLen = len; ledMarkEvLevel = level; }

// What is wrong now; the Fault LED starts once something has been wrong for FAULT_HOLD_MS
bool battLow = false;                    // kept for the dashboard (the System card) too
void faultCheck(uint32_t now) {
  char w[96] = "";
  auto add = [&](const char* t) { if (w[0]) strlcat(w, "; ", sizeof(w)); strlcat(w, t, sizeof(w)); };
  if (!P.imuOff && !imuFresh()) add("IMU silent");
  for (int i = 0; i < EXT_N; i++) if (extOn(i) && !ext[i].ok) { char t[24]; snprintf(t, sizeof(t), "%s not answering", EXT_NAME[i]); add(t); }
  if (windActive() && windOn && !loggerMode && now - windStartMs > windSilentMs() && (!windGoodMs || now - windGoodMs > windSilentMs())) add("wind meter silent");
  if (strstr(i2cMissing, "OLED")) add("OLED missing");
  if (strstr(i2cMissing, "EEPROM")) add("EEPROM missing");
  if (strstr(i2cMissing, "RTC")) add("RTC missing");
  if (logging && sdDownMs) add("microSD failing");
  if (!gpsOff && !loggerMode && (!gpsLastNmeaMs || now - gpsLastNmeaMs > 5000)) add("GPS silent");
  // on USB by the voltage step alone isn't enough to clear it: the gauge has to say charging too
  bool chgSure = battSrc == BS_USB && battRate > 0;
  battLow = P.battType == 1 ? batt12Low(battLow)         // 12 V: under 20 %, or the chemistry's floor
          : battOK && !isnan(battPct) && !chgSure && battPct < (battLow ? BATT_LOW_PCT + 1 : BATT_LOW_PCT);
  if (battLow) add("battery low");
  uint8_t k = faultWhyIdx ^ 1;
  strlcpy(faultWhy[k], w, sizeof(faultWhy[k]));
  faultWhyIdx = k;
  if (!w[0]) { faultRawSince = 0; faultLed = false; return; }
  if (!faultRawSince) faultRawSince = now ? now : 1;
  if (!faultLed && now - faultRawSince >= FAULT_HOLD_MS) { faultLed = true; if (!faultLedStart) faultLedStart = now ? now : 1; }
}

// Mark: a blink per mark; on during a cast (an off-blink per mark); a flash on a Datalogger wake.
// Recording: on; slow blink paused; fast blink microSD failing; a blink per row in Datalogger sleep.
// while the 7-segment counts down, Recording blinks each second instead; at zero all three
// join the 7-segment's show for its 6 s.
// Fault: FAULT in Morse while faultCheck() finds something (held 5 s), the word finished at the end.
void serviceLeds(uint32_t now) {
  static uint32_t lastChk = 0;
  if (now - lastChk >= 1000) { lastChk = now; faultCheck(now); }
  if (reqLedTest) { reqLedTest = false; ledTestMs = now ? now : 1; }
  bool on[LED_N];
  // Mark
  on[LED_MARK] = castOpenNow;
  ledState[LED_MARK] = castOpenNow ? "on (cast open)" : "off";
  if (ledMarkEvMs) { if (now - ledMarkEvMs < ledMarkEvLen) on[LED_MARK] = ledMarkEvLevel; else ledMarkEvMs = 0; }
  // Recording
  bool sleepy = loggerMode && logging && logMs() >= LOGGER_SLEEP_MIN_MS;
  if (!logging)      { on[LED_REC] = false; ledState[LED_REC] = "off (not recording)"; }
  else if (sleepy)   { on[LED_REC] = ledHeartMs && now - ledHeartMs < LED_HEARTBEAT_MS; ledState[LED_REC] = "blink per row (Datalogger)"; }
  else if (sdDownMs) { on[LED_REC] = (now / 125) & 1; ledState[LED_REC] = "fast blink (microSD failing)"; }
  else if (paused)   { on[LED_REC] = (now / 1000) & 1; ledState[LED_REC] = "slow blink (paused)"; }
  else               { on[LED_REC] = true; ledState[LED_REC] = "on (recording)"; }
  // Fault: Morse, each word finished before it stops
  on[LED_FAULT] = false;
  if (faultLedStart) {
    uint32_t u = ((now - faultLedStart) / LED_MORSE_UNIT_MS) % 52;
    if (!faultLed && u >= 45) faultLedStart = 0;
    else on[LED_FAULT] = MORSE_FAULT[u] == '1';
  }
  ledState[LED_FAULT] = faultLed ? "FAULT in Morse" : faultLedStart ? "finishing the word" : "off";
  // the 7-segment countdown: Recording blinks each second; at zero every LED joins the show
  if (Cd::active()) {
    long left = Cd::left(now), t = Cd::showT(now);
    if (left > 0) { on[LED_REC] = left % 1000 >= 850; ledState[LED_REC] = "blink per second (countdown)"; }
    else if (t >= 0) {
      uint32_t k = t / 60;
      for (int i = 0; i < LED_N; i++) {
        on[i] = t < CD_BOOM_MS ? (t % 420 < 300) == ((k + i) & 1)                     // with bOOM, alternating
              : t < CD_STAT_MS ? ((k * 2654435761u) >> (8 + 5 * i)) & 1                // random
              : (k / 2) % LED_N == (uint32_t)i;                                          // chasing
        ledState[i] = "countdown show";
      }
    }
  }
  if (alarmShowNow()) { on[LED_FAULT] = (now / 150) & 1; ledState[LED_FAULT] = "fast blink (alarm)"; }   // an alarm (the Alarms card)
  // Test (the Pin mappings card): each LED in turn, 1 s, full brightness, whatever the switch
  int test = -1;
  if (ledTestMs) { uint32_t t = now - ledTestMs; if (t < 1000UL * LED_N) test = t / 1000; else ledTestMs = 0; }
  bool sw = ledSwitchOn();
  int duty = ledDutyNow();
  if (darkNow()) {                                   // a screens-off update: the three in turn at their dimmest, whatever the switch;
    bool fail = otaState == OTA_FAIL;                // failed, Recording alone blinking fast
    for (int i = 0; i < LED_N; i++) {
      on[i] = fail ? i == LED_REC && (now / 100) % 2 : (now / LED_DARK_STEP_MS) % LED_N == (uint32_t)i;
      ledState[i] = fail ? (i == LED_REC ? "fast blink (screens-off update failed)" : "off") : "in turn (screens-off update)";
    }
    sw = true; duty = LED_DUTY_MIN; test = -1;
  }
  for (int i = 0; i < LED_N; i++) {
    if (!ledOnPin[i]) continue;
    int d = test >= 0 ? (test == i ? 1023 : 0) : (on[i] && sw ? duty : 0);
    if (d == ledLastDuty[i]) continue;
    if (awPin(ledOnPin[i])) { if (awDim(ledOnPin[i], (uint8_t)((d * 255L + 511) / 1023))) ledLastDuty[i] = d; }   // 256 steps
    else { ledcWrite(LED_GPIO[ledOnPin[i]], d); ledLastDuty[i] = d; }
  }
}

// ============================================================================
//            ALARMS: BNWAS, ANCHOR WATCH, THRESHOLDS; THE PIEZO AND THE VIBRATION MOTOR
// ============================================================================
// The Alarms card sets each alarm's output (P.alOut): off, visual (the OLED shows it over any screen, the Fault LED blinks
// fast, the dashboard shows it), or visual and the piezo, the vibration motor or both. An alarm shows and sounds from when it
// starts until acknowledged: any VMR control (button B, the screen button, the Mark button, an optional button, a turn of the knob) or the dashboard's
// Silence acknowledges it: quiet until it clears and starts again, or 5 min later if it is still on. That press does nothing
// else. Not in Datalogger mode (the VMR sleeps between rows there).
//   BNWAS (bridge navigational watch alarm, IMO style): after the period (3-12 min) with no VMR control touched, 15 s
//   visual only, then the sound / vibration, faster as it goes on. Only a VMR control resets it, never the dashboard. Off
//   at the dock.
//   Anchor watch: the GPS position at Drop anchor (or as typed in, on the Chart card); the alarm when the GPS is more than
//   the radius from it, or has had no fix for 60 s. Centred on the GPS antenna, not the anchor: for small craft.
// The piezo (Adafruit 1739) is on one or two Feather pins (the Pin mappings card): with two, they are driven in opposite
// phase (twice the swing). The vibration motor is a disc (Adafruit 1201) on a DRV2605L haptic driver (Adafruit 2305,
// 0x5A, the Add-ons card), run in real-time mode: on while the pattern is on. With no motor, an alarm set to vibrate
// sounds instead. The patterns are the Life Logger's.
#define HAP_ADDR        0x5A
#define BUZ_HZ          2650                // the piezo's loudest note
#define BUZ_HZ2         3100                // the second note
#define BUZ_CH_A        6                   // LEDC channels (the LEDs and backlight take the low ones); one timer: in step
#define BUZ_CH_B        7
#define AL_RESOUND_MS   300000UL            // acknowledged but still on: sounds again after 5 min
#define AL_HOLD_MS      10000UL             // roll and wind: on for 10 s after the last reading past the limit
#define BN_VISUAL_MS    15000UL
#define ANCHOR_NOFIX_MS 60000UL
static const char* const AL_NAME[AL_N] = {"BNWAS", "ANCHOR", "ROLL", "HEAVE HS", "WIND", "BATTERY", "GPS"};
static const char* const AO_NAME[AO_N] = {"off", "visual", "sound", "vibrate", "sound + vibrate"};
struct AlarmSt { bool on, acked; uint32_t since, ackMs, lastHit; };
AlarmSt al[AL_N];
uint8_t  bnStage = 0;                       // 0 counting down, 1 visual, 2 sounding
uint32_t bnT0 = 0;                          // the start of this stage (0: of the period)
uint32_t alTestUntil = 0;                   // the Alarms card's Test: one pattern, 1.5 s
volatile bool reqAlAck = false, reqAlTest = false;
float    anchorDistM = NAN, anchorMaxM = NAN, anchorBrg = NAN;   // the GPS from the anchor now (m, deg T), the farthest since the drop
uint32_t anchorNoFixMs = 0;                 // (no fix since)
uint32_t gpsNoFixMs = 0;
uint8_t  buzPinA = 0, buzPinB = 0;          // the Feather pin codes driven now (0 none)
bool     buzOn = false; uint32_t buzHz = 0;
bool     hapOK = false, hapOn = false; uint32_t hapRetryMs = 0; uint8_t hapSaid = 0;

bool alOutSound(uint8_t o) { return o == AO_SOUND || o == AO_BOTH || (o == AO_VIBE && !hapOK); }
bool alOutVibe(uint8_t o) { return hapOK && (o == AO_VIBE || o == AO_BOTH); }
bool alarmsRun() { return !loggerMode; }
bool bnwasOn() { return P.alOut[AL_BNWAS] != AO_OFF && !P.atDock && alarmsRun(); }
void bnwasRestart(uint32_t now) { bnStage = 0; bnT0 = now; }
uint32_t bnLeftS(uint32_t now) {               // to the next stage
  if (!bnwasOn()) return 0;
  if (bnStage == 0) { uint32_t per = bnwasMinNow() * 60000UL, el = now - bnT0; return el >= per ? 0 : (per - el + 999) / 1000; }
  if (bnStage == 1) { uint32_t el = now - bnT0; return el >= BN_VISUAL_MS ? 0 : (BN_VISUAL_MS - el + 999) / 1000; }
  return 0;
}
// an alarm on and not acknowledged: shown over the screens
bool alarmShowNow() {
  if (!alarmsRun()) return false;
  if (bnStage) return true;
  for (int i = 1; i < AL_N; i++) if (al[i].on && !al[i].acked && P.alOut[i] != AO_OFF) return true;
  return false;
}
// Any VMR control: the BNWAS period starts again and every alarm showing is acknowledged. true = something was showing
// (the press did that and nothing else).
bool alarmCtl(uint32_t now) {
  bool busy = alarmShowNow();
  if (bnwasOn()) bnwasRestart(now);
  for (int i = 1; i < AL_N; i++) if (al[i].on && !al[i].acked) { al[i].acked = true; al[i].ackMs = now; }
  if (busy) { lastDrawMs = 0; Log.println("Alarm acknowledged (a VMR control)"); }
  return busy;
}

// ---- the piezo
void buzRelease() {
  for (uint8_t c : {buzPinA, buzPinB}) if (c) { ledcWrite(LED_GPIO[c], 0); ledcDetach(LED_GPIO[c]); pinMode(LED_GPIO[c], INPUT); }
  buzPinA = buzPinB = 0; buzOn = false;
}
// the Pin mappings card's piezo pins, if nothing else has them (an LED, a backlight colour, an optional button, A5's wind
// meter, the relay or the laptop port)
bool piezoPinFree(uint8_t c) {
  if (!fpinOk(c) || fpinUsed(c, P.ledPin, P.lcdRgb)) return false;
  for (int i = 0; i < XB_N; i++) if (P.xbSrc[i] == c) return false;
  return true;
}
void buzApply() {
  buzRelease();
  uint8_t a = P.piezoPin[0], b = P.piezoPin[1];
  if (!a || !piezoPinFree(a)) { if (a) Log.println("Piezo: its pin is taken by something else - no sound"); return; }
  if (b && (!piezoPinFree(b) || b == a)) { Log.println("Piezo: the second pin is taken - one pin only"); b = 0; }
  bool ok = ledcAttachChannel(LED_GPIO[a], BUZ_HZ, 8, BUZ_CH_A);
  if (ok && b) ok = ledcAttachChannel(LED_GPIO[b], BUZ_HZ, 8, BUZ_CH_B) && ledcOutputInvert(LED_GPIO[b], true);   // B inverted: twice the swing
  if (!ok) { Log.println("Piezo: no PWM channel for it"); if (b) ledcDetach(LED_GPIO[b]); ledcDetach(LED_GPIO[a]); return; }
  buzPinA = a; buzPinB = b; buzHz = BUZ_HZ;
  ledcWrite(LED_GPIO[a], 0); if (b) ledcWrite(LED_GPIO[b], 256);   // both low (256 inverted = low)
  Log.printf("Piezo: on %s%s\n", FPIN_LABEL[a], b ? (String(" and ") + FPIN_LABEL[b]).c_str() : " (other leg to GND)");
}
void buzSet(uint32_t hz) {
  if (!buzPinA) return;
  uint8_t a = LED_GPIO[buzPinA], b = buzPinB ? LED_GPIO[buzPinB] : 0;
  if (!hz) { if (buzOn) { ledcWrite(a, 0); if (b) ledcWrite(b, 256); buzOn = false; } return; }
  if (hz != buzHz) { ledcChangeFrequency(a, hz, 8); buzHz = hz; }
  if (!buzOn) { ledcWrite(a, 128); if (b) ledcWrite(b, 128); buzOn = true; }
}

// ---- the DRV2605L, its registers directly (real-time mode, an ERM motor, open loop)
static bool hapW(uint8_t r, uint8_t v) { Wire.beginTransmission(HAP_ADDR); Wire.write(r); Wire.write(v); return Wire.endTransmission() == 0; }
static int hapR(uint8_t r) {
  Wire.beginTransmission(HAP_ADDR); Wire.write(r);
  if (Wire.endTransmission(false) != 0 || Wire.requestFrom((uint8_t)HAP_ADDR, (uint8_t)1) != 1) return -1;
  return Wire.read();
}
bool hapWanted() { return (P.extEn & EXT_HAP) && !(extOn(EXT_AW) && extAddr(EXT_AW) == HAP_ADDR); }   // (an AW9523 at 0x5A has the address)
void hapStart() {
  hapOK = false; hapOn = false;
  int st = hapR(0x00);                                       // status: the device ID in bits 7-5 (3 DRV2605, 7 DRV2605L)
  if (st >= 0 && ((st >> 5) == 3 || (st >> 5) == 7)) {
    int fb = hapR(0x1A), c3 = hapR(0x1D);
    hapOK = fb >= 0 && c3 >= 0 && hapW(0x01, 0x00) && hapW(0x02, 0) && hapW(0x03, 1)   // out of standby, nothing playing, ERM library A
         && hapW(0x1A, fb & 0x7F) && hapW(0x1D, c3 | 0x20) && hapW(0x01, 0x05);      // ERM, open loop, real-time playback
  }
  if (hapOK != (hapSaid == 1)) { hapSaid = hapOK ? 1 : 2; Log.printf("Vibration motor (DRV2605L 0x5A): %s\n", hapOK ? "found" : "not answering"); }
}
void hapSet(bool on) {
  if (!hapOK || on == hapOn) return;
  if (hapW(0x02, on ? 0x7F : 0)) hapOn = on; else { hapOK = false; hapRetryMs = millis(); }
}
void hapService(uint32_t now) {
  if (!hapWanted()) { if (hapOK) { hapSet(false); hapW(0x01, 0x40); hapOK = false; hapSaid = 0; } return; }   // (standby)
  if (!hapOK && now - hapRetryMs >= 5000) { hapRetryMs = now; hapStart(); }
}

// ---- the anchor watch
float anchorDist(int32_t la, int32_t lo, float* brg) {
  double dlo = (double)lo - P.anchorLo;
  if (dlo > 1800000000.0) dlo -= 3600000000.0; else if (dlo < -1800000000.0) dlo += 3600000000.0;
  double n = ((double)la - P.anchorLa) * 1e-7 * 111320.0, e = dlo * 1e-7 * 111320.0 * cos((double)P.anchorLa * 1e-7 * DEG_TO_RAD);
  if (brg) *brg = fmodf((float)(atan2(e, n) * RAD_TO_DEG) + 360.0f, 360.0f);
  return (float)sqrt(n * n + e * e);
}
// POST /anchor  act=drop (here, from the GPS) | act=set&la=&lo= (degrees) | act=rad&r=<m> | act=up (the watch off)
volatile int8_t reqAnchor = -1;              // 0 up, 1 drop, 2 set, 3 radius
volatile int32_t reqAnchorLa = 0, reqAnchorLo = 0; volatile uint16_t reqAnchorRad = 0;
void handleAnchor() {
  String a = server.arg("act");
  if (a == "drop") {
    if (!gpsFixValid()) { server.send(409, "application/json", "{\"error\":\"No GPS fix: the anchor needs one\"}"); return; }
    reqAnchorLa = gps.latE7; reqAnchorLo = gps.lonE7; reqAnchor = 1;
  } else if (a == "set") {
    double la = server.arg("la").toDouble(), lo = server.arg("lo").toDouble();
    if (!server.hasArg("la") || !server.hasArg("lo") || !(fabs(la) <= 90) || !(fabs(lo) <= 180)) { server.send(400, "application/json", "{\"error\":\"Latitude -90 to 90, longitude -180 to 180\"}"); return; }
    reqAnchorLa = (int32_t)llround(la * 1e7); reqAnchorLo = (int32_t)llround(lo * 1e7); reqAnchor = 2;
  } else if (a == "rad") {
    long r = server.arg("r").toInt();
    if (r < 5 || r > 5000) { server.send(400, "application/json", "{\"error\":\"Radius 5-5000 m\"}"); return; }
    reqAnchorRad = (uint16_t)r; reqAnchor = 3;
  } else if (a == "up") reqAnchor = 0;
  else { server.send(400, "application/json", "{\"error\":\"act: drop, set, rad or up\"}"); return; }
  uint32_t t0 = millis();
  while (reqAnchor >= 0 && millis() - t0 < 2000) vTaskDelay(5);   // loop() applies it
  server.send(200, "application/json", "{\"ok\":true}");
}
void anchorApply(uint32_t now) {
  int8_t r = reqAnchor;
  if (r < 0) return;
  if (r == 1 || r == 2) {
    P.anchorLa = reqAnchorLa; P.anchorLo = reqAnchorLo;
    if (r == 1 || !P.anchorOn) { P.anchorOn = 1; anchorMaxM = NAN; }
    al[AL_ANCHOR].on = false;
    Log.printf("Anchor watch: %s %.6f, %.6f, %u m\n", r == 1 ? "anchor dropped at" : "anchor moved to", P.anchorLa * 1e-7, P.anchorLo * 1e-7, anchorRadNow());
    if (logging) { char t[48]; snprintf(t, sizeof(t), "ANCHOR %s %.5f %.5f", r == 1 ? "DOWN" : "MOVED", P.anchorLa * 1e-7, P.anchorLo * 1e-7); Vy::evqPush(t); }
  } else if (r == 3) { P.anchorRadM = reqAnchorRad; Log.printf("Anchor watch: radius %u m\n", reqAnchorRad); }
  else { if (P.anchorOn && logging) Vy::evqPush("ANCHOR UP"); P.anchorOn = 0; al[AL_ANCHOR].on = false; anchorDistM = anchorMaxM = anchorBrg = NAN; Log.println("Anchor watch: off"); }
  markPersistDirty(true);
  lastDrawMs = 0;
  reqAnchor = -1;
  (void)now;
}

// ---- the conditions, the outputs
void alSet(int i, bool on, uint32_t now) {
  AlarmSt& a = al[i];
  if (on && !a.on) {
    a.on = true; a.acked = false; a.since = now; lastDrawMs = 0;
    Log.printf("ALARM: %s\n", AL_NAME[i]);
    if (logging) { char t[32]; snprintf(t, sizeof(t), "ALARM %s", AL_NAME[i]); Vy::evqPush(t); }
  } else if (!on && a.on) { a.on = false; lastDrawMs = 0; Log.printf("Alarm over: %s\n", AL_NAME[i]); }
  if (a.on && a.acked && now - a.ackMs >= AL_RESOUND_MS) { a.acked = false; lastDrawMs = 0; }   // still on: again
}
void alarmsTick(uint32_t now) {
  hapService(now);
  anchorApply(now);
  if (reqAlAck) {                                             // the dashboard's Silence (never BNWAS)
    reqAlAck = false;
    for (int i = 1; i < AL_N; i++) if (al[i].on && !al[i].acked) { al[i].acked = true; al[i].ackMs = now; lastDrawMs = 0; }
  }
  if (reqAlTest) { reqAlTest = false; alTestUntil = now + 1500; }
  static uint32_t lastMs = 0;
  if (now - lastMs >= 200) {                                  // the conditions, 5 times a second
    lastMs = now;
    bool run = alarmsRun();
    // BNWAS
    if (!bnwasOn()) bnwasRestart(now);
    else if (bnStage == 0 && now - bnT0 >= bnwasMinNow() * 60000UL) { bnStage = 1; bnT0 = now; lastDrawMs = 0; Log.println("BNWAS: press a VMR control"); if (logging) Vy::evqPush("BNWAS"); }
    else if (bnStage == 1 && now - bnT0 >= BN_VISUAL_MS) { bnStage = 2; bnT0 = now; lastDrawMs = 0; }
    // anchor
    bool fix = gpsFixValid();
    if (P.anchorOn && fix) {
      anchorNoFixMs = 0;
      anchorDistM = anchorDist(gps.latE7, gps.lonE7, &anchorBrg);
      if (isnan(anchorMaxM) || anchorDistM > anchorMaxM) anchorMaxM = anchorDistM;
    } else if (P.anchorOn && !anchorNoFixMs) anchorNoFixMs = now ? now : 1;
    if (!P.anchorOn) { anchorDistM = anchorBrg = NAN; anchorNoFixMs = 0; }
    float r = anchorRadNow();
    bool anc = P.anchorOn && ((fix && anchorDistM > (al[AL_ANCHOR].on ? r * 0.95f : r)) || (anchorNoFixMs && now - anchorNoFixMs >= ANCHOR_NOFIX_MS));
    alSet(AL_ANCHOR, run && P.alOut[AL_ANCHOR] && anc, now);
    // roll and true wind: past the limit, held 10 s
    if (imuFresh() && fabsf(roll) >= alRollDeg()) al[AL_ROLL].lastHit = now ? now : 1;
    alSet(AL_ROLL, run && P.alOut[AL_ROLL] && al[AL_ROLL].lastHit && now - al[AL_ROLL].lastHit < AL_HOLD_MS, now);
    float tkn = NAN;
    if (windActive() && windFresh() && !isnan(windS1)) { float tr, td; windTrue(windA1, windS1, tr, td, tkn); }
    if (!isnan(tkn) && tkn >= alWindKn()) al[AL_WIND].lastHit = now ? now : 1;
    alSet(AL_WIND, run && P.alOut[AL_WIND] && al[AL_WIND].lastHit && now - al[AL_WIND].lastHit < AL_HOLD_MS, now);
    // heave Hs: the current estimate (as the screens show it: fused, else the motion's, else the pressure's corrected)
    float hz; bool mid; float hs = wvHsShown(hz, mid);
    float hsf = mid ? wvHsFMid : wvHsF;
    if (!isnan(hsf)) hs = hsf; else if (isnan(hs) && wvAnBOnly) hs = wvHsBc;
    bool hsOn = wvCurrent && !isnan(hs) && hs >= (al[AL_HS].on ? alHsM() * 0.95f : alHsM());
    alSet(AL_HS, run && P.alOut[AL_HS] && hsOn, now);
    // battery: below the limit, not charging (2 % back to clear)
    bool chg = battSrc == BS_USB && battRate > 0;
    bool bat = !isnan(battPct) && !chg && battPct < alBattNow() + (al[AL_BATT].on ? 2 : 0);
    alSet(AL_BATT, run && P.alOut[AL_BATT] && bat, now);
    // GPS: no fix for the time set (the GPS on)
    if (gpsOff || fix) gpsNoFixMs = 0; else if (!gpsNoFixMs) gpsNoFixMs = now ? now : 1;
    alSet(AL_GPS, run && P.alOut[AL_GPS] && gpsNoFixMs && now - gpsNoFixMs >= alGpsMs(), now);
  }
  // the sound and the vibration: BNWAS first, then the anchor, then the others (the first one sounding picks the pattern)
  uint32_t hz = 0; int who = -1;
  if (bnStage == 2) {
    who = AL_BNWAS;
    uint32_t s = now - bnT0, per = s < 30000 ? 2000 : s < 60000 ? 1000 : 400, onMs = s < 60000 ? 300 : 250, ph = s % per;
    if (ph < onMs) hz = (s >= 60000 && (s / per) % 2) ? BUZ_HZ2 : BUZ_HZ;   // faster the longer it goes
  } else {
    static const uint8_t ORDER[] = {AL_ANCHOR, AL_GPS, AL_ROLL, AL_WIND, AL_HS, AL_BATT};
    for (uint8_t i : ORDER) if (al[i].on && !al[i].acked && (alOutSound(P.alOut[i]) || alOutVibe(P.alOut[i]))) { who = i; break; }
    if (who == AL_ANCHOR || who == AL_GPS) {                  // the anchor, GPS: high-low, fast
      uint32_t ph = now % 1200;
      if (ph < 150) hz = BUZ_HZ; else if (ph < 300) hz = BUZ_HZ2;
    } else if (who >= 0) {                                    // the others: three short beeps every 1.5 s
      uint32_t ph = now % 1500;
      if (ph < 120 || (ph >= 240 && ph < 360) || (ph >= 480 && ph < 600)) hz = BUZ_HZ;
    } else if ((int32_t)(alTestUntil - now) > 0) {            // Test: the three beeps, on both
      uint32_t ph = (alTestUntil - now) % 1500;
      if (ph < 120 || (ph >= 240 && ph < 360) || (ph >= 480 && ph < 600)) hz = BUZ_HZ;
      buzSet(hz); hapSet(hz != 0); return;
    }
  }
  uint8_t o = who >= 0 ? P.alOut[who] : AO_OFF;
  buzSet(alOutSound(o) ? hz : 0);
  hapSet(alOutVibe(o) && hz);
}
bool alarmSounding() { return buzOn || hapOn; }
// /data "al": the outputs, which are on and acknowledged (bits by AL_*), BNWAS, the limits, the anchor, the piezo and motor
void alarmJson(String& j) {
  uint32_t now = millis();
  j += "\"al\":{\"out\":[";
  for (int i = 0; i < AL_N; i++) { if (i) j += ','; j += (int)P.alOut[i]; }
  int on = 0, ack = 0;
  for (int i = 1; i < AL_N; i++) { if (al[i].on) on |= 1 << i; if (al[i].acked) ack |= 1 << i; }
  if (bnStage) on |= 1;
  j += "],\"on\":"; j += on; j += ",\"ack\":"; j += ack;
  j += ",\"snd\":"; j += alarmSounding() ? "true" : "false";
  j += ",\"run\":"; j += alarmsRun() ? "true" : "false";
  j += ",\"bn\":{\"run\":"; j += bnwasOn() ? "true" : "false"; j += ",\"st\":"; j += (int)bnStage;
  j += ",\"left\":"; j += (unsigned long)bnLeftS(now); j += ",\"min\":"; j += (unsigned long)bnwasMinNow(); j += '}';
  j += ",\"lim\":["; j += String(alRollDeg(), 1); j += ','; j += String(alHsM(), 2); j += ','; j += String(alWindKn(), 1);
  j += ','; j += (int)alBattNow(); j += ','; j += (unsigned long)(alGpsMs() / 1000); j += ']';
  j += ",\"pz\":"; j += buzPinA ? "true" : "false"; j += ",\"hap\":"; j += hapOK ? "true" : "false";
  j += ",\"hapw\":"; j += (P.extEn & EXT_HAP) ? "true" : "false";
  j += ",\"anc\":{\"on\":"; j += P.anchorOn ? "true" : "false";
  j += ",\"la\":"; j += String(P.anchorLa * 1e-7, 7); j += ",\"lo\":"; j += String(P.anchorLo * 1e-7, 7);
  j += ",\"r\":"; j += (int)anchorRadNow(); j += ',';
  auto num = [&](const char* k, float v, bool comma) { j += '"'; j += k; j += "\":"; if (isnan(v)) j += "null"; else j += String(v, 0); if (comma) j += ','; };
  num("d", anchorDistM, true); num("b", anchorBrg, true); num("max", anchorMaxM, false);
  j += "}},";
}


// Charge mode: everything that can be is switched off and the ESP32 goes into deep sleep,
// so the battery charges as fast as it can; the Feather's charge LED goes out when it is full.
// Logging stops (file closed), settings are saved, the GPS goes to standby, the OLED off, the
// STEMMA QT rail (IMU, EEPROM, add-ons, I2C pull-ups and so the battery gauge) off with the bus
// lines held low (no back-powering), Wi-Fi off. OLED button B, or the screen button on Feather pin 12
// (not on the PCF8574: unpowered), wakes it, as does turning the VMR off and on: a fresh boot either way.
// With sleepNoWake (the LiPo empty) nothing wakes it and the wake pins' pull-ups stay off: only off / on.
void chargeSleep() {
  if (!sleepNoWake) Log.println("Charge mode: everything off, deep sleep. Button B, the screen button on Feather pin 12, or off / on wakes the VMR.");
  if (logging || logWanted) { logWanted = false; applyLogRequest(millis()); }
  pauseWeb(true);                               // no more requests, no location-mark writes
  if (eepromOK) savePersist();
  if (sdLock(3000)) { SD.end(); sdOK = false; }  // held: nothing writes to the card again
  gpsSend("PMTK161,0");                         // GPS standby (any byte wakes it: the next boot)
  delay(50);
  if (displayOK) display.oled_command(SH110X_DISPLAYOFF);
  displaysOff();                                // 7-segment and LCD blank, backlight pins let go
  server.close();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_OFF);
  Wire.end();
  pinMode(SCL, OUTPUT); digitalWrite(SCL, LOW);
  pinMode(SDA, OUTPUT); digitalWrite(SDA, LOW);
  stemmaPower(false);
  gpio_hold_en((gpio_num_t)SDA);
  gpio_hold_en((gpio_num_t)SCL);
#if defined(PIN_I2C_POWER)
  gpio_hold_en((gpio_num_t)PIN_I2C_POWER);
#endif
  ledsRelease();                                     // indicator LEDs off (held low)
  buzRelease(); hapSet(false);                       // the piezo and the vibration motor quiet
  gpio_deep_sleep_hold_en();
  pinMode(LED_BUILTIN, OUTPUT); digitalWrite(LED_BUILTIN, LOW);
  // pin 12 wakes it only as a screen button: as the wind meter's data line it would wake it at once
  bool w12 = !windActive();
  if (!w12) { digitalWrite(WIND_DE_PIN, LOW); gpio_hold_en((gpio_num_t)WIND_DE_PIN); }   // SP3485 stays receiving
  if (!sleepNoWake) {
    const gpio_num_t wake[2] = {(gpio_num_t)BUTTON_B, (gpio_num_t)SCREEN_BTN_PIN};   // both to GND
    for (int i = 0; i < (w12 ? 2 : 1); i++) { gpio_num_t g = wake[i]; rtc_gpio_init(g); rtc_gpio_set_direction(g, RTC_GPIO_MODE_INPUT_ONLY); rtc_gpio_pullup_en(g); rtc_gpio_pulldown_dis(g); }
    esp_sleep_pd_config(ESP_PD_DOMAIN_RTC_PERIPH, ESP_PD_OPTION_ON);   // keeps those pull-ups on
    esp_sleep_enable_ext1_wakeup((1ULL << BUTTON_B) | (w12 ? (1ULL << SCREEN_BTN_PIN) : 0), ESP_EXT1_WAKEUP_ANY_LOW);
  }
  Serial.flush();
  delay(100);
  esp_deep_sleep_start();
}

// LiPo empty (battEmptyCheck): in steps, so the data is saved first. A SeaLabMOS session is disarmed (the WTB
// closes an open cast and its files, up to 35 s), the recording gets a last row with the BATTERY EMPTY event,
// then chargeSleep: recording stopped and the file closed, settings saved, the marks file left whole, everything
// off, with no wake: it stays off until the power switch is cycled (or RESET).
void serviceBattEmpty() {
  if (!battEmptyMs) return;
  static uint8_t step = 0; static bool evSet = false; static uint32_t stepMs = 0;
  uint32_t now = millis();
  if (step == 0) {
    showMessage("BATTERY EMPTY", 60000);
    if (P.slmOn && slmArmed && !slmDisarming) slmArm(false);
    step = 1; stepMs = now;
  }
  if (!evSet && logging && !paused && !sysEvent) { sysEvent = "BATTERY EMPTY (3.30 V): SHUTDOWN"; pauseRowDue = true; evSet = true; }
  bool slmBusy = P.slmOn && (slmArmed || slmDisarming) && now - stepMs < 35000UL;
  bool rowBusy = logging && !paused && (!evSet || sysEvent) && now - stepMs < 10000UL;
  if (slmBusy || rowBusy) return;
  Log.println("Battery empty: shut down. Charge it, then switch it off and on.");
  sleepNoWake = true;
  chargeSleep();
}
// After charge mode's deep sleep: let go of the pins it held (call first thing in setup)
void releaseSleepPins() {
  gpio_deep_sleep_hold_dis();
  gpio_hold_dis((gpio_num_t)SDA);
  gpio_hold_dis((gpio_num_t)SCL);
#if defined(PIN_I2C_POWER)
  gpio_hold_dis((gpio_num_t)PIN_I2C_POWER);
#endif
  gpio_hold_dis((gpio_num_t)WIND_DE_PIN);
  if (esp_sleep_get_wakeup_cause() != ESP_SLEEP_WAKEUP_UNDEFINED) {
    rtc_gpio_deinit((gpio_num_t)BUTTON_B);
    rtc_gpio_deinit((gpio_num_t)SCREEN_BTN_PIN);
  }
}

// Wi-Fi idle: nobody on the hotspot for a minute -> CPU 80 MHz (the slowest Wi-Fi allows; Datalogger
// mode already records at 80). The hotspot stays at full power, so a phone finds it at once; joining
// brings 240 MHz back within 0.5 s - before DHCP and the page load. Logger sets its own speed.
void serviceIdle(uint32_t now) {
  if (loggerMode) { wifiIdle = false; staSeenMs = now; return; }   // the minute restarts after
  if (now - staChkMs < 500) return;
  staChkMs = now;
  bool sta = WiFi.softAPgetStationNum() > 0;
  if (sta) staSeenMs = now;
  if (sta && wifiIdle) {
    battLoadChange();
    setCpuFrequencyMhz(240);
    wifiIdle = false;
    Log.println("Wi-Fi: phone connected - CPU 240 MHz");
  } else if (!sta && !wifiIdle && now - staSeenMs >= IDLE_AFTER_MS) {
    battLoadChange();
    setCpuFrequencyMhz(80);
    wifiIdle = true;
    Log.println("Wi-Fi idle (no phone for 1 min) - CPU 80 MHz");
  }
}

// Pause/resume the web task around Wi-Fi changes
void pauseWeb(bool p) {
  webPaused = p;
  if (!p) return;
  uint32_t t0 = millis();
  while (!webIdle && millis() - t0 < 3000) vTaskDelay(10);
}

// Datalogger mode: while recording (started with Start), switch off Wi-Fi and
// the OLED and slow the CPU. It never starts a recording itself.
// Button B or the Mark button (PCF8574; no mark is made) brings Wi-Fi and the OLED back. The screen button only shows the
// countdown to the next row for LOGGER_PEEK_MS (proof of life), then the OLED
// goes off again.
void setLoggerMode(bool on) {
  if (on == loggerMode) return;
  battLoadChange();
  if (logging) Vy::evqPush(!on ? "DATALOGGER OFF" : logMs() < LOGGER_SLEEP_MIN_MS ? "DATALOGGER ON, no sleep (rows < 1 min)"
                           : gpsWaitFix() ? "DATALOGGER ON, GPS awake until a fix" : "DATALOGGER ON, GPS standby between rows");
  if (on) gpsWakeMs = millis();
  for (uint32_t t0 = millis(); wifiJob && millis() - t0 < 3000; ) vTaskDelay(10);   // a Wi-Fi job finishes first
  if (on) {
    dispBeforeLogger = displayOn;
    setDisplayOn(false);
    if (oledForced) { oledForced = false; if (displayOK) display.oled_command(SH110X_DISPLAYOFF); }   // serial / IMU warning screens too
    peekOn = false;
    pauseWeb(true);
    server.close();
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);
    setCpuFrequencyMhz(80);
    pinMode(LED_BUILTIN, OUTPUT);
    wifiIdle = false;                            // datalogger mode owns the CPU speed now
    loggerMode = true;
    Log.println("Datalogger mode ON (Wi-Fi off). B or Mark: Wi-Fi back on; screen button: countdown to the next row.");
  } else {
    setCpuFrequencyMhz(240);
    WiFi.mode(WIFI_AP);
    ApNet::start();
    server.begin();
    pauseWeb(false);
    digitalWrite(LED_BUILTIN, LOW);
    if (peekOn) { peekOn = false; if (displayOK && !dispBeforeLogger) display.oled_command(SH110X_DISPLAYOFF); }
    setDisplayOn(dispBeforeLogger);
    loggerMode = false;
    wifiOffByBtn = false;                        // the Wi-Fi is on again either way
    lastDrawMs = 0;
    Log.println("Datalogger mode OFF (Wi-Fi on)");
  }
}

// Restart the hotspot (dashboard, the System card): clears phones that left without
// disconnecting, which otherwise hold some of the AP's 4 places.
void wifiRestart() {
  Log.println("Wi-Fi: restarting the hotspot");
  battLoadChange();
  pauseWeb(true);
  server.close();
  WiFi.softAPdisconnect(true);
  delay(300);
  WiFi.mode(WIFI_AP);
  ApNet::start();
  server.begin();
  pauseWeb(false);
}

// Clock from the dashboard phone, used only until GPS time has been seen this boot
void applyPhoneTime() {
  if (!reqPhone) return;
  reqPhone = false;
  if (gpsTimeSeen) return;
  uint32_t u = reqPhoneUnix + (millis() - reqPhoneRxMs) / 1000;
  setClock(DateTime(u));
  clockSrc = 'P';
  if (!phoneZdDone) {                                  // ZD from the phone once per boot
    phoneZdDone = true;
    P.zdHours = reqPhoneZd;
    markPersistDirty(true);
  }
  Log.printf("Clock set from phone (ZD %+d)\n", (int)P.zdHours);
}

// Pause / resume (dashboard). While logging, a PAUSED row is written before
// the rows stop and a RESUMED row when they start again (event column).
void setPaused(bool on) {
  if (on == paused) return;
  paused = on;
  if (on) {
    pausedAtMs = millis();
    rsCur = {0, 0, 0};                                 // drop the part-filled 10 s roll block
    if (logging) { sysEvent = "PAUSED"; pauseRowDue = true; }
  } else if (pauseRowDue) {
    sysEvent = nullptr; pauseRowDue = false;           // resumed before the marker went out
  } else if (logging) {
    sysEvent = "RESUMED";
  }
  lastDrawMs = 0;
  Log.printf("VMR %s\n", on ? "PAUSED" : "RESUMED");
}

// The pause, update and serial screens show even with the OLED switched off;
// during an update the contrast is also set to full.
void serviceOledForce() {
  bool dark = darkNow();                               // a screens-off update: nothing forced on, not even its own screen
  bool ota = otaState != OTA_IDLE && !dark, want = !dark && (paused || ota || serOledOn || imuWarnOn() || alarmShowNow());
  if (want != oledForced) {
    oledForced = want;
    if (displayOK && !dispLit(DISP_OLED)) display.oled_command(want ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
    lastDrawMs = 0;
  }
  static bool darkWas = false;
  if (dark != darkWas) {                               // into or out of it: the panel to match
    darkWas = dark;
    if (displayOK) display.oled_command(dispLit(DISP_OLED) || oledForced ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
    lastDrawMs = 0;
  }
  if (ota && contrastBeforeOta < 0) { contrastBeforeOta = contrast; setContrastLevel(255); }
  else if (!ota && contrastBeforeOta >= 0) { setContrastLevel(contrastBeforeOta); contrastBeforeOta = -1; }
  if (otaState == OTA_FAIL && millis() - otaEndMs > 15000) otaState = OTA_IDLE;   // error shown 15 s
}

// Restart button (the System card) and a verified firmware update (the Firmware update card): stop
// logging (closes the file; after an update it was stopped when the upload
// began), save settings, restart. Logging does not resume after this.
// The Firmware update card's "Clear EEPROM": the settings block erased (0xFF), so the new firmware starts
// from its defaults (it finds no valid layout). Only after an update that installed OK.
bool eepromClearSettings() {
  uint8_t ff[EEPROM_PAGE];
  memset(ff, 0xFF, sizeof(ff));
  bool ok = true;
  const uint16_t end = EEPROM_BASE + ((sizeof(Persist) + EEPROM_PAGE - 1) / EEPROM_PAGE) * EEPROM_PAGE;
  for (uint16_t a = EEPROM_BASE; a < end; a += EEPROM_PAGE) ok = eepromWrite(a, ff, EEPROM_PAGE) && ok;
  Log.printf("EEPROM clear %s: the new firmware starts from its defaults\n", ok ? "OK" : "FAILED");
  return ok;
}
// The System card's Clear EEPROM: every byte of the 24LC32 set to 0xFF, so the VMR starts from its defaults
bool eepromClearAll() {
  uint8_t ff[EEPROM_PAGE];
  memset(ff, 0xFF, sizeof(ff));
  bool ok = true;
  for (uint32_t a = 0; a < 4096; a += EEPROM_PAGE) ok = eepromWrite((uint16_t)a, ff, EEPROM_PAGE) && ok;
  Log.printf("EEPROM cleared %s: the VMR starts from its defaults\n", ok ? "OK" : "(some pages FAILED)");
  return ok;
}
void doRestart(const char* why) {
  if (reqEeClear) why = "Clear EEPROM (the System card): every setting and the maxima erased, restarting";
  Log.println(why);
  if (logging || logWanted) { logWanted = false; applyLogRequest(millis()); }
  if (eepromOK) { if (reqEeClear) eepromClearAll(); else if (otaState == OTA_OK && otaClearEe) eepromClearSettings(); else savePersist(); }
  otaDarkMagic = otaState == OTA_OK && otaDark ? OTA_DARK_MAGIC : 0;   // the next boot stays dark too
  delay(300);
  esp_restart();
}

// Settings and actions requested from the dashboard. The web task only sets
// req* variables; they are applied here, in the loop task, so the I2C bus,
// the OLED and the EEPROM image P are only ever touched from one task.
void applyWebRequests() {
  if (reqV33) {                                      // the Alarms card, the track, columns, waves, units (the anchor stays: /anchor's)
    uint8_t on = P.anchorOn; int32_t la = P.anchorLa, lo = P.anchorLo; uint16_t rad = P.anchorRadM, col = P.colOff;
    portENTER_CRITICAL(&v33Mux);
    memcpy((uint8_t*)&P + V33_A, v33Pend, V33_B - V33_A);
    reqV33 = false;
    portEXIT_CRITICAL(&v33Mux);
    P.anchorOn = on; P.anchorLa = la; P.anchorLo = lo; P.anchorRadM = rad;
    if (P.colOff != col && !logging) bufEnd();      // the last-20-min buffer starts a new run with the new columns
    markPersistDirty(true);
    trkSettingsApply();
    lastDrawMs = 0;
  }
  if (reqWvGainClr) { reqWvGainClr = false; wvGainForget(); }
  if (reqExtSet) { reqExtSet = false; extApplySettings(); }
  int16_t s = reqScreen;
  if (s >= 0) { reqScreen = -1; if (s < NUM_SCREENS && screenAvail(s)) { screen = (uint8_t)s; lastDrawMs = 0; oledBlankSet(false); } }   // not one whose source is off
  int8_t dk = reqDark;
  if (dk >= 0) {
    reqDark = -1;
    uint8_t ne = (P.dispEn & 7) | (uint8_t)(dk << 4);
    if (ne != P.dispEn) {
      if ((ne ^ P.dispEn) & DISP_DARK(DISP_OLED)) oledBlank = false;   // only the OLED's own On / Off ends an OLED off
      P.dispEn = ne; markPersistDirty(false);
      if (displayOK) display.oled_command(dispLit(DISP_OLED) || oledForced ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
      lastDrawMs = 0;
    }
  }
  int8_t ws = reqWxSpan;
  if (ws >= 0) { reqWxSpan = -1; if (P.wxSpan != (uint8_t)ws) { P.wxSpan = (uint8_t)ws; markPersistDirty(false); lastDrawMs = 0; } }
  int16_t c = reqContrast;
  if (c >= 0) {                                    // the slider: only in slider mode (saved to EEPROM)
    reqContrast = -1;
    if (P.briWeb) { P.briLevel = (uint8_t)c; setContrastLevel(c); markPersistDirty(true); }
  }
  int8_t bw = reqBriWeb;
  if (bw >= 0) {
    reqBriWeb = -1;
    if (P.potSrc == POT_NONE) bw = 1;                  // no knob (the Pin mappings card): always the slider
    if (P.briWeb != (uint8_t)bw) {
      P.briWeb = (uint8_t)bw;
      if (bw) { P.briLevel = (uint8_t)contrast; }      // slider mode starts where the knob left it
      else potEma = -1;                                // knob mode: its reading applies at once
      markPersistDirty(true);
      Log.printf("Brightness from the %s\n", bw ? "dashboard" : "knob");
    }
  }
  int8_t o = reqDisplayOn;
  if (o >= 0) { reqDisplayOn = -1; setDisplayOn(o == 1); }
  int8_t z = reqZero;
  if (z >= 0) { setZero(z == 1); reqZero = -1; }
  int8_t gx = reqGraphMax, gn = reqGraphMin;
  // graph limits: any whole degree +/-GRAPH_LIMIT_DEG, top always above bottom
  if (gx != REQ_NONE) { reqGraphMax = REQ_NONE; if (gx > P.graphMin) { P.graphMax = gx; markPersistDirty(true); lastDrawMs = 0; } }
  if (gn != REQ_NONE) { reqGraphMin = REQ_NONE; if (gn < P.graphMax) { P.graphMin = gn; markPersistDirty(true); lastDrawMs = 0; } }
  int8_t px = reqPitchMax, pn = reqPitchMin;
  if (px != REQ_NONE) { reqPitchMax = REQ_NONE; if (px > P.pitchGraphMin) { P.pitchGraphMax = px; markPersistDirty(true); } }
  if (pn != REQ_NONE) { reqPitchMin = REQ_NONE; if (pn < P.pitchGraphMax) { P.pitchGraphMin = pn; markPersistDirty(true); } }
  if (reqResetMax) { reqResetMax = 0; resetAllTime(); }
  if (reqWvReset) { reqWvReset = 0; wvReset(); }
  Vy::applyVoyage(millis());
  int8_t ad = reqAtDock;
  if (ad >= 0) {
    reqAtDock = -1;
    if (P.atDock != (uint8_t)ad) {
      P.atDock = (uint8_t)ad;
      markPersistDirty(true);
      if (logging && !sysEvent) sysEvent = ad ? "AT DOCK" : "UNDERWAY";   // marked in the CSV
      Log.printf("%s: wave analysis %s\n", ad ? "At the dock" : "Underway", ad ? "off" : "on");
    }
  }
  if (reqClinoReset) { reqClinoReset = 0; clinoMaxS = clinoMaxP = 0; clinoMaxSu = clinoMaxPu = 0; }
  if (reqGReset) { reqGReset = 0; gPeaksReset(); }
  int8_t tc = reqTrimCal;
  if (tc) {
    if (tc > 0) trimCalibrate(reqCalF, reqCalM, reqCalA);
    else { P.trimCal = 0; markPersistDirty(true); Log.println("Trim calibration cleared"); if (logging && !sysEvent) sysEvent = "TRIM CAL CLEARED"; }
    reqTrimCal = 0;
  }
  if (reqCharge == 1 && millis() - reqChargeAtMs > 600) { reqCharge = -1; chargeSleep(); }   // reply sent first
  int8_t pf = reqPosFmt;
  if (pf >= 0) { reqPosFmt = -1; if (P.posFmt != pf) { P.posFmt = (uint8_t)pf; markPersistDirty(true); lastDrawMs = 0; } }
  int8_t lr = reqLogRate;
  if (lr >= 0) { reqLogRate = -1; if (!loggingActive() && (P.imuOff || lr == 0)) { P.logRate = (uint8_t)lr; markPersistDirty(true); Log.printf("Logging rate: %lu ms\n", (unsigned long)logMs()); } }
  if (reqLogger == 1 && millis() - reqLoggerAtMs > 600) { reqLogger = -1; setLoggerMode(true); }   // reply sent first
  if (reqBeamCm >= 0 || reqLengthDm >= 0 || reqLbpDm >= 0 || reqRollThr > 0 ||
      reqDraftFwdCm >= 0 || reqDraftAftCm >= 0 || reqDraftMidCm >= 0 || reqKeelDeckCm >= 0 || reqKeelBridgeCm >= 0 ||
      reqKeelTopCm >= 0 || reqParWlDm >= 0 || reqCb >= 0 || reqCwp >= 0 || reqTpi >= 0 || reqDisp >= 0 || reqGmLc >= 0 ||
      reqVmrXdm != POS_REQ_NONE || reqVmrYcm != POS_REQ_NONE || reqVmrZcm >= 0) {
    if (reqBeamCm >= 0)   { P.shipBeamCm = (uint16_t)reqBeamCm;     reqBeamCm = -1; }
    if (reqLengthDm >= 0) { P.shipLengthDm = (uint16_t)reqLengthDm; reqLengthDm = -1; }
    if (reqLbpDm >= 0)    { P.shipLbpDm = (uint16_t)reqLbpDm;       reqLbpDm = -1; }
    if (reqRollThr > 0)   { P.rollThrDeg = (uint8_t)reqRollThr;     reqRollThr = -1; }
    if (reqDraftFwdCm >= 0 || reqDraftAftCm >= 0 || reqDraftMidCm >= 0) {
      if (reqDraftFwdCm >= 0) { P.draftFwdCm = (uint16_t)reqDraftFwdCm; reqDraftFwdCm = -1; }
      if (reqDraftAftCm >= 0) { P.draftAftCm = (uint16_t)reqDraftAftCm; reqDraftAftCm = -1; }
      if (reqDraftMidCm >= 0) { P.draftMidCm = (uint16_t)reqDraftMidCm; reqDraftMidCm = -1; }
      shipDraftUpdate();                               // quarter mean with all three
    }
    if (reqKeelDeckCm >= 0)   { P.keelDeckCm = (uint16_t)reqKeelDeckCm;     reqKeelDeckCm = -1; }
    if (reqKeelBridgeCm >= 0) { P.keelBridgeCm = (uint16_t)reqKeelBridgeCm; reqKeelBridgeCm = -1; }
    if (reqKeelTopCm >= 0)    { P.keelTopCm = (uint16_t)reqKeelTopCm;       reqKeelTopCm = -1; }
    if (reqParWlDm >= 0)      { P.parWlDm = (uint16_t)reqParWlDm;           reqParWlDm = -1; }
    if (reqCb >= 0)           { P.cbX1000 = (uint16_t)reqCb;                reqCb = -1; }
    if (reqCwp >= 0)          { P.cwpX1000 = (uint16_t)reqCwp;              reqCwp = -1; }
    if (reqTpi >= 0)          { P.tpiX10 = (uint16_t)reqTpi;                reqTpi = -1; }
    if (reqDisp >= 0)         { P.dispX10 = (uint16_t)reqDisp;              reqDisp = -1; }
    if (reqGmLc >= 0)         { P.gmLcFt100 = (uint16_t)reqGmLc;            reqGmLc = -1; }
    if (reqVmrXdm != POS_REQ_NONE) { P.vmrXdm = (int16_t)reqVmrXdm;             reqVmrXdm = POS_REQ_NONE; }
    if (reqVmrYcm != POS_REQ_NONE) { P.vmrYcm = (int16_t)reqVmrYcm;             reqVmrYcm = POS_REQ_NONE; }
    if (reqVmrZcm >= 0)       { P.vmrZcm = (uint16_t)reqVmrZcm;             reqVmrZcm = -1; }
    markPersistDirty(true);
    lastStatsMs = 0;                                  // recompute GM / statistics now
  }
  int8_t br = reqBallRot;
  if (br >= 0) { reqBallRot = -1; if (P.ballRot != br) { P.ballRot = br; markPersistDirty(true); ballMs = 0; } }   // restart it in the middle
  int32_t sr = reqScrRot;
  if (sr > 0) { reqScrRot = -1; if (P.scrRot != (uint32_t)sr) { P.scrRot = sr; markPersistDirty(true); } }
  sr = reqSegRot;
  if (sr > 0) { reqSegRot = -1; if (P.segRot != (uint16_t)sr) { P.segRot = (uint16_t)sr; markPersistDirty(true); } }
  sr = reqLcdRot;
  if (sr > 0) { reqLcdRot = -1; if (P.lcdRot != (uint16_t)sr) { P.lcdRot = (uint16_t)sr; markPersistDirty(true); } }
  int8_t un = reqUnits;
  if (un >= 0) {
    reqUnits = -1;
    uint8_t f = (P.flags31 & ~8) | ((un & 4) ? 8 : 0);   // bit 2 = drafts typed as decimal feet (kept in flags31: a firmware without it ignores the bit)
    if (f != P.flags31) { P.flags31 = f; markPersistDirty(true); }
    un &= 3;
    if (P.units != (uint8_t)un) { P.units = un; markPersistDirty(true); segRamValid = false; lcdShownValid = false; lastDrawMs = 0; }
  }
  if (reqApNameSet) {                                    // a new Wi-Fi name: saved, and the hotspot restarted under it
    if (strcmp(P.apName, reqApName)) {
      memset(P.apName, 0, sizeof(P.apName)); strlcpy(P.apName, reqApName, sizeof(P.apName));
      ApNet::name(); markPersistDirty(true); reqWifiRestart = 1;
      Log.printf("Wi-Fi name: %s\n", apSsid);
    }
    reqApNameSet = false;
  }
  int16_t ah = reqBattAh10;                              // a new capacity: the old draw (worked out with it) goes
  if (ah >= 0) { reqBattAh10 = -1; if (P.battAh10 != (uint16_t)ah) { P.battAh10 = (uint16_t)ah; P.battDrawMa = 0; markPersistDirty(true); } }
  int8_t cm = reqClm;
  if (cm >= 0) { reqClm = -1; if (P.clinoMax != (uint8_t)cm) { P.clinoMax = (uint8_t)cm; markPersistDirty(true); lastDrawMs = 0; } }
  if (reqBallReset) { reqBallReset = false; ballInMs = 0; ballArmed = false; if (P.ballBest10) { P.ballBest10 = 0; markPersistDirty(true); } }
  int8_t fl = reqFlip;
  if (fl >= 0) {
    reqFlip = -1;
    P.oledFlip = fl;
    if (displayOK) display.setRotation(oledRotation());
    markPersistDirty(true);
    lastDrawMs = 0;
  }
  int8_t sf = reqSegFlip;
  if (sf >= 0) { reqSegFlip = -1; if (P.segFlip != sf) { P.segFlip = sf; segRamValid = false; markPersistDirty(true); } }
  int8_t db = reqRotDb;
  if (db >= 0) { reqRotDb = -1; P.rotDeadband = db; markPersistDirty(true); }
  applyPhoneTime();
  int8_t rg = reqGps;
  if (rg) { reqGps = 0; if (rg >= 3) gpsSetOff(rg == 3); else gpsRestart(rg == 2); }
  if (reqRestart) doRestart("Restart requested from the dashboard");
  if (reqWifiRestart && !loggerMode && wifiJobStart(1)) reqWifiRestart = 0;   // its own task (reply sent first)
  int8_t pz = reqPause;
  if (pz >= 0) { reqPause = -1; setPaused(pz == 1); }
  if (reqOtaReboot && millis() - otaEndMs > 1000) doRestart("Firmware update installed: restarting");   // reply sent first
  int8_t gi = reqGraphIdx;
  if (gi >= 0) { reqGraphIdx = -1; P.graphSecIdx = gi; markPersistDirty(true); lastDrawMs = 0; }
  int8_t sa = reqSogAvg;
  if (sa > 0) { reqSogAvg = 0; P.sogAvgS = sa; markPersistDirty(true); }
  int8_t da = reqDockAvg10;
  if (da > 0) { reqDockAvg10 = 0; P.dockAvg10 = (da == 6) ? 0 : da; markPersistDirty(true); }   // 60 s stored as 0 (the default)
  if (reqZdSet) { P.zdHours = reqZd; reqZdSet = 0; markPersistDirty(true); lastDrawMs = 0; }
  int16_t nr = reqNudgeRoll, np = reqNudgePitch;
  if (nr || np) {                          // shift the READING: offset moves the other way
    P.rollOffset  = roundf((P.rollOffset  - nr * 0.1f) * 100.0f) / 100.0f;
    P.pitchOffset = roundf((P.pitchOffset - np * 0.1f) * 100.0f) / 100.0f;
    P.zeroApplied = 1;
    reqNudgeRoll = 0; reqNudgePitch = 0;
    markPersistDirty(true);
  }
}

