// Feather pin codes: 1-6 = A0-A5, 7 = pin 9 (LEDs only) (the PCF8574 INT is on pin 5)
#define FPIN_A5 6                        // the wind meter's DE/RE, or an LED / colour with the wind meter off
#define FPIN_P9 7                        // pin 9 (OLED button A's, unused): LEDs only
#define FPIN_MAX 8                       // 8 = pin 13 (the red LED on the Feather): LEDs only
// pin codes 17-32 = the AW9523 LED driver's P0_0-P0_7, P1_0-P1_7 (the LEDs and the LCD's colours, dimmed)
#define AW_PIN0 17
#define AW_PIN_MAX 32
#define awPin(c) ((c) >= AW_PIN0 && (c) <= AW_PIN_MAX)   // (a macro: a function here would move the IDE's prototypes above the structs)
// LCD backlight cathodes: 0 none, 1-6 Feather A0-A5 (not an LED's), 9-16 PCF8574 P0-P7, 17-32 AW9523; none twice
bool Cfg::lcdRgbOk(const uint8_t* c, const uint8_t* led) {
  for (int i = 0; i < 3; i++) {
    if (c[i] && !(c[i] <= FPIN_A5 || (c[i] >= 9 && c[i] <= 16) || awPin(c[i]))) return false;
    for (int k = 0; k < i; k++) if (c[i] && c[i] == c[k]) return false;
    for (int k = 0; k < 3; k++) if (c[i] && (c[i] <= FPIN_MAX || awPin(c[i])) && c[i] == led[k]) return false;
  }
  return true;
}
