float wrap180(float a) {
  while (a > 180.0f)  a -= 360.0f;
  while (a <= -180.0f) a += 360.0f;
  return a;
}

bool imuFresh() { return haveImu && (millis() - lastImuMs < 1000); }

bool gpsFixValid() { return gps.gpsFix && gps.gpsLastFixMs != 0 && (millis() - gps.gpsLastFixMs < GPS_FIX_TIMEOUT_MS); }

uint32_t nowUnix() { return baseUnix + (millis() - baseMillis) / 1000; }

uint16_t crc16(const uint8_t* d, size_t n) {
  uint16_t c = 0xFFFF;
  while (n--) {
    c ^= (uint16_t)(*d++) << 8;
    for (int i = 0; i < 8; i++) c = (c & 0x8000) ? (c << 1) ^ 0x1021 : (c << 1);
  }
  return c;
}

void showMessage(const char* t, uint32_t ms = 1500) {
  strncpy(msgText, t, sizeof(msgText) - 1);
  msgText[sizeof(msgText) - 1] = 0;
  msgUntil = millis() + ms;
}

// Current UTC as unix seconds. src = 'G' (GPS fix), 'R' (RTC-backed clock),
// 'P' (clock set from a phone), '-' (no time yet -> 0)
uint32_t utcNow(char& src) {
  if (gpsFixValid() && GPS.year >= 24) {
    src = 'G';
    return DateTime(2000 + GPS.year, GPS.month, GPS.day, GPS.hour, GPS.minute, GPS.seconds).unixtime();
  }
  if (clockSynced) { src = clockSrc; return nowUnix(); }
  src = '-';
  return 0;
}

// Local time from UTC with the nautical zone description: LT = UTC - ZD
uint32_t ltOf(uint32_t utc) { return utc - (int32_t)P.zdHours * 3600; }

void zdText(char* out, size_t n) {
  if (P.zdHours) snprintf(out, n, "%+d", (int)P.zdHours);
  else           snprintf(out, n, "0");
}

uint16_t graphSecs() { return GRAPH_SECS[P.graphSecIdx < GRAPH_LENGTHS ? P.graphSecIdx : 1]; }

// degrees + decimal minutes, e.g. "38\xF806.124'N"
void fmtDM(char* out, size_t n, float v, char pos, char neg, bool isLon) {
  char hemi = v < 0 ? neg : pos;
  v = fabsf(v);
  int d = (int)v;
  float mnt = (v - d) * 60.0f;
  if (mnt >= 59.9995f) { d++; mnt = 0; }
  if (isLon) snprintf(out, n, "%3d%c%06.3f'%c", d, (char)248, mnt, hemi);
  else       snprintf(out, n, "%2d%c%06.3f'%c", d, (char)248, mnt, hemi);
}

// ============================================================================
//                                  EEPROM
// ============================================================================
bool eepromWrite(uint16_t addr, const uint8_t* data, size_t len) {
  while (len > 0) {
    size_t room = EEPROM_PAGE - (addr % EEPROM_PAGE);
    size_t n = len < room ? len : room;
    Wire.beginTransmission(EEPROM_ADDR);
    Wire.write((uint8_t)(addr >> 8));
    Wire.write((uint8_t)(addr & 0xFF));
    Wire.write(data, n);
    if (Wire.endTransmission() != 0) return false;
    uint32_t t0 = millis();                       // ACK polling (~5 ms write cycle)
    while (true) {
      Wire.beginTransmission(EEPROM_ADDR);
      if (Wire.endTransmission() == 0) break;
      if (millis() - t0 > 20) return false;
    }
    addr += n; data += n; len -= n;
  }
  return true;
}

bool eepromRead(uint16_t addr, uint8_t* data, size_t len) {
  while (len > 0) {
    size_t n = len < 32 ? len : 32;
    Wire.beginTransmission(EEPROM_ADDR);
    Wire.write((uint8_t)(addr >> 8));
    Wire.write((uint8_t)(addr & 0xFF));
    if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom((int)EEPROM_ADDR, (int)n) != (int)n) return false;
    for (size_t i = 0; i < n; i++) data[i] = Wire.read();
    addr += n; data += n; len -= n;
  }
  return true;
}

void persistDefaults() {
  memset(&P, 0, sizeof(P));
  P.magic = PERSIST_MAGIC;
  P.graphMin = -GRAPH_DEFAULT_DEG;
  P.graphMax = GRAPH_DEFAULT_DEG;
  P.graphSecIdx = 1;      // 1 min
  P.sogAvgS = 10;
  P.rotDeadband = 3;
  P.pitchGraphMin = -GRAPH_DEFAULT_DEG;
  P.pitchGraphMax = GRAPH_DEFAULT_DEG;
  P.rollThrDeg = 10;
  P.vmrXdm = P.vmrYcm = VMR_POS_UNSET;
  P.ledPin[0] = FPIN_P9; P.ledPin[1] = 4; P.ledPin[2] = 5;   // Mark pin 9, Recording A3, Fault A4
  P.lcdRgb[0] = 1; P.lcdRgb[1] = 2; P.lcdRgb[2] = 3;         // LCD backlight: red A0, green A1, blue A2
  P.ethCsPin = 1;                                            // the laptop port's chip select, A0 (used only when ticked)
  P.lcdMix[0] = 255; P.lcdMix[1] = 96; P.lcdMix[2] = 0;       // the custom colour starts amber
  P.lcdScreen = LCD_WX;                                  // weather, not cycling
  // The controls on the I2C boards: the PCF8574 (0x20) and the
  // ADS7830 (0x48) on, at their no-jumper addresses (extAddr 0 = the default). The Pin mappings card changes them.
  P.extEn = (1 << EXT_PCF) | (1 << EXT_ADC1);
  P.potSwSrc = 1;                    // PCF8574 P0: pot switch
  P.scrSrc = 2;                      // PCF8574 P1: screen button
  P.markSrc = 3;                     // PCF8574 P2: Mark button (hold for a cast; P3 was the Cast button)
  P.scrRot = SCR_ROT_DEF;            // the screen button's rotation (the Displays card's ticks)
  P.segRot = SEG_ROT_DEF; P.lcdRot = LCD_ROT_ALL;   // the 7-segment's and LCD's
  P.markKey = MARK_KEY;
  P.potSrc = 1;                      // ADS7830 channel 0: brightness pot
  P.dispEn = DISP_OLED;              // the OLED on; the 7-segment and LCD off until ticked in the Add-ons card
}

bool savePersist() {
  if (!eepromOK) return false;
  P.magic = PERSIST_MAGIC;
  P.crc = crc16((const uint8_t*)&P, offsetof(Persist, crc));
  bool ok = eepromWrite(EEPROM_BASE, (const uint8_t*)&P, sizeof(P));
  Log.printf("EEPROM save %s\n", ok ? "OK" : "FAILED");
  return ok;
}

// Addresses each add-on can take (jumpers on the board); 0x4A is the BNO085
bool extAddrAllowed(int i, uint8_t a) {
  switch (i) {
    case EXT_BMP: return a == 0x76 || a == 0x77;
    case EXT_SHT: return a == 0x44 || a == 0x45;
    case EXT_PCF: return a >= 0x20 && a <= 0x27;
    case EXT_AW:  return a >= 0x58 && a <= 0x5B;
    default:      return a == 0x48 || a == 0x49 || a == 0x4B;
  }
}
bool extAddrsOk(const Persist& t) {
  for (int i = 0; i < EXT_N; i++) if (i != EXT_AW && t.extAddr[i] && !extAddrAllowed(i, t.extAddr[i])) return false;   // (EXT_AW: the old ADC2's address may be there: fixed up)
  return true;
}

// LED pins: each 0 (none), 1-8 (A0-A5, pin 9, pin 13) or 17-32 (AW9523), no pin used twice
bool ledPinsOk(const uint8_t* p) {
  for (int i = 0; i < 3; i++) { if (p[i] > FPIN_MAX && !awPin(p[i])) return false; for (int k = 0; k < i; k++) if (p[i] && p[i] == p[k]) return false; }
  return true;
}
bool xbSrcOk(const uint8_t* x) {                       // each 0, a Feather pin code 1-7 (not 13) or PCF8574 9-16
  for (int i = 0; i < 5; i++) if (x[i] == FPIN_MAX || x[i] > 16) return false;
  return true;
}
// The Wi-Fi name after "VMR ": up to AP_NAME_MAX of letters, digits, spaces and . _ - ( ) #, not starting or ending
// with a space and no two spaces together (empty = the unit's tag). No quote or backslash: it goes into the JSON as it is.
bool apNameOk(const char* n, size_t cap) {
  size_t L = strnlen(n, cap);
  if (L >= cap || L > AP_NAME_MAX) return false;
  for (size_t i = 0; i < L; i++) {
    char c = n[i];
    if (!(isalnum((unsigned char)c) || c == ' ' || c == '.' || c == '_' || c == '-' || c == '(' || c == ')' || c == '#')) return false;
    if (c == ' ' && (i == 0 || i == L - 1 || n[i - 1] == ' ')) return false;
  }
  return true;
}
bool persistV33Ok(const Persist& t) {
  for (int i = 0; i < 2; i++) if (t.piezoPin[i] > FPIN_MAX) return false;
  if (t.piezoPin[0] && t.piezoPin[0] == t.piezoPin[1]) return false;
  for (int i = 0; i < AL_N; i++) if (t.alOut[i] >= AO_N) return false;
  return (t.bnwasMin == 0 || (t.bnwasMin >= 3 && t.bnwasMin <= 12)) && t.anchorOn <= 1 && t.anchorRadM <= 5000 &&
         t.anchorLa >= -900000000 && t.anchorLa <= 900000000 && t.anchorLo >= -1800000000 && t.anchorLo <= 1800000000 &&
         t.alRoll10 <= 900 && t.alHsCm <= 3000 && t.alWind10 <= 2000 && t.alBattPct <= 90 && t.alGpsS10 <= 60 &&
         t.trkMoveS <= 600 && t.trkStillS <= 3600 && t.trkMoveM <= 1000 && (t.trkKeepH <= TRK_KEEP_MAX_H || t.trkKeepH == TRK_KEEP_ALL) &&
         t.colOff < (1 << COLG_N) && t.wvCoh100 <= 95 && t.wvBlendA <= 30 && t.wvBlendB <= 40 && t.wvLearn100 <= 100 && t.unitsX <= 6 &&
         t.windHdg10 <= 3600 && t.shtHeatOff <= 1 && t.calFrac[0] <= 9 && t.calFrac[1] <= 9 && t.calFrac[2] <= 9 &&
         apNameOk(t.apName, sizeof(t.apName));
}
bool persistValid(const Persist& t) {
  return (t.scrRot & SCR_ROT_ALL) != 0 &&
         xbSrcOk(t.xbSrc) && t.xbScreen < NUM_SCREENS &&
         (t.segRot & SEG_ROT_DEF) != 0 && (t.lcdRot & LCD_ROT_ALL) != 0 &&
         t.battAh10 <= 1000 &&                                                 // up to 100 Ah
         t.graphMin >= -GRAPH_LIMIT_DEG && t.graphMax <= GRAPH_LIMIT_DEG && t.graphMin < t.graphMax &&
         t.zdHours >= -12 && t.zdHours <= 12 && t.graphSecIdx < GRAPH_LENGTHS &&
         t.sogAvgS >= 1 && t.sogAvgS <= 60 && t.rotDeadband <= 60 && t.oledFlip <= 1 && t.segFlip <= 1 && t.units <= 3 &&
         t.pitchGraphMin >= -GRAPH_LIMIT_DEG && t.pitchGraphMax <= GRAPH_LIMIT_DEG && t.pitchGraphMin < t.pitchGraphMax &&
         memchr(t.logTag, 0, sizeof(t.logTag)) != nullptr &&
         t.logCond < LOAD_COND_N && t.rollThrDeg >= 1 && t.rollThrDeg <= 45 &&
         t.atDock <= 1 && (t.dockAvg10 == 0 || t.dockAvg10 == 3 || t.dockAvg10 == 6 || t.dockAvg10 == 12 || t.dockAvg10 == 30) &&
         t.trimCal <= 1 && (!t.trimCal || (isfinite(t.trimPitchOffset) && fabsf(t.trimPitchOffset) < 45)) &&
         (t.extEn & ~(((1 << EXT_N) - 1) | EXT_WIND | EXT_HAP)) == 0 && t.scrSrc <= SCR_NONE && t.potSrc <= 17 && t.potSwSrc <= SW_NONE && t.briWeb <= 1 && extAddrsOk(t) &&
         t.logRate < LOG_RATE_N && t.imuOff <= 1 && (t.imuOff || t.logRate == 0) && t.gmLcFt100 <= 10000 && t.posFmt <= 2 &&
         (t.vmrXdm == VMR_POS_UNSET || (t.vmrXdm >= -3000 && t.vmrXdm <= 3000)) &&
         (t.vmrYcm == VMR_POS_UNSET || (t.vmrYcm >= -5000 && t.vmrYcm <= 5000)) && t.vmrZcm <= 15000 &&
         ledPinsOk(t.ledPin) && t.windRate <= WIND_RATE_N &&
         t.windOff10 >= -1800 && t.windOff10 <= 1800 && t.windZcm <= 20000 && t.windYcm >= -5000 && t.windYcm <= 5000 &&
         t.zeroRef100 >= -1500 && t.zeroRef100 <= 1500 && t.magVar10 >= -1800 && t.magVar10 <= 1800 &&
         Cfg::mountOk(t.mountX, t.mountZ) && t.axFlip <= 7 && (t.clinoMax == 0 || (t.clinoMax >= 10 && t.clinoMax <= 60 && t.clinoMax % 5 == 0)) &&
         (t.dispEn & ~0x77) == 0 && (!t.segAddr || (t.segAddr >= 0x70 && t.segAddr <= 0x77)) && (!t.lcdAddr || (t.lcdAddr >= 0x20 && t.lcdAddr <= 0x27)) &&
         t.segScreen < SEG_N && t.lcdScreen < LCD_N && t.lcdColor <= LCD_COLOR_CUSTOM && Cfg::lcdRgbOk(t.lcdRgb, t.ledPin) && t.lcdCycle <= 1 &&
         persistV33Ok(t);
}

// The draft GM, sea-level pressure and the Level zero and ship data card use: the quarter mean (F + 6M + A) / 8 with
// all three drafts, else the mean of fwd and aft, else the one given.
void shipDraftUpdate() {
  uint32_t f = P.draftFwdCm, m = P.draftMidCm, a = P.draftAftCm;
  P.shipDraftCm = (f && m && a) ? (uint16_t)((f + 6 * m + a + 4) / 8)
                : (f && a)      ? (uint16_t)((f + a + 1) / 2)
                                : (uint16_t)(f ? f : a ? a : m);
}

// the pot is never on the Feather (0 -> ADS7830 ch 0); no pot = the dashboard's slider
void persistFixups() {
  if (P.extAddr[EXT_AW] && !extAddrAllowed(EXT_AW, P.extAddr[EXT_AW])) P.extAddr[EXT_AW] = 0;   // the old ADC2 slot's address

  if (!P.potSrc) P.potSrc = 1;
  if (!(P.flags31 & 1)) { P.scrRot |= 1UL << SCREEN_ROLL; P.flags31 |= 1; markPersistDirty(true); }   // the new screen ticked once
  if (!(P.flags31 & 4)) { P.lcdRot |= 1U << LCD_CAST; P.flags31 |= 4; markPersistDirty(true); }         // the LCD's Cast screen, ticked once
  if (!(P.flags31 & 0x20)) { P.scrRot |= 1UL << SCREEN_VOYAGE; P.flags31 |= 0x20; markPersistDirty(true); }   // the Voyage screen, ticked once
  if (P.segScreen == SEG_CD) P.segScreen = SEG_ROLL;   // a countdown does not survive a restart
  if (P.potSrc == POT_NONE) P.briWeb = 1;
  Voyage& v = P.vs;                            // anything out of range back to "not set"
  if (v.vClass > VC_OTHER) v.vClass = 0;
  if (v.towMode > TOW_OTHER) v.towMode = 0;
  if (v.towLen05 > TOW_LEN_MAX) v.towLen05 = 0;
  if (v.bargeType > BARGE_OTHER) v.bargeType = 0;
  if (v.lenUnit > 1) v.lenUnit = 0;
  if (v.tonUnit > 2) v.tonUnit = 0;
  for (float* f : {&v.bLen, &v.bWid, &v.bDf, &v.bDm, &v.bDa, &v.bTon}) if (!(*f > 0 && *f < 1e6f)) *f = 0;
  v.classTxt[VTXT - 1] = v.condTxt[VTXT - 1] = v.towTxt[VTXT - 1] = v.bargeTxt[VTXT - 1] = 0;
  v.voyage[sizeof(v.voyage) - 1] = 0;
}
void loadPersist() {
  Persist t;
  bool ok = eepromRead(EEPROM_BASE, (uint8_t*)&t, sizeof(t));
  if (ok && (t.magic == PERSIST_MAGIC_V12 || t.magic == PERSIST_MAGIC_V13 || t.magic == PERSIST_MAGIC_V14 ||
             t.magic == PERSIST_MAGIC_V15 || t.magic == PERSIST_MAGIC_V16 || t.magic == PERSIST_MAGIC_V17 ||
             t.magic == PERSIST_MAGIC_V18 || t.magic == PERSIST_MAGIC_V19 || t.magic == PERSIST_MAGIC_V20 || t.magic == PERSIST_MAGIC_V21 ||
             t.magic == PERSIST_MAGIC_V22 || t.magic == PERSIST_MAGIC_V23 || t.magic == PERSIST_MAGIC_V24 ||
             t.magic == PERSIST_MAGIC_V25 || t.magic == PERSIST_MAGIC_V26 || t.magic == PERSIST_MAGIC_V27 ||
             t.magic == PERSIST_MAGIC_V28 || t.magic == PERSIST_MAGIC_V29 || t.magic == PERSIST_MAGIC_V30 ||
             t.magic == PERSIST_MAGIC_V31 || t.magic == PERSIST_MAGIC_V32 || t.magic == PERSIST_MAGIC_V33 || t.magic == PERSIST_MAGIC_V34)) {
    // older layout: the same leading fields, newer fields added at the end (zero = default)
    size_t crcAt = t.magic == PERSIST_MAGIC_V12 ? offsetof(Persist, briWeb)
                 : t.magic == PERSIST_MAGIC_V13 ? offsetof(Persist, logRate)
                 : t.magic == PERSIST_MAGIC_V14 ? offsetof(Persist, gmLcFt100)
                 : t.magic == PERSIST_MAGIC_V15 ? offsetof(Persist, posFmt)
                 : t.magic == PERSIST_MAGIC_V16 ? offsetof(Persist, vmrXdm)
                 : t.magic == PERSIST_MAGIC_V17 ? offsetof(Persist, ledPin)
                 : t.magic == PERSIST_MAGIC_V18 ? offsetof(Persist, windRate)
                 : t.magic == PERSIST_MAGIC_V19 ? offsetof(Persist, windYcm)
                 : t.magic == PERSIST_MAGIC_V20 ? offsetof(Persist, zeroRef100)
                 : t.magic == PERSIST_MAGIC_V21 ? offsetof(Persist, magVar10)
                 : t.magic == PERSIST_MAGIC_V22 ? offsetof(Persist, mountX)
                 : t.magic == PERSIST_MAGIC_V25 ? offsetof(Persist, wxSpan) + 1
                 : t.magic == PERSIST_MAGIC_V26 ? offsetof(Persist, ballBest10)
                 : t.magic == PERSIST_MAGIC_V27 ? offsetof(Persist, segFlip)
                 : t.magic == PERSIST_MAGIC_V28 ? offsetof(Persist, segRot)
                 : t.magic == PERSIST_MAGIC_V29 ? offsetof(Persist, battAh10)
                 : t.magic == PERSIST_MAGIC_V30 ? offsetof(Persist, slmOn)
                 : t.magic == PERSIST_MAGIC_V31 ? PERSIST_V31_CRC
                 : t.magic == PERSIST_MAGIC_V32 ? PERSIST_V32_CRC
                 : t.magic == PERSIST_MAGIC_V33 ? PERSIST_V33_CRC
                 : t.magic == PERSIST_MAGIC_V34 ? PERSIST_V34_CRC : offsetof(Persist, lcdMix);   // V23, V24
    uint16_t oldCrc;
    memcpy(&oldCrc, (const uint8_t*)&t + crcAt, sizeof(oldCrc));
    if (oldCrc == crc16((const uint8_t*)&t, crcAt)) {
      Persist n;
      memset(&n, 0, sizeof(n));
      memcpy(&n, &t, crcAt);                            // identical prefix
      if (crcAt <= PERSIST_V31_CRC) { memset(n.xbSrc, 0, sizeof(n.xbSrc)); n.xbScreen = 0; }   // (layout 31's padding byte may have come along)
      if (crcAt <= PERSIST_V32_CRC) memset((uint8_t*)&n + offsetof(Persist, piezoPin), 0, offsetof(Persist, crc) - offsetof(Persist, piezoPin));   // (and layout 32's)
      if (crcAt <= PERSIST_V33_CRC) memset((uint8_t*)&n + offsetof(Persist, windHdg10), 0, offsetof(Persist, crc) - offsetof(Persist, windHdg10));   // (and layout 33's)
      memset(n.apName, 0, sizeof(n.apName));                                                                     // (and layout 34's)
      n.magic = PERSIST_MAGIC;
      if (crcAt <= offsetof(Persist, vmrXdm)) n.vmrXdm = n.vmrYcm = VMR_POS_UNSET;   // newer fields whose zero is a real value
      if (crcAt <= offsetof(Persist, ledPin)) { n.ledPin[0] = 1; n.ledPin[1] = 2; n.ledPin[2] = 3; }   // LEDs: Mark A0, Recording A1, Fault A2
      if (crcAt <= offsetof(Persist, mountX)) n.dispEn = DISP_OLED;   // the OLED stays on
      if (crcAt <= offsetof(Persist, mountX)) n.lcdScreen = LCD_WX;   // weather, not cycling
      else if (t.magic == PERSIST_MAGIC_V23) { n.lcdScreen = t.lcdScreen ? t.lcdScreen - 1 : LCD_WX; n.lcdCycle = 0; }
      if (crcAt <= offsetof(Persist, lcdMix)) { n.lcdMix[0] = 255; n.lcdMix[1] = 96; n.lcdMix[2] = 0; }   // amber
      if (crcAt <= offsetof(Persist, segFlip)) n.scrRot = SCR_ROT_DEF;   // the screens the button stepped before
      if (crcAt <= offsetof(Persist, segRot)) { n.segRot = SEG_ROT_DEF; n.lcdRot = LCD_ROT_ALL; }   // all (no countdown)
      if (crcAt <= offsetof(Persist, slmOn)) n.ethCsPin = 1;   // the laptop port's chip select starts on A0
      if (crcAt <= offsetof(Persist, battAh10) && crcAt > offsetof(Persist, segFlip))   // Health in the rotation if Position
        n.scrRot |= (n.scrRot >> SCREEN_POSITION & 1UL) << SCREEN_HEALTH;            // (Health has the lines Position had)
      if (persistValid(n)) {
        P = n;
        persistFixups();
        Log.println("EEPROM: settings + maxima migrated to new layout");
        savePersist();
        return;
      }
    }
  }
  if (ok && t.magic == PERSIST_MAGIC &&
      t.crc == crc16((const uint8_t*)&t, offsetof(Persist, crc)) && persistValid(t)) {
    P = t;
    persistFixups();
    Log.println("EEPROM: settings + maxima loaded");
  } else {
    persistDefaults();
    Log.println("EEPROM: blank or invalid, writing defaults");
    savePersist();
  }
}

void markPersistDirty(bool urgent) {
  persistDirty = true;
  if (urgent) { persistUrgent = true; persistChangeMs = millis(); }
}

void servicePersist() {
  if (!persistDirty || !eepromOK) return;
  uint32_t now = millis();
  bool due = persistUrgent ? (now - persistChangeMs >= SETTINGS_SAVE_DELAY_MS)
                           : (now - lastPersistSaveMs >= MAXIMA_SAVE_MIN_MS);
  if (!due) return;
  if (savePersist()) { persistDirty = false; persistUrgent = false; }
  else persistChangeMs = now;                  // failed (EEPROM not answering): try again later, not every loop
  lastPersistSaveMs = now;
}

// ============================================================================
//                              1-MINUTE BINS
// ============================================================================
void resetBin(Bin& b) {
  b.rMax = -1e9f; b.rMin = 1e9f; b.pMax = -1e9f; b.pMin = 1e9f; b.yrMax = 0; b.used = false;
}

void serviceBins() {
  if (!bins) return;
  uint32_t now = millis();
  if (now - binStartMs >= 61000UL) {
    for (int i = 0; i < 60; i++) resetBin(bins[i]);
    binIdx = 0; binStartMs = now;
    return;
  }
  while (now - binStartMs >= 1000UL) {
    binStartMs += 1000UL;
    binIdx = (binIdx + 1) % 60;
    resetBin(bins[binIdx]);
  }
}

Win window1m() {
  Win w = {-1e9f, 1e9f, -1e9f, 1e9f, 0, false};
  for (int i = 0; bins && i < 60; i++) {
    const Bin& b = bins[i];
    if (!b.used) continue;
    w.valid = true;
    if (b.rMax > w.rMax) w.rMax = b.rMax;
    if (b.rMin < w.rMin) w.rMin = b.rMin;
    if (b.pMax > w.pMax) w.pMax = b.pMax;
    if (b.pMin < w.pMin) w.pMin = b.pMin;
    if (b.yrMax > w.yrMax) w.yrMax = b.yrMax;
  }
  if (!w.valid) { w.rMax = w.rMin = w.pMax = w.pMin = w.yrMax = NAN; }
  return w;
}

// ============================================================================
//                                   IMU
// ============================================================================
// The CEVA SH2 transport retries a failed I2C write in an endless loop (shtp.c: "while (status == 0)"),
// so a BNO085 that answers the probe and then drops off the bus - holding SDA low - hung the loop
// until the task watchdog restarted the VMR ("IMU re-enable (I2C)", up 317 s, SDA stuck low).
// The driver's write is wrapped: after IMU_WRITE_GIVEUP_MS of failed writes it reports the packet as
// sent, which ends that loop, and flags it; the IMU recovery (re-request, then power-cycle) takes over.
#define IMU_WRITE_GIVEUP_MS 250
int (*imuHalWriteOrig)(sh2_Hal_t*, uint8_t*, unsigned) = nullptr;
uint32_t imuWrFail0 = 0, imuWrFailLast = 0;
int imuHalWrite(sh2_Hal_t* self, uint8_t* buf, unsigned len) {
  int n = imuHalWriteOrig(self, buf, len);
  if (n != 0) return n;
  uint32_t now = millis();
  if (!imuWrFail0 || now - imuWrFailLast > 100) imuWrFail0 = now ? now : 1;   // a new run of failures
  imuWrFailLast = now;
  if (now - imuWrFail0 >= IMU_WRITE_GIVEUP_MS) {
    imuWrFail0 = 0;
    imuWriteGaveUp = true;
    imuWriteGiveUps++;
    return (int)len;
  }
  delay(1);
  return 0;
}
void imuGuardWrites() {                          // after every begin_I2C (it resets the hardware layer)
  sh2_Hal_t* h = bno08x.hal();
  if (h->write != imuHalWrite) { imuHalWriteOrig = h->write; h->write = imuHalWrite; }
}

// true if every command went out; false if a write had to be abandoned (the sensor dropped off the bus)
bool imuEnableReports() {
  imuWriteGaveUp = false;
#if USE_GAME_ROTATION_VECTOR
  bno08x.enableReport(SH2_GAME_ROTATION_VECTOR, IMU_REPORT_US);
#else
  bno08x.enableReport(SH2_ROTATION_VECTOR, IMU_REPORT_US);
#endif
  if (!imuWriteGaveUp) bno08x.enableReport(SH2_GYROSCOPE_CALIBRATED, IMU_REPORT_US);
  if (!imuWriteGaveUp) bno08x.enableReport(SH2_ACCELEROMETER, IMU_REPORT_US);   // gravity included (felt acceleration)
  if (!imuWriteGaveUp) bno08x.enableReport(SH2_MAGNETIC_FIELD_CALIBRATED, MAG_REPORT_US);   // magnetometer test
  return !imuWriteGaveUp;
}
// A re-enable that could not be sent: try again in 2 s; if the IMU stays silent the
// usual recovery steps follow (re-request, then power-cycle the STEMMA QT rail).
void imuReenableFailed(uint32_t now) {
  imuNeedReports = true;
  imuReenFailMs = now ? now : 1;
  Log.printf("IMU: sensor dropped off the I2C bus while being sent commands (%lu) - retrying\n",
             (unsigned long)imuWriteGiveUps);
}

// The BNO08x library has ONE session slot, and begin_I2C() opens a new session
// without closing the old one. A second open fails AND wipes the pointer to the
// first, after which it can never be closed (closing then crashes). So: close
// any session we opened before trying again, and once the IMU has started,
// never call begin_I2C() again (recovery reuses the session, see imuRecoverI2C).
bool imuBegin() {
  if (!imuAcks()) return false;                // never start the driver on a silent sensor
  if (imuSessionOpen) { sh2_close(); imuSessionOpen = false; }
  imuSessionOpen = true;                       // begin_I2C runs sh2_open once the sensor answers
  if (!bno08x.begin_I2C(BNO_ADDR, &Wire)) return false;
  imuGuardWrites();
  imuStarted = true;
  sh2_setSensorCallback(imuEventHandler, nullptr);   // see imuEventHandler()
  if (!imuEnableReports()) imuReenableFailed(millis());
  return true;
}

// IMU mounting (the Add-ons card). The BNO085 reports in its own axes; mntM turns them into ship axes
// (X bow, Y port, Z up): its columns are where the board's X, Y and Z point (Y = Z x X). The
// orientation becomes q_ship = q_sensor (x) conj(q_M), q_M the rotation of mntM. Done once, as each
// report arrives, so everything after it (roll, pitch, rate of turn, the G-meter, waves, the
// magnetometer) works in ship axes for any mounting: flat, upside down, either kind of bulkhead.
float mntM[3][3] = {{1, 0, 0}, {0, 1, 0}, {0, 0, 1}};
float mntQc[4] = {1, 0, 0, 0};          // conj(q_M): w, x, y, z
bool  mntId = true;
void mountApply() {
  const int8_t *xv = MNT_V[P.mountX], *zv = MNT_V[MNT_ZDIR[P.mountZ]];
  int8_t yv[3] = {(int8_t)(zv[1] * xv[2] - zv[2] * xv[1]), (int8_t)(zv[2] * xv[0] - zv[0] * xv[2]), (int8_t)(zv[0] * xv[1] - zv[1] * xv[0])};
  for (int r = 0; r < 3; r++) { mntM[r][0] = xv[r]; mntM[r][1] = yv[r]; mntM[r][2] = zv[r]; }
  float (*M)[3] = mntM, w, x, y, z, t = M[0][0] + M[1][1] + M[2][2];
  if (t > 0) { float q = sqrtf(t + 1) * 2; w = 0.25f * q; x = (M[2][1] - M[1][2]) / q; y = (M[0][2] - M[2][0]) / q; z = (M[1][0] - M[0][1]) / q; }
  else if (M[0][0] > M[1][1] && M[0][0] > M[2][2]) { float q = sqrtf(1 + M[0][0] - M[1][1] - M[2][2]) * 2; w = (M[2][1] - M[1][2]) / q; x = 0.25f * q; y = (M[0][1] + M[1][0]) / q; z = (M[0][2] + M[2][0]) / q; }
  else if (M[1][1] > M[2][2]) { float q = sqrtf(1 + M[1][1] - M[0][0] - M[2][2]) * 2; w = (M[0][2] - M[2][0]) / q; x = (M[0][1] + M[1][0]) / q; y = 0.25f * q; z = (M[1][2] + M[2][1]) / q; }
  else { float q = sqrtf(1 + M[2][2] - M[0][0] - M[1][1]) * 2; w = (M[1][0] - M[0][1]) / q; x = (M[0][2] + M[2][0]) / q; y = (M[1][2] + M[2][1]) / q; z = 0.25f * q; }
  mntQc[0] = w; mntQc[1] = -x; mntQc[2] = -y; mntQc[3] = -z;
  mntId = P.mountX == MNT_BOW && P.mountZ == 0;
}
void mountVec(float& x, float& y, float& z) {     // sensor axes -> ship axes
  if (mntId) return;
  float a = x, b = y, c = z;
  x = mntM[0][0] * a + mntM[0][1] * b + mntM[0][2] * c;
  y = mntM[1][0] * a + mntM[1][1] * b + mntM[1][2] * c;
  z = mntM[2][0] * a + mntM[2][1] * b + mntM[2][2] * c;
}
void mountQuat(float& r, float& i, float& j, float& k) {
  if (mntId) return;
  float a = r, b = i, c = j, d = k, w = mntQc[0], x = mntQc[1], y = mntQc[2], z = mntQc[3];
  r = a * w - b * x - c * y - d * z;
  i = a * x + b * w + c * z - d * y;
  j = a * y - b * z + c * w + d * x;
  k = a * z + b * y - c * x + d * w;
}
String mountText() {
  String t = String("board X arrow to the ") + MNT_NAME[P.mountX] + ", chip facing " + MNT_NAME[MNT_ZDIR[P.mountZ]];
  if (P.axFlip) t += String(" / sign flips:") + (P.axFlip & 1 ? " roll" : "") + (P.axFlip & 2 ? " pitch" : "") + (P.axFlip & 4 ? " yaw" : "");
  return t;
}

void quatToEuler(float qr, float qi, float qj, float qk) {
  float sqr = qr * qr, sqi = qi * qi, sqj = qj * qj, sqk = qk * qk;
  float n = sqi + sqj + sqk + sqr;
  if (n <= 0) return;
  float yaw = atan2f(2.0f * (qi * qj + qk * qr), (sqi - sqj - sqk + sqr));
  float sp  = -2.0f * (qi * qk - qj * qr) / n;
  if (sp > 1.0f) sp = 1.0f;
  if (sp < -1.0f) sp = -1.0f;
  float pit = asinf(sp);
  float rol = atan2f(2.0f * (qj * qk + qi * qr), (-sqi - sqj + sqk + sqr));
  rawRoll  = rol * R2D;             // + = starboard side down (ship axes: the mounting is already undone)
  if (P.axFlip & 1) rawRoll = -rawRoll;    // the the Add-ons card flips
  rawPitch = -pit * R2D;            // + = bow up
  if (P.axFlip & 2) rawPitch = -rawPitch;
  yawDeg   = -yaw * R2D;            // quaternion yaw is CCW-positive; make it heading-like
  if (P.axFlip & 4) yawDeg = -yawDeg;
  yawDeg   = fmodf(yawDeg + 360.0f, 360.0f);
}

// ---- ROLLPERIOD BEGIN ----
// Roll period: time between upward zero-crossings of roll about its running,
// trend-following mean. Roll is first low-passed (2 stages, ~1 Hz) to strip
// noise and vibration; the delay is the same at every crossing, so the period
// is unaffected. Hysteresis: a cycle counts only if it swung beyond +/-HYST
// both ways. Crossing times are interpolated between IMU samples. Result =
// median of the last ROLL_PERIOD_CYCLES cycles (at least 3), cleared after
// 60 s without a cycle or after a data gap.
// Each accepted cycle is also stored for the roll statistics (rsCyc).
void updateRollPeriod(uint32_t now) {
  if (isnan(rpMean) || now - rpPrevMs > 2000) {     // first sample, or after a gap
    rpMean = rpM2 = rpLp1 = rpLp2 = roll; rpPrevMs = now; rpPrevX = 0; rpMaxSince = 0;
    rpArmed = false; rpLastCrossMs = 0; rpCount = 0; rollPeriod = NAN;
    rpMinSince = 0; rpPkS = -INFINITY; rpPkP = INFINITY;
    return;
  }
  float dt = (now - rpPrevMs) / 1000.0f;
  float a = dt / (0.15f + dt);                         // 2 x first-order, tau 0.15 s
  rpLp1 += a * (roll - rpLp1);
  rpLp2 += a * (rpLp1 - rpLp2);
  // Double-exponential mean (2*m1 - m2): follows a steadily changing list
  // without lagging behind it, which a plain running mean would.
  float k = dt / (ROLL_PERIOD_MEAN_S + dt);
  rpMean += k * (rpLp2 - rpMean);
  rpM2   += k * (rpMean - rpM2);
  float x = rpLp2 - (2.0f * rpMean - rpM2);
  if (x < -ROLL_PERIOD_HYST_DEG) rpArmed = true;
  if (rpArmed && rpPrevX < 0 && x >= 0) {             // upward zero-crossing
    uint32_t tc = rpPrevMs + (uint32_t)((now - rpPrevMs) * (-rpPrevX / (x - rpPrevX)));
    if (rpLastCrossMs && rpMaxSince > ROLL_PERIOD_HYST_DEG) {
      float per = (tc - rpLastCrossMs) / 1000.0f;
      if (per >= 2.0f && per <= 60.0f) {
        rpHist[rpIdx] = per;
        rpIdx = (rpIdx + 1) % ROLL_PERIOD_CYCLES;
        if (rpCount < ROLL_PERIOD_CYCLES) rpCount++;
        if (rsCyc) {                                  // for the roll statistics card
          RollCycle& c = rsCyc[rsHead];
          c.ms = now;
          c.amp10 = (int16_t)lroundf(5.0f * (rpMaxSince - rpMinSince));   // half of peak-to-peak, x10
          c.pkS10 = (int16_t)lroundf(10.0f * rpPkS);
          c.pkP10 = (int16_t)lroundf(10.0f * rpPkP);
          c.per100 = (uint16_t)lroundf(per * 100.0f);
          rsHead = (rsHead + 1) % RS_CYCLES;
          if (rsCount < RS_CYCLES) rsCount++;
        }
      }
    }
    rpLastCrossMs = tc;
    rpArmed = false;
    rpMaxSince = x;
    rpMinSince = x;
    rpPkS = -INFINITY; rpPkP = INFINITY;
  }
  if (x > rpMaxSince) rpMaxSince = x;
  if (x < rpMinSince) rpMinSince = x;
  if (roll > rpPkS) rpPkS = roll;
  if (roll < rpPkP) rpPkP = roll;
  rpPrevX = x;
  rpPrevMs = now;

  if (rpLastCrossMs && now - rpLastCrossMs > 60000UL) rpCount = 0;   // motion stopped
  if (rpCount >= 3) {
    float t[ROLL_PERIOD_CYCLES];
    for (int i = 0; i < rpCount; i++) t[i] = rpHist[i];
    for (int i = 1; i < rpCount; i++)                    // insertion sort, n <= 9
      for (int m = i; m > 0 && t[m - 1] > t[m]; m--) { float q = t[m]; t[m] = t[m - 1]; t[m - 1] = q; }
    rollPeriod = (rpCount % 2) ? t[rpCount / 2] : 0.5f * (t[rpCount / 2 - 1] + t[rpCount / 2]);
  } else {
    rollPeriod = NAN;
  }
}
// ---- ROLLPERIOD END ----

// Every IMU sample: 10 s blocks of roll sum / sum of squares (mean list, RMS)
void rollStatsSample(uint32_t now) {
  if (rsCur.n == 0) rsCurStartMs = now;
  rsCur.sum += roll; rsCur.sumSq += roll * roll; rsCur.n++;
  if (now - rsCurStartMs >= RS_BLOCK_MS) {
    if (!rsBlk) { rsCur = {0, 0, 0}; return; }
    rsBlk[rsBlkHead] = rsCur;
    rsBlkHead = (rsBlkHead + 1) % RS_BLOCKS;
    if (rsBlkCount < RS_BLOCKS) rsBlkCount++;
    rsCur = {0, 0, 0};
  }
}

// GM from the natural roll period, IMO IS Code 2008 (Part A, 2.3): T = 2 C B / sqrt(GM),
// C = 0.373 + 0.023 B/d - 0.043 L/100  ->  GM = (2 C B / T)^2.
// T = the peak of the roll spectrum (Waves analysis, last 17 min, every 30 s), not the
// zero-crossing roll period: rolls timed one by one mix the natural roll with rolling forced at
// the wave period, and their median sits between the two - in the 2026-11-01 loaded recording
// 13.7 s against a 14.6 s spectrum peak, GM about 18-19 ft against CargoMax 14.48 (the peak:
// 15.4 ft). No GM in the first 8.5 min of steady motion, at the dock or paused. A roll peak near the
// encounter period gets no note: overnight on 2026-11-03 the peak stayed at 15.3 s while the
// encounter period moved 11.4-15.9 s - the natural roll, not forced.
void updateGm() {
  if (!P.shipBeamCm || !P.shipDraftCm || (!P.shipLengthDm && !P.shipLbpDm)) { gmC = gmEst = NAN; return; }
  float B = P.shipBeamCm / 100.0f, d = P.shipDraftCm / 100.0f;
  float L = shipLengthM();                          // the formula wants the waterline length: LBP, else LOA
  gmC = 0.373f + 0.023f * (B / d) - 0.043f * (L / 100.0f);
  float T = wvCurrent ? wvTrs : NAN;                // never from an old estimate
  if (isnan(T) || T <= 0 || gmC <= 0) { gmEst = NAN; return; }
  float r = 2.0f * gmC * B / T;
  gmEst = r * r;
}

// ---- Waves: sampling (2 Hz) and Welch spectra --------------------------------
// In-place radix-2 FFT (n a power of two)
static void fftR2(float* re, float* im, int n) {
  for (int i = 1, j = 0; i < n; i++) {
    int bit = n >> 1;
    for (; j & bit; bit >>= 1) j ^= bit;
    j ^= bit;
    if (i < j) { float t = re[i]; re[i] = re[j]; re[j] = t; t = im[i]; im[i] = im[j]; im[j] = t; }
  }
  for (int len = 2; len <= n; len <<= 1) {
    float ang = -2.0f * (float)M_PI / len, wr = cosf(ang), wi = sinf(ang);
    for (int i = 0; i < n; i += len) {
      float cr = 1, ci = 0;
      for (int k = 0; k < len / 2; k++) {
        float* a = re + i + k; float* b = re + i + k + len / 2;
        float* ai = im + i + k; float* bi = im + i + k + len / 2;
        float tr = *b * cr - *bi * ci, ti = *b * ci + *bi * cr;
        *b = *a - tr; *bi = *ai - ti; *a += tr; *ai += ti;
        float nr = cr * wr - ci * wi; ci = cr * wi + ci * wr; cr = nr;
      }
    }
  }
}

// Peak period of a spectrum over k0..k1 (parabolic between bins); NaN if flat
static float wvPeakPeriod(const float* S, int k0, int k1) {
  int kb = -1; float best = 0;
  for (int k = k0; k <= k1; k++) if (S[k] > best) { best = S[k]; kb = k; }
  if (kb < 0) return NAN;
  float d = 0;
  if (kb > k0 && kb < k1) {
    float a = S[kb - 1], b = S[kb], c = S[kb + 1], den = a - 2 * b + c;
    if (den < 0) d = 0.5f * (a - c) / den;
  }
  float f = (kb + d) * (1000.0f / WV_DT_MS) / WV_SEG;
  return f > 0 ? 1.0f / f : NAN;
}

// Start an analysis of the window as it is now (its newest sample, length and segments are kept,
// so the samples added meanwhile do not move it). Oldest segment first: new samples overwrite the
// oldest ones, which are done by then (about 45 loop passes; the window is 2048 samples, 64 s of
// new ones would be needed to reach a segment not yet done).
// the gain at bin k, else at the nearest bin that has one (the mean of the two if one each side is as near); NaN if none
float wvGainNear(const float* g, int k) {
  int k0 = WV_K0;
  while (k0 * (1000.0f / WV_DT_MS) / WV_SEG < 0.05f) k0++;     // 20 s and shorter
  if (!isnan(g[k])) return g[k];
  for (int d = 1; d <= WV_K1 - k0; d++) {
    float a = k - d >= k0 ? g[k - d] : NAN, b = k + d <= WV_K1 ? g[k + d] : NAN;
    if (!isnan(a) && !isnan(b)) return 0.5f * (a + b);
    if (!isnan(a)) return a;
    if (!isnan(b)) return b;
  }
  return NAN;
}
// a window's coherent gains folded into the stored curve (wvLearnNow() of the way, a fifth by default; a bin's first one as
// it is). 0.2-10 only.
void wvGainLearn(const float* gk, float agg) {
  if (!wvGk) return;
  bool any = false;
  for (int k = WV_K0; k <= WV_K1; k++) {
    float x = gk[k];
    if (isnan(x) || x < 0.2f || x > 10.0f) continue;
    wvGk->g[k] = isnan(wvGk->g[k]) ? x : wvGk->g[k] + wvLearnNow() * (x - wvGk->g[k]);
    any = true;
  }
  if (!any) return;
  if (!isnan(agg) && agg >= 0.2f && agg <= 10.0f) wvGk->agg = isnan(wvGk->agg) ? agg : wvGk->agg + wvLearnNow() * (agg - wvGk->agg);
  if (clockSynced) wvGk->unix = nowUnix();
  wvGkDirty = true;
}
// Power-up, after the card is mounted: the stored curve read back (none: all NaN until the IMU and the pressure agree)
void wvGainBegin() {
  wvGk = (WvGain*)ps_malloc(sizeof(WvGain));
  if (!wvGk) return;
  wvGk->magic = WV_GAIN_MAGIC; wvGk->unix = 0; wvGk->agg = NAN;
  for (int k = 0; k <= WV_K1; k++) wvGk->g[k] = NAN;
  if (!sdOK) return;
  File f = SD.open(WV_GAIN_FILE, FILE_READ);
  if (!f) return;
  WvGain t;
  bool ok = f.size() == sizeof(WvGain) && f.read((uint8_t*)&t, sizeof(t)) == (int)sizeof(t) && t.magic == WV_GAIN_MAGIC;
  f.close();
  if (!ok) { Log.println("Waves: the stored pressure gain is not readable, learning it again"); return; }
  int n = 0;
  for (int k = 0; k <= WV_K1; k++) { float x = t.g[k]; wvGk->g[k] = k >= WV_K0 && x >= 0.2f && x <= 10.0f ? x : NAN; if (!isnan(wvGk->g[k])) n++; }
  wvGk->unix = t.unix; wvGk->agg = t.agg >= 0.2f && t.agg <= 10.0f ? t.agg : NAN;
  Log.printf("Waves: pressure gain read back (%d periods, x%.2f)\n", n, wvGk->agg);
}
// The Waves card's Forget learned gain: the curve cleared and its file deleted (learned again while the IMU is on)
void wvGainForget() {
  if (!wvGk) return;
  wvGk->unix = 0; wvGk->agg = NAN;
  for (int k = 0; k <= WV_K1; k++) wvGk->g[k] = NAN;
  wvGkDirty = false; wvHsBc = NAN;
  if (sdOK && sdLock(3000)) { SD.remove(WV_GAIN_FILE); sdUnlock(); }
  Log.println("Waves: the learned pressure gain forgotten (the Waves card)");
}
// loop(): the curve written out when it has changed, at most every 10 min (the first time at once), if the card is free
void wvGainSave(uint32_t now) {
  if (!wvGk || !wvGkDirty || !sdOK) return;
  if (wvGkSaveMs && now - wvGkSaveMs < 600000UL) return;
  if (!sdLock(0)) return;
  if (!SD.exists(WV_GAIN_DIR)) SD.mkdir(WV_GAIN_DIR);
  File f = SD.open(WV_GAIN_TMP, FILE_WRITE);
  bool ok = false;
  if (f) { ok = f.write((const uint8_t*)wvGk, sizeof(WvGain)) == sizeof(WvGain); f.close(); }
  if (ok) { SD.remove(WV_GAIN_FILE); ok = SD.rename(WV_GAIN_TMP, WV_GAIN_FILE); }
  else SD.remove(WV_GAIN_TMP);
  sdUnlock();
  wvGkSaveMs = now | 1;
  if (ok) wvGkDirty = false;
}

void wvAnalyseStart() {
  wvAnM = wvN < WV_N ? wvN : WV_N;
  wvAnSegs = (wvAnM - WV_SEG) / (WV_SEG / 2) + 1;
  wvAnHead = wvHead;
  memset(wvAcc, 0, sizeof(float) * 3 * (WV_K1 + 1));
  memset(wvAccMid, 0, sizeof(float) * (WV_K1 + 1));
  // the pressure over the window's newest segments it covers (the same segments as the motion,
  // so midships works the same), once it has 8.5 min of its own. Not over the whole window: the
  // BMP388's first second after a start is dropped (settling), so it would always fall a few samples
  // short and show nothing until the window was full (17 min) - or never after a gap.
  wvAnB0 = wvBN >= wvAnM ? 0 : (wvAnM - wvBN + WV_SEG / 2 - 1) / (WV_SEG / 2);
  wvAnBSegs = wvAnSegs - wvAnB0;
  wvAnBaro = wvB && wvBN >= WV_MIN && wvAnBSegs >= 1;
  wvAnBOnly = wvBOnly;
  memset(wvAccB, 0, sizeof(float) * (WV_K1 + 1)); memset(wvAccBMid, 0, sizeof(float) * (WV_K1 + 1));
  for (float* a : {wvXr, wvXi, wvXa, wvXrM, wvXiM, wvXaM}) memset(a, 0, sizeof(float) * (WV_K1 + 1));
  bool pos = !wvBOnly && P.vmrXdm != VMR_POS_UNSET && P.vmrYcm != VMR_POS_UNSET;   // both entered (0 = midships / centreline); not without pitch and roll
  wvAnX = pos ? P.vmrXdm / 10.0f : NAN;
  wvAnY = pos ? P.vmrYcm / 100.0f : NAN;
  wvStep = 0;
}

// One FFT: segment wvStep / 4 of signal wvStep % 4 (accelerometer, pitch, pressure height, roll; the
// pressure is skipped when it does not cover the window). After the last one the spectra, heave Hs
// and the peak periods are worked out and published.
void wvAnalyseStep() {
  if (wvStep < 0) return;
  const float fs = 1000.0f / WV_DT_MS, df = fs / WV_SEG;
  int sgi = wvStep / 4, q = wvStep % 4;
  bool bSeg = wvAnBaro && sgi >= wvAnB0;              // this segment is inside the pressure's span
  if ((q != 2 || bSeg) && !(wvAnBOnly && q != 2)) {   // (pressure only: just the pressure)
    const float* src = q == 0 ? wvA : q == 1 ? wvP : q == 2 ? wvB : wvR;
    float* re = wvRe; float* im = wvIm;
    int start = (wvAnHead - wvAnM + sgi * (WV_SEG / 2) + 2 * WV_N) % WV_N;   // oldest of the window + offset
    float mean = 0;
    for (int i = 0; i < WV_SEG; i++) mean += src[(start + i) % WV_N];
    mean /= WV_SEG;
    float slope = 0;                                // the pressure: its straight-line trend too (the weather moving)
    if (q == 2) {
      double sxy = 0, sxx = 0;
      for (int i = 0; i < WV_SEG; i++) { float c = i - (WV_SEG - 1) / 2.0f; sxy += c * (src[(start + i) % WV_N] - mean); sxx += c * c; }
      slope = (float)(sxy / sxx);
    }
    for (int i = 0; i < WV_SEG; i++) {
      float c = i - (WV_SEG - 1) / 2.0f;
      re[i] = (src[(start + i) % WV_N] - mean - slope * c) * wvHann[i]; im[i] = 0;
    }
    fftR2(re, im, WV_SEG);
    if (q == 2) for (int k = 1; k <= WV_K1; k++) wvAccB[k] += re[k] * re[k] + im[k] * im[k];
    else { int row = q == 3 ? 2 : q; for (int k = 1; k <= WV_K1; k++) wvAcc[row][k] += re[k] * re[k] + im[k] * im[k]; }
    if (q == 0) for (int k = 1; k <= WV_K1; k++) { wvCx[0][0][k] = re[k]; wvCx[0][1][k] = im[k]; }   // kept for the cross-spectrum (and midships)
    if (q == 2 && !wvAnBOnly) for (int k = 1; k <= WV_K1; k++) {   // fused: the motion's heave (A / -w^2) against the pressure's height
      float w = 2 * (float)M_PI * k * df, w2 = w * w;
      if (k * df < 0.05f) continue;                 // past 20 s: as the heave
      float ar = -wvCx[0][0][k] / w2, ai = -wvCx[0][1][k] / w2;
      wvXr[k] += ar * re[k] + ai * im[k]; wvXi[k] += ar * im[k] - ai * re[k]; wvXa[k] += ar * ar + ai * ai;
    }
    if (!isnan(wvAnX)) {                            // midships heave: keep this segment's acceleration, pitch, pressure
      if (q == 1 || q == 2) for (int k = 1; k <= WV_K1; k++) { wvCx[q][0][k] = re[k]; wvCx[q][1][k] = im[k]; }
      else for (int k = 1; k <= WV_K1; k++) {       // roll is the last of the four: combine
        float w = 2 * (float)M_PI * k * df, w2 = w * w;
        float pr = wvAnX * D2R * wvCx[1][0][k] - wvAnY * D2R * re[k], pi = wvAnX * D2R * wvCx[1][1][k] - wvAnY * D2R * im[k];
        float zr = -wvCx[0][0][k] / w2 - pr, zi = -wvCx[0][1][k] / w2 - pi;
        wvAccMid[k] += zr * zr + zi * zi;
        if (bSeg) {
          float br = wvCx[2][0][k] - pr, bi = wvCx[2][1][k] - pi;   // already height
          wvAccBMid[k] += br * br + bi * bi;
          if (k * df >= 0.05f) { wvXrM[k] += zr * br + zi * bi; wvXiM[k] += zr * bi - zi * br; wvXaM[k] += zr * zr + zi * zi; }
        }
      }
    }
  }
  if (++wvStep < wvAnSegs * 4) return;

  wvStep = -1;                                      // all done: scale, publish
  float wsum = 0;
  for (int i = 0; i < WV_SEG; i++) wsum += wvHann[i] * wvHann[i];
  const float sc = 2.0f / (fs * wsum) / wvAnSegs;
  for (int qq = 0; qq < 3; qq++) { wvSpec[qq][0] = 0; for (int k = 1; k <= WV_K1; k++) wvSpec[qq][k] = wvAcc[qq][k] * sc; }
  // heave from acceleration: divide by (2 pi f)^4; below 0.05 Hz (20 s) the integration only amplifies noise
  double m0 = 0;
  for (int k = 1; k <= WV_K1; k++) {
    float f = k * df, w = 2 * (float)M_PI * f;
    wvSpec[0][k] = (f >= 0.05f) ? wvSpec[0][k] / (w * w * w * w) : 0;
    if (k >= WV_K0) m0 += wvSpec[0][k] * df;
  }
  wvHs = 4.0f * sqrtf((float)m0);
  if (!isnan(wvAnX)) {                              // the same band at midships (already displacement)
    double mm = 0;
    for (int k = 1; k <= WV_K1; k++) {
      if (k * df < 0.05f) wvAccMid[k] = 0;          // as the VMR's heave: nothing past 20 s
      else if (k >= WV_K0) mm += wvAccMid[k] * sc * df;
    }
    wvHsMid = 4.0f * sqrtf((float)mm);
    wvTzMid = wvPeakPeriod(wvAccMid, WV_K0, WV_K1);
  } else wvHsMid = wvTzMid = NAN;
  if (wvAnBaro) {                                   // the pressure heave, the same band (2 Hz samples, 1.6-20 s)
    double mb = 0, mbm = 0;
    for (int k = 1; k <= WV_K1; k++) {
      if (k * df < 0.05f) { wvAccB[k] = wvAccBMid[k] = 0; continue; }   // past 20 s: the weather, not the ship
      const float scB = sc * wvAnSegs / wvAnBSegs;   // averaged over its own segments
      wvAccB[k] *= scB; wvAccBMid[k] *= scB;
      if (k >= WV_K0) { mb += wvAccB[k] * df; mbm += wvAccBMid[k] * df; }
    }
    wvHsB = 4.0f * sqrtf((float)mb);
    wvTzB = wvPeakPeriod(wvAccB, WV_K0, WV_K1);
    wvHsBMid = isnan(wvAnX) ? NAN : 4.0f * sqrtf((float)mbm);
  } else wvHsB = wvHsBMid = wvTzB = NAN;
  wvHsF = wvHsFMid = wvCohF = wvGainB = wvHsBc = NAN;
  if (wvAnBaro && !wvAnBOnly) {                     // fused (see wvXr): the gain period by period, then the blend
    const float scB = sc * wvAnSegs / wvAnBSegs;
    float* gk = wvRe;                               // this window's gain by bin (NaN where the two do not agree); wvRe is free now
    const float coh = wvCohNow(), bA = wvBlendANow(), bB = wvBlendBNow() > bA ? wvBlendBNow() : bA + 1.0f;   // (the Waves card's advanced settings)
    double gc = 0, ga = 0, cw = 0, aw = 0;
    // one place's fused Hs: where coherent the motion's own; elsewhere the motion's to bA s, from bB s the shared part over
    // the gain at the nearest coherent period (this window's, else the stored curve), blended between
    auto fused = [&](const float* Xr, const float* Xi, const float* Xa, const float* Sb, bool main) {
      for (int k = 0; k <= WV_K1; k++) gk[k] = NAN;
      for (int k = WV_K0; k <= WV_K1; k++) {
        float f = k * df; if (f < 0.05f) continue;
        float Sa = Xa[k] * scB, C = sqrtf(Xr[k] * Xr[k] + Xi[k] * Xi[k]) * scB;
        float g2 = Sa > 0 && Sb[k] > 0 ? C * C / (Sa * Sb[k]) : 0;
        if (g2 >= coh && Sa > 0) gk[k] = C / Sa;
        if (main) { cw += g2 * Sa; aw += Sa; if (f >= 1.0f / 12.0f && g2 >= coh) { gc += C; ga += Sa; } }
      }
      double m = 0;
      for (int k = WV_K0; k <= WV_K1; k++) {
        float f = k * df; if (f < 0.05f) continue;
        float T = 1.0f / f, Sa = Xa[k] * scB, C = sqrtf(Xr[k] * Xr[k] + Xi[k] * Xi[k]) * scB;
        if (!isnan(gk[k])) { m += Sa * df; continue; }                     // the two agree: the motion stands
        float w = T <= bA ? 1.0f : T >= bB ? 0.0f : (bB - T) / (bB - bA);   // the motion's weight
        float g = w < 1.0f ? wvGainNear(gk, k) : NAN;
        if (isnan(g) && wvGk) g = wvGainNear(wvGk->g, k);
        m += (w * Sa + (1.0f - w) * (isnan(g) ? Sa : C / g)) * df;
      }
      return 4.0f * sqrtf((float)m);
    };
    wvHsFMid = isnan(wvAnX) ? NAN : fused(wvXrM, wvXiM, wvXaM, wvAccBMid, false);
    wvHsF = fused(wvXr, wvXi, wvXa, wvAccB, true);  // last: gk is the VMR's, for the stored curve
    wvCohF = aw > 0 ? (float)(cw / aw) : NAN;
    wvGainB = ga > 0 ? (float)(gc / ga) : NAN;      // the pressure's height / the motion's (1 = the same), 12 s and shorter
    wvGainLearn(gk, wvGainB);
  }
  if (wvAnBaro && wvAnBOnly && wvGk) {               // pressure only: corrected by the stored gain, period by period
    double m = 0; bool any = false;
    for (int k = WV_K0; k <= WV_K1; k++) {
      if (k * df < 0.05f) continue;
      float g = wvGainNear(wvGk->g, k);
      if (isnan(g)) { m = 0; any = false; break; }
      m += wvAccB[k] / (g * g) * df; any = true;
    }
    if (any) wvHsBc = 4.0f * sqrtf((float)m);
  }
  if (wvAnBOnly) {                                  // pressure only: nothing from the motion
    wvHs = wvHsMid = wvTzMid = NAN;
    memset(wvSpec, 0, sizeof(float) * 3 * (WV_K1 + 1));
  }
  wvTz = wvAnBOnly ? NAN : wvPeakPeriod(wvSpec[0], WV_K0, WV_K1);
  wvTe = wvAnBOnly ? NAN : wvPeakPeriod(wvSpec[1], WV_K0, WV_K1);       // pitching period = encounter period (MSC.1/Circ.1228, 1.6)
  wvTrs = wvAnBOnly ? NAN : wvPeakPeriod(wvSpec[2], WV_K0, WV_K1);
  wvCurrent = true;
  wvLastMs = millis() | 1;
  wvNewForLog = true;
}

// 2-Hz sample of the 0.5-s mean; a gap, pause or stale IMU starts the window again
void wvTick(uint32_t now) {
  wvAnalyseStep();                                    // one FFT of a running analysis per loop pass
  wvGainSave(now);                                    // the pressure's gain by period, to the card when due
  if (now - wvMs < WV_DT_MS) return;
  wvMs = (now - wvMs > 2000) ? now : wvMs + WV_DT_MS;
  if (!wvA) {                                         // all of this on the heap, at first use (the large arrays land in PSRAM)
    // every one in PSRAM (the small ones, about 8 KB, would land in internal RAM, which the Wi-Fi needs)
    wvA = psNew<float>(WV_N); wvR = psNew<float>(WV_N); wvP = psNew<float>(WV_N);
    wvRe = psNew<float>(WV_SEG); wvIm = psNew<float>(WV_SEG);
    wvSpec = psNew<float[WV_K1 + 1]>(3);
    wvAcc = psNew<float[WV_K1 + 1]>(3); wvHann = psNew<float>(WV_SEG);
    wvCx = psNew<float[2][WV_K1 + 1]>(3); wvAccMid = psNew<float>(WV_K1 + 1);
    wvB = psNew<float>(WV_N); wvAccB = psNew<float>(WV_K1 + 1); wvAccBMid = psNew<float>(WV_K1 + 1);
    wvXr = psNew<float>(WV_K1 + 1); wvXi = psNew<float>(WV_K1 + 1); wvXa = psNew<float>(WV_K1 + 1);
    wvXrM = psNew<float>(WV_K1 + 1); wvXiM = psNew<float>(WV_K1 + 1); wvXaM = psNew<float>(WV_K1 + 1);
    if (!wvA || !wvR || !wvP || !wvRe || !wvIm || !wvSpec || !wvAcc || !wvHann || !wvCx || !wvAccMid || !wvB || !wvAccB || !wvAccBMid ||
        !wvXr || !wvXi || !wvXa || !wvXrM || !wvXiM || !wvXaM) {
      free(wvA); free(wvR); free(wvP); free(wvRe); free(wvIm); free(wvSpec); free(wvAcc); free(wvHann);
      free(wvCx); free(wvAccMid); free(wvB); free(wvAccB); free(wvAccBMid);
      free(wvXr); free(wvXi); free(wvXa); free(wvXrM); free(wvXiM); free(wvXaM);
      wvA = wvR = wvP = wvRe = wvIm = wvHann = wvAccMid = wvB = wvAccB = wvAccBMid = nullptr; wvSpec = wvAcc = nullptr; wvCx = nullptr;
      wvXr = wvXi = wvXa = wvXrM = wvXiM = wvXaM = nullptr; return;
    }
    memset(wvSpec, 0, sizeof(float) * 3 * (WV_K1 + 1));
    for (int i = 0; i < WV_SEG; i++) wvHann[i] = 0.5f - 0.5f * cosf(2 * (float)M_PI * i / WV_SEG);
  }
  // the motion and the pressure; with the IMU off (Add-ons), the pressure alone (a change of mode starts the window again)
  bool bOnly = P.imuOff;
  if (bOnly != wvBOnly) { wvBOnly = bOnly; wvN = 0; wvBN = 0; wvStep = -1; wvCurrent = false; }
  bool ok = !paused && !P.atDock && (bOnly || (imuFresh() && wvCnt > 0));   // at the dock: no wave analysis (pressure only: a missed reading below)
  float a = wvCnt ? (float)(wvSumA / wvCnt) : 0;
  float mp = wvCnt ? (float)(wvSumP / wvCnt) : pitch, mr = wvCnt ? (float)(wvSumR / wvCnt) : roll;
  wvSumA = wvSumP = wvSumR = 0; wvCnt = 0;
  float zb = NAN;                                     // the pressure's 0.5-s mean as height (m, + up)
  if (wvCntB) {
    float p = (float)(wvSumB / wvCntB);
    float tK = (!isnan(extTa) ? extTa : !isnan(extTb) ? extTb : 15.0f) + 273.15f;
    if (wvBN == 0 || isnan(wvBRef)) wvBRef = p;       // a new run of samples: heights about here
    zb = -(p - wvBRef) / (p / (287.05f * tK) * 9.80665f);
  }
  wvSumB = 0; wvCntB = 0;
  if (!ok) { wvN = 0; wvBN = 0; wvStep = -1; wvCurrent = false; return; }   // the last estimate stays, marked old
  // pitch and roll as 0.5-s means over the same samples as the acceleration (the value at the
  // tick is 0.25 s later than the acceleration's middle: about 9 deg of phase at 10 s, which
  // the midships heave would feel)
  wvA[wvHead] = a; wvR[wvHead] = mr; wvP[wvHead] = mp;
  // a tick or two with no reading (a loop hold-up) keeps the last height rather than starting
  // the pressure's window again; longer than 1.5 s, or the BMP388 failing, does start it again
  static float zbLast = NAN; static uint8_t zbMiss = 0;
  if (isnan(zb) && wvBN > 0 && !isnan(zbLast) && zbMiss < 3) { zb = zbLast; zbMiss++; }
  else if (!isnan(zb)) zbMiss = 0;
  zbLast = zb;
  wvB[wvHead] = isnan(zb) ? 0 : zb;
  if (isnan(zb)) { wvBN = 0; if (bOnly) { wvN = 0; wvStep = -1; wvCurrent = false; return; } } else if (wvBN < WV_N) wvBN++;
  wvHead = (wvHead + 1) % WV_N;
  if (wvN < WV_N) wvN++;
  if (wvN >= WV_MIN && now - wvCalcMs >= 30000 && wvStep < 0) { wvCalcMs = now; wvAnalyseStart(); }
}

// Waves card Reset: the window, the estimates and the spectra cleared; the first new
// estimate comes after WV_MIN (8.5 min) of steady motion. A recording gets a WAVES RESET event.
void wvReset() {
  wvN = 0; wvBN = 0; wvStep = -1; wvCurrent = false; wvLastMs = 0; wvNewForLog = false; wvCalcMs = 0;
  wvTe = wvTz = wvTrs = wvHs = wvHsMid = wvTzMid = NAN;
  wvHsB = wvHsBMid = wvTzB = NAN;
  wvHsF = wvHsFMid = wvCohF = wvGainB = wvHsBc = NAN;
  if (wvSpec) memset(wvSpec, 0, sizeof(float) * 3 * (WV_K1 + 1));
  gmEst = NAN;
  if (logging && !paused && !sysEvent) sysEvent = "WAVES RESET (dashboard)";
  Log.println("Waves: reset from the dashboard, collecting again");
}

// GET /wavegain: the learned pressure gain by bin (k = WV_K0..WV_K1, null where none), when, and the 12-s-and-shorter gain
void handleWaveGain() {
  String j; j.reserve(900);
  j = "{\"df\":"; j += String((1000.0f / WV_DT_MS) / WV_SEG, 6); j += ",\"k0\":"; j += WV_K0;
  j += ",\"t\":"; j += wvGk ? (unsigned long)wvGk->unix : 0UL;
  j += ",\"agg\":"; if (wvGk && !isnan(wvGk->agg)) j += String(wvGk->agg, 3); else j += "null";
  j += ",\"now\":["; for (int k = WV_K0; k <= WV_K1; k++) { if (k > WV_K0) j += ','; float g = wvGk ? wvGk->g[k] : NAN; if (isnan(g)) j += "null"; else j += String(g, 3); }
  j += "],\"wg\":"; if (isnan(wvGainB)) j += "null"; else j += String(wvGainB, 3);
  j += '}';
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}
// GET /wave -> the last spectra for the Waves card (bins k = WV_KSEND..WV_K1)
void handleWave() {
  String j;
  j.reserve(3 * (WV_K1 - WV_KSEND + 1) * 10 + 64);
  j = "{\"df\":"; j += String((1000.0f / WV_DT_MS) / WV_SEG, 6); j += ",\"k0\":"; j += WV_KSEND;
  const char* key[3] = {"z", "p", "r"};
  for (int q = 0; q < 3; q++) {
    j += ",\""; j += key[q]; j += "\":[";
    for (int k = WV_KSEND; k <= WV_K1; k++) { if (k > WV_KSEND) j += ','; j += String(wvSpec && wvLastMs ? wvSpec[q][k] : 0.0f, 6); }
    j += ']';
  }
  j += '}';
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

// ---- At the dock: trim from the pitch, list from the roll -------------------
// Trim = L x tan(pitch), L = LBP (LOA if none), + = by the stern (bow up). The pitch is measured
// from the trim calibration (drafts read at the marks) when there is one, else
// from level zero. Close one 1 s mean per second; refresh the window's means.
uint16_t dockAvgS() { return P.dockAvg10 ? P.dockAvg10 * 10 : 60; }
uint16_t dockFill() { return min(dockCount, dockAvgS()); }   // seconds of the window seen so far
void serviceDock(uint32_t now) {
  if (now - dockSecMs < 1000) return;
  dockSecMs = (now - dockSecMs > 3000) ? now : dockSecMs + 1000;
  if (!dockSecP) {
    dockSecP = psNew<float>(DOCK_MAX_S);                // PSRAM (2.4 KB off internal RAM)
    dockSecR = psNew<float>(DOCK_MAX_S);
    if (!dockSecP || !dockSecR) { free(dockSecP); free(dockSecR); dockSecP = dockSecR = nullptr; return; }
  }
  dockSecP[dockHead] = dockAccN ? (float)(dockAccP / dockAccN) : NAN;
  dockSecR[dockHead] = dockAccN ? (float)(dockAccR / dockAccN) : NAN;
  dockAccP = dockAccR = 0; dockAccN = 0;
  dockHead = (dockHead + 1) % DOCK_MAX_S;
  if (dockCount < DOCK_MAX_S) dockCount++;
  double sp = 0, sr = 0;
  int n = 0;
  for (int i = 0, w = dockFill(); i < w; i++) {         // the newest w seconds
    int k = (dockHead + DOCK_MAX_S - 1 - i) % DOCK_MAX_S;
    if (!isnan(dockSecP[k])) { sp += dockSecP[k]; sr += dockSecR[k]; n++; }
  }
  dockN = n;
  dockRawPitch = n ? (float)(sp / n) : NAN;
  dockRoll = n ? (float)(sr / n) : NAN;
}

// Ship length for the GM estimate and the trim: LBP if entered, else LOA (NaN = none)
float shipLengthM() {
  if (P.shipLbpDm) return P.shipLbpDm / 10.0f;
  return P.shipLengthDm ? P.shipLengthDm / 10.0f : NAN;
}

// Trim angle (deg, + = by the stern) from a raw sensor pitch
// Level zero with drafts: the deck slope at the VMR, bow up +, deg. The keel line is the straight
// line through the forward and aft drafts plus the hog / sag as a parabola between the perpendiculars,
// zero at the ends and M - (F + A) / 2 at midships (+ = sagging): its slope at x m forward of midships is
// (A - F) / L + 8 * sag * x / L^2. trim and hs: the two parts. NaN without the fwd and aft drafts and a length.
float levelRefPitch(float& trimDeg, float& hsDeg) {
  trimDeg = hsDeg = NAN;
  float L = shipLengthM();
  if (!P.draftFwdCm || !P.draftAftCm || isnan(L) || L < 5) return NAN;
  float F = P.draftFwdCm / 100.0f, A = P.draftAftCm / 100.0f, sag = P.draftMidCm ? P.draftMidCm / 100.0f - (F + A) / 2 : 0.0f;
  float x = P.vmrXdm != VMR_POS_UNSET ? P.vmrXdm / 10.0f : 0.0f;
  float t = (A - F) / L, hs = 8.0f * sag * x / (L * L);
  trimDeg = atanf(t) * R2D;
  hsDeg = atanf(t + hs) * R2D - trimDeg;
  return atanf(t + hs) * R2D;
}

float trimAngle(float rawP) {
  return rawP - (P.trimCal ? P.trimPitchOffset : P.zeroApplied ? P.pitchOffset : 0.0f);
}

// Trim in metres (+ = by the stern) from a raw sensor pitch
float trimMetres(float rawP) {
  float L = shipLengthM();
  if (isnan(rawP) || isnan(L)) return NAN;
  return L * tanf(trimAngle(rawP) * D2R);
}

// Calibrate from drafts read at the marks (inches): the offset makes the
// window's mean pitch give exactly the trim the drafts show. Loop task.
// The trim calibration's drafts in tenths of an inch (whole inches + calFrac), and as feet-inches ("33-04", "33-04.5")
uint32_t calIn10(int i) { uint16_t w = i == 0 ? P.calFwdIn : i == 1 ? P.calMidIn : P.calAftIn; return w * 10UL + P.calFrac[i]; }
void ftIn10(char* o, size_t n, uint32_t t10) {
  if (t10 % 10) snprintf(o, n, "%lu-%02lu.%lu", (unsigned long)(t10 / 120), (unsigned long)(t10 % 120 / 10), (unsigned long)(t10 % 10));
  else snprintf(o, n, "%lu-%02lu", (unsigned long)(t10 / 120), (unsigned long)(t10 % 120 / 10));
}
void trimCalibrate(uint16_t fwd10, uint16_t mid10, uint16_t aft10) {      // tenths of an inch (mid 0 = not read)
  float L = shipLengthM();
  if (isnan(L) || isnan(dockRawPitch) || dockN < DOCK_CAL_MIN) return;   // checked by the web handler too
  float trueDeg = atanf((aft10 - (float)fwd10) * 0.00254f / L) * R2D;
  P.trimPitchOffset = dockRawPitch - trueDeg;
  P.trimCal = 1;
  P.calFwdIn = fwd10 / 10; P.calMidIn = mid10 / 10; P.calAftIn = aft10 / 10;
  P.calFrac[0] = fwd10 % 10; P.calFrac[1] = mid10 % 10; P.calFrac[2] = aft10 % 10;
  P.trimCalUnix = clockSynced ? nowUnix() : 0;
  markPersistDirty(true);
  if (logging && !sysEvent) sysEvent = "TRIM CALIBRATED";     // trim_ft changes reference from the next row
  char f[16], m[16], a[16];
  ftIn10(f, sizeof(f), fwd10); ftIn10(m, sizeof(m), mid10); ftIn10(a, sizeof(a), aft10);
  Log.printf("Trim calibrated: F %s M %s A %s, L %.1f m, offset %.3f deg\n", f, m, a, L, P.trimPitchOffset);
}

void updateRollStats(uint32_t now) {
  if (lastStatsMs && now - lastStatsMs < 5000) return;
  lastStatsMs = now;
  updateGm();
  if (!rsCyc || !rsSort) return;
  float* a = rsSort;
  for (int w = 0; w < 2; w++) {
    uint32_t win = RS_WIN_MIN[w] * 60000UL;
    RollStats& st = rStat[w];
    st = {0, NAN, NAN, NAN, NAN, 0, 0, NAN};
    int n = 0;
    for (int i = 0; i < rsCount; i++) {
      const RollCycle& c = rsCyc[(rsHead + RS_CYCLES - 1 - i) % RS_CYCLES];
      if (now - c.ms > win) break;                    // newest first: the rest are older
      a[n++] = c.amp10 / 10.0f;
      if (c.pkS10 >= (int)P.rollThrDeg * 10) st.overS++;
      if (c.pkP10 <= -(int)P.rollThrDeg * 10) st.overP++;
    }
    st.n = n;
    if (n >= 3) {
      std::sort(a, a + n, [](float x, float y) { return x > y; });
      int k = (n + 2) / 3;                            // highest third
      float sum = 0;
      for (int i = 0; i < k; i++) sum += a[i];
      st.sig = sum / k;
      st.maxAmp = a[0];
      for (int i = 0; i < n; i++) a[i] = rsCyc[(rsHead + RS_CYCLES - 1 - i) % RS_CYCLES].per100 / 100.0f;
      std::nth_element(a, a + n / 2, a + n);          // median period (upper middle when n is even)
      st.tMed = a[n / 2];
    }
    double s1 = rsCur.sum, s2 = rsCur.sumSq;          // blocks inside the window + the open one
    uint32_t cnt = rsCur.n;
    int nb = (int)(win / RS_BLOCK_MS) - 1;
    for (int i = 0; i < rsBlkCount && i < nb; i++) {
      const RsBlock& b = rsBlk[(rsBlkHead + RS_BLOCKS - 1 - i) % RS_BLOCKS];
      s1 += b.sum; s2 += b.sumSq; cnt += b.n;
    }
    if (cnt > 50) {
      double m = s1 / cnt, v = s2 / cnt - m * m;
      st.mean = (float)m;
      st.rms = (float)sqrt(v > 0 ? v : 0);
    }
  }
}

// Rate of turn shown on screens and used for maxima: smoothed, deadband applied (deg/min)
float rotShown() {
  float r = rotSmooth * 60.0f;
  return fabsf(r) < P.rotDeadband ? 0.0f : r;
}

void updateAllTime() {
  uint32_t ts = clockSynced ? nowUnix() : 0;
  bool ch = false;
  if (roll  > P.rollMaxPos)  { P.rollMaxPos  = roll;  P.tRollMaxPos  = ts; ch = true; }
  if (roll  < P.rollMaxNeg)  { P.rollMaxNeg  = roll;  P.tRollMaxNeg  = ts; ch = true; }
  if (pitch > P.pitchMaxPos) { P.pitchMaxPos = pitch; P.tPitchMaxPos = ts; ch = true; }
  if (pitch < P.pitchMaxNeg) { P.pitchMaxNeg = pitch; P.tPitchMaxNeg = ts; ch = true; }
  float ayr = fabsf(rotShown()) / 60.0f;
  if (ayr > P.yawRateMax)    { P.yawRateMax  = ayr;   P.tYawRateMax  = ts; ch = true; }
  if (ch) markPersistDirty(false);
}

void onOrientation() {
  uint32_t now = millis();
  if (!haveImu) {
    haveImu = true;
    imuStartMs = now;
    tareRollAvg = rawRoll;
    tarePitchAvg = rawPitch;
  } else {
    float dt = (now - lastImuMs) / 1000.0f;
    float a = dt / (TARE_TAU_S + dt);
    tareRollAvg  += a * (rawRoll  - tareRollAvg);
    tarePitchAvg += a * (rawPitch - tarePitchAvg);
  }
  lastImuMs = now;
  imuQuietRefMs = now;

  roll  = wrap180(rawRoll  - (P.zeroApplied ? P.rollOffset  : 0.0f));
  pitch = wrap180(rawPitch - (P.zeroApplied ? P.pitchOffset : 0.0f));
  if (paused) return;                 // moving: live values only, nothing counted
  dockAccP += rawPitch; dockAccR += roll; dockAccN++;          // at-the-dock means

  if (bins) {
    Bin& b = bins[binIdx];
    if (roll  > b.rMax) b.rMax = roll;
    if (roll  < b.rMin) b.rMin = roll;
    if (pitch > b.pMax) b.pMax = pitch;
    if (pitch < b.pMin) b.pMin = pitch;
    float yr = fabsf(rotShown()) / 60.0f;
    if (yr > b.yrMax) b.yrMax = yr;
    b.used = true;
  }

  updateRollPeriod(now);
  rollStatsSample(now);
  if (now - imuStartMs > WARMUP_MS) {
    updateAllTime();
    char cs;                                         // clinometer drag pointers (and when)
    if (roll > clinoMaxS) { clinoMaxS = roll; clinoMaxSu = utcNow(cs); }
    if (roll < clinoMaxP) { clinoMaxP = roll; clinoMaxPu = utcNow(cs); }
  }
}

// Power-cycle the STEMMA QT rail with SDA and SCL held LOW while it is off. Without that,
// anything still pulling the bus lines up - the ESP32's own pull-ups, or a board powered from
// the Feather's 3V pin (OLED and Adalogger FeatherWings, add-ons not on the STEMMA chain) -
// feeds the BNO085 through its SDA/SCL pins, so it never fully resets: after a software restart
// (OTA update, watchdog) it would stay dead until the whole VMR was power-cycled.
// The lines are released SCL first, then SDA - a STOP, which every device takes as "idle".
// The caller must have ended Wire (or not started it yet).
void stemmaCycle() {
  pinMode(SCL, OUTPUT); digitalWrite(SCL, LOW);
  pinMode(SDA, OUTPUT); digitalWrite(SDA, LOW);
  stemmaPower(false);
  delay(I2C_POWER_OFF_MS);
  stemmaPower(true);
  delay(2);
  pinMode(SCL, INPUT_PULLUP); delayMicroseconds(10);
  pinMode(SDA, INPUT_PULLUP);
  delay(I2C_POWER_SETTLE_MS);
}

// STEMMA QT rail (BNO085 + EEPROM, and the Feather's I2C pull-ups)
void stemmaPower(bool on) {
#if defined(PIN_I2C_POWER)
  if (i2cPowerOff < 0) return;
  digitalWrite(PIN_I2C_POWER, on ? !i2cPowerOff : i2cPowerOff);
#else
  (void)on;
#endif
}

// Is the BNO085 answering? The I2C driver is restarted first (and a stuck bus
// cleared): a BNO085 that resets, or stretches the clock past the driver's
// timeout, during a read can leave the ESP-IDF I2C driver with a late receive
// pending, and the next empty probe then writes it through a null pointer in
// the driver's interrupt (a crash in i2c_isr_receive_handler from
// i2c_master_probe). Every probe here comes after
// such trouble, so restarting the driver each time costs nothing that matters.
bool imuAcks() {
  Wire.end();
  i2cBusClear();
  Wire.begin();
  Wire.setClock(I2C_HZ);
  Wire.beginTransmission(BNO_ADDR);
  return Wire.endTransmission() == 0;
}

// Power-cycle the STEMMA QT rail (IMU, EEPROM, add-ons on the chain) and restart the bus: the last
// step of the IMU recovery, and the dashboard's Reset I2C bus. The loop is held ~1.4 s.
void imuRecoverI2C(uint32_t now) {
  lastImuRecoverMs = now;
  imuRecoveries++;
  Log.printf("IMU: power-cycling STEMMA QT (recovery %lu)\n", (unsigned long)imuRecoveries);
  crumb(ST_IMU_BEGIN);
  Wire.end();
  stemmaCycle();
  i2cBusClear();
  Wire.begin();
  Wire.setClock(I2C_HZ);
  if (P.imuOff) {
    // switched off in the Add-ons card: leave it (its reports stay off after the power cycle)
  } else if (imuStarted) {
    // Keep the existing driver session: the rebooted BNO085 announces a reset,
    // the library reports it through wasReset(), and the reports are re-enabled.
    imuOK = true;
    imuNeedReports = true;                     // backstop in case the reset notice is missed
    Log.printf("IMU: power-cycled, %s\n", imuAcks() ? "answering" : "not answering yet");
  } else {
    imuOK = imuBegin();
    Log.printf("IMU: start %s\n", imuOK ? "OK" : "failed");
  }
  imuQuietRefMs = millis();                    // give it IMU_SILENT_MS to start reporting
  oledReinit();                                // the OLED lost its set-up with the bus: back to the screen it showed
  segOK = lcdOK = false; segRetryMs = lcdRetryMs = 0;   // so did the 7-segment and LCD (powered from the same rail)
  for (int i = 0; i < 3; i++) rgbLast[i] = -1;          // and PCF8574 backlight pins went back to inputs
}

// Every report the BNO085 sends goes through here. (The Adafruit getSensorEvent()
// keeps only the LAST report of each I2C transfer; the BNO085 often packs the
// orientation and gyro reports into one transfer, so orientation would be silently
// dropped for long stretches, which looks like a dead sensor and triggers
// needless power-cycles.)
// One accelerometer sample (m/s2, sensor axes X bow / Y port / Z up) -> ship
// axes in g, mounting tilt removed when level zero is on, then the log sums,
// the G-meter smoothing and its peak hold.
void onAccel(float ax, float ay, float az) {
  const float G = 9.80665f;
  {                                                  // waves: vertical acceleration in the earth frame (+ up)
    float qr = imuQr, qi = imuQi, qj = imuQj, qk = imuQk;
    float azE = 2.0f * (qi * qk - qr * qj) * ax + 2.0f * (qj * qk + qr * qi) * ay + (1.0f - 2.0f * (qi * qi + qj * qj)) * az;
    wvSumA += azE - G; wvSumP += pitch; wvSumR += roll; wvCnt++;
  }
  float f = ax / G, st = -ay / G, u = az / G;         // forward, starboard, up
  if (P.axFlip & 2) f = -f;                           // the the Add-ons card flips, as for pitch and roll
  if (P.axFlip & 1) st = -st;
  if (P.zeroApplied) {                                 // undo the tilt level zero measured (roll, then pitch)
    static float oR = 0, oP = 0, cR = 1, sR = 0, cP = 1, sP = 0;   // cos / sin of the offsets, again only when they change
    if (P.rollOffset != oR || P.pitchOffset != oP) {
      oR = P.rollOffset; oP = P.pitchOffset;
      cR = cosf(oR * D2R); sR = sinf(oR * D2R); cP = cosf(oP * D2R); sP = sinf(oP * D2R);
    }
    float s1 = st * cR + u * sR, u1 = -st * sR + u * cR;
    float f1 = f * cP - u1 * sP, u2 = f * sP + u1 * cP;
    f = f1; st = s1; u = u2;
  }
  uint32_t now = millis();
  bool gap = now - lastAccMs > 1000;
  lastAccMs = now;
  accSumF += f; accSumS += st; accSumU += u; accSumN++;
  const float a = (IMU_REPORT_US / 1e6f) / (0.3f + IMU_REPORT_US / 1e6f);   // 0.3 s smoothing
  if (gap) { gFeltF = -f; gFeltS = -st; gVert = u; }
  else { gFeltF += a * (-f - gFeltF); gFeltS += a * (-st - gFeltS); gVert += a * (u - gVert); }
  if (!paused && haveImu && now - imuStartMs > WARMUP_MS) {   // peak hold on the smoothed values
    gPkF = fmaxf(gPkF, gFeltF);  gPkA = fmaxf(gPkA, -gFeltF);
    gPkS = fmaxf(gPkS, gFeltS);  gPkP = fmaxf(gPkP, -gFeltS);
    gPkHi = fmaxf(gPkHi, gVert); gPkLo = fminf(gPkLo, gVert);
  }
}

bool accFresh() { return lastAccMs && millis() - lastAccMs < 1000; }

// Magnetometer test. One calibrated field sample (uT, sensor axes X bow / Y port / Z up),
// turned into the earth frame with the game rotation vector (tilt removed), then measured against
// the bow turned the same way: the heading is the clockwise angle from the field's horizontal part
// (magnetic north, before the ship's own deviation) to the bow. Independent of the game rotation
// vector's arbitrary yaw: only the angle between the two horizontal vectors counts. The bow-frame
// components are averaged (not the angle, which wraps at 360).
void onMag(float mx, float my, float mz, uint8_t acc) {
  float qr = imuQr, qi = imuQi, qj = imuQj, qk = imuQk;
  if (qr == 0 && qi == 0 && qj == 0 && qk == 0) return;      // no orientation yet
  float wx = (1 - 2 * (qj * qj + qk * qk)) * mx + 2 * (qi * qj - qr * qk) * my + 2 * (qi * qk + qr * qj) * mz;
  float wy = 2 * (qi * qj + qr * qk) * mx + (1 - 2 * (qi * qi + qk * qk)) * my + 2 * (qj * qk - qr * qi) * mz;
  float wz = 2 * (qi * qk - qr * qj) * mx + 2 * (qj * qk + qr * qi) * my + (1 - 2 * (qi * qi + qj * qj)) * mz;
  float bx = 1 - 2 * (qj * qj + qk * qk), by = 2 * (qi * qj + qr * qk);   // the bow (sensor X), earth frame
  float bn = sqrtf(bx * bx + by * by), hn = sqrtf(wx * wx + wy * wy);
  if (bn < 1e-3f || hn < 1e-3f) return;
  bx /= bn; by /= bn;
  float fwd = wx * bx + wy * by;                              // field along the bow
  float stb = wx * by - wy * bx;                              // field to starboard of the bow
  uint32_t now = millis();
  bool reset = !magMs || now - magMs > 2000 || isnan(magFwd);
  float a = reset ? 1.0f : (MAG_REPORT_US / 1e6f) / (MAG_SMOOTH_S + MAG_REPORT_US / 1e6f);
  magFwd = reset ? fwd : magFwd + a * (fwd - magFwd);
  magStb  = reset ? stb : magStb  + a * (stb - magStb);
  magTotal = sqrtf(mx * mx + my * my + mz * mz);
  magDip   = atan2f(-wz, hn) * R2D;                    // the field points down in the northern hemisphere
  magAcc   = acc;
  magMs    = now ? now : 1;
}
bool magFresh() { return magMs && millis() - magMs < 2000; }
// Magnetic heading of the bow, 0-360 (deg, clockwise); NaN without fresh data. North lies `h`
// degrees to port of the bow when the field has fwd = cos h, starboard = -sin h.
float magHeading() {
  if (!magFresh() || isnan(magFwd)) return NAN;
  float h = atan2f(-magStb, magFwd) * R2D;
  if (P.axFlip & 4) h = -h;
  return fmodf(h + 360.0f, 360.0f);
}
// Deviation: COG stands in for the true heading (no gyro), so true = mag + variation + deviation gives
// deviation = COG - mag - variation. COG - mag is averaged (as vectors) over the last minute, from seconds
// with a fix, 3 kn or more and |rate of turn| under 15 deg/min (COG lags in a turn); at least 30 of them.
#define MAGDEV_N 60
float    magDevC[MAGDEV_N], magDevS[MAGDEV_N];   // cos / sin of COG - mag; NaN = that second did not count
uint8_t  magDevHead = 0;
uint32_t magDevMs = 0;
float    magDevRaw = NAN;                        // mean COG - mag, deg (variation not taken off)
void serviceMagDev(uint32_t now) {
  if (now - magDevMs < 1000) return;
  magDevMs = (now - magDevMs > 3000) ? now : magDevMs + 1000;
  float mh = magHeading();
  bool ok = !isnan(mh) && gpsFixValid() && !isnan(sogAvgKn) && sogAvgKn >= 3.0f && !isnan(cogAvgDeg) && fabsf(rotSmooth * 60.0f) < 15.0f;
  float d = ok ? (cogAvgDeg - mh) * D2R : NAN;
  magDevC[magDevHead] = ok ? cosf(d) : NAN; magDevS[magDevHead] = ok ? sinf(d) : NAN;
  magDevHead = (magDevHead + 1) % MAGDEV_N;
  float c = 0, s = 0; int n = 0;
  for (int i = 0; i < MAGDEV_N; i++) if (!isnan(magDevC[i]) && (magDevC[i] || magDevS[i])) { c += magDevC[i]; s += magDevS[i]; n++; }
  magDevRaw = n >= 30 ? atan2f(s, c) * R2D : NAN;
}
float magDeviation() { return isnan(magDevRaw) ? NAN : wrap180(magDevRaw - P.magVar10 / 10.0f); }

// NOAA's World Magnetic Model 2025 (epoch 2025.0, good to 2030.0): the magnetic variation at the GPS
// position, so nobody has to type it in. A port of NOAA's geomag routine (as in pygeomag), in float: once a
// minute is plenty and 0.1 deg is all that is shown. Coefficients from WMM.COF (n, m in order, 1 1 to 12 12):
// g, h (nT) and their yearly change.
struct Wmm {
  static constexpr float EPOCH = 2025.0f;
  static const float COF[90][4];
  // The work arrays (5 KB) live on the heap - PSRAM when there is some - made at the first call: the static
  // RAM (dram0) is close to full (it overflowed by 1.2 KB with them static)
  struct Work { float c[13][13], cd[13][13], snorm[13 * 13], k[13][13], fn[13], fm[13], p[13 * 13], dp[13][13], tc[13][13], sp[13], cp[13], pp[13]; };
  static float decl(float latDeg, float lonDeg, float altKm, float year) {
    const int N = 12;
    static Work* w = nullptr;
    bool fresh = false;
    if (!w) {
      w = (Work*)heap_caps_malloc(sizeof(Work), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
      if (!w) w = (Work*)malloc(sizeof(Work));
      if (!w) return NAN;
      fresh = true;
    }
    auto& c = w->c; auto& cd = w->cd; auto& snorm = w->snorm; auto& k = w->k; auto& fn = w->fn; auto& fm = w->fm;
    auto& p = w->p; auto& dp = w->dp; auto& tc = w->tc; auto& sp = w->sp; auto& cp = w->cp; auto& pp = w->pp;
    if (fresh) {
      for (int i = 0; i < 13; i++) for (int j = 0; j < 13; j++) { c[i][j] = cd[i][j] = k[i][j] = 0; }
      int r = 0;
      for (int n = 1; n <= N; n++) for (int m = 0; m <= n; m++, r++) {
        c[m][n] = COF[r][0]; cd[m][n] = COF[r][2];
        if (m) { c[n][m - 1] = COF[r][1]; cd[n][m - 1] = COF[r][3]; }
      }
      snorm[0] = 1; fm[0] = 0; fn[0] = 0;
      for (int n = 1; n <= N; n++) {
        snorm[n] = snorm[n - 1] * (2 * n - 1) / (float)n;
        int j = 2;
        for (int m = 0; m <= n; m++) {
          k[m][n] = (float)((n - 1) * (n - 1) - m * m) / (float)((2 * n - 1) * (2 * n - 3));
          if (m > 0) {
            float flnmj = (float)((n - m + 1) * j) / (float)(n + m);
            snorm[n + m * 13] = snorm[n + (m - 1) * 13] * sqrtf(flnmj);
            j = 1;
            c[n][m - 1] *= snorm[n + m * 13]; cd[n][m - 1] *= snorm[n + m * 13];
          }
          c[m][n] *= snorm[n + m * 13]; cd[m][n] *= snorm[n + m * 13];
        }
        fn[n] = n + 1; fm[n] = n;
      }
      k[1][1] = 0;
    }
    for (int i = 0; i < 13 * 13; i++) p[i] = snorm[i];
    const float a = 6378.137f, b = 6356.7523142f, re = 6371.2f, a2 = a * a, b2 = b * b, c2 = a2 - b2, a4 = a2 * a2, b4 = b2 * b2, c4 = a4 - b4;
    float dt = year - EPOCH;
    float rlon = lonDeg * 0.017453293f, rlat = latDeg * 0.017453293f;
    float srlon = sinf(rlon), srlat = sinf(rlat), crlon = cosf(rlon), crlat = cosf(rlat), srlat2 = srlat * srlat, crlat2 = crlat * crlat;
    sp[0] = 0; cp[0] = pp[0] = 1; dp[0][0] = 0; sp[1] = srlon; cp[1] = crlon;
    float q = sqrtf(a2 - c2 * srlat2), q1 = altKm * q, q2 = ((q1 + a2) / (q1 + b2)) * ((q1 + a2) / (q1 + b2));
    float ct = srlat / sqrtf(q2 * crlat2 + srlat2), st = sqrtf(1 - ct * ct);
    float r2 = altKm * altKm + 2 * q1 + (a4 - c4 * srlat2) / (q * q), r = sqrtf(r2), d = sqrtf(a2 * crlat2 + b2 * srlat2);
    float ca = (altKm + d) / r, sa = c2 * crlat * srlat / (r * d);
    for (int m = 2; m <= N; m++) { sp[m] = sp[1] * cp[m - 1] + cp[1] * sp[m - 1]; cp[m] = cp[1] * cp[m - 1] - sp[1] * sp[m - 1]; }
    float aor = re / r, ar = aor * aor, br = 0, bt = 0, bp = 0, bpp = 0;
    for (int n = 1; n <= N; n++) {
      ar *= aor;
      for (int m = 0; m <= n; m++) {
        if (n == m) { p[n + m * 13] = st * p[n - 1 + (m - 1) * 13]; dp[m][n] = st * dp[m - 1][n - 1] + ct * p[n - 1 + (m - 1) * 13]; }
        else if (n == 1 && m == 0) { p[n] = ct * p[n - 1]; dp[m][n] = ct * dp[m][n - 1] - st * p[n - 1]; }
        else if (n > 1 && n != m) {
          if (m > n - 2) { p[n - 2 + m * 13] = 0; dp[m][n - 2] = 0; }
          p[n + m * 13] = ct * p[n - 1 + m * 13] - k[m][n] * p[n - 2 + m * 13];
          dp[m][n] = ct * dp[m][n - 1] - st * p[n - 1 + m * 13] - k[m][n] * dp[m][n - 2];
        }
        tc[m][n] = c[m][n] + dt * cd[m][n];
        if (m) tc[n][m - 1] = c[n][m - 1] + dt * cd[n][m - 1];
        float par = ar * p[n + m * 13], t1, t2;
        if (m == 0) { t1 = tc[m][n] * cp[m]; t2 = tc[m][n] * sp[m]; }
        else { t1 = tc[m][n] * cp[m] + tc[n][m - 1] * sp[m]; t2 = tc[m][n] * sp[m] - tc[n][m - 1] * cp[m]; }
        bt -= ar * t1 * dp[m][n];
        bp += fm[m] * t2 * par;
        br += fn[n] * t1 * par;
        if (st == 0 && m == 1) {
          pp[n] = n == 1 ? pp[n - 1] : ct * pp[n - 1] - k[m][n] * pp[n - 2];
          bpp += fm[m] * t2 * ar * pp[n];
        }
      }
    }
    bp = st == 0 ? bpp : bp / st;
    float bx = -bt * ca - br * sa, by = bp;
    return atan2f(by, bx) * 57.29578f;
  }
};
const float Wmm::COF[90][4] = {
    {-29351.8, 0.0, 12.0, 0.0},
    {-1410.8, 4545.4, 9.7, -21.5},
    {-2556.6, 0.0, -11.6, 0.0},
    {2951.1, -3133.6, -5.2, -27.7},
    {1649.3, -815.1, -8.0, -12.1},
    {1361.0, 0.0, -1.3, 0.0},
    {-2404.1, -56.6, -4.2, 4.0},
    {1243.8, 237.5, 0.4, -0.3},
    {453.6, -549.5, -15.6, -4.1},
    {895.0, 0.0, -1.6, 0.0},
    {799.5, 278.6, -2.4, -1.1},
    {55.7, -133.9, -6.0, 4.1},
    {-281.1, 212.0, 5.6, 1.6},
    {12.1, -375.6, -7.0, -4.4},
    {-233.2, 0.0, 0.6, 0.0},
    {368.9, 45.4, 1.4, -0.5},
    {187.2, 220.2, 0.0, 2.2},
