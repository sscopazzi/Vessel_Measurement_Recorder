// ---- Screen 20: health - what was under Position, with time left on the battery, brightness,
// box temperature and the Fault LED's reasons
void drawHealth() {
  char line[32], src;
  uint32_t now = millis(), up = (uint32_t)(esp_timer_get_time() / 1000000ULL), u = utcNow(src);
  if (u) {                                               // LT with where the time is from
    DateTime lt(ltOf(u));
    snprintf(line, sizeof(line), "HEALTH %02u:%02u:%02uLT %c", (unsigned)lt.hour(), (unsigned)lt.minute(), (unsigned)lt.second(),
             src == 'P' ? 'W' : src);                    // G GPS, R RTC, W a phone on the Wi-Fi
  } else snprintf(line, sizeof(line), "HEALTH no time yet");
  printAt(0, 0, line);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  snprintf(line, sizeof(line), "Up %lud %02lu:%02lu", (unsigned long)(up / 86400), (unsigned long)(up / 3600 % 24),
           (unsigned long)(up / 60 % 60));
  printAt(0, 11, line);
  bool early; int ma; float h;
  uint8_t be = battEst(now, h, ma, early);
  if (isnan(battV)) snprintf(line, sizeof(line), "Batt none (USB)");
  else snprintf(line, sizeof(line), "Batt %.2fV %3.0f%%%s", battV, battPct, be == BE_CHG ? " chg" : be == BE_FULL ? " USB" : "");
  printAt(0, 20, line);
  char hs[8] = "--", ms[10] = "", t[28];
  if (!isnan(h) && h < 999.5f) { if (h < 9.95f) snprintf(hs, sizeof(hs), "%.1fh", h); else snprintf(hs, sizeof(hs), "%.0fh", h); }
  if (ma) snprintf(ms, sizeof(ms), " %dmA", ma);
  if (isnan(battV)) snprintf(t, sizeof(t), "Left -- (USB power)");
  else if (be == BE_FULL) snprintf(t, sizeof(t), "Full (on USB)");
  else if (be == BE_CHG) snprintf(t, sizeof(t), isnan(h) ? "Full in -- settling" : "Full in %s%s", hs, ms);
  else if (be == BE_BATT && !isnan(h)) snprintf(t, sizeof(t), "Left ~%s%s%s", hs, ms, early ? " last" : "");
  else snprintf(t, sizeof(t), be == BE_BATT && battSettled(now) ? "Left -- (steady)" : "Left -- (settling)");
  printAt(strlen(t) <= 19 ? 12 : 6, 29, t);              // set in under Batt (2 spaces; 1 if it would not fit)
  // brightness, CPU and box (deg F, inside the box) on one line: up to 22 characters, so the room left
  // over is shared out as the gaps (in pixels) instead of a 6-px space each
  char sb[20], sc[12], sx[12] = "";
  snprintf(sb, sizeof(sb), "Brgt%d%%", (int)((contrast * 100 + 127) / 255));   // (no space: the line is tight)
  if (isnan(cpuTempC)) strcpy(sc, "CPU--"); else snprintf(sc, sizeof(sc), "CPU%.0f%c", tShow(cpuTempC), tUnit());   // F or C
  if (extOn(EXT_BMP) && !isnan(extTb)) snprintf(sx, sizeof(sx), "BOX%.0f%c", tShow(extTb), tUnit());
  int wb = (int)strlen(sb) * 6 - 1, wc = (int)strlen(sc) * 6 - 1, wx = sx[0] ? (int)strlen(sx) * 6 - 1 : 0;
  if (wb + wc + wx + 2 > 128) {                          // too wide (100 %, CPU and box both 3 digits): drop the Fs
    if (!isnan(cpuTempC)) sc[strlen(sc) - 1] = 0;
    if (sx[0]) sx[strlen(sx) - 1] = 0;
    wc -= 6; if (wx) wx -= 6;
  }
  int gap = sx[0] ? (128 - wb - wc - wx) / 2 : 6;
  if (gap < 1) gap = 1;
  printAt(0, 38, sb); printAt(wb + gap, 38, sc);
  if (sx[0]) printAt(128 - wx, 38, sx);
  static uint32_t staMs = 0;                     // phones on the hotspot, refreshed every 2 s
  static int staN = 0, staWorst = 0;
  if (!staMs || millis() - staMs > 2000) {
    staMs = millis();
    wifi_sta_list_t sl;
    staN = 0; staWorst = 0;
    if (esp_wifi_ap_get_sta_list(&sl) == ESP_OK) {
      staN = sl.num;
      for (int i = 0; i < sl.num; i++) if (!i || sl.sta[i].rssi < staWorst) staWorst = sl.sta[i].rssi;
    }
  }
  if (wifiOffByBtn || loggerMode) snprintf(line, sizeof(line), "WiFi OFF");
  else if (staN) snprintf(line, sizeof(line), "WiFi %d phone%s %ddBm", staN, staN == 1 ? "" : "s", staWorst);
  else snprintf(line, sizeof(line), "WiFi no phones");
  printAt(0, 47, line);
  char w[sizeof(faultWhy[0])];                             // the Fault LED's reasons, one at a time
  strlcpy(w, faultWhy[faultWhyIdx], sizeof(w));
  if (!w[0]) { printAt(0, 56, "Faults: none"); return; }
  int n = 1; for (const char* q = w; (q = strstr(q, "; ")); q += 2) n++;
  int k = (int)(now / 2000 % n);
  const char* a = w; for (int i = 0; i < k; i++) a = strstr(a, "; ") + 2;
  const char* e = strstr(a, "; ");
  char item[16]; size_t len = e ? (size_t)(e - a) : strlen(a), mx = n > 1 ? 11 : 14; if (len > mx) len = mx;
  memcpy(item, a, len); item[len] = 0;
  char fl[48];                                             // (cut to 21 characters by the lengths above)
  if (n > 1) snprintf(fl, sizeof(fl), "Fault %d/%d %s", k + 1, n, item); else snprintf(fl, sizeof(fl), "Fault: %s", item);
  printAt(0, 56, fl);
}

