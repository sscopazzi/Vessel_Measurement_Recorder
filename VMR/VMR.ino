// A towboat has a barge alongside, astern or ahead unless it is running light (or the mode is not set)
bool Vy::bargeOn() { return P.vs.vClass == VC_TOW && P.vs.towMode && P.vs.towMode != TOW_LIGHT; }
// The header's "condition" and the dashboard's: the tanker's (or other's) loading condition, or the tow
void Vy::condSummary(char* o, size_t n) {
  const Voyage& v = P.vs;
  o[0] = 0;
  if (v.vClass == VC_TOW) {
    if (v.towMode == TOW_OTHER) strlcpy(o, v.towTxt[0] ? v.towTxt : "other", n);
    else if (v.towMode == TOW_ASTERN && v.towLen05) snprintf(o, n, "towing astern %.2f nmi", v.towLen05 * 0.05f);
    else if (v.towMode) strlcpy(o, TOW_NAME[v.towMode], n);
  } else if (P.logCond == COND_OTHER) strlcpy(o, v.condTxt[0] ? v.condTxt : "other", n);
  else strlcpy(o, LOAD_COND[P.logCond < LOAD_COND_N ? P.logCond : 0], n);
}
