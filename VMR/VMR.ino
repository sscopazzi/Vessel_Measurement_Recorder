// Set uses the 5 s running mean of raw roll/pitch, not a single sample
bool setZero(bool on) {
  if (on && !haveImu) { showMessage("No IMU data"); return false; }
  if (!on) {
    P.zeroApplied = 0; P.rollOffset = 0; P.pitchOffset = 0; P.zeroRef100 = 0;
    showMessage("Level zero CLEARED");
  } else {
    float tr, hs, ref = levelRefPitch(tr, hs);      // with drafts: pitch reads the deck slope they give
    if (isnan(ref) || fabsf(ref) > 15) ref = 0;
    P.rollOffset = tareRollAvg; P.pitchOffset = tarePitchAvg - ref; P.zeroApplied = 1;
    P.zeroRef100 = (int16_t)lroundf(ref * 100);
    showMessage("Level zero SET");
  }
  if (logging && !sysEvent) sysEvent = P.zeroApplied ? "LEVEL ZERO SET" : "LEVEL ZERO CLEARED";   // roll / pitch reference changed
  Log.printf("Zero: %s  roll_off=%.2f pitch_off=%.2f (pitch set to read %.2f)\n",
                P.zeroApplied ? "on" : "off", P.rollOffset, P.pitchOffset, P.zeroRef100 / 100.0f);
  markPersistDirty(true);
  return true;
}

void resetAllTime() {
  P.rollMaxPos = P.rollMaxNeg = P.pitchMaxPos = P.pitchMaxNeg = P.yawRateMax = 0;
  P.tRollMaxPos = P.tRollMaxNeg = P.tPitchMaxPos = P.tPitchMaxNeg = P.tYawRateMax = 0;
  imuStartMs = millis();                         // restart warm-up so the press itself is not recorded
  showMessage("All-time max RESET");
  Log.println("All-time maxima reset");
  markPersistDirty(true);
}

// The screen button and B step through the screens ticked in the Displays card (by default all but the
// all-time maxima, sky plot, trim / list and tilt ball, which are picked on the dashboard)
bool wxOn() { return extOn(EXT_BMP) || extOn(EXT_SHT); }   // the weather screens are in the cycle when a weather add-on is on
// the screens ticked in the Displays card (P.scrRot), less those with nothing to show
// a screen whose source is switched off is greyed out in the Displays card and left out of the rotation:
// the motion screens with the BNO085 off (the Add-ons card), the GPS ones with the GPS off, Wind without the wind meter, the weather ones
// without their add-ons; Cast only while a cast is open
bool screenNeedsImu(uint8_t s) {
  return s == SCREEN_LIVE || s == SCREEN_GRAPH || s == SCREEN_ALLTIME || s == SCREEN_CLINO || s == SCREEN_DOCK ||
         s == SCREEN_GMETER || s == SCREEN_WAVES || s == SCREEN_WAVESTAT || s == SCREEN_BALL || s == SCREEN_ROLL;
}
bool screenAvail(uint8_t s) {
  if (s == SCREEN_CAST) return castOpenNow;
  if (s == SCREEN_DL) return dlShowNow();
  if (s == SCREEN_CTD) return P.slmOn && slmArmed;
  if (s == SCREEN_VOYAGE) return rtN >= 2;               // an active route read
  if (P.imuOff && screenNeedsImu(s)) return false;
  if (gpsOff && (s == SCREEN_POSITION || s == SCREEN_GPS || s == SCREEN_SKY)) return false;
  if (s == SCREEN_WIND) return windActive();
  if (s == SCREEN_WX || s == SCREEN_WXGRAPH) return wxOn();
  return true;
}
bool screenInCycle(uint8_t s) { return (s == SCREEN_CAST || s == SCREEN_CTD || s == SCREEN_DL || (P.scrRot >> s & 1)) && screenAvail(s); }
// a cast starting (Mark button or dashboard) shows the Cast screen; when it stops, the
// screen it was on comes back
void serviceCastScreen() {
  static bool was = false;
  static uint8_t before = SCREEN_LIVE;
  bool open = castOpenNow;
  if (open == was) return;
  was = open;
  if (open) { if (screen != SCREEN_CAST) before = screen; screen = SCREEN_CAST; }
  else if (screen == SCREEN_CAST) screen = before;
  lastDrawMs = 0;
}
// the Download screen while the dashboard's download pop-up is open (or the VMR sends one); then back
void serviceDlScreen() {
  static bool was = false;
  static uint8_t before = SCREEN_LIVE;
  bool on = dlShowNow();
  if (on == was) return;
  was = on;
  if (on) { if (screen != SCREEN_DL) before = screen; screen = SCREEN_DL; }
  else if (screen == SCREEN_DL) screen = before;
  lastDrawMs = 0;
}
void serviceScreenAvail() {                              // e.g. the IMU switched off while on Live
  if (screenAvail(screen)) return;
  uint8_t was = screen;
  screenStep();                                          // (none showable: it stays, and is drawn as it is)
  if (screen != was) lastDrawMs = 0;
}
void screenStep() {
  for (int k = 0; k < NUM_SCREENS; k++) {                // at most once round: none showable leaves it where it is
    uint8_t s = (screen + 1 + k) % NUM_SCREENS;
    if (screenInCycle(s)) { screen = s; break; }
  }
  lastDrawMs = 0;
}

// ---- the screen button held 1 s
int brightPct() { return (contrast * 100 + 127) / 255; }
// the knob's position picks (read in slider mode too while holding); with no knob, the slider's level
int knobSelPct() {
  if (potEma >= 0) return (int)lroundf(potEma * 100.0f / 4095.0f);
  return holdPrevContrast >= 0 ? (holdPrevContrast * 100 + 127) / 255 : brightPct();
}
uint8_t hgCount() { return P.slmOn ? 12 : 11; }
uint8_t hgAt(uint8_t i) { if (!P.slmOn || i < 8) return HG_BASE[i < 11 ? i : 10]; return i == 8 ? (uint8_t)HG_CAST : HG_BASE[i - 1]; }
uint8_t hgPos(uint8_t b) { for (uint8_t i = 0; i < hgCount(); i++) if (hgAt(i) == b) return i; return 0; }
int hgTop(int i) { return i < 0 ? 0 : (i + 1) * 100 / hgCount(); }   // each band's top knob position, %
uint8_t holdBand() { int p = knobSelPct(); for (uint8_t i = 0; i < hgCount(); i++) if (p <= hgTop(i)) return hgAt(i); return HG_REC; }
// Only with the OLED showing the ordinary screens (it must show what will happen)
bool holdOk() { return displayOK && dispShown(DISP_OLED) && otaState == OTA_IDLE && !serOledOn && !imuWarnOn() && !paused; }
bool cdRunning() { return cdSet && Cd::left(millis()) > 0; }
// What letting go does: a big word or two (size 2: up to 10 characters) and a line under it
void holdLabel(uint8_t b, char* big, char* det) {
  switch (b) {
    case HG_RESTART: if (wifiOffByBtn) { strcpy(big, "Wi-Fi ON"); strcpy(det, "turn the hotspot on"); }
                     else { strcpy(big, "Restart"); strcpy(det, "the Wi-Fi hotspot"); } break;
    case HG_WIFI:    if (wifiOffByBtn) { strcpy(big, "Wi-Fi ON"); strcpy(det, "turn the hotspot on"); }
                     else { strcpy(big, "Wi-Fi OFF"); strcpy(det, "until on or restart"); } break;
    case HG_INFO:    strcpy(big, "Wi-Fi info"); strcpy(det, "password and link"); break;
    case HG_CANCEL:  strcpy(big, "CANCEL"); strcpy(det, "nothing happens"); break;
    case HG_CAST:    strcpy(big, slmHoldBig()); strlcpy(det, slmHoldDet(), 22); break;
    case HG_OLEDOFF: strcpy(big, "OLED OFF"); strcpy(det, "screen button: back"); break;
    case HG_GPS:     if (gpsOff) { strcpy(big, "GPS ON"); strcpy(det, "wake it (hot start)"); }
                     else { strcpy(big, "GPS OFF"); strcpy(det, loggingActive() ? "no position in file" : "standby (GPS card)"); } break;
    case HG_PAUSE:   if (paused) { strcpy(big, "RESUME"); strcpy(det, "carry on logging"); }
                     else { strcpy(big, "PAUSE"); strcpy(det, "screen btn resumes"); } break;
    case HG_BALL:    if (screen == SCREEN_BALL) { strcpy(big, "Back"); strcpy(det, "from the tilt ball"); }
                     else { strcpy(big, "Tilt ball"); strcpy(det, screenAvail(SCREEN_BALL) ? "the ball game" : "needs the IMU"); } break;
    case HG_FLIP:    strcpy(big, "Flip"); strcpy(det, P.oledFlip ? "OLED + 7-seg back" : "OLED + 7-seg 180 deg"); break;
    case HG_CD:      if (cdRunning()) { strcpy(big, "Stop"); strcpy(det, "the countdown"); }
                     else { strcpy(big, "Countdown"); uint16_t t = cdTotalS ? cdTotalS : 300;
                            if (P.dispEn & DISP_SEG) snprintf(det, 22, "from %u:%02u, 7-seg", t / 60, t % 60); else strcpy(det, "needs a 7-segment"); } break;
    default:         if (loggingActive()) { strcpy(big, "Stop REC"); strcpy(det, "close the file"); }
                     else { strcpy(big, "Start REC"); strcpy(det, sdOK ? "a new file" : "no microSD card"); } break;
  }
}
bool holdNeedsConfirm(uint8_t b) { return b == HG_REC || (b == HG_GPS && !gpsOff && loggingActive()) || (!wifiOffByBtn && (b == HG_RESTART || b == HG_WIFI)) || (b == HG_CAST && slmArmed && ctdCastOpen); }
// Wi-Fi off / on (RAM only). Datalogger mode has its own switch-off; leaving it turns the Wi-Fi on.
void wifiSetOff(bool off) {
  if (off == wifiOffByBtn || loggerMode) return;
  if (!wifiJobStart(off ? 2 : 3)) return;              // (in its own task)
  wifiOffByBtn = off;
  Log.printf("Wi-Fi %s (screen button)\n", off ? "OFF" : "ON");
}
// Wi-Fi off / on / restart in a task of their own: WiFi.mode() and pausing the web task take
// a few hundred ms, which held the loop (sampling, logging) up - "buttons" 224 ms
void wifiJobTask(void*) {
  uint8_t jb = wifiJob;
  battLoadChange();
  if (jb == 1) { vTaskDelay(pdMS_TO_TICKS(200)); wifiRestart(); }   // (a dashboard reply goes out first)
  else if (jb == 2) { pauseWeb(true); server.close(); WiFi.softAPdisconnect(true); WiFi.mode(WIFI_OFF); }
  else if (jb == 3) { WiFi.mode(WIFI_AP); ApNet::start(); server.begin(); pauseWeb(false); }
  battLoadChange();
  wifiJob = 0;
  vTaskDelete(nullptr);
}
bool wifiJobStart(uint8_t jb) {
  if (wifiJob) return false;
  wifiJob = jb;
  if (xTaskCreate(wifiJobTask, "wifijob", 4096, nullptr, 1, nullptr) != pdPASS) { wifiJob = 0; return false; }
  return true;
}
void holdDo(uint8_t b) {
  uint32_t now = millis();
  switch (b) {
    case HG_RESTART: if (wifiOffByBtn) { wifiSetOff(false); showMessage("WI-FI ON", 2000); }
                     else { showMessage("WI-FI RESTART", 2000); wifiJobStart(1); } break;
    case HG_WIFI:    wifiSetOff(!wifiOffByBtn); showMessage(wifiOffByBtn ? "WI-FI OFF" : "WI-FI ON", 2000); break;
    case HG_INFO:    infoOn = true; infoMs = now; break;
    case HG_CANCEL:  showMessage("CANCELLED", 1200); break;   // picked like the others; nothing, not even a step
    case HG_OLEDOFF: oledBlankSet(true); break;
    case HG_GPS:     gpsSetOff(!gpsOff); showMessage(gpsOff ? "GPS OFF" : "GPS ON", 2000); break;
    case HG_PAUSE:   setPaused(!paused); break;
    case HG_CAST:    slmArm(!slmArmed || slmDisarming); showMessage(slmArmed && !slmDisarming ? "CAST SESSION ON" : "DISARMING", 2000); break;
    case HG_BALL:    if (screen == SCREEN_BALL) screen = ballBefore;
                     else if (screenAvail(SCREEN_BALL)) { ballBefore = screen; screen = SCREEN_BALL; }
                     else showMessage("NEEDS THE IMU", 2000);
                     break;
    case HG_FLIP:    { uint8_t f = P.oledFlip ? 0 : 1;          // both the same way (from either one's state)
                       P.oledFlip = f; P.segFlip = f; if (displayOK) display.setRotation(oledRotation());
                       segRamValid = false; markPersistDirty(true); showMessage(f ? "FLIPPED" : "UPRIGHT", 1500); } break;
    case HG_CD:      if (!(P.dispEn & DISP_SEG)) showMessage("NO 7-SEGMENT", 2000);
                     else if (cdRunning()) { cdSet = false; if (P.segScreen == SEG_CD) segStep(); showMessage("COUNTDOWN OFF", 2000); }
                     else { reqSegCd = cdTotalS ? cdTotalS : 300; showMessage("COUNTDOWN", 2000); }
                     break;
    default:
      if (loggingActive()) { logWanted = false; showMessage("REC STOP", 2500); break; }
      if (!sdOK) { showMessage("NO microSD CARD", 2500); break; }   // (no mount attempt here: it can take a while)
      pendTag[0] = 0; pendCond = 255; logWanted = true;   // the last condition and file split (pendDaily)
      showMessage("REC START", 2500);
      break;
  }
  lastDrawMs = 0;
}
// the OLED off (knob selector) and back on. Only the OLED: the 7-segment, LCD and LEDs carry on.
void oledBlankSet(bool b) {
  if (b == oledBlank) return;
  oledBlank = b;
  if (displayOK) display.oled_command(dispLit(DISP_OLED) || oledForced ? SH110X_DISPLAYON : SH110X_DISPLAYOFF);
  lastDrawMs = 0;
  Log.println(b ? "OLED off (screen button + knob): the screen button brings it back" : "OLED back on");
}
// Cancel a waiting confirmation (Mark, B, or 5 s)
void cfmCancel() { if (cfmAct == 255) return; cfmAct = 255; cfmBy = 255; showMessage("CANCELLED", 1500); lastDrawMs = 0; }

void serviceButtons() {
  btnB.update(); btnScr.update();
  uint32_t now = millis();
  if ((btnB.pressed || btnScr.pressed) && alarmCtl(now)) {   // an alarm showing: the press acknowledges it, nothing else
    if (btnScr.pressed) { scrDownMs = 0; scrComboUsed = true; }
    return;
  }
  if (oledBlank && btnScr.pressed && !loggerMode) {   // the press only brings the OLED back (the screen button only)
    oledBlankSet(false);
    scrDownMs = 0; scrComboUsed = true;                 // (letting go and holding do nothing this time)
    return;
  }
  if (btnScr.pressed) { scrComboUsed = false; scrDownMs = now ? now : 1; }
  bool hs = !loggerMode && btnScr.isDown() && scrDownMs && now - scrDownMs >= HOLD_MS && holdOk() && !infoOn && cfmAct == 255;
  if (hs != holdShow) {                                // the brightness held at 30 % while picking
    holdShow = hs; lastDrawMs = 0;
    if (hs) { holdPrevContrast = contrast; setContrastLevel(HOLD_CONTRAST); }
    else if (holdPrevContrast >= 0) { setContrastLevel(holdPrevContrast); holdPrevContrast = -1; }   // the knob takes it on from there
  }
  if (cfmAct != 255 && (now - cfmMs > CONFIRM_MS || btnB.pressed || loggerMode)) { cfmCancel(); return; }
  if (infoOn && (now - infoMs > INFO_MS || btnB.pressed || loggerMode || !holdOk())) { infoOn = false; lastDrawMs = 0; if (btnB.pressed) return; }
  if (btnScr.released) {                               // the confirmation, the Wi-Fi details, the hold
    bool longHold = scrDownMs && now - scrDownMs >= HOLD_MS;
    scrDownMs = 0;
    if (!loggerMode && cfmAct != 255) { uint8_t a = cfmAct; cfmAct = 255; holdDo(a); return; }
    if (!loggerMode && infoOn) { infoOn = false; lastDrawMs = 0; return; }
    if (!loggerMode && longHold && !scrComboUsed && holdOk()) {
      uint8_t b = holdBand();
      if (holdNeedsConfirm(b)) { cfmAct = b; cfmBy = 255; cfmMs = now; lastDrawMs = 0; } else holdDo(b);
      return;
    }
  }
  if (loggerMode) {                                    // B: leave datalogger mode; screen button: countdown
    if (btnB.pressed) setLoggerMode(false);
    else if (btnScr.pressed) loggerPeek();
    return;
  }
  // the screen button acts when let go (held + Mark = a 7-segment step, serviceMarkBtn); B on press
  bool scr = btnScr.released && !scrComboUsed;
  if (paused && (btnB.pressed || scr)) {               // B or a tap of the screen button resumes after a pause (the screen stays)
    setPaused(false);
  } else if (btnB.pressed || scr) {
    if (!dispShown(DISP_OLED) && (dispShown(DISP_LCD) || dispShown(DISP_SEG))) displayStep();   // no OLED (or off in the Displays card): the LCD (or 7-segment)
    else screenStep();
  }
}

// the optional buttons, on a press. Cast starts / stops a cast (as holding Mark); Pause pauses / resumes;
// Record asks first (a second press, or the screen button, says yes; Mark, B or 5 s no), and so does Wi-Fi when
// it would switch the hotspot off; Screen jumps to the screen picked in the Pin mappings card, and back again. In Datalogger
// mode any of them leaves the mode (as B). With a confirmation up, another of them cancels it.
void serviceXb(uint32_t now) {
  static uint8_t before = SCREEN_LIVE;
  for (int i = 0; i < XB_N; i++) {
    Button& b = xbBtn[i];
    b.update();
    if (!b.pressed) continue;
    if (alarmCtl(now)) continue;                     // an alarm showing: acknowledged, nothing else
    if (loggerMode) { Log.println("Optional button: leaving Datalogger mode"); setLoggerMode(false); continue; }
    if (cfmAct != 255) {
      if (cfmBy == i) { uint8_t a = cfmAct; cfmAct = 255; cfmBy = 255; holdDo(a); } else cfmCancel();
      continue;
    }
    if (infoOn) { infoOn = false; lastDrawMs = 0; continue; }
    switch (i) {
      case XB_CAST:  reqMarkBtn = 2; break;
      case XB_PAUSE: setPaused(!paused); break;
      case XB_REC:   cfmAct = HG_REC; cfmBy = i; cfmMs = now; lastDrawMs = 0; break;
      case XB_WIFI:  if (holdNeedsConfirm(HG_WIFI)) { cfmAct = HG_WIFI; cfmBy = i; cfmMs = now; lastDrawMs = 0; } else holdDo(HG_WIFI); break;
      default: {
        uint8_t s = P.xbScreen < NUM_SCREENS ? P.xbScreen : SCREEN_LIVE;
        if (screen == s) { if (screenAvail(before)) screen = before; }
        else if (screenAvail(s)) { before = screen; screen = s; }
        else showMessage("NOT AVAILABLE", 1500);
        oledBlankSet(false);
        lastDrawMs = 0;
      } break;
    }
  }
}

// ============================================================================
//                                  OLED
// ============================================================================
void printAt(int x, int y, const char* s) { display.setCursor(x, y); display.print(s); }

void fmtVal(char* out, size_t n, float v, int w, bool sign, int dp = 1) {
  if (isnan(v)) snprintf(out, n, "%*s", w, "--");
  else if (sign) snprintf(out, n, "%+*.*f", w, dp, v);
  else snprintf(out, n, "%*.*f", w, dp, v);
}

// Roll as size + side, 6 chars wide, right-aligned: " 12.3S" = starboard down, "  4.0P" = port down.
// Number first (as the marks screen): the leading spaces keep the columns apart - with the side
// first, "Rol" + "P  3.4" would read "RolP  3.4S  3.8".
// Rate of turn the same way, whole deg/min: "   12S" = turning to starboard
void fmtRot(char* out, size_t n, float v) {
  if (isnan(v)) { snprintf(out, n, "%5s ", "--"); return; }
  long r = constrain(lroundf(v), -9999L, 9999L);
  if (!r) snprintf(out, n, "%5d ", 0); else snprintf(out, n, "%5ld%c", labs(r), r > 0 ? 'S' : 'P');
}
void fmtRoll(char* out, size_t n, float v) {
  if (isnan(v)) { snprintf(out, n, "%5s ", "--"); return; }   // "--" under the digits
  float a = fabsf(v);
  if (a < 0.05f) snprintf(out, n, "%5.1f ", 0.0f);
  else           snprintf(out, n, "%5.1f%c", a, v > 0 ? 'S' : 'P');
}

// each screen's number (1-23, as the Pin mappings card lists them), top right in the 4 x 6 font: rows 0-4, so the
// screens' top lines end 2 px left of it (hdrRightX)
int tomWidth(const char* s) {
  int w = 0;
  for (; *s; s++) {
    uint8_t c = (uint8_t)*s;
    if (c < TomThumb.first || c > TomThumb.last) continue;
    const GFXglyph& g = TomThumb.glyph[c - TomThumb.first];
    w += s[1] ? g.xAdvance : g.xOffset + g.width;
  }
  return w;
}
int scrNumX() { char t[4]; snprintf(t, sizeof(t), "%u", (unsigned)screen + 1); return 128 - tomWidth(t); }
int hdrRightX(const char* s) { return scrNumX() - 3 - 6 * (int)strlen(s); }   // right-hand header text, 6 x 8 font (4 px clear)
void drawScrNum() {
  char t[4]; snprintf(t, sizeof(t), "%u", (unsigned)screen + 1);
  display.setFont(&TomThumb);
  display.setTextColor(screen == SCREEN_DOCK ? SH110X_BLACK : SH110X_WHITE);   // (Dock's header bar is lit)
  printAt(scrNumX(), 5, t);
  display.setTextColor(SH110X_WHITE);
  display.setFont();
}

void drawHeaderTime() {
  char src, z[8], b[24];
  uint32_t u = utcNow(src);
  zdText(z, sizeof(z));
  if (u) { DateTime t(ltOf(u)); snprintf(b, sizeof(b), "LIVE %02u:%02u:%02u ZD%s", (unsigned)t.hour(),
                                         (unsigned)t.minute(), (unsigned)t.second(), z); }
  else   snprintf(b, sizeof(b), "LIVE --:--:-- ZD%s", z);   // the title; the battery is on Health (screen 20)
  printAt(0, 0, b);
}

void drawLive() {
  drawHeaderTime();
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);
  Win w = window1m();
  bool f = imuFresh();
  char line[32], a[10], b[10], c[10];

  snprintf(line, sizeof(line), "%-3s%6s%12s", "", "Live", "1-min max");
  printAt(0, 12, line);

  fmtRoll(a, sizeof(a), f ? roll : NAN);
  fmtRoll(b, sizeof(b), w.rMax);                 // furthest to starboard
  fmtRoll(c, sizeof(c), w.rMin);                 // furthest to port
  snprintf(line, sizeof(line), "Rol%s%s%s", a, b, c);
  printAt(0, 21, line);

  fmtVal(a, sizeof(a), f ? pitch : NAN, 6, true);
  fmtVal(b, sizeof(b), w.pMax, 6, true);
  fmtVal(c, sizeof(c), w.pMin, 6, true);
  snprintf(line, sizeof(line), "Pit%s%s%s", a, b, c);
  printAt(0, 30, line);

  fmtRot(a, sizeof(a), f ? rotShown() : NAN);                    // rate of turn, deg/min
  fmtVal(b, sizeof(b), w.yrMax * 60.0f, 6, false, 0);
  snprintf(line, sizeof(line), "ROT%s%s %c/min", a, b, (char)248);
  printAt(0, 39, line);

  char gpsS[8];
  if (gpsFixValid()) snprintf(gpsS, sizeof(gpsS), "%d", (int)gps.gpsSats);
  else               snprintf(gpsS, sizeof(gpsS), "--");
  snprintf(line, sizeof(line), "%s GPS %s Wi %d",
           logging ? (sdOK ? "REC " : "REC!") : (sdOK ? "stop" : "noSD"),
           gpsS, (int)WiFi.softAPgetStationNum());
  printAt(0, 56, line);
}

// The OLED graphs' column scratch (1.5 KB): on the heap - PSRAM when there is some - made at the first
// draw; the graph screens share it (one screen is drawn at a time, by loop() only). Static RAM is close to full.
struct GraphScratch {
  float cv[128], cs[128]; uint8_t cn[128];         // the weather graph
  int8_t cLo[128], cHi[128]; bool cOk[128];         // the roll graph's envelope
  static GraphScratch* get() {
    static GraphScratch* g = nullptr;
    if (!g) { g = (GraphScratch*)ps_malloc(sizeof(GraphScratch)); if (!g) g = (GraphScratch*)malloc(sizeof(GraphScratch)); }
    return g;
  }
};

void drawGraph() {
  char line[32], a[10];
  fmtRoll(a, sizeof(a), imuFresh() ? roll : NAN);
  uint16_t secs = graphSecs();
  char per[12], len[8];
  if (isnan(rollPeriod)) snprintf(per, sizeof(per), "T --s");
  else                   snprintf(per, sizeof(per), "T%4.1fs", rollPeriod);
  if (secs < 60) snprintf(len, sizeof(len), "%us", (unsigned)secs);
  else           snprintf(len, sizeof(len), "%um", (unsigned)(secs / 60));
  snprintf(line, sizeof(line), "R%s %s %s", a, per, len);
  printAt(0, 0, line);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);              // the rule, as the other screens

  const int gx0 = 19, gx1 = 127, gy0 = 11, gy1 = 63;
  float lo = P.graphMin, hi = P.graphMax;

  auto sideLbl = [&](int v) {                                  // S n / P n / 0 (limits may be on either side)
    if (v > 0) snprintf(line, sizeof(line), "S%d", v); else if (v < 0) snprintf(line, sizeof(line), "P%d", -v); else strcpy(line, "0");
  };
  sideLbl(P.graphMax); printAt(0, gy0, line);                  // top
  sideLbl(P.graphMin); printAt(0, gy1 - 7, line);              // bottom
  display.drawFastVLine(gx0 - 1, gy0, gy1 - gy0 + 1, SH110X_WHITE);

  auto mapY = [&](float v) -> int {
    if (v < lo) v = lo;
    if (v > hi) v = hi;
    return gy1 - (int)lroundf((v - lo) * (gy1 - gy0) / (hi - lo));
  };

  if (lo < 0 && hi > 0) {                                      // zero line only when 0 is on the scale
    int zy = mapY(0);
    for (int x = gx0; x <= gx1; x += 3) display.drawPixel(x, zy, SH110X_WHITE);
    if (zy > gy0 + 8 && zy < gy1 - 10) printAt(6, zy - 3, "0");
  }
  if (!gRoll) return;

  // Each pixel column covers nS/cols samples; draw that column's min-max span,
  // joined to the previous column, so peaks survive on the 2 min view.
  const int cols = gx1 - gx0 + 1;
  const int nS = (int)((uint32_t)secs * 1000UL / GRAPH_SAMPLE_MS);

  if (secs >= GRAPH_ENVELOPE_S) {
    // 5 / 10 min: amplitude envelope. Highest and lowest roll within a sliding
    // window of about one roll period, drawn as two lines (peak to starboard,
    // peak to port), so the individual swings don't turn into a solid block.
    GraphScratch* gs = GraphScratch::get(); if (!gs) return;
    int8_t* cLo = gs->cLo; int8_t* cHi = gs->cHi; bool* cOk = gs->cOk;
    for (int c = 0; c < cols; c++) {
      int s0 = (int)((long)c * nS / cols), s1 = (int)((long)(c + 1) * nS / cols);
      float vlo = INFINITY, vhi = -INFINITY;
      for (int si = s0; si < s1; si++) {
        int age = nS - 1 - si;
        if (age >= gCount) continue;
        float v = gRoll[(gHead + GRAPH_POINTS - 1 - age) % GRAPH_POINTS];
        if (isnan(v)) continue;
        vlo = fminf(vlo, v); vhi = fmaxf(vhi, v);
      }
      cOk[c] = vlo <= vhi;
      if (cOk[c]) { cLo[c] = (int8_t)mapY(vlo); cHi[c] = (int8_t)mapY(vhi); }
    }
    float win = isnan(rollPeriod) ? 15.0f : constrain(1.25f * rollPeriod, 8.0f, 30.0f);
    int h = (int)ceilf(win * cols / secs) / 2;      // window = 2h+1 columns, at least one roll
    if (h < 1) h = 1;
    int pu = -1, pd = -1;
    for (int c = 0; c < cols; c++) {
      if (!cOk[c]) { pu = pd = -1; continue; }
      int up = gy1, dn = gy0;                       // screen y: smaller = higher
      for (int j = max(0, c - h); j <= min(cols - 1, c + h); j++)
        if (cOk[j]) { up = min(up, (int)cHi[j]); dn = max(dn, (int)cLo[j]); }
      int x = gx0 + c;
      if (pu >= 0) { display.drawLine(x - 1, pu, x, up, SH110X_WHITE); display.drawLine(x - 1, pd, x, dn, SH110X_WHITE); }
      else { display.drawPixel(x, up, SH110X_WHITE); display.drawPixel(x, dn, SH110X_WHITE); }
      pu = up; pd = dn;
    }
    return;
  }

  int prevY = -1;
  for (int c = 0; c < cols; c++) {
    int s0 = (int)((long)c * nS / cols), s1 = (int)((long)(c + 1) * nS / cols);
    if (s1 <= s0) s1 = s0 + 1;
    float vlo = INFINITY, vhi = -INFINITY, vfirst = NAN, vlast = NAN;
    for (int si = s0; si < s1; si++) {
      int age = nS - 1 - si;                       // 0 = newest sample
      if (age >= gCount) continue;
      float v = gRoll[(gHead + GRAPH_POINTS - 1 - age) % GRAPH_POINTS];
      if (isnan(v)) continue;
      if (isnan(vfirst)) vfirst = v;
      vlast = v;
      vlo = fminf(vlo, v);
      vhi = fmaxf(vhi, v);
    }
    if (isnan(vfirst)) { prevY = -1; continue; }
    int x = gx0 + c;
    if (prevY >= 0) display.drawLine(x - 1, prevY, x, mapY(vfirst), SH110X_WHITE);
    display.drawFastVLine(x, mapY(vhi), mapY(vlo) - mapY(vhi) + 1, SH110X_WHITE);
    prevY = mapY(vlast);
  }
}

void drawPosition() {
  char src, line[32], v[16];
  uint32_t u = utcNow(src);
  if (u) {                                               // a title and a rule; UTC moved down by the altitude
    DateTime lt(ltOf(u));
    snprintf(line, sizeof(line), "GPS DIAG %02u:%02u:%02uLT", (unsigned)lt.hour(), (unsigned)lt.minute(), (unsigned)lt.second());
  } else {
    snprintf(line, sizeof(line), "GPS DIAG no time");
  }
  printAt(0, 0, line);
  display.drawFastHLine(0, 9, 128, SH110X_WHITE);

  if (gpsFixValid()) {
    fmtDM(v, sizeof(v), gps.gpsLat, 'N', 'S', false);
    snprintf(line, sizeof(line), "Lat  %s", v);
    printAt(0, 11, line);
    fmtDM(v, sizeof(v), gps.gpsLon, 'E', 'W', true);
    snprintf(line, sizeof(line), "Lon %s", v);
    printAt(0, 20, line);
    char sg[8], cg[6];                                  // averaged SOG / COG (the GPS settings and diagnosis card setting)
    if (isnan(sogAvgKn)) snprintf(sg, sizeof(sg), " --.-"); else snprintf(sg, sizeof(sg), "%4.1f", fminf(sShow(sogAvgKn), 99.9f));
    if (isnan(cogAvgDeg)) snprintf(cg, sizeof(cg), "---"); else snprintf(cg, sizeof(cg), "%03d", (int)lroundf(cogAvgDeg) % 360);
    snprintf(line, sizeof(line), spdU() ? "SOG %s%s COG %sT" : "SOG %s%s  COG %sT", sg, sUnit(), cg);
    printAt(0, 29, line);
  } else {
    printAt(0, 11, "Lat  --");
    printAt(0, 20, "Lon  --");
    printAt(0, 29, "No GPS fix");
  }
  snprintf(line, sizeof(line), "GPS %2d/%-2d sat %2ddB", (int)gps.gpsSats, gpsInView[0] + gpsInView[1], (int)gpsBestSnr);
  printAt(0, 38, line);
  if (gpsFixValid()) {                                   // (the health lines are on screen 20)
    snprintf(line, sizeof(line), "HDOP %.1f  age %.1fs", gps.gpsHdop, (millis() - gpsRmcMs) / 1000.0f); printAt(0, 47, line);
    snprintf(line, sizeof(line), "Alt %.0f %s MSL", lShow(gps.gpsAlt), lUnit()); printAt(0, 56, line);
  } else { printAt(0, 47, "HDOP --  age --"); strcpy(line, "Alt --"); printAt(0, 56, line); }
  if (u && strlen(line) <= 14) {                         // UTC, bottom right
    DateTime ut(u); snprintf(v, sizeof(v), "%02u:%02uZ", (unsigned)ut.hour(), (unsigned)ut.minute());
    printAt(128 - 6 * (int)strlen(v), 56, v);
  }
}

