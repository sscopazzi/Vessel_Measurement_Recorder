  if (f) f.close();
  sdUnlock();
  if (!ok) { server.send(404, "application/json", "{\"error\":\"No such save\"}"); return; }
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", body);
}
// POST /shipput  n=<name>&j=<JSON>: saved (an existing save of that name replaced)
void handleShipPut() {
  String n = server.arg("n"), body = server.arg("j");
  if (!shipNameOk(n)) { server.send(400, "application/json", "{\"error\":\"Name: letters, digits, spaces, . _ - (up to 31)\"}"); return; }
  if (!body.length() || body.length() > SHIP_MAX_B || body[0] != '{') { server.send(400, "application/json", "{\"error\":\"Not ship data\"}"); return; }
  if (!sdOK || !sdLock(3000)) { server.send(503, "application/json", "{\"error\":\"The microSD card is busy: try again\"}"); return; }
  if (!SD.exists(SHIP_DIR)) SD.mkdir(SHIP_DIR);
  String tmp = String(SHIP_DIR "/save.tmp"), fin = shipPath(n);
  File f = SD.open(tmp.c_str(), FILE_WRITE);
  bool ok = f && f.write((const uint8_t*)body.c_str(), body.length()) == body.length();
  if (f) f.close();
  if (ok) { SD.remove(fin.c_str()); ok = SD.rename(tmp.c_str(), fin.c_str()); }
  if (!ok) SD.remove(tmp.c_str());
  sdUnlock();
  Log.printf("Ship data %s as \"%s\"\n", ok ? "saved" : "NOT saved", n.c_str());
  server.send(ok ? 200 : 500, "application/json", ok ? "{\"ok\":true}" : "{\"error\":\"Could not write it to the microSD card\"}");
}
