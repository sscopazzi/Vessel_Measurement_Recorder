// ---- Serial monitor copy ----------------------------------------------------
// Everything the sketch prints goes through Log: it is sent to the USB Serial
// Monitor and the last SLOG_LINES lines are kept for the dashboard
// (the Serial monitor card) and the OLED. Lines longer than SLOG_LEN are cut in the
// copy only. Several tasks print, so the copy is guarded by a spinlock.
#define SLOG_LINES  30
#define SLOG_LEN    120
class TeeLog : public Print {
 public:
  void begin(unsigned long baud) {                  // the line copy lives in PSRAM (3.6 KB off internal RAM)
    Serial.begin(baud);
    Serial.setTxTimeoutMs(20);                      // the core's 250 ms a write is too long (see out())
    if (!lines) {
      void* m = ps_malloc(sizeof(char[SLOG_LINES][SLOG_LEN + 1]));
      if (!m) m = malloc(sizeof(char[SLOG_LINES][SLOG_LEN + 1]));
      if (m) { memset(m, 0, sizeof(char[SLOG_LINES][SLOG_LEN + 1])); lines = (char(*)[SLOG_LEN + 1])m; }
    }
  }
  size_t write(uint8_t c) override { out(&c, 1); keep(&c, 1); return 1; }
  size_t write(const uint8_t* b, size_t n) override { out(b, n); keep(b, n); return n; }
  using Print::write;
  uint32_t seq() const { return lineSeq; }          // lines completed since boot
  // copy line number i (0 = first since boot); false once it has scrolled out
  bool get(uint32_t i, char* out) {
    bool ok = false;
    portENTER_CRITICAL(&mux);
    if (lines && i < lineSeq && lineSeq - i <= SLOG_LINES) { memcpy(out, lines[i % SLOG_LINES], SLOG_LEN + 1); ok = true; }
    portEXIT_CRITICAL(&mux);
    return ok;
  }
 private:
  // USB serial: with a computer attached whose serial port is open but not being read (a
  // sleeping laptop, a stalled terminal), every write would wait out the USB timeout - 250 ms each, a
  // line is 1-2 writes - and the loop with it, losing rows. After one write that does not all go, nothing more is sent until the computer has
  // emptied the USB buffer (64 bytes): the copy here (the dashboard's Serial card) keeps every line.
  volatile bool stalled = false;
  void out(const uint8_t* b, size_t n) {
    if (stalled) { if (Serial.availableForWrite() < 64) return; stalled = false; }
    if (Serial.write(b, n) < n) stalled = true;
  }
  void keep(const uint8_t* b, size_t n) {
    portENTER_CRITICAL(&mux);
    for (size_t i = 0; i < n; i++) {
      char c = (char)b[i];
      if (c == '\r') continue;
      if (c == '\n') {
        cur[curLen] = 0;
        if (lines) { memcpy(lines[lineSeq % SLOG_LINES], cur, SLOG_LEN + 1); lineSeq = lineSeq + 1; }
        curLen = 0;
      } else if (curLen < SLOG_LEN) {
        cur[curLen++] = (c >= 0x20 && c <= 0x7E) ? c : (c == '\t' ? ' ' : '?');
      }
    }
    portEXIT_CRITICAL(&mux);
  }
  portMUX_TYPE mux = portMUX_INITIALIZER_UNLOCKED;
  char (*lines)[SLOG_LEN + 1] = nullptr;           // SLOG_LINES of them, from begin()
  char cur[SLOG_LEN + 1] = {};
  uint16_t curLen = 0;
  volatile uint32_t lineSeq = 0;
};
TeeLog Log;

