// Web diagnostics for the System card: worst time in the last 1 to 2 minutes and since boot
struct WorstMs {
  uint32_t cur = 0, prev = 0, boot = 0, t0 = 0;
  void roll() { uint32_t now = millis(); if (now - t0 >= 60000) { prev = (now - t0 >= 120000) ? 0 : cur; cur = 0; t0 = now; } }
  void add(uint32_t v) { roll(); if (v > cur) cur = v; if (v > boot) boot = v; }
  uint32_t recent() { roll(); return cur > prev ? cur : prev; }
};
