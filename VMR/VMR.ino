  j += "\",\"flip\":"; j += (int)P.oledFlip; j += ",\"sflip\":"; j += (int)P.segFlip;
  j += ",\"brot\":"; j += (int)(P.ballRot & 3);
  j += ",\"rot\":"; j += (unsigned long)(P.scrRot & SCR_ROT_ALL);   // the Displays card's ticks
  j += ",\"av\":"; { unsigned long m = 0; for (int i = 0; i < NUM_SCREENS; i++) if (screenAvail(i)) m |= 1UL << i; j += m; }
  j += ",\"bbest\":"; j += (unsigned long)(ballBestMs(millis()) / 100);   // 0.1 s
  j += ",\"en\":"; j += (int)(P.dispEn & 7);        // which displays (the Add-ons card), the 7-segment and the LCD
  j += ",\"dark\":"; j += (int)(P.dispEn >> 4);      // switched off in the Displays card
  j += ",\"seg\":{\"ok\":"; j += segOK ? "true" : "false"; j += ",\"a\":"; j += (int)segAddrNow(); j += ",\"scr\":"; j += (int)P.segScreen;
  j += ",\"av\":"; { int m = 0; for (int i = 0; i < SEG_N; i++) if (segAvail(i)) m |= 1 << i; j += m; }
  j += ",\"rot\":"; j += (unsigned)(P.segRot & SEG_ROT_DEF);   // the Displays card's ticks
  if (cdSet) { long l = Cd::left(millis()); j += ",\"cd\":"; j += l > 0 ? (l + 999) / 1000 : 0; j += ",\"cdt\":"; j += (int)cdTotalS; }
  j += "},\"lcd\":{\"ok\":"; j += lcdOK ? "true" : "false"; j += ",\"a\":"; j += (int)lcdAddrNow(); j += ",\"scr\":"; j += (int)P.lcdScreen; j += ",\"cyc\":"; j += (int)P.lcdCycle;
  j += ",\"col\":"; j += (int)P.lcdColor;
